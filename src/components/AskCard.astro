---
const suggestions = [
  { q: "Who am I?", label: "Who am I?" },
  { q: "What am I working on?", label: "What am I working on?" },
  { q: "Get me a copy of your CV", label: "Get me a copy of your CV" },
  { q: "How can you reach me?", label: "How can you reach me?" },
];
---

<div class="ask-card-wrap" id="ask-card-wrap">
  <p class="ask-label" aria-hidden="true">Nike's avatar</p>
  <p class="ask-intro" id="ask-intro" aria-live="off">I am Nike's avatar. You come seeking answers.</p>
  <form class="ask-card" id="ask-card" autocomplete="off">
    <div class="ask-card-inner">
      <input
        type="text"
        name="question"
        class="ask-input"
        placeholder="Ask me anything…"
        maxlength="200"
        aria-label="Ask a question about Olanike"
        required
      />
      <button type="submit" class="ask-submit" aria-label="Send question">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="ask-suggestions">
      {suggestions.map((s) => (
        <button type="button" class="ask-chip" data-q={s.q}>
          <span class="ask-chip-chevron" aria-hidden="true">›</span> {s.label}
        </button>
      ))}
    </div>
    <p class="ask-hint">Press <kbd>Enter</kbd> to send, or click here</p>
  </form>
</div>

<script>
  import "./askCard.js"
</script>

<style>
  .ask-card-wrap {
    position: fixed;
    left: var(--ask-card-left, 6vw);
    bottom: var(--ask-card-bottom, 9vh);
    width: min(85vw, 420px);
    z-index: 50;
  }

  .ask-card-wrap.busy {
    pointer-events: none;
  }

  .ask-label {
    margin: 0 0 6px;
    text-align: left;
    text-transform: uppercase;
    background: var(--tarot-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    font-family: var(--secondary-font);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .ask-intro {
    margin: 0 0 14px;
    max-width: 30ch;
    text-align: left;
    color: var(--text);
    font-family: var(--secondary-font);
    font-size: clamp(1.15rem, 3.4vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .ask-intro::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 3px;
    background: var(--teal-light);
    vertical-align: text-bottom;
    animation: ask-cursor-blink 1s steps(1) infinite;
  }

  @keyframes ask-cursor-blink {
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-intro::after {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ask-intro {
      animation: ask-intro-in 0.8s ease 0.4s forwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-intro {
      opacity: 1;
    }
  }

  .ask-intro.hidden {
    opacity: 0;
  }

  @keyframes ask-intro-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ask-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ask-card-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1.5px solid rgba(207, 207, 223, 0.25);
    transition: border-color 0.2s ease;
  }

  .ask-card-inner:has(.ask-input:focus) {
    border-color: var(--teal-light);
  }

  .ask-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--secondary-font);
    font-size: clamp(1rem, 3vw, 1.2rem);
    font-weight: 600;
    padding: 8px 2px;
  }

  .ask-input::placeholder {
    color: var(--muted-text);
  }

  .ask-input:disabled {
    opacity: 0.6;
  }

  .ask-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    margin-right: 2px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--teal-light);
    cursor: pointer;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .ask-submit:hover {
    transform: translateX(2px);
    color: var(--text);
  }

  .ask-submit:focus-visible {
    outline: 2px solid var(--teal-light);
    outline-offset: 2px;
  }

  .ask-suggestions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 6px;
  }

  .ask-chip {
    background: rgba(207, 207, 223, 0.08);
    border: none;
    border-radius: 999px;
    padding: 6px 14px;
    color: var(--muted-text);
    font-family: var(--secondary-font);
    font-size: 0.75rem;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .ask-chip-chevron {
    color: var(--teal-light);
  }

  .ask-chip:hover,
  .ask-chip:focus-visible {
    color: var(--text);
    background: rgba(207, 207, 223, 0.16);
  }

  .ask-hint {
    margin: 0;
    text-align: left;
    color: var(--muted-text);
    font-family: var(--secondary-font);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ask-hint kbd {
    font-family: inherit;
  }

  .ask-hint kbd::before {
    content: '[';
  }

  .ask-hint kbd::after {
    content: ']';
  }

  @media (max-width: 480px) {
    .ask-card-wrap {
      left: var(--ask-card-left-mobile, 5vw);
      bottom: var(--ask-card-bottom-mobile, 6vh);
      width: min(90vw, 340px);
    }

    .ask-suggestions,
    .ask-hint {
      display: none;
    }
  }
</style>
