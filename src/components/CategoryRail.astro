---
import { CATEGORIES, CATEGORY_META } from "../categories.js";

const { counts, total } = Astro.props;
---

<div class="career-col">
    <nav class="category-rail" id="category-rail" aria-label="Filter projects by category">
        <p class="rail-title">Filter by Discipline</p>
        <ol class="rail-list">
            <li class="rail-item">
                <button type="button" class="rail-node active" data-category="all" aria-pressed="true">
                    <span class="node-dot" aria-hidden="true"></span>
                    <span class="node-label">All Work</span>
                    <span class="node-count">{String(total).padStart(2, "0")}</span>
                </button>
            </li>
            {CATEGORIES.map((category) => {
                const count = counts[category] ?? 0;
                const meta = CATEGORY_META[category];
                return (
                    <li class="rail-item">
                        <button
                            type="button"
                            class="rail-node"
                            data-category={category}
                            aria-pressed="false"
                            style={{ "--cat-accent": meta.accent }}
                        >
                            <span class="node-dot" aria-hidden="true"></span>
                            <span class="node-label">{meta.label}</span>
                            <span class="node-count">{String(count).padStart(2, "0")}</span>
                        </button>
                    </li>
                );
            })}
        </ol>
    </nav>
</div>

<style>
    .career-col {
        width: 100%;
        max-width: 240px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding-bottom: clamp(6px, 1.5vh, 20px);
        user-select: none;
    }

    .category-rail {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .rail-title {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(8, 14, 28, 0.5);
        margin: 0 0 6px;
    }

    .rail-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .rail-item {
        margin: 0;
        padding: 0;
    }

    .rail-node {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 8px 14px;
        border: 2px solid #000000;
        border-radius: 9999px;
        background: #ffffff;
        box-shadow: 2px 2px 0px #000000;
        cursor: pointer;
        text-align: left;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    .rail-node:hover {
        transform: translate(-1px, -1px);
        box-shadow: 3px 3px 0px #000000;
    }

    .rail-node:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px #000000, 0 0 0 5px var(--doodle-cyan, #00B3E3);
    }

    .rail-node[aria-pressed="true"] {
        background: var(--cat-accent, var(--doodle-cyan, #00B3E3));
        border-color: #000000;
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0px #000000;
    }

    .node-dot {
        flex-shrink: 0;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgba(8, 14, 28, 0.25);
        transition: all 0.25s ease;
    }

    .rail-node[aria-pressed="true"] .node-dot {
        background: #000000;
        transform: scale(1.3);
    }

    .node-label {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 700;
        font-size: 0.875rem;
        color: #0F172A;
        transition: color 0.2s ease;
        flex: 1;
    }

    .rail-node[aria-pressed="true"] .node-label {
        color: #000000;
        font-weight: 800;
    }

    .node-count {
        font-family: monospace;
        font-size: 0.6875rem;
        font-weight: 700;
        color: rgba(8, 14, 28, 0.4);
    }

    .rail-node[aria-pressed="true"] .node-count {
        color: #000000;
    }

    @media (max-width: 900px) {
        .career-col {
            max-width: none;
        }

        .rail-title {
            display: none;
        }

        .rail-list {
            flex-direction: row;
            overflow-x: auto;
            scrollbar-width: none;
            gap: 8px;
        }

        .rail-list::-webkit-scrollbar {
            display: none;
        }

        .rail-node {
            padding: 6px 14px;
            white-space: nowrap;
        }
    }
</style>
