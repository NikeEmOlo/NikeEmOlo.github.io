---
import { CATEGORIES, CATEGORY_META } from "../categories.js";

const { counts, total } = Astro.props;
---

<nav class="category-toolbar" id="category-rail" aria-label="Filter projects by discipline">
    <!-- Mobile-only trigger. Hidden on desktop, where the pills stay a rail. -->
    <button
        type="button"
        class="rail-dropdown-trigger"
        id="railDropdownTrigger"
        aria-expanded="false"
        aria-controls="railPillGroup"
    >
        <span class="trigger-label" aria-hidden="true">FILTER:</span>
        <span class="trigger-value" data-trigger-value>All Work</span>
        <span class="trigger-count" data-trigger-count>{String(total).padStart(2, "0")}</span>
        <span class="trigger-chevron" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </span>
    </button>

    <div class="toolbar-pill-group" id="railPillGroup">
        <span class="toolbar-label" aria-hidden="true">FILTER:</span>
        <button
            type="button"
            class="rail-node active"
            data-category="all"
            aria-pressed="true"
            style={{ "--cat-accent": "var(--doodle-yellow, #FFDA00)" }}
        >
            <span class="doodle-crown" aria-hidden="true">
                <svg width="18" height="15" viewBox="0 0 24 20" fill="none" class="crown-svg">
                    <path d="M2 17L4 5L9 11L12 3L15 11L20 5L22 17H2Z" fill="var(--cat-accent, #FFDA00)" stroke="#000000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="12" cy="3" r="1.5" fill="#FF1F70" stroke="#000000" stroke-width="1.2" />
                    <circle cx="4" cy="5" r="1.2" fill="#00B3E3" stroke="#000000" stroke-width="1" />
                    <circle cx="20" cy="5" r="1.2" fill="#00B3E3" stroke="#000000" stroke-width="1" />
                    <path d="M5 14H8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" />
                </svg>
            </span>
            <span class="node-dot" aria-hidden="true"></span>
            <span class="node-label">All Work</span>
            <span class="node-count">{String(total).padStart(2, "0")}</span>
        </button>

        {CATEGORIES.map((category) => {
            const count = counts[category] ?? 0;
            const meta = CATEGORY_META[category];
            return (
                <button
                    type="button"
                    class="rail-node"
                    data-category={category}
                    aria-pressed="false"
                    style={{ "--cat-accent": meta.accent }}
                >
                    <span class="doodle-crown" aria-hidden="true">
                        <svg width="18" height="15" viewBox="0 0 24 20" fill="none" class="crown-svg">
                            <path d="M2 17L4 5L9 11L12 3L15 11L20 5L22 17H2Z" fill="var(--cat-accent, #FFDA00)" stroke="#000000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="12" cy="3" r="1.5" fill="#FF1F70" stroke="#000000" stroke-width="1.2" />
                            <circle cx="4" cy="5" r="1.2" fill="#00B3E3" stroke="#000000" stroke-width="1" />
                            <circle cx="20" cy="5" r="1.2" fill="#00B3E3" stroke="#000000" stroke-width="1" />
                            <path d="M5 14H8" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="node-dot" aria-hidden="true"></span>
                    <span class="node-label">{meta.label}</span>
                    <span class="node-count">{String(count).padStart(2, "0")}</span>
                </button>
            );
        })}
    </div>
</nav>

<style>
    .category-toolbar {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        user-select: none;
        z-index: 30;
        margin-bottom: clamp(1.75rem, 3.5vh, 2.75rem);
    }

    .toolbar-pill-group {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .toolbar-label {
        font-family: monospace;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(15, 23, 42, 0.45);
        margin-right: 2px;
    }

    /* Sleek, streamlined pill buttons */
    .rail-node {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border: 1.5px solid #000000;
        border-radius: 9999px;
        background: #ffffff;
        box-shadow: 1.5px 1.5px 0px #000000;
        cursor: pointer;
        text-align: left;
        line-height: 1;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .rail-node:hover {
        transform: translate(-1px, -1px);
        box-shadow: 2px 2px 0px #000000;
        background: #ffffff;
    }

    .rail-node:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px #000000, 0 0 0 4px var(--cat-accent, var(--doodle-yellow, #FFDA00));
    }

    .rail-node[aria-pressed="true"] {
        background: #000000;
        border-color: #000000;
        color: #ffffff;
        transform: translate(1px, 1px);
        box-shadow: 0.5px 0.5px 0px #000000;
    }

    /* Floating Doodle-Pop Street Art Crown Mascot */
    .doodle-crown {
        position: absolute;
        top: -16px;
        left: 50%;
        transform: translateX(-50%) translateY(6px) scale(0) rotate(-15deg);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.16s ease, visibility 0.16s ease;
        z-index: 50;
        filter: drop-shadow(1.5px 1.5px 0px #000000);
    }

    /* Active selected button always displays the colored crown */
    .rail-node[aria-pressed="true"] .doodle-crown {
        visibility: visible;
        opacity: 1;
        transform: translateX(-50%) translateY(0) scale(1) rotate(-6deg);
    }

    /* Hovering shows the colored crown pop up */
    @media (hover: hover) {
        .rail-node:hover .doodle-crown {
            visibility: visible;
            opacity: 1;
            transform: translateX(-50%) translateY(0) scale(1) rotate(-6deg);
        }
    }

    .node-dot {
        flex-shrink: 0;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: rgba(15, 23, 42, 0.3);
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .rail-node[aria-pressed="true"] .node-dot {
        background: var(--cat-accent, #FFDA00);
        transform: scale(1.2);
    }

    .node-label {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: -0.04em;
        color: #0F172A;
        transition: color 0.15s ease;
    }

    .rail-node[aria-pressed="true"] .node-label {
        color: #ffffff;
        font-weight: 800;
    }

    .node-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: monospace;
        font-size: 0.625rem;
        font-weight: 800;
        color: rgba(15, 23, 42, 0.5);
        background: rgba(15, 23, 42, 0.05);
        border-radius: 9999px;
        min-width: 18px;
        height: 16px;
        padding: 0 5px;
        line-height: 1;
        box-sizing: border-box;
    }

    .rail-node[aria-pressed="true"] .node-count {
        color: #000000;
        background: #ffffff;
    }

    /* ── Mobile: collapse the rail into a dropdown ──
       The pill rail wrapped onto three lines on a phone and ate the vertical
       space the card deck needed. Below 900px the same buttons become a
       panel that opens over the deck instead of pushing it down. */
    .rail-dropdown-trigger {
        display: none;
    }

    @media (max-width: 900px) {
        .category-toolbar {
            position: relative;
            margin-bottom: 0;
        }

        /* Bare control, not a card: the panel it opens carries the chrome, so
           the trigger only needs to read as a line of type. */
        .rail-dropdown-trigger {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 2px 4px;
            border: none;
            background: transparent;
            box-shadow: none;
            cursor: pointer;
            line-height: 1;
            color: #0F172A;
            transition: opacity 0.12s ease;
        }

        .rail-dropdown-trigger:active {
            opacity: 0.6;
        }

        .trigger-label {
            font-family: monospace;
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(15, 23, 42, 0.45);
        }

        .trigger-value {
            font-family: var(--archivo-font, 'Archivo', sans-serif);
            font-weight: 800;
            font-size: 0.8125rem;
            letter-spacing: -0.04em;
            color: #0F172A;
        }

        .trigger-count {
            font-family: monospace;
            font-size: 0.625rem;
            font-weight: 800;
            color: rgba(15, 23, 42, 0.5);
            background: none;
            padding: 0;
        }

        .trigger-chevron {
            display: inline-flex;
            color: #0F172A;
            transition: transform 0.18s ease;
        }

        .rail-dropdown-trigger[aria-expanded="true"] .trigger-chevron {
            transform: rotate(180deg);
        }

        /* The panel floats over the deck rather than reserving layout space. */
        .toolbar-pill-group {
            position: absolute;
            top: calc(100% + 8px);
            left: 50%;
            transform: translateX(-50%);
            z-index: 900;
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: 6px;
            width: min(280px, calc(100vw - 48px));
            padding: 10px;
            background: #ffffff;
            border: 2.5px solid #000000;
            border-radius: 16px;
            box-shadow: 4px 5px 0px #000000;
            box-sizing: border-box;
            max-height: min(60vh, 420px);
            overflow-y: auto;
        }

        .category-toolbar.is-dropdown-open .toolbar-pill-group {
            display: flex;
        }

        .toolbar-label {
            display: none;
        }

        .toolbar-pill-group .rail-node {
            width: 100%;
            justify-content: flex-start;
            padding: 10px 12px;
            border-radius: 10px;
            box-shadow: none;
            transform: none;
        }

        .toolbar-pill-group .rail-node .node-count {
            margin-left: auto;
        }

        .toolbar-pill-group .rail-node[aria-pressed="true"] {
            transform: none;
            box-shadow: none;
        }

        /* Absolutely positioned above the pill — inside a panel it would sit
           on top of the row above it. */
        .toolbar-pill-group .doodle-crown {
            display: none;
        }

        .toolbar-pill-group .rail-node .node-label {
            font-size: 0.875rem;
        }
    }
</style>

<script>
    function initCategoryDropdown() {
        const rail = document.getElementById("category-rail");
        const trigger = document.getElementById("railDropdownTrigger");
        const panel = document.getElementById("railPillGroup");
        if (!rail || !trigger || !panel || rail.dataset.dropdownInit === "true") return;
        rail.dataset.dropdownInit = "true";

        const valueEl = trigger.querySelector("[data-trigger-value]");
        const countEl = trigger.querySelector("[data-trigger-count]");

        const isDropdownMode = () => window.matchMedia("(max-width: 900px)").matches;

        const close = () => {
            rail.classList.remove("is-dropdown-open");
            trigger.setAttribute("aria-expanded", "false");
        };

        const open = () => {
            rail.classList.add("is-dropdown-open");
            trigger.setAttribute("aria-expanded", "true");
        };

        trigger.addEventListener("click", (e) => {
            e.stopPropagation();
            if (trigger.getAttribute("aria-expanded") === "true") close();
            else open();
        });

        // The deck controller owns the aria-pressed swap; mirror whichever pill
        // ends up pressed onto the trigger's label, then collapse the panel.
        panel.querySelectorAll(".rail-node").forEach((btn) => {
            btn.addEventListener("click", () => {
                const label = btn.querySelector(".node-label")?.textContent?.trim();
                const count = btn.querySelector(".node-count")?.textContent?.trim();
                if (valueEl && label) valueEl.textContent = label;
                if (countEl && count) countEl.textContent = count;
                close();
            });
        });

        document.addEventListener("click", (e) => {
            if (!rail.contains(e.target)) close();
        });

        document.addEventListener("keydown", (e) => {
            if (e.key !== "Escape") return;
            if (trigger.getAttribute("aria-expanded") !== "true") return;
            close();
            trigger.focus();
        });

        // Resizing past the breakpoint must not leave the open-state class on
        // the desktop rail, where it would mean nothing but still linger.
        window.addEventListener("resize", () => {
            if (!isDropdownMode()) close();
        });
    }

    document.addEventListener("astro:page-load", initCategoryDropdown);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCategoryDropdown);
    } else {
        initCategoryDropdown();
    }
</script>
