---
import { CATEGORIES, CATEGORY_META } from "../categories.js";

const { counts, total } = Astro.props;
---

<div class="career-col">
    <nav class="category-rail" id="category-rail" aria-label="Filter projects by category">
        <p class="rail-title">Filter by Discipline</p>
        <ol class="rail-list">
            <li class="rail-item">
                <button type="button" class="rail-node active" data-category="all" aria-pressed="true">
                    <span class="node-dot" aria-hidden="true"></span>
                    <span class="node-label">All Work</span>
                    <span class="node-count">{String(total).padStart(2, "0")}</span>
                </button>
            </li>
            {CATEGORIES.map((category) => {
                const count = counts[category] ?? 0;
                const meta = CATEGORY_META[category];
                return (
                    <li class="rail-item">
                        <button
                            type="button"
                            class="rail-node"
                            data-category={category}
                            aria-pressed="false"
                            style={{ "--cat-accent": meta.accent }}
                        >
                            <span class="node-dot" aria-hidden="true"></span>
                            <span class="node-label">{meta.label}</span>
                            <span class="node-count">{String(count).padStart(2, "0")}</span>
                        </button>
                    </li>
                );
            })}
        </ol>
    </nav>
</div>

<style>
    .career-col {
        width: 100%;
        max-width: 240px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        user-select: none;
    }

    .category-rail {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .rail-title {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(207, 207, 223, 0.4);
        margin: 0 0 4px;
    }

    .rail-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .rail-item {
        margin: 0;
        padding: 0;
    }

    .rail-node {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 8px 12px;
        border: 1px solid transparent;
        border-radius: 999px;
        background: transparent;
        cursor: pointer;
        text-align: left;
        transition: all 0.2s ease;
    }

    .rail-node:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .rail-node:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--teal-light, #7ecece);
    }

    .rail-node[aria-pressed="true"] {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.1);
    }

    .node-dot {
        flex-shrink: 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(207, 207, 223, 0.3);
        transition: all 0.25s ease;
    }

    .rail-node[aria-pressed="true"] .node-dot {
        background: var(--cat-accent, var(--teal-light, #7ecece));
        box-shadow: 0 0 8px var(--cat-accent, var(--teal-light, #7ecece));
        transform: scale(1.3);
    }

    .node-label {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-weight: 500;
        font-size: 0.875rem;
        color: rgba(207, 207, 223, 0.6);
        transition: color 0.2s ease;
        flex: 1;
    }

    .rail-node[aria-pressed="true"] .node-label {
        color: #ffffff;
        font-weight: 600;
    }

    .node-count {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-size: 0.6875rem;
        font-weight: 600;
        color: rgba(207, 207, 223, 0.35);
    }

    .rail-node[aria-pressed="true"] .node-count {
        color: var(--cat-accent, var(--teal-light, #7ecece));
    }

    @media (max-width: 900px) {
        .career-col {
            max-width: none;
        }

        .rail-title {
            display: none;
        }

        .rail-list {
            flex-direction: row;
            overflow-x: auto;
            scrollbar-width: none;
            gap: 8px;
        }

        .rail-list::-webkit-scrollbar {
            display: none;
        }

        .rail-node {
            padding: 6px 14px;
            white-space: nowrap;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    }
</style>
