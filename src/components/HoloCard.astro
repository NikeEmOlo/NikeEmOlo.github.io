---
export interface Props {
    id?: string;
    title?: string;
    subtitle?: string;
    description?: string;
    badge?: string;
    stat?: string;
    orbColor?: "purple" | "teal" | "amber" | "rose" | "blue" | "cyan" | "coral" | "emerald" | string;
    autoFlip?: boolean;
    flipOnClick?: boolean;
    artworkUrl?: string;
    interactive?: boolean;
    startFront?: boolean;
    showVortex?: boolean;
}

const {
    id,
    title = "The Awakening",
    subtitle = "You've taken the first step in your journey.\nA fresh, new mind awaits you.",
    description,
    badge = "Epic Milestone",
    stat = "+100 Tranquility",
    orbColor = "purple",
    autoFlip = false,
    flipOnClick = false,
    interactive = true,
    startFront = true,
} = Astro.props;

const cardSubtitle = subtitle || description || "You've taken the first step in your journey.\nA fresh, new mind awaits you.";
const subtitleLines = cardSubtitle.split("\n");

// Harmonic Mystic Tarot Orb Color Themes (matching site brand palette)
const ORB_THEMES: Record<string, { hue: string; glow: string; badgeBg: string; gradStart: string; gradEnd: string; halo: string }> = {
    purple: { hue: "0deg", glow: "rgba(112, 72, 152, 0.6)", badgeBg: "#704898", gradStart: "#c084d4", gradEnd: "#704898", halo: "rgba(112, 72, 152, 0.25)" },
    teal: { hue: "160deg", glow: "rgba(53, 158, 157, 0.6)", badgeBg: "#1b6f6e", gradStart: "#7ecece", gradEnd: "#359e9d", halo: "rgba(53, 158, 157, 0.25)" },
    amber: { hue: "260deg", glow: "rgba(232, 114, 44, 0.6)", badgeBg: "#d97706", gradStart: "#fbbf24", gradEnd: "#e8722c", halo: "rgba(232, 114, 44, 0.25)" },
    rose: { hue: "45deg", glow: "rgba(225, 29, 72, 0.6)", badgeBg: "#be83d3", gradStart: "#fb7185", gradEnd: "#704898", halo: "rgba(225, 29, 72, 0.25)" },
    blue: { hue: "200deg", glow: "rgba(53, 158, 157, 0.6)", badgeBg: "#2563eb", gradStart: "#60a5fa", gradEnd: "#2563eb", halo: "rgba(37, 99, 235, 0.25)" },
    cyan: { hue: "175deg", glow: "rgba(53, 158, 157, 0.6)", badgeBg: "#1b6f6e", gradStart: "#22d3ee", gradEnd: "#0891b2", halo: "rgba(126, 206, 206, 0.25)" },
    coral: { hue: "300deg", glow: "rgba(232, 114, 44, 0.6)", badgeBg: "#e8722c", gradStart: "#fb923c", gradEnd: "#704898", halo: "rgba(232, 114, 44, 0.25)" },
    emerald: { hue: "130deg", glow: "rgba(53, 158, 157, 0.6)", badgeBg: "#1b6f6e", gradStart: "#34d399", gradEnd: "#059669", halo: "rgba(53, 158, 157, 0.25)" },
};

const theme = ORB_THEMES[orbColor] || ORB_THEMES.purple;
const uid = id || title.toLowerCase().replace(/[^a-z0-9]/g, "-");
---

<div
    class="holo-card-root"
    data-holo-card
    data-card-id={uid}
    data-orb-color={orbColor}
    style={{
        "--orb-hue": theme.hue,
        "--orb-glow": theme.glow,
        "--badge-bg": theme.badgeBg,
        "--orb-grad-start": theme.gradStart,
        "--orb-grad-end": theme.gradEnd,
        "--orb-halo": theme.halo,
    }}
>
    <!-- Subtle Ambient Stardust Field -->
    <div class="holo-ambient-bokeh-field" aria-hidden="true">
        <span class="stardust p1"></span>
        <span class="stardust p2"></span>
        <span class="stardust p3"></span>
        <span class="stardust p4"></span>
        <span class="stardust p5"></span>
        <span class="stardust p6"></span>
        <span class="stardust p7"></span>
        <span class="stardust p8"></span>
    </div>

    <!-- 3D Card Interactive Wrapper -->
    <div
        class="holo-card-3d-wrapper"
        data-holo-3d-wrapper
        data-title={title}
        data-subtitle={cardSubtitle}
        data-badge={badge}
        data-stat={stat}
        data-flip-on-click={flipOnClick ? "true" : "false"}
        data-start-front={startFront ? "true" : "false"}
        data-interactive={interactive ? "true" : "false"}
    >
        <div class="holo-card-flipper" data-holo-flipper>
            <!-- ─── FRONT FACE (100% Vector & Pure CSS Hologram) ─── -->
            <div class="holo-card-face holo-card-front">
                <div class="holo-face-clip">
                    <!-- 1. Pure CSS Animated Fluid Gradient Aura -->
                    <div class="holo-fluid-aura" aria-hidden="true">
                        <div class="fluid-orb orb-primary"></div>
                        <div class="fluid-orb orb-secondary"></div>
                        <div class="fluid-orb orb-tertiary"></div>
                    </div>

                    <!-- 2. Sacred Astral Rings & Cosmic Geometry -->
                    <div class="holo-astral-stage" aria-hidden="true">
                        <svg viewBox="0 0 200 200" class="astral-svg">
                            <defs>
                                <linearGradient id={`astral-grad-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color={theme.gradStart} stop-opacity="0.9" />
                                    <stop offset="50%" stop-color={theme.gradEnd} stop-opacity="0.6" />
                                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0.95" />
                                </linearGradient>
                                <linearGradient id={`astral-glow-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color={theme.gradStart} stop-opacity="0.4" />
                                    <stop offset="100%" stop-color="transparent" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <circle cx="100" cy="100" r="82" fill="none" stroke={`url(#astral-grad-${uid})`} stroke-width="1.2" stroke-dasharray="4 6" opacity="0.6" class="spin-slow" />
                            <circle cx="100" cy="100" r="66" fill={`url(#astral-glow-${uid})`} stroke={`url(#astral-grad-${uid})`} stroke-width="1.4" opacity="0.8" />
                            <circle cx="100" cy="100" r="48" fill="none" stroke="#ffffff" stroke-width="1.2" opacity="0.75" class="pulse-gentle" />
                            <circle cx="100" cy="100" r="28" fill="none" stroke={`url(#astral-grad-${uid})`} stroke-width="1.4" stroke-dasharray="2 4" class="spin-reverse" />
                            <circle cx="100" cy="100" r="10" fill="#ffffff" opacity="0.9" />
                            <line x1="100" y1="18" x2="100" y2="182" stroke="#ffffff" stroke-width="1" stroke-dasharray="3 5" opacity="0.5" />
                            <line x1="18" y1="100" x2="182" y2="100" stroke="#ffffff" stroke-width="1" stroke-dasharray="3 5" opacity="0.5" />
                        </svg>
                    </div>

                    <!-- 3. Die-Cut White Frame Layer -->
                    <svg class="holo-vector-frame" viewBox="0 0 360 500" preserveAspectRatio="none" aria-hidden="true">
                        <path
                            d="M 0 0 L 360 0 L 360 500 L 0 500 Z
                               M 30 16
                               L 330 16
                               Q 344 16 344 30
                               L 344 416
                               Q 344 430 330 434
                               Q 214 438 206 432
                               A 26 26 0 0 0 154 432
                               Q 146 438 30 434
                               Q 16 430 16 416
                               L 16 30
                               Q 16 16 30 16
                               Z"
                            fill="#ffffff"
                            fill-rule="evenodd"
                        />
                        <path
                            d="M 30 16 L 330 16 Q 344 16 344 30 L 344 416 Q 344 430 330 434 Q 214 438 206 432 A 26 26 0 0 0 154 432 Q 146 438 30 434 Q 16 430 16 416 L 16 30 Q 16 16 30 16 Z"
                            fill="none"
                            stroke="rgba(226, 232, 240, 0.85)"
                            stroke-width="1"
                        />
                    </svg>

                    <!-- 4. Vector Pin-Sharp Typography -->
                    <div class="holo-typography-container">
                        <h2 class="holo-title-text" data-title-text>{title}</h2>
                        <div class="holo-subtitle-text" data-subtitle-text>
                            {subtitleLines.map((line) => (
                                <p class="subtitle-line">{line}</p>
                            ))}
                        </div>
                    </div>

                    <!-- 5. Crisp Solid Frosted Status Pill -->
                    <div class="holo-status-pill">
                        <div class="status-left-badge">
                            <span class="badge-e-square" data-badge-icon>{badge.charAt(0).toUpperCase()}</span>
                            <span class="badge-title-label" data-badge-label>{badge}</span>
                        </div>
                        <div class="status-right-stat">
                            <span class="stat-value-label" data-stat-label>{stat}</span>
                            <div class="sacred-geo-icon">
                                <svg viewBox="0 0 24 24" width="16" height="16">
                                    <circle cx="12" cy="12" r="11" fill={`url(#geo-grad-${uid})`} />
                                    <defs>
                                        <linearGradient id={`geo-grad-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color={theme.gradStart} />
                                            <stop offset="100%" stop-color={theme.gradEnd} />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="12" cy="12" r="4.5" fill="none" stroke="#ffffff" stroke-width="1.2" />
                                    <line x1="12" y1="2" x2="12" y2="22" stroke="#ffffff" stroke-width="1.2" />
                                    <line x1="2" y1="12" x2="22" y2="12" stroke="#ffffff" stroke-width="1.2" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- 6. Center Notch Gemstone Crystal Orb -->
                    <div class="holo-orb-notch-anchor">
                        <div class="crystal-orb-glow-wrapper">
                            <img
                                src="/holo-card/demo-orb-crystal.png"
                                alt="Crystal Gemstone Orb"
                                class="crystal-orb-img"
                            />
                            <div class="crystal-orb-sheen-overlay" aria-hidden="true"></div>
                        </div>
                    </div>

                    <!-- 7. 4 Diamond Stars -->
                    <div class="holo-diamond-stars" aria-hidden="true">✦ &nbsp;✦ &nbsp;✦ &nbsp;✦</div>

                    <!-- 8. Multi-Layer Pure CSS Spectral Holographic Foil Glare -->
                    <div class="holo-foil-glare-layer" aria-hidden="true">
                        <div class="glare-spectral-sweep"></div>
                        <div class="glare-specular-flare"></div>
                    </div>
                </div>
            </div>

            <!-- ─── BACK FACE (Metallic Midnight Tarot Back) ─── -->
            <div class="holo-card-face holo-card-back">
                <div class="holo-face-clip">
                    <div class="metallic-back-container">
                        <div class="metallic-filigree-border">
                            <span class="corner-diamond top-left">✦</span>
                            <span class="corner-diamond top-right">✦</span>
                            <span class="corner-diamond bottom-left">✦</span>
                            <span class="corner-diamond bottom-right">✦</span>

                            <div class="back-sacred-stage">
                                <svg viewBox="0 0 200 300" class="back-mandala-svg">
                                    <defs>
                                        <linearGradient id={`back-gold-grad-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="#e2e8f0" stop-opacity="0.8" />
                                            <stop offset="45%" stop-color="#94a3b8" stop-opacity="0.4" />
                                            <stop offset="100%" stop-color="#cbd5e1" stop-opacity="0.75" />
                                        </linearGradient>
                                    </defs>
                                    <circle cx="100" cy="150" r="75" fill="none" stroke={`url(#back-gold-grad-${uid})`} stroke-width="1.2" stroke-dasharray="3 5" />
                                    <circle cx="100" cy="150" r="58" fill="rgba(255, 255, 255, 0.03)" stroke={`url(#back-gold-grad-${uid})`} stroke-width="1.4" />
                                    <circle cx="100" cy="150" r="40" fill="none" stroke={`url(#back-gold-grad-${uid})`} stroke-width="1" />
                                    <circle cx="100" cy="150" r="22" fill="rgba(255, 255, 255, 0.06)" stroke={`url(#back-gold-grad-${uid})`} stroke-width="1.2" stroke-dasharray="2 3" />
                                    
                                    <path d="M 100 134 L 104 146 L 116 150 L 104 154 L 100 166 L 96 154 L 84 150 L 96 146 Z" fill="#ffffff" opacity="0.9" />

                                    <line x1="100" y1="45" x2="100" y2="255" stroke={`url(#back-gold-grad-${uid})`} stroke-width="0.8" stroke-dasharray="2 4" />
                                    <line x1="20" y1="150" x2="180" y2="150" stroke={`url(#back-gold-grad-${uid})`} stroke-width="0.8" stroke-dasharray="2 4" />
                                    <line x1="40" y1="90" x2="160" y2="210" stroke={`url(#back-gold-grad-${uid})`} stroke-width="0.6" opacity="0.5" />
                                    <line x1="40" y1="210" x2="160" y2="90" stroke={`url(#back-gold-grad-${uid})`} stroke-width="0.6" opacity="0.5" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .holo-card-root {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        user-select: none;
        overflow: visible;
        transform-style: preserve-3d;
    }

    /* Ambient Stardust Field */
    .holo-ambient-bokeh-field {
        position: absolute;
        inset: -20px;
        pointer-events: none;
        z-index: 1;
        overflow: visible;
    }

    .stardust {
        position: absolute;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: 0 0 4px rgba(255, 255, 255, 0.8), 0 0 8px rgba(126, 206, 206, 0.4);
        animation: slowStardustDrift var(--duration, 24s) linear infinite;
        animation-delay: var(--delay, 0s);
        will-change: transform, opacity;
    }

    @keyframes slowStardustDrift {
        0% { transform: translate3d(0, 0, 0); opacity: 0; }
        15% { opacity: var(--max-op, 0.45); }
        85% { opacity: var(--max-op, 0.45); }
        100% { transform: translate3d(var(--drift-x, 0px), var(--drift-y, -140px), 0); opacity: 0; }
    }

    .stardust.p1 { top: 20%; left: 8%; width: 2px; height: 2px; --duration: 20s; --delay: 0s; --max-op: 0.40; --drift-x: 6px; --drift-y: -120px; }
    .stardust.p2 { top: 40%; right: 12%; width: 3px; height: 3px; --duration: 26s; --delay: -4s; --max-op: 0.50; --drift-x: -8px; --drift-y: -140px; }
    .stardust.p3 { bottom: 25%; left: 16%; width: 2.5px; height: 2.5px; --duration: 22s; --delay: -8s; --max-op: 0.45; --drift-x: 5px; --drift-y: -130px; }
    .stardust.p4 { bottom: 15%; right: 20%; width: 2px; height: 2px; --duration: 24s; --delay: -12s; --max-op: 0.35; --drift-x: -4px; --drift-y: -125px; }
    .stardust.p5 { top: 15%; right: 30%; width: 2px; height: 2px; --duration: 28s; --delay: -16s; --max-op: 0.35; --drift-x: 7px; --drift-y: -135px; }
    .stardust.p6 { bottom: 35%; left: 35%; width: 2px; height: 2px; --duration: 25s; --delay: -20s; --max-op: 0.40; --drift-x: -5px; --drift-y: -140px; }
    .stardust.p7 { top: 50%; left: 6%; width: 3px; height: 3px; --duration: 23s; --delay: -2s; --max-op: 0.45; --drift-x: 8px; --drift-y: -120px; }
    .stardust.p8 { top: 65%; right: 8%; width: 2px; height: 2px; --duration: 27s; --delay: -10s; --max-op: 0.30; --drift-x: -6px; --drift-y: -130px; }

    /* 3D Card Interactive Perspective Wrapper */
    .holo-card-3d-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        z-index: 2;
        cursor: pointer;
    }

    .holo-card-flipper {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        border-radius: 18px;
        box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.45);
        transition: transform 0.12s ease-out, box-shadow 0.25s ease;
    }

    .holo-card-3d-wrapper:hover .holo-card-flipper {
        box-shadow: 0 24px 48px -8px rgba(0, 0, 0, 0.65);
    }

    /* Core 3D Face Styling with Explicit Backface Culling */
    .holo-card-face {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: 18px;
        backface-visibility: hidden !important;
        -webkit-backface-visibility: hidden !important;
        transform-style: preserve-3d;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    .holo-face-clip {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: 18px;
        overflow: hidden;
    }

    /* FRONT FACE */
    .holo-card-front {
        transform: rotateY(0deg) translateZ(1px);
        background: #ffffff;
    }

    /* BACK FACE */
    .holo-card-back {
        transform: rotateY(180deg) translateZ(1px);
        background: radial-gradient(circle at center, #1b263b 0%, #0d1527 60%, #050a14 100%);
        border: 2px solid rgba(226, 232, 240, 0.3);
        box-sizing: border-box;
    }

    /* 1. Pure CSS Animated Fluid Aura */
    .holo-fluid-aura {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        overflow: hidden;
        background: radial-gradient(circle at 50% 40%, #111d33 0%, #080f1d 70%, #030710 100%);
        z-index: 1;
    }

    .fluid-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(28px);
        opacity: 0.85;
        mix-blend-mode: screen;
        will-change: transform;
    }

    .orb-primary {
        width: 170px;
        height: 170px;
        top: 15%;
        left: 15%;
        background: radial-gradient(circle, var(--orb-grad-start, #c084d4) 0%, var(--orb-grad-end, #704898) 70%, transparent 100%);
        animation: orbDrift1 12s ease-in-out infinite alternate;
    }

    .orb-secondary {
        width: 140px;
        height: 140px;
        top: 25%;
        right: 12%;
        background: radial-gradient(circle, #7ecece 0%, #359e9d 60%, transparent 100%);
        animation: orbDrift2 10s ease-in-out infinite alternate;
    }

    .orb-tertiary {
        width: 120px;
        height: 120px;
        top: 8%;
        left: 32%;
        background: radial-gradient(circle, #ffffff 0%, var(--orb-grad-start, #c084d4) 50%, transparent 100%);
        opacity: 0.65;
        animation: orbDrift3 8s ease-in-out infinite alternate;
    }

    @keyframes orbDrift1 {
        0% { transform: translate3d(0, 0, 0) scale(1.0); }
        100% { transform: translate3d(24px, 18px, 0) scale(1.15); }
    }

    @keyframes orbDrift2 {
        0% { transform: translate3d(0, 0, 0) scale(1.0); }
        100% { transform: translate3d(-20px, -16px, 0) scale(1.12); }
    }

    @keyframes orbDrift3 {
        0% { transform: translate3d(0, 0, 0) scale(0.95); opacity: 0.5; }
        100% { transform: translate3d(12px, 20px, 0) scale(1.2); opacity: 0.8; }
    }

    /* 2. Sacred Astral Rings & Geometry */
    .holo-astral-stage {
        position: absolute;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        width: 170px;
        height: 170px;
        z-index: 2;
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .astral-svg {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 0 12px var(--orb-glow, rgba(112, 72, 152, 0.4)));
    }

    .spin-slow {
        transform-origin: 100px 100px;
        animation: rotateAstral 40s linear infinite;
    }

    .spin-reverse {
        transform-origin: 100px 100px;
        animation: rotateAstralReverse 28s linear infinite;
    }

    .pulse-gentle {
        transform-origin: 100px 100px;
        animation: pulseAstral 5s ease-in-out infinite alternate;
    }

    @keyframes rotateAstral {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @keyframes rotateAstralReverse {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(-360deg); }
    }

    @keyframes pulseAstral {
        0% { transform: scale(0.96); opacity: 0.6; }
        100% { transform: scale(1.04); opacity: 0.95; }
    }

    /* 3. Die-Cut Vector Frame */
    .holo-vector-frame {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 3;
        pointer-events: none;
    }

    /* 4. Sleek, Modern, Highly Legible Typography */
    .holo-typography-container {
        position: absolute;
        top: 48%;
        bottom: 42px;
        left: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        z-index: 4;
        pointer-events: none;
        padding: 0 14px;
        box-sizing: border-box;
    }

    .holo-title-text {
        margin: 0 0 4px 0;
        font-family: var(--secondary-font, 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
        font-size: clamp(0.92rem, 1.2vw, 1.06rem);
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.015em;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.6);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    .holo-subtitle-text {
        margin: 0;
        font-family: var(--secondary-font, 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
        font-size: 0.70rem;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.95);
        line-height: 1.3;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
        max-width: 26ch;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    .subtitle-line {
        margin: 0;
    }

    /* 5. Frosted Bottom Status Bar */
    .holo-status-pill {
        position: absolute;
        bottom: 14px;
        left: 10px;
        right: 10px;
        height: 28px;
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 8px;
        box-sizing: border-box;
        z-index: 4;
        pointer-events: none;
    }

    .status-left-badge {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .badge-e-square {
        width: 16px;
        height: 16px;
        background: var(--badge-bg, #704898);
