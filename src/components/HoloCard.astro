<script>
    function mountPureCSSHoloCards() {
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

        document.querySelectorAll("[data-holo-card]").forEach((rootEl) => {
            const root = rootEl;
            if (root.dataset.holoMounted) return;
            root.dataset.holoMounted = "true";

            const wrapper = root.querySelector("[data-holo-3d-wrapper]");
            const flipper = root.querySelector("[data-holo-flipper]");
            if (!wrapper || !flipper) return;

            // Pointer tracking for interactive holographic glare & subtle tilt
            wrapper.addEventListener("pointermove", (e) => {
                const parentItem = root.closest(".deck-card-item");
                // ONLY apply interactive tilt & glare to the active center hero card
                if (parentItem && !parentItem.classList.contains("is-active-hero")) {
                    return;
                }

                const rect = wrapper.getBoundingClientRect();
                const px = Math.min(Math.max((e.clientX - rect.left) / rect.width, 0), 1);
                const py = Math.min(Math.max((e.clientY - rect.top) / rect.height, 0), 1);
                const nx = px * 2 - 1;
                const ny = -(py * 2 - 1);

                // Set CSS custom properties on flipper
                flipper.style.setProperty("--pointer-x", `${(px * 100).toFixed(1)}%`);
                flipper.style.setProperty("--pointer-y", `${(py * 100).toFixed(1)}%`);
                flipper.style.setProperty("--glare-angle", `${(115 + nx * 45).toFixed(1)}deg`);
                
                const dist = Math.sqrt(nx * nx + ny * ny);
                const glareOp = Math.min(0.60, Math.max(0.20, 0.28 + dist * 0.25));
                flipper.style.setProperty("--glare-opacity", glareOp.toFixed(2));

                const orbLightX = (36 + nx * 8).toFixed(1);
                const orbLightY = (26 - ny * 8).toFixed(1);
                flipper.style.setProperty("--orb-light-x", `${orbLightX}%`);
                flipper.style.setProperty("--orb-light-y", `${orbLightY}%`);

                // Gentle 3D tilt ONLY when directly hovered on active center card
                if (!reducedMotion) {
                    const tiltX = (-10 * ny).toFixed(2);
                    const tiltY = (12 * nx).toFixed(2);
                    flipper.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;
                }
            });

            wrapper.addEventListener("pointerleave", () => {
                flipper.style.transform = "";
                flipper.style.setProperty("--glare-opacity", "0.30");
            });
        });
    }

    document.addEventListener("astro:page-load", mountPureCSSHoloCards);
    document.addEventListener("DOMContentLoaded", mountPureCSSHoloCards);
</script>
