---
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<nav class="doodle-nav">
    <button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <div class="nav-menu" id="nav-menu">
        <ul id="pages-list">
            <li>
                <button id="open-living-cv" class="nav-item-btn nav-cv-btn" style="--accent-color: var(--doodle-pink, #FF1F70)" aria-haspopup="dialog" aria-controls="cv-modal">
                    <svg class="nav-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>CV</span>
                </button>
            </li>
            <li>
                <a href="/" class="nav-item-btn nav-link" style="--accent-color: var(--doodle-cyan, #00B3E3)" aria-current={isCurrent("/") ? "page" : undefined}>
                    <span>Home</span>
                </a>
            </li>
            <li>
                <a href="https://outeroffice.co" target="_blank" rel="noopener noreferrer" class="nav-item-btn nav-link" style="--accent-color: var(--doodle-yellow, #FFDA00)">
                    <span>Outer Office</span>
                    <svg class="nav-ext-svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                </a>
            </li>
            <li>
                <a href="mailto:nike.emily@pm.me" class="nav-item-btn nav-link nav-contact" style="--accent-color: var(--doodle-purple, #A855F7)">
                    <span>Contact</span>
                </a>
            </li>
        </ul>
    </div>
</nav>

<script>
    import "./navigation.js"
</script>

<style>
    nav.doodle-nav {
        position: fixed;
        top: 1.25rem;
        right: 1.5rem;
        display: flex;
        align-items: center;
        width: fit-content;
        border-radius: 9999px;
        padding: 4px;
        z-index: 200;
        background: #ffffff;
        border: 2px solid #000000;
        box-shadow: 2px 3px 0px #000000;
    }

    .nav-menu {
        display: flex;
        align-items: center;
    }

    ul {
        display: flex;
        align-items: center;
        gap: 4px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-item-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        background: transparent;
        padding: 5px 12px;
        border: 2px solid transparent;
        border-radius: 9999px;
        color: #0F172A;
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 700;
        text-decoration: none;
        font-size: 0.8125rem;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease, border-color 0.12s ease, color 0.12s ease;
    }

    .nav-item-btn:hover {
        background: var(--accent-color, #f1f5f9);
        border-color: #000000;
        color: #000000;
        transform: translate(-1px, -1px);
        box-shadow: 2px 2px 0px #000000;
    }

    .nav-item-btn:active {
        transform: translate(1px, 1px);
        box-shadow: 0px 0px 0px #000000;
    }

    .nav-item-btn[aria-current="page"] {
        background: var(--doodle-cyan, #00B3E3);
        color: #000000;
        border-color: #000000;
        box-shadow: 2px 2px 0px #000000;
    }

    .nav-icon-svg {
        display: inline-block;
        flex-shrink: 0;
    }

    .nav-ext-svg {
        display: inline-block;
        flex-shrink: 0;
        opacity: 0.75;
    }

    /* ── Hamburger button ── */
    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 4px;
        width: 34px;
        height: 34px;
        padding: 6px;
        background: #ffffff;
        border: 2px solid #000000;
        border-radius: 9999px;
        box-shadow: 2px 2px 0px #000000;
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .hamburger:hover {
        background: var(--doodle-cyan, #00B3E3);
        transform: translate(-1px, -1px);
        box-shadow: 3px 3px 0px #000000;
    }

    .hamburger:active {
        transform: translate(1px, 1px);
        box-shadow: 0px 0px 0px #000000;
    }

    .hamburger span {
        display: block;
        width: 18px;
        height: 2px;
        border-radius: 2px;
        background: #000000;
        transition: transform 0.2s ease, opacity 0.2s ease;
        transform-origin: center;
    }

    /* Animate into × when open */
    .hamburger[aria-expanded="true"] span:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }
    .hamburger[aria-expanded="true"] span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    .hamburger[aria-expanded="true"] span:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    /* ── Collapsed (mobile) layout ── */
    nav.is-mobile {
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
    }

    nav.is-mobile .hamburger {
        display: flex;
    }

    nav.is-mobile .nav-menu {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        flex-direction: column;
        align-items: stretch;
        padding: 8px;
        border-radius: 16px;
        background-color: #ffffff;
        border: 2px solid #000000;
        box-shadow: 3px 4px 0px #000000;
        z-index: 100;
        min-width: 140px;
    }

    nav.is-mobile:has(.hamburger[aria-expanded="true"]) .nav-menu {
        display: flex;
    }

    nav.is-mobile ul {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    nav.is-mobile .nav-item-btn {
        width: 100%;
        justify-content: flex-start;
        padding: 8px 12px;
        font-size: 0.875rem;
    }
</style>
