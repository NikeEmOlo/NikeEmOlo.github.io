---
interface Props {
  size?: string;
  class?: string;
}

const { size = "100%", class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 320 360"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  style={`width: ${size}; height: auto; display: block;`}
  class={className}
>
  <!-- Ground Cast Shadow (Hard-edged ellipse) -->
  <ellipse cx="160" cy="334" rx="68" ry="14" fill="#000000" opacity="0.9" />

  <!-- MAIN CHARACTER GROUP -->
  <g class="cordelia-figure">
    
    <!-- 1. LEGS & SNEAKERS -->
    <!-- Left Leg & Shoe -->
    <g class="leg-left">
      <path d="M 126 235 L 122 286" stroke="#000000" stroke-width="8" stroke-linecap="round" />
      <path d="M 126 235 L 122 286" stroke="#8C5338" stroke-width="4" stroke-linecap="round" />

      <!-- Sneaker Left -->
      <path
        d="M 102 288 C 102 278, 122 276, 138 280 C 146 282, 148 290, 146 300 C 144 308, 132 312, 116 312 C 100 312, 102 298, 102 288 Z"
        fill="#FFFFFF"
        stroke="#000000"
        stroke-width="4"
        stroke-linejoin="round"
      />
      <!-- Coral Accent -->
      <path
        d="M 102 294 C 104 284, 116 282, 126 284 C 120 296, 116 308, 106 310 C 102 306, 102 298, 102 294 Z"
        fill="#E11D48"
        stroke="#000000"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <rect x="124" y="284" width="10" height="3" rx="1.5" fill="#FFFFFF" transform="rotate(-15 124 284)" />
    </g>

    <!-- Right Leg & Shoe -->
    <g class="leg-right">
      <path d="M 194 235 L 198 286" stroke="#000000" stroke-width="8" stroke-linecap="round" />
      <path d="M 194 235 L 198 286" stroke="#8C5338" stroke-width="4" stroke-linecap="round" />

      <!-- Sneaker Right -->
      <path
        d="M 174 280 C 190 276, 210 278, 218 288 C 218 298, 220 312, 204 312 C 188 312, 176 308, 174 300 C 172 290, 174 282, 174 280 Z"
        fill="#FFFFFF"
        stroke="#000000"
        stroke-width="4"
        stroke-linejoin="round"
      />
      <!-- Coral Accent -->
      <path
        d="M 194 284 C 204 282, 216 284, 218 294 C 218 298, 218 306, 214 310 C 204 308, 200 296, 194 284 Z"
        fill="#E11D48"
        stroke="#000000"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <rect x="182" y="282" width="10" height="3" rx="1.5" fill="#FFFFFF" transform="rotate(15 182 282)" />
    </g>

    <!-- 2. SHORTS / SKIRT -->
    <g class="bottoms">
      <path
        d="M 114 204 L 206 204 L 214 238 L 176 242 L 160 222 L 144 242 L 106 238 Z"
        fill="#18181B"
        stroke="#000000"
        stroke-width="4"
        stroke-linejoin="round"
      />
    </g>

    <!-- 3. OVERSIZED HOODIE (THE TAILOR) -->
    <g class="torso">
      <!-- Shadow Plane -->
      <path
        d="M 112 138 C 112 138, 132 132, 160 132 C 188 132, 208 138, 208 138 L 214 208 L 106 208 Z"
        fill="#9F1239"
      />
      <!-- Coral Main Hoodie Base -->
      <path
        d="M 112 136 C 112 136, 132 130, 160 130 C 188 130, 208 136, 208 136 L 214 204 L 106 204 Z"
        fill="#E11D48"
        stroke="#000000"
        stroke-width="4"
        stroke-linejoin="round"
      />
      <!-- Kangaroo Pocket -->
      <path
        d="M 128 174 L 192 174 L 186 202 L 134 202 Z"
        fill="#BE123C"
        stroke="#000000"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <!-- Drawstrings -->
      <path d="M 150 136 L 148 162" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
      <path d="M 170 136 L 172 162" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
    </g>

    <!-- 4. HANDS HOLDING FLOATING RESUME / SKILL CARDS -->
    <g class="tailoring-cards">
      <!-- Left Arm & Hand -->
      <path
        d="M 114 138 L 90 170 L 120 184 L 130 156 Z"
        fill="#E11D48"
        stroke="#000000"
        stroke-width="4"
        stroke-linejoin="round"
      />
      <circle cx="124" cy="184" r="10" fill="#8C5338" stroke="#000000" stroke-width="3.5" />

      <!-- Right Arm & Hand -->
      <path
        d="M 206 138 L 230 170 L 200 184 L 190 156 Z"
        fill="#E11D48"
        stroke="#000000"
        stroke-width="4"
        stroke-linejoin="round"
      />
      <circle cx="196" cy="184" r="10" fill="#8C5338" stroke="#000000" stroke-width="3.5" />

      <!-- Floating Card 1 (Master CV) -->
      <rect
        x="132"
        y="160"
        width="38"
        height="52"
        rx="4"
        fill="#FFFFFF"
        stroke="#000000"
        stroke-width="3"
        transform="rotate(-8 132 160)"
      />
      <!-- Card mini header line -->
      <rect x="137" y="166" width="16" height="3" rx="1.5" fill="#E11D48" transform="rotate(-8 132 160)" />
      <rect x="137" y="173" width="26" height="2" rx="1" fill="#71717A" transform="rotate(-8 132 160)" />
      <rect x="137" y="178" width="22" height="2" rx="1" fill="#71717A" transform="rotate(-8 132 160)" />
      <rect x="137" y="183" width="18" height="2" rx="1" fill="#71717A" transform="rotate(-8 132 160)" />

      <!-- Floating Card 2 (Tailored Application) -->
      <rect
        x="152"
        y="154"
        width="38"
        height="52"
        rx="4"
        fill="#FFFFFF"
        stroke="#000000"
        stroke-width="3"
        transform="rotate(10 152 154)"
      />
      <!-- Tailored verified badge -->
      <circle cx="178" cy="164" r="4" fill="#10B981" stroke="#000000" stroke-width="1.5" />
      <rect x="158" y="160" width="14" height="3" rx="1.5" fill="#0EA5E9" transform="rotate(10 152 154)" />
      <rect x="158" y="167" width="24" height="2" rx="1" fill="#71717A" transform="rotate(10 152 154)" />
      <rect x="158" y="172" width="20" height="2" rx="1" fill="#71717A" transform="rotate(10 152 154)" />
    </g>

    <!-- 5. HEAD & BRAIDED BUNS HAIRSTYLE -->
    <g class="head-group">
      <!-- Left Bun -->
      <circle cx="106" cy="62" r="22" fill="#3D261C" stroke="#000000" stroke-width="4.5" />
      <rect x="98" y="52" width="10" height="4" rx="2" fill="#FFFFFF" opacity="0.8" transform="rotate(-20 98 52)" />

      <!-- Right Bun -->
      <circle cx="214" cy="62" r="22" fill="#3D261C" stroke="#000000" stroke-width="4.5" />
      <rect x="212" y="52" width="10" height="4" rx="2" fill="#FFFFFF" opacity="0.8" transform="rotate(20 212 52)" />

      <!-- Main Hair Back -->
      <path
        d="M 160 36 C 130 36, 110 50, 106 72 C 104 90, 112 110, 118 126 C 130 136, 144 140, 160 140 C 176 140, 190 136, 202 126 C 208 110, 216 90, 214 72 C 210 50, 190 36, 160 36 Z"
        fill="#3D261C"
        stroke="#000000"
        stroke-width="4.5"
        stroke-linejoin="round"
      />

      <!-- Blank Faceless Head -->
      <path
        d="M 124 90 C 124 72, 140 64, 160 64 C 180 64, 196 72, 196 90 C 196 118, 186 144, 160 144 C 134 144, 124 118, 124 90 Z"
        fill="#8C5338"
        stroke="#000000"
        stroke-width="4"
      />

      <!-- Curved Smile Line -->
      <path
        d="M 152 114 Q 160 121 168 114"
        stroke="#000000"
        stroke-width="3.5"
        stroke-linecap="round"
        fill="none"
      />

      <!-- Gold Hoop Earrings -->
      <circle cx="120" cy="106" r="6" stroke="#F59E0B" stroke-width="2.5" fill="none" />
      <circle cx="200" cy="106" r="6" stroke="#F59E0B" stroke-width="2.5" fill="none" />
    </g>
  </g>
</svg>
