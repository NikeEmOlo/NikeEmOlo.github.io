    function updateMissionControlHeadingDate() {
      const dateSub = document.getElementById("mcHomeDateSub");
      if (!dateSub) return;
      const now = new Date();
      const dayName = now.toLocaleDateString("en-GB", { weekday: "long" });
      const dayNum = now.getDate();
      const monthName = now.toLocaleDateString("en-GB", { month: "long" });
      dateSub.textContent = `${dayName} ${dayNum} ${monthName}: here is what your agents and workflows are doing.`;
    }

    function switchMcView(view: "home" | "jobs") {
      playClickSound();
      const mcHomeView = document.getElementById("mcHomeView");
      const mcJobsView = document.getElementById("mcJobsView");
      const mcNavHomeBtn = document.getElementById("mcNavHomeBtn");
      const mcNavJobsBtn = document.getElementById("mcNavJobsBtn");
      const mcHeaderTag = document.getElementById("mcHeaderTag");

      if (view === "home") {
        updateMissionControlHeadingDate();
        if (mcHomeView) mcHomeView.classList.remove("is-hidden");
        if (mcJobsView) mcJobsView.classList.add("is-hidden");
        if (mcNavHomeBtn) mcNavHomeBtn.classList.add("is-active");
        if (mcNavJobsBtn) mcNavJobsBtn.classList.remove("is-active");
        if (mcHeaderTag) mcHeaderTag.textContent = "Executive Overview";
      } else {
        if (mcHomeView) mcHomeView.classList.add("is-hidden");
        if (mcJobsView) mcJobsView.classList.remove("is-hidden");
        if (mcNavJobsBtn) mcNavJobsBtn.classList.add("is-active");
        if (mcNavHomeBtn) mcNavHomeBtn.classList.remove("is-active");
        if (mcHeaderTag) mcHeaderTag.textContent = "Interactive Triage Dashboard";
      }
    }

    function openMissionControl() {
      ensureFullscreenOnInteraction();
      playPopSound();
      bringToFront(mcDashboard);
      const storyHeader = document.getElementById("storyHeader") || document.querySelector(".story-header");
      if (storyHeader) {
        (storyHeader as HTMLElement).style.display = "none";
        storyHeader.classList.add("is-hidden-mc");
      }
      const headerBack = document.getElementById("headerBackBtn");
      if (headerBack) {
        headerBack.style.display = "none";
        headerBack.classList.add("is-hidden-mc");
      }
      if (mcDashboard) {
        mcDashboard.classList.add("is-open");
        switchMcView("jobs");
        renderMissionJobs();
        updateMissionControlHeadingDate();
      }
    }

    function closeMissionControl() {
      playClickSound();
      const storyHeader = document.getElementById("storyHeader") || document.querySelector(".story-header");
      if (storyHeader) {
        (storyHeader as HTMLElement).style.display = "";
        storyHeader.classList.remove("is-hidden-mc");
      }
      const headerBack = document.getElementById("headerBackBtn");
      if (headerBack) {
        headerBack.style.display = "";
        headerBack.classList.remove("is-hidden-mc");
      }
      if (mcDashboard) mcDashboard.classList.remove("is-open");
      if (missionJobModal) missionJobModal.classList.remove("is-open");
      if (missionTailoredCvModal) missionTailoredCvModal.classList.remove("is-open");
    }

    function openMissionJobModal(jobId: string) {
      const job = missionJobsData.find(j => j.id === jobId);
      if (!job || !missionJobModal) return;
      currentSelectedJobId = jobId;
      playPopSound();
      bringToFront(missionJobModal);

      if (mjDetailTitle) mjDetailTitle.textContent = job.title;
      if (mjDetailSubtitle) mjDetailSubtitle.textContent = `${job.company} · ${job.location}`;
      if (mjDetailScore) mjDetailScore.textContent = `${job.score}%`;
      if (mjDetailPriority) {
        mjDetailPriority.textContent = job.priority;
        mjDetailPriority.className = `mj-badge pink`;
      }
      if (mjDetailStatus) {
        const s = job.decision === 'approved' ? 'Review' : job.decision === 'pending' ? 'Pending' : job.decision === 'rejected' ? 'Rejected' : job.status;
        mjDetailStatus.textContent = s;
        mjDetailStatus.className = `mj-badge ${job.decision === 'approved' ? 'green' : job.decision === 'pending' ? 'gold' : job.decision === 'rejected' ? 'red' : 'cyan'}`;
      }
      if (mjDetailPosted) mjDetailPosted.textContent = job.posted;
      if (mjDetailSalary) mjDetailSalary.textContent = `💰 ${job.salary || 'Competitive'}`;

      const mjDetailVibeScore = document.getElementById("mjDetailVibeScore");
      const mjDetailVibeText = document.getElementById("mjDetailVibeText");
      if (mjDetailVibeScore) mjDetailVibeScore.textContent = `Vibe check · ${job.vibeScore || '8/10'}`;
      if (mjDetailVibeText) {
        mjDetailVibeText.textContent = `The "vibe check" saves me around an hour of manual due-diligence per role, that I would otherwise need to do before I could even think of applying. The job description is fed directly to Cordy (the CV agent). It is used, along with all the other scraped data, to research the company including projects, news stories, values, and culture giving a "vibe score" against a pre-set criteria I provided.`;
      }

      const mjDetailDesc = document.getElementById("mjDetailDesc");
      if (mjDetailDesc) {
        mjDetailDesc.textContent = "Here I can see the job description from within the dashboard.";
      }

      if (mjApproveBtn) {
        mjApproveBtn.textContent = job.decision === 'approved' ? '✓ Approved' : '✓ Approve Role';
      }
      if (mjRejectBtn) {
        mjRejectBtn.textContent = job.decision === 'rejected' ? '✕ Rejected' : '✕ Reject';
      }

      missionJobModal.classList.add("is-open");
    }

    function closeMissionJobModal() {
      playClickSound();
      if (missionJobModal) missionJobModal.classList.remove("is-open");
    }

    // Web Audio Synthesizer for UI Clicks & Notifications
    // The interactive desktop is display:none below 860px, but its timers,
    // toasts and terminal stream still tick. Never make noise where the UI
    // that justifies it cannot be seen or reached.
    function isDesktopSimAudible() {
      return window.matchMedia("(min-width: 861px)").matches;
    }

    function playClickSound() {
      if (!isDesktopSimAudible()) return;
      try {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(600, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(200, ctx.currentTime + 0.04);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.04);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.05);
      } catch (e) {}
    }

    function playPopSound() {
      if (!isDesktopSimAudible()) return;
      try {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(320, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(780, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.09);
      } catch (e) {}
    }

    function playChime() {
      if (!isDesktopSimAudible()) return;
      try {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(587.33, ctx.currentTime);
        osc.frequency.setValueAtTime(880, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.36);
      } catch (e) {}
    }

    function playKeyTick() {
      if (!isDesktopSimAudible()) return;
      try {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(1200 + Math.random() * 400, ctx.currentTime);
        gain.gain.setValueAtTime(0.06, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.03);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.04);
      } catch (e) {}
    }

    function playSlackSound() {
      if (!isDesktopSimAudible()) return;
      try {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc1 = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const gain = ctx.createGain();

        osc1.type = "sine";
        osc1.frequency.setValueAtTime(520, ctx.currentTime);
        osc2.type = "sine";
        osc2.frequency.setValueAtTime(780, ctx.currentTime + 0.08);

        gain.gain.setValueAtTime(0.16, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);

        osc1.connect(gain);
        osc2.connect(gain);
        gain.connect(ctx.destination);

        osc1.start();
        osc1.stop(ctx.currentTime + 0.09);
        osc2.start(ctx.currentTime + 0.08);
        osc2.stop(ctx.currentTime + 0.35);
      } catch (e) {}
    }

    // Terminal Script Execution Stream (Realistic, Non-Technical, Zero Duplication)
