      termBody.innerHTML = `
        <div class="log-line" style="color: #94a3b8;"><span style="color: #22c55e; font-weight: 700;">nike@workstation</span>:<span style="color: #38bdf8;">~/job_hunter</span>$ <span style="color: #f1f5f9;">python -m workflow.morning_daemon</span></div>
      `;

      const lineDelay = 1900; // Relaxed reading pace ~1.9s per line so visitors can comfortably read

      logScript.forEach((item, index) => {
        const timer = setTimeout(() => {
          try {
            // Remove previous active cursor line if present
            const oldCursor = termBody.querySelector(".log-cursor-line");
            if (oldCursor) oldCursor.remove();

            const lineEl = document.createElement("div");
            lineEl.className = "log-line";
            lineEl.style.color = item.color;
            lineEl.textContent = `${item.time} ${item.tag} > ${item.text}`;
            termBody.appendChild(lineEl);

            // Add active cursor after line
            const cursorEl = document.createElement("div");
            cursorEl.className = "log-line log-cursor-line";
            if (index === logScript.length - 1) {
              cursorEl.innerHTML = `<span style="color: #22c55e; font-weight: 700;">nike@workstation</span>:<span style="color: #38bdf8;">~/job_hunter</span>$ <span class="log-cursor">█</span>`;
            } else {
              cursorEl.innerHTML = `<span class="log-cursor">█</span>`;
            }
            termBody.appendChild(cursorEl);

            termBody.scrollTop = termBody.scrollHeight;
            playKeyTick();
          } catch (e) {}

          // When the final log arrives, trigger prominent Slack alert from Giles!
          if (index === logScript.length - 1) {
            const slackTimer = setTimeout(() => {
              playSlackSound();
              hasSlackTriggered = true;
              if (slackNotification) {
                slackNotification.classList.add("is-visible");
                bringSlackNotificationToFront();
              }
              if (taskbarSlackBtn) {
                taskbarSlackBtn.classList.add("is-visible");
                taskbarSlackBtn.classList.add("is-active-app");
              }
              isTerminalRunning = false;
              isAutoPlaying = false;
              if (startWorkflowBtn) {
                startWorkflowBtn.classList.remove("is-running");
                startWorkflowBtn.innerHTML = `<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg><span>Replay</span>`;
              }
            }, 1000);
            logTimers.push(slackTimer);
          }
        }, 300 + index * lineDelay);

        logTimers.push(timer);
      });
    }

    const startWorkflowBtn = document.getElementById("startWorkflowBtn");

    // Apply morph state (0 = floating mockup, 1 = full viewport bleed)
    function applyMorph(morph: number) {
      currentMorph = morph;
      zoomContainer.style.setProperty("--morph", morph.toFixed(4));
      if (headerOverlay) headerOverlay.style.setProperty("--morph", morph.toFixed(4));

      if (scrubSlider) scrubSlider.value = String(Math.round(morph * 100));
      if (pctLabel) pctLabel.textContent = `${Math.round(morph * 100)}%`;

      const winW = window.innerWidth;
      const winH = window.innerHeight;
      const maxRestH = Math.max(winH - 200, 320);
      const maxRestWFromH = maxRestH * (16 / 9);
      const baseW = Math.min(winW * 0.74, 1040, maxRestWFromH);
      const baseH = (baseW * (9 / 16)) + 48 + 42; // wallpaper + taskbar + padding

      if (morph >= 0.999) {
        zoomContainer.style.height = "100vh";
        zoomContainer.style.width = "100vw";
        zoomContainer.style.maxWidth = "100vw";
        if (screenMockup) screenMockup.style.height = "100vh";
        if (screenCanvas) screenCanvas.style.height = "100vh";
        if (wallpaperStage) {
          wallpaperStage.style.height = "calc(100vh - 48px)";
          wallpaperStage.style.aspectRatio = "unset";
        }
      } else if (morph > 0.001) {
        const currentH = baseH + (winH - baseH) * morph;
        const currentWallH = (baseH - 48 - (42 * (1 - morph))) + ((winH - 48) - (baseH - 48 - 42)) * morph;
        zoomContainer.style.height = `${currentH.toFixed(1)}px`;
        zoomContainer.style.width = `calc(${baseW.toFixed(1)}px + (100vw - ${baseW.toFixed(1)}px) * ${morph.toFixed(4)})`;
        zoomContainer.style.maxWidth = `calc(1040px + (100vw - 1040px) * ${morph.toFixed(4)})`;
        if (screenMockup) screenMockup.style.height = `${currentH.toFixed(1)}px`;
        if (screenCanvas) screenCanvas.style.height = `${currentH.toFixed(1)}px`;
        if (wallpaperStage) {
          wallpaperStage.style.height = `${currentWallH.toFixed(1)}px`;
          wallpaperStage.style.aspectRatio = "unset";
        }
      } else {
        zoomContainer.style.height = "auto";
        zoomContainer.style.width = "min(74vw, 1040px, calc((100vh - 200px) * (16 / 9)))";
        zoomContainer.style.maxWidth = "1040px";
        if (screenMockup) screenMockup.style.height = "auto";
        if (screenCanvas) screenCanvas.style.height = "auto";
        if (wallpaperStage) {
          wallpaperStage.style.height = "auto";
          wallpaperStage.style.aspectRatio = "16 / 9";
        }
      }

      if (morph > 0.08) {
        if (headerOverlay) headerOverlay.classList.add("is-faded");
      } else {
        if (headerOverlay) headerOverlay.classList.remove("is-faded");
      }
    }

