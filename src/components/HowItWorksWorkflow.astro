---
// HowItWorksWorkflow.astro - Interactive Windows Desktop Mockup & Scrollytelling Workflow
import { getEntry } from "astro:content";

interface Props {
  showTestToolbar?: boolean;
}

const { showTestToolbar = false } = Astro.props;

const cvEntry = await getEntry("cv", "master_cv");
const cv = cvEntry?.data;
---

<section class="how-it-works-section" id="how-it-works">
  <!-- Sticky Scrollytelling Runway -->
  <div class="how-runway" id="how-runway">
    <div class="how-sticky-viewport" id="how-sticky-viewport">
      
      <!-- Section Header -->
      <div class="how-header-overlay" data-how-header>
        <span class="how-eyebrow">03 // WORKFLOW EXECUTION</span>
        <h2 class="how-main-title">How it works</h2>
        <p class="how-subtitle"><span class="how-subtitle-pill">This desktop is interactive</span> Click the files and icons to find out more about what was built, or hit Preview to watch a live run.</p>
      </div>




      <!-- OPTIONAL STAGE CURTAIN LAYER: sits above the header but below the -->
      <!-- desktop mockup, so a caller can wipe the stage while leaving the  -->
      <!-- device poking out in front. Renders nothing when unused.          -->
      <slot name="stage-curtain" />

      <!-- INTERACTIVE ANIMATION TEST CONTROLS (ONLY RENDERED IN SANDBOX) -->
      {showTestToolbar && (
        <div class="anim-test-toolbar" id="animTestToolbar">
          <button class="test-btn play" id="playAnimBtn" title="Play simulation">▶ Play Animation</button>
          <button class="test-btn reset" id="resetAnimBtn" title="Reset">↺</button>
          <div class="test-slider-row">
            <span class="test-label">Scrub:</span>
            <input type="range" min="0" max="100" value="0" id="animScrubSlider" class="test-slider" />
            <span class="test-pct" id="animPctLabel">0%</span>
          </div>
        </div>
      )}

      <!-- THE DESKTOP STAGE (SCALES UP SMOOTHLY TO FILL SCREEN ON DESKTOP) -->
      <div class="desktop-zoom-container" data-desktop-zoom id="desktopZoomContainer">
        
        <!-- DEVICE / SCREEN MOCKUP BEZEL (DESKTOP) -->
        <div class="device-screen-mockup" data-screen-mockup>
          
          <!-- Top Bezel Web Camera -->
          <div class="mockup-top-bezel">
            <div class="camera-lens">
              <div class="lens-dot"></div>
            </div>
          </div>

          <!-- DESKTOP SCREEN CANVAS (CONTAINER HOUSING WALLPAPER + TASKBAR + MODALS) -->
          <div class="mockup-screen-canvas" id="desktopCanvas">
            
            <!-- 1. FULL UNCLIPPED WALLPAPER VIEWPORT -->
            <div class="desktop-wallpaper-stage">
              
              <!-- Interactive Desktop Hint Beacon (Square Sticker Badge) -->
              <div class="os-interactive-hint-badge" id="osHintBadge" title="Click to expand workspace to full-screen">
                <div class="hint-badge-header">
                  <span class="hint-beacon-dot"></span>
                  <span class="hint-badge-tag">WORKSPACE TIP</span>
                </div>
                <span class="hint-badge-text">💡 Click files, folders & taskbar apps to explore</span>
              </div>

              <!-- Desktop Document Icons (Clickable) -->
              <div class="os-desktop-icons">

                <!-- Desktop File 1: master_cv -->
                <div class="os-icon-item" data-file-key="master_cv" role="button" tabindex="0" aria-label="Click to open the ground-truth CV">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 18 2 L 25 9 L 25 32 L 3 32 Z" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
                      <path d="M 18 2 L 18 9 L 25 9 Z" fill="#E4E4E7" stroke="#000000" stroke-width="1.5" />
                      <line x1="6" y1="14" x2="22" y2="14" stroke="#71717A" stroke-width="2" stroke-linecap="round" />
                      <line x1="6" y1="19" x2="19" y2="19" stroke="#71717A" stroke-width="2" stroke-linecap="round" />
                      <line x1="6" y1="24" x2="16" y2="24" stroke="#71717A" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </div>
                  <span class="os-icon-label">master_cv</span>
                  <span class="os-icon-tip" aria-hidden="true">Click to open the ground-truth CV</span>
                </div>

                <!-- Desktop File 2: job_scraper.py -->
                <div class="os-icon-item" data-file-key="job_scraper" role="button" tabindex="0" aria-label="Click to see how jobs get scraped">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 25 2 L 25 32 L 3 32 Z" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
                      <g transform="translate(4, 7) scale(0.83)">
                        <path fill="#38BDF8" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M11.922 1.25c-5.32 0-4.99 2.308-4.99 2.308l.006 2.392h5.056v.72H4.93s-3.43-.39-3.43 4.965c0 5.356 2.99 5.16 2.99 5.16h1.783v-2.52s-.096-2.99 2.94-2.99h5.035s2.846.046 2.846-2.766V4.053s.425-2.803-5.172-2.803zm-2.87 1.58a.93.93 0 1 1 0 1.86.93.93 0 0 1 0-1.86z"/>
                        <path fill="#FFD43B" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M12.078 22.75c5.32 0 4.99-2.308 4.99-2.308l-.006-2.392h-5.056v-.72h7.064s3.43.39 3.43-4.965c0-5.356-2.99-5.16-2.99-5.16h-1.783v2.52s.096 2.99-2.94 2.99H9.762s-2.846-.046-2.846 2.766v4.469s-.425 2.803 5.162 2.803zm2.87-1.58a.93.93 0 1 1 0-1.86.93.93 0 0 1 0 1.86z"/>
                      </g>
                    </svg>
                  </div>
                  <span class="os-icon-label">job_scraper.py</span>
                  <span class="os-icon-tip" aria-hidden="true">Click to see how jobs get scraped</span>
                </div>

                <!-- Desktop File 3: scoring_metric.py -->
                <div class="os-icon-item" data-file-key="scoring_metric" role="button" tabindex="0" aria-label="Click to see how jobs get scored">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 25 2 L 25 32 L 3 32 Z" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
                      <g transform="translate(4, 7) scale(0.83)">
                        <path fill="#38BDF8" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M11.922 1.25c-5.32 0-4.99 2.308-4.99 2.308l.006 2.392h5.056v.72H4.93s-3.43-.39-3.43 4.965c0 5.356 2.99 5.16 2.99 5.16h1.783v-2.52s-.096-2.99 2.94-2.99h5.035s2.846.046 2.846-2.766V4.053s.425-2.803-5.172-2.803zm-2.87 1.58a.93.93 0 1 1 0 1.86.93.93 0 0 1 0-1.86z"/>
                        <path fill="#FFD43B" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M12.078 22.75c5.32 0 4.99-2.308 4.99-2.308l-.006-2.392h-5.056v-.72h7.064s3.43.39 3.43-4.965c0-5.356-2.99-5.16-2.99-5.16h-1.783v2.52s.096 2.99-2.94 2.99H9.762s-2.846-.046-2.846 2.766v4.469s-.425 2.803 5.162 2.803zm2.87-1.58a.93.93 0 1 1 0-1.86.93.93 0 0 1 0 1.86z"/>
                      </g>
                    </svg>
                  </div>
                  <span class="os-icon-label">scoring_metric.py</span>
                  <span class="os-icon-tip" aria-hidden="true">Click to see how jobs get scored</span>
                </div>

                <!-- Desktop File 4: mission_control.html -->
                <div class="os-icon-item" data-file-key="mission_control_html" role="button" tabindex="0" aria-label="Click to launch the live dashboard">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 25 2 L 25 32 L 3 32 Z" fill="#1E293B" stroke="#000000" stroke-width="2" />
                      <rect x="7" y="8" width="14" height="10" rx="1.5" fill="#0D9488" stroke="#000000" stroke-width="1.5" />
                      <circle cx="11" cy="24" r="2" fill="#2DD4BF" />
                      <circle cx="17" cy="24" r="2" fill="#2DD4BF" />
                    </svg>
                  </div>
                  <span class="os-icon-label">mission_control.html</span>
                  <span class="os-icon-tip" aria-hidden="true">Click to launch the live dashboard</span>
                </div>

                <!-- Desktop Shortcut: Files Explorer -->
                <div class="os-icon-item" id="desktopFolderBtn" role="button" tabindex="0" aria-label="Click to browse the workspace files">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 2 8 L 10 8 L 13 11 L 26 11 L 26 28 L 2 28 Z" fill="#F59E0B" stroke="#000000" stroke-width="2" />
                      <path d="M 2 13 L 26 13 L 26 28 L 2 28 Z" fill="#FBBF24" stroke="#000000" stroke-width="1.8" />
                    </svg>
                  </div>
                  <span class="os-icon-label">Files</span>
                  <span class="os-icon-tip" aria-hidden="true">Click to browse the workspace files</span>
                </div>

              </div>

              <!-- CENTER EXECUTION HUB: WINDOWS TERMINAL CONSOLE -->
              <div class="runtime-chamber" data-runtime-chamber>
                <div class="hacker-terminal-console" data-terminal-console id="terminalConsole">
                  <div class="windows-terminal-titlebar">
                    <div class="win-term-left">
                      <svg viewBox="0 0 16 16" width="13" height="13" fill="none">
                        <rect x="1" y="2" width="14" height="12" rx="2" fill="#000000" stroke="#22C55E" stroke-width="1.5" />
                        <path d="M 4 6 L 7 8 L 4 10" stroke="#22C55E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <line x1="8" y1="10" x2="11" y2="10" stroke="#22C55E" stroke-width="1.5" stroke-linecap="round" />
                      </svg>
                      <span class="win-term-title">Terminal</span>
                    </div>
                    <div class="win-term-controls">
                      <button class="win-term-btn" id="minimizeTermBtn" title="Minimize">─</button>
                      <button class="win-term-btn" title="Maximize">□</button>
                      <button class="win-term-btn close" id="closeTermBtn" title="Close">✕</button>
                    </div>
                  </div>
                  
                  <div class="terminal-body" id="terminalOutput">
                    <div class="terminal-line dim">OpenClaw Autonomous Runtime v2.6.4 (node-esm64)</div>
                    <div class="terminal-line dim">Workspace mounted: workspace\job_hunter</div>
                    <div class="terminal-line dim">Loading multi-agent configuration... [OK]</div>
                    <div class="terminal-line system-ready">System ready. Awaiting scheduled triggers or manual execution.</div>
                  </div>
                </div>
              </div>

              <!-- ============================================================ -->
              <!-- WINDOWS 11 SIMULATION MODALS (POPUPS) -->
              <!-- ============================================================ -->

              <!-- MODAL 1: FILE EXPLORER (LARGE TILE VIEW) -->
              <div class="os-window-modal os-explorer-window" id="osExplorerModal">
                <div class="os-modal-titlebar">
                  <div class="modal-title-left">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                      <path d="M 1 4 L 6 4 L 8 6 L 15 6 L 15 13 L 1 13 Z" fill="#F59E0B" stroke="#000000" stroke-width="1.5" />
                    </svg>
                    <span class="modal-title-text">File Explorer - Workspace</span>
                  </div>
                  <div class="modal-title-controls">
                    <button class="win-ctrl-btn close" id="closeExplorerBtn">✕</button>
                  </div>
                </div>

                <div class="os-explorer-address-bar">
                  <span class="address-tag">Location:</span>
                  <span class="address-path" id="explorerCurrentPath">workspace\agents</span>
                </div>

                <div class="os-explorer-body">
                  <!-- Quick Access Sidebar -->
                  <div class="explorer-sidebar">
                    <button class="explorer-nav-btn active" data-folder="agents" title="Agents">
                      <span class="nav-icon">🤖</span>
                      <span class="nav-label">Agents</span>
                      <span class="nav-count">3</span>
                    </button>
                    <button class="explorer-nav-btn" data-folder="tailored_cvs" title="CVs">
                      <span class="nav-icon">📄</span>
                      <span class="nav-label">CVs</span>
                      <span class="nav-count">2</span>
                    </button>
                    <button class="explorer-nav-btn" data-folder="scripts" title="Scripts">
                      <span class="nav-icon">⚡</span>
                      <span class="nav-label">Scripts</span>
                      <span class="nav-count">3</span>
                    </button>
                    <button class="explorer-nav-btn" data-folder="mission_control" title="Mission Control">
                      <span class="nav-icon">🎯</span>
                      <span class="nav-label">Mission Control</span>
                      <span class="nav-count">3</span>
                    </button>
                  </div>

                  <!-- Large Tile View Content Grid -->
                  <div class="explorer-files-viewport">
                    <div class="explorer-folder-header">
                      <span class="folder-header-title" id="explorerFolderHeaderTitle">Agents</span>
                      <span class="folder-header-count" id="explorerFolderHeaderCount">3 items</span>
                    </div>
                    <div class="explorer-tile-grid" id="explorerTileGrid">
                      <!-- Rendered dynamically -->
                    </div>
                  </div>
                </div>
              </div>

              <!-- MODAL: RETRO INTERNET BROWSER WINDOW -->
              <div class="os-window-modal os-browser-window" id="osBrowserModal">
                
                <!-- 1. Window Titlebar -->
                <div class="os-modal-titlebar browser-titlebar">
                  <div class="modal-title-left">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                      <circle cx="8" cy="8" r="7" fill="#0284C7" stroke="#000000" stroke-width="1.5" />
                      <ellipse cx="8" cy="8" rx="3" ry="6.5" stroke="#000000" stroke-width="1.2" fill="none" />
                      <line x1="1" y1="8" x2="15" y2="8" stroke="#000000" stroke-width="1.2" />
                      <rect x="4" y="3" width="3" height="1.5" rx="0.5" fill="#FFFFFF" opacity="0.8" />
                    </svg>
                    <span class="modal-title-text" id="browserTitlebarText">Oggle! World Wide Web</span>
                  </div>
                  <div class="modal-title-controls">
                    <button class="win-ctrl-btn minimize" id="minBrowserModalBtn" title="Minimize">_</button>
                    <button class="win-ctrl-btn maximize" id="maxBrowserModalBtn" title="Maximize">□</button>
                    <button class="win-ctrl-btn close" id="closeBrowserModalBtn" title="Close">✕</button>
                  </div>
                </div>

                <!-- 2. Browser Navigation & Address Toolbar -->
                <div class="browser-toolbar">
                  <div class="browser-nav-buttons">
                    <button class="browser-btn is-disabled" id="browserBackBtn" title="Back to Search Results" disabled>
                      <span class="browser-btn-icon">&#8592;</span>
                      <span class="browser-btn-label">Back</span>
                    </button>
                    <button class="browser-btn is-disabled" id="browserForwardBtn" title="Forward" disabled>
                      <span class="browser-btn-icon">&#8594;</span>
                    </button>
                    <button class="browser-btn" id="browserReloadBtn" title="Reload Page">
                      <span class="browser-btn-icon">&#8635;</span>
                    </button>
                    <button class="browser-btn" id="browserHomeBtn" title="Home (Search)">
                      <span class="browser-btn-icon">&#8962;</span>
                    </button>
                  </div>

                  <div class="browser-address-container">
                    <div class="browser-security-badge" title="Connection is simulated retro HTTP">
                      <span class="browser-lock-icon">🔒</span>
                      <span class="browser-protocol">http://</span>
                    </div>
                    <input
                      type="text"
                      class="browser-address-input"
                      id="browserAddressInput"
                      value="www.oggle.com/search?q=how+does+job-hunt+automation+work"
                      readonly
                      aria-label="Web Address"
                    />
                    <button class="browser-go-btn" id="browserGoBtn" type="button" title="Go">Go &#9656;</button>
                  </div>
                </div>

                <!-- 3. Browser Viewport Area (Holds Search View or Blog Post View) -->
                <div class="browser-viewport" id="browserViewport">
                  
                  <!-- VIEW A: RETRO SEARCH ENGINE RESULTS PAGE -->
                  <div class="browser-search-view" id="browserSearchView">
                    
                    <!-- Search Engine Masthead -->
                    <div class="search-engine-masthead">
                      <div class="retro-search-logo" aria-label="Oggle!">
                        <span class="logo-char logo-o1">O</span>
                        <span class="logo-char logo-g1">g</span>
                        <span class="logo-char logo-g2">g</span>
                        <span class="logo-char logo-l">l</span>
                        <span class="logo-char logo-e">e</span>
                        <span class="logo-char logo-excl">!</span>
                        <span class="logo-badge">SEARCH</span>
                      </div>

                      <div class="search-input-wrapper">
                        <div class="search-input-box">
                          <span class="search-glass-glyph" aria-hidden="true">&#128269;</span>
                          <input
                            type="text"
                            class="search-query-field"
                            id="searchQueryField"
                            value="how does job-hunt automation work?"
                            readonly
                          />
                          <button class="search-clear-btn" type="button" title="Search">&#9656;</button>
                        </div>
                        <div class="search-actions-row">
                          <button class="retro-search-btn is-primary" type="button">Oggle Search</button>
                          <button class="retro-search-btn" type="button" id="oggleImageSearchBtn">Image search</button>
                        </div>
                      </div>

                      <div class="search-stats-bar">
                        <span>About 8 results (0.04 seconds)</span>
                        <span class="stats-divider">&middot;</span>
                        <span>Categorised in: <strong>Autonomous Systems &amp; Career Automation</strong></span>
                      </div>
                    </div>

                    <!-- Search Results Feed -->
                    <div class="search-results-list">
                      
                      <!-- RESULT 1: PRIMARY EXPLAINER (From README) -->
                      <article class="search-result-item primary-result">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; engineering &rsaquo; job-hunt-automation</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="job-hunt-automation">
                            In simple terms, how does job-hunt automation work?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          I wanted to reduce the time I spent looking for and applying for jobs, so I automated the majority of that process using AI agents. Here is the full breakdown of how scraping, scoring metrics, company vibe checks, and tailored CVs work with a human in the loop...
                        </p>
                        <div class="result-meta-tags">
                          <span class="result-tag featured">⭐ FEATURED GUIDE</span>
                          <span class="result-tag">READ TIME: 3 MIN</span>
                          <span class="result-tag">7 PIPELINE STEPS</span>
                        </div>
                      </article>

                      <!-- FAQ DIVIDER -->
                      <div class="search-faq-divider">
                        <span class="faq-divider-line"></span>
                        <span class="faq-divider-text">PEOPLE ALSO ASK: FREQUENTLY ASKED QUESTIONS</span>
                        <span class="faq-divider-line"></span>
                      </div>

                      <!-- RESULT 2: FAQ 1 -->
                      <article class="search-result-item">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; faq &rsaquo; what-is-an-ai-agent</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="what-is-an-ai-agent">
                            What is an AI agent?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          Most people are familiar with AI through chatbots like ChatGPT. An agent goes much further: combining a Large Language Model Brain, structured Rulebooks, and connected Tools to execute multi-step digital goals autonomously without manual copy-pasting...
                        </p>
                      </article>

                      <!-- RESULT 3: FAQ 2 -->
                      <article class="search-result-item">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; faq &rsaquo; why-not-fully-automated</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="why-not-fully-automated">
                            Why isn't the whole process automated?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          The agents could submit applications automatically, but is that really the right call? Recognizing AI's strengths (coding, speed) versus weaknesses (creativity, tone, hallucinations) and why keeping a human in the loop preserves application quality...
                        </p>
                      </article>

                      <!-- RESULT 4: FAQ 3 -->
                      <article class="search-result-item">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; faq &rsaquo; benefit-of-three-agents</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="benefit-of-three-agents">
                            What is the benefit of three agents?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          Each agent has dedicated agent files: GILES.md, CORDELIA.md, and WILLOW.md. Specializing agents across different models (Opus, Sonnet) saves operational costs while improving accuracy for specific tasks...
                        </p>
                      </article>

                      <!-- RESULT 5: FAQ 4 -->
                      <article class="search-result-item">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; faq &rsaquo; managing-costs</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="managing-costs">
                            How did I manage costs?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          Five key architectural rules: converting prompts to deterministic code, using open-source OpenClaw, managing context windows, model tiering, and filtering out 96% of listings in Python before calling any LLM...
                        </p>
                      </article>

                      <!-- RESULT 6: FAQ 5 -->
                      <article class="search-result-item">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; faq &rsaquo; communicating-with-agents</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="communicating-with-agents">
                            How do I communicate with the agents?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          Through Slack or Telegram to monitor runs, request bug fixes, or steer new features from mobile. Secure tunneling gives remote access to the Mission Control dashboard from any browser...
                        </p>
                      </article>

                      <!-- RESULT 7: FAQ 6 -->
                      <article class="search-result-item">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; faq &rsaquo; keeping-it-secure</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="keeping-it-secure">
                            How is it kept secure?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          Agents run inside an isolated virtual computer, with scraped listings quarantined as passive data to prevent prompt injection into Cordy. Grounding stays anchored to master_cv.md...
                        </p>
                      </article>

                      <!-- RESULT 8: FAQ 7 -->
                      <article class="search-result-item">
                        <div class="result-breadcrumb">
                          <span class="result-domain">answer.me/blog</span>
                          <span class="result-path">&rsaquo; faq &rsaquo; improving-the-workflow</span>
                        </div>
                        <h3 class="result-title">
                          <button class="search-result-link" type="button" data-blog-slug="improving-the-workflow">
                            How can I improve this workflow?
                          </button>
                        </h3>
                        <p class="result-snippet">
                          Future improvements: API connections for automated inbound application status emails, auto-forwarding to Slack, and full application response tracking in Mission Control...
                        </p>
