  /* ---------------------------------------------------- */
  /* WINDOWS MODALS (FILE EXPLORER, FILE INFO, EMAIL)     */
  /* ---------------------------------------------------- */
  .os-window-modal {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 86%;
    max-width: 580px;
    max-height: calc(100% - 24px);
    background: #ffffff;
    border: 3.5px solid #000000;
    border-radius: 10px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 6px 8px 0px #000000;
    display: none;
    flex-direction: column;
    overflow: hidden;
    z-index: 40;
    color: #000000;
    opacity: 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .os-window-modal.is-open {
    display: flex;
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .os-modal-titlebar {
    height: 32px;
    background: #e4e4e7;
    border-bottom: 2px solid #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    user-select: none;
    flex-shrink: 0;
  }

  .os-modal-titlebar.info-bar {
    background: #ffd233;
  }

  .os-modal-titlebar.mail-bar {
    background: #2563eb;
    color: #ffffff;
  }

  .taskbar-win-btn.is-interactive {
    cursor: pointer;
    border-radius: 6px;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .taskbar-win-btn.is-interactive:hover {
    transform: translateY(-2px) scale(1.06);
    background: rgba(255, 255, 255, 0.55);
  }

  .taskbar-win-btn.is-interactive:active {
    transform: translateY(1px) scale(0.98);
  }

  .taskbar-win-btn.is-interactive:focus-visible {
    outline: 2px solid #0078d4;
    outline-offset: 2px;
  }

  .os-window-modal.email-modal {
    width: min(540px, 92vw);
    max-width: 540px;
    z-index: 85;
  }

  .modal-title-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .modal-title-text {
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .win-ctrl-btn {
    width: 20px;
    height: 20px;
    background: #ffffff;
    border: 1.5px solid #000000;
    border-radius: 4px;
    font-family: monospace;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 1px 1.5px 0px #000000;
  }

  .win-ctrl-btn:hover {
    background: #ef4444;
    color: #ffffff;
  }

  /* File Explorer Modal Specifics */
  .os-window-modal.os-explorer-window {
    width: min(840px, 92vw);
    max-width: 840px;
  }

  .os-explorer-address-bar {
    height: 30px;
    background: #f4f4f5;
    border-bottom: 2px solid #000000;
    display: flex;
    align-items: center;
    padding: 0 14px;
    gap: 8px;
    font-family: monospace;
    font-size: 0.72rem;
  }

  .address-tag {
    font-weight: 900;
    color: #52525b;
  }

  .address-path {
    font-weight: 800;
    color: #09090b;
    background: #ffffff;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid #d4d4d8;
  }

  .os-explorer-body {
    display: flex;
    height: clamp(340px, 50vh, 440px);
    background: #ffffff;
  }

  .explorer-sidebar {
    width: 175px;
    background: #f8fafc;
    border-right: 2px solid #000000;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
  }

  .sidebar-section-title {
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 900;
    color: #64748b;
    letter-spacing: 0.08em;
    padding: 0 8px;
    margin-bottom: 4px;
  }

  .explorer-nav-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 7px 10px;
    border-radius: 6px;
    border: 1.5px solid transparent;
    background: transparent;
    cursor: pointer;
    font-family:
      var(--archivo-font),
      "Archivo",
      sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: #1e293b;
    text-align: left;
    transition: all 0.12s ease;
  }

  .explorer-nav-btn:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
    transform: translateX(2px);
  }

  .explorer-nav-btn.active {
    background: #ffd233;
    border-color: #000000;
    box-shadow: 1.5px 2px 0px #000000;
    color: #000000;
    font-weight: 800;
  }

  .nav-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .nav-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-count {
    margin-left: auto;
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 800;
    background: rgba(0, 0, 0, 0.08);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .explorer-files-viewport {
    flex: 1;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .explorer-folder-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: #faf7f2;
    border-bottom: 1.5px solid #e2e8f0;
  }

  .folder-header-title {
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 900;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .folder-header-count {
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: #64748b;
  }

  .explorer-tile-grid {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 20px 24px;
    padding: 24px 26px;
    overflow-y: auto;
  }

  :global(.explorer-file-tile) {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 6px !important;
    width: 92px !important;
    padding: 8px 4px !important;
    border-radius: 4px !important;
    border: 1px solid transparent !important;
    cursor: pointer !important;
    transition: background 0.12s ease, border-color 0.12s ease !important;
    user-select: none !important;
    text-align: center !important;
  }

  :global(.explorer-file-tile:hover) {
    background: #EBF3FB !important;
    border-color: #CCE8FF !important;
  }

  :global(.explorer-file-tile:active) {
    background: #CCE8FF !important;
  }

  :global(.explorer-file-glyph) {
    width: 44px !important;
    height: 52px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    filter: drop-shadow(0px 2px 4px rgba(0, 0, 0, 0.08)) !important;
  }

  :global(.explorer-file-glyph svg) {
    width: 100% !important;
    height: 100% !important;
  }

  :global(.explorer-file-label) {
    font-family: var(--archivo-font), "Archivo", "Segoe UI", sans-serif !important;
    font-size: 0.73rem !important;
    font-weight: 500 !important;
    color: #1E293B !important;
    text-align: center !important;
    background: transparent !important;
    border: none !important;
    padding: 1px 2px !important;
    border-radius: 2px !important;
    box-shadow: none !important;
    max-width: 88px !important;
    line-height: 1.25 !important;
    display: block !important;
  }

  :global(.file-stem) {
    word-break: normal !important;
    overflow-wrap: normal !important;
  }

  :global(.file-ext) {
    white-space: nowrap !important;
    display: inline !important;
  }

