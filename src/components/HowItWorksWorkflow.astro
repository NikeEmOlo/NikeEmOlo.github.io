---
// HowItWorksWorkflow.astro - Interactive Windows Desktop Mockup & Scrollytelling Workflow
interface Props {
  showTestToolbar?: boolean;
}

const { showTestToolbar = false } = Astro.props;
---

<section class="how-it-works-section" id="how-it-works">
  <!-- Sticky Scrollytelling Runway -->
  <div class="how-runway" id="how-runway">
    <div class="how-sticky-viewport" id="how-sticky-viewport">
      
      <!-- Section Header -->
      <div class="how-header-overlay" data-how-header>
        <span class="how-eyebrow">04 // WORKFLOW EXECUTION</span>
        <h2 class="how-main-title">How it works</h2>
        <p class="how-subtitle">From unattended morning trigger to tailored dispatch in seconds.</p>
      </div>


      <!-- INTERACTIVE ANIMATION TEST CONTROLS (ONLY RENDERED IN SANDBOX) -->
      {showTestToolbar && (
        <div class="anim-test-toolbar" id="animTestToolbar">
          <button class="test-btn play" id="playAnimBtn" title="Play simulation">▶ Play Animation</button>
          <button class="test-btn reset" id="resetAnimBtn" title="Reset">↺</button>
          <div class="test-slider-row">
            <span class="test-label">Scrub:</span>
            <input type="range" min="0" max="100" value="0" id="animScrubSlider" class="test-slider" />
            <span class="test-pct" id="animPctLabel">0%</span>
          </div>
        </div>
      )}

      <!-- THE DESKTOP STAGE (SCALES UP SMOOTHLY TO FILL SCREEN) -->
      <div class="desktop-zoom-container" data-desktop-zoom id="desktopZoomContainer">
        
        <!-- DEVICE / SCREEN MOCKUP BEZEL (THICK BLACK LINES) -->
        <div class="device-screen-mockup" data-screen-mockup>
          
          <!-- Top Bezel Web Camera -->
          <div class="mockup-top-bezel">
            <div class="camera-lens">
              <div class="lens-dot"></div>
            </div>
          </div>

          <!-- DESKTOP SCREEN CANVAS (CONTAINER HOUSING WALLPAPER + TASKBAR + MODALS) -->
          <div class="mockup-screen-canvas" id="desktopCanvas">
            
            <!-- 1. FULL UNCLIPPED WALLPAPER VIEWPORT -->
            <div class="desktop-wallpaper-stage">
              
              <!-- Interactive Desktop Hint Beacon (Square Sticker Badge) -->
              <div class="os-interactive-hint-badge" id="osHintBadge" title="Click to expand workspace to full-screen">
                <div class="hint-badge-header">
                  <span class="hint-beacon-dot"></span>
                  <span class="hint-badge-tag">WORKSPACE TIP</span>
                </div>
                <span class="hint-badge-text">💡 Click files, folders & taskbar apps to explore</span>
              </div>

              <!-- Desktop Document Icons (Clickable) -->
              <div class="os-desktop-icons">
                
                <!-- Desktop File 1: master_cv -->
                <div class="os-icon-item" data-file-key="master_cv" title="Open master_cv.md properties">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 18 2 L 25 9 L 25 32 L 3 32 Z" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
                      <path d="M 18 2 L 18 9 L 25 9 Z" fill="#E4E4E7" stroke="#000000" stroke-width="1.5" />
                      <line x1="6" y1="14" x2="22" y2="14" stroke="#71717A" stroke-width="2" stroke-linecap="round" />
                      <line x1="6" y1="19" x2="19" y2="19" stroke="#71717A" stroke-width="2" stroke-linecap="round" />
                      <line x1="6" y1="24" x2="16" y2="24" stroke="#71717A" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </div>
                  <span class="os-icon-label">master_cv</span>
                </div>

                <!-- Desktop File 2: job_scraper.py -->
                <div class="os-icon-item" data-file-key="job_scraper" title="Open job_scraper.py properties">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 25 2 L 25 32 L 3 32 Z" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
                      <g transform="translate(4, 7) scale(0.83)">
                        <path fill="#38BDF8" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M11.922 1.25c-5.32 0-4.99 2.308-4.99 2.308l.006 2.392h5.056v.72H4.93s-3.43-.39-3.43 4.965c0 5.356 2.99 5.16 2.99 5.16h1.783v-2.52s-.096-2.99 2.94-2.99h5.035s2.846.046 2.846-2.766V4.053s.425-2.803-5.172-2.803zm-2.87 1.58a.93.93 0 1 1 0 1.86.93.93 0 0 1 0-1.86z"/>
                        <path fill="#FFD43B" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M12.078 22.75c5.32 0 4.99-2.308 4.99-2.308l-.006-2.392h-5.056v-.72h7.064s3.43.39 3.43-4.965c0-5.356-2.99-5.16-2.99-5.16h-1.783v2.52s.096 2.99-2.94 2.99H9.762s-2.846-.046-2.846 2.766v4.469s-.425 2.803 5.162 2.803zm2.87-1.58a.93.93 0 1 1 0-1.86.93.93 0 0 1 0 1.86z"/>
                      </g>
                    </svg>
                  </div>
                  <span class="os-icon-label">job_scraper.py</span>
                </div>

                <!-- Desktop File 3: scoring_metric.py -->
                <div class="os-icon-item" data-file-key="scoring_metric" title="Open scoring_metric.py properties">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 25 2 L 25 32 L 3 32 Z" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
                      <g transform="translate(4, 7) scale(0.83)">
                        <path fill="#38BDF8" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M11.922 1.25c-5.32 0-4.99 2.308-4.99 2.308l.006 2.392h5.056v.72H4.93s-3.43-.39-3.43 4.965c0 5.356 2.99 5.16 2.99 5.16h1.783v-2.52s-.096-2.99 2.94-2.99h5.035s2.846.046 2.846-2.766V4.053s.425-2.803-5.172-2.803zm-2.87 1.58a.93.93 0 1 1 0 1.86.93.93 0 0 1 0-1.86z"/>
                        <path fill="#FFD43B" stroke="#000000" stroke-width="1.2" stroke-linejoin="round" d="M12.078 22.75c5.32 0 4.99-2.308 4.99-2.308l-.006-2.392h-5.056v-.72h7.064s3.43.39 3.43-4.965c0-5.356-2.99-5.16-2.99-5.16h-1.783v2.52s.096 2.99-2.94 2.99H9.762s-2.846-.046-2.846 2.766v4.469s-.425 2.803 5.162 2.803zm2.87-1.58a.93.93 0 1 1 0-1.86.93.93 0 0 1 0 1.86z"/>
                      </g>
                    </svg>
                  </div>
                  <span class="os-icon-label">scoring_metric.py</span>
                </div>

                <!-- Desktop File 4: mission_control.html -->
                <div class="os-icon-item" data-file-key="mission_control_html" title="Launch Mission Control Dashboard">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 3 2 L 25 2 L 25 32 L 3 32 Z" fill="#1E293B" stroke="#000000" stroke-width="2" />
                      <rect x="7" y="8" width="14" height="10" rx="1.5" fill="#0D9488" stroke="#000000" stroke-width="1.5" />
                      <circle cx="11" cy="24" r="2" fill="#2DD4BF" />
                      <circle cx="17" cy="24" r="2" fill="#2DD4BF" />
                    </svg>
                  </div>
                  <span class="os-icon-label">mission_control.html</span>
                </div>

                <!-- Desktop Shortcut: Files Explorer -->
                <div class="os-icon-item" id="desktopFolderBtn" title="Open File Explorer">
                  <div class="os-icon-glyph">
                    <svg viewBox="0 0 28 34" fill="none">
                      <path d="M 2 8 L 10 8 L 13 11 L 26 11 L 26 28 L 2 28 Z" fill="#F59E0B" stroke="#000000" stroke-width="2" />
                      <path d="M 2 13 L 26 13 L 26 28 L 2 28 Z" fill="#FBBF24" stroke="#000000" stroke-width="1.8" />
                    </svg>
                  </div>
                  <span class="os-icon-label">Files</span>
                </div>

              </div>

              <!-- CENTER EXECUTION HUB: WINDOWS TERMINAL CONSOLE -->
              <div class="runtime-chamber" data-runtime-chamber>
                <div class="hacker-terminal-console" data-terminal-console id="terminalConsole">
                  <div class="windows-terminal-titlebar">
                    <div class="win-term-left">
                      <svg viewBox="0 0 16 16" width="13" height="13" fill="none">
                        <rect x="1" y="2" width="14" height="12" rx="2" fill="#000000" stroke="#22C55E" stroke-width="1.5" />
                        <path d="M 4 6 L 7 8 L 4 10" stroke="#22C55E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <line x1="8" y1="10" x2="11" y2="10" stroke="#22C55E" stroke-width="1.5" stroke-linecap="round" />
                      </svg>
                      <span class="win-term-title">Terminal: openclaw: job_seeker_runtime</span>
                    </div>
                    <div class="win-term-controls">
                      <button class="win-term-btn" id="minimizeTermBtn" title="Minimize">─</button>
                      <button class="win-term-btn" title="Maximize">□</button>
                      <button class="win-term-btn close" id="closeTermBtn" title="Close">✕</button>
                    </div>
                  </div>
                  
                  <div class="terminal-body" id="terminalOutput">
                    <div class="terminal-line dim">OpenClaw Autonomous Runtime v2.6.4 (node-esm64)</div>
                    <div class="terminal-line dim">Workspace mounted: C:\openClaw\workspace\job_hunter</div>
                    <div class="terminal-line dim">Loading multi-agent configuration... [OK]</div>
                    <div class="terminal-line system-ready">System ready. Awaiting scheduled triggers or manual execution.</div>
                  </div>
                </div>
              </div>

              <!-- ============================================================ -->
              <!-- WINDOWS 11 SIMULATION MODALS (POPUPS) -->
              <!-- ============================================================ -->

              <!-- MODAL 1: FILE EXPLORER (LARGE TILE VIEW) -->
              <div class="os-window-modal os-explorer-window" id="osExplorerModal">
                <div class="os-modal-titlebar">
                  <div class="modal-title-left">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                      <path d="M 1 4 L 6 4 L 8 6 L 15 6 L 15 13 L 1 13 Z" fill="#F59E0B" stroke="#000000" stroke-width="1.5" />
                    </svg>
                    <span class="modal-title-text">File Explorer - C:\openClaw\workspace</span>
                  </div>
                  <div class="modal-title-controls">
                    <button class="win-ctrl-btn close" id="closeExplorerBtn">✕</button>
                  </div>
                </div>

                <div class="os-explorer-address-bar">
                  <span class="address-tag">Location:</span>
                  <span class="address-path" id="explorerCurrentPath">openClaw\workspace\agents</span>
                </div>

                <div class="os-explorer-body">
                  <!-- Quick Access Sidebar -->
                  <div class="explorer-sidebar">
                    <button class="explorer-nav-btn active" data-folder="agents" title="Agents">
                      <span class="nav-icon">🤖</span>
                      <span class="nav-label">Agents</span>
                      <span class="nav-count">3</span>
                    </button>
                    <button class="explorer-nav-btn" data-folder="tailored_cvs" title="CVs">
                      <span class="nav-icon">📄</span>
                      <span class="nav-label">CVs</span>
                      <span class="nav-count">2</span>
                    </button>
                    <button class="explorer-nav-btn" data-folder="scripts" title="Scripts">
                      <span class="nav-icon">⚡</span>
                      <span class="nav-label">Scripts</span>
                      <span class="nav-count">3</span>
                    </button>
                    <button class="explorer-nav-btn" data-folder="mission_control" title="Mission Control">
                      <span class="nav-icon">🎯</span>
                      <span class="nav-label">Mission Control</span>
                      <span class="nav-count">2</span>
                    </button>
                  </div>

                  <!-- Large Tile View Content Grid -->
                  <div class="explorer-files-viewport">
                    <div class="explorer-folder-header">
                      <span class="folder-header-title" id="explorerFolderHeaderTitle">Agents</span>
                      <span class="folder-header-count" id="explorerFolderHeaderCount">3 items</span>
                    </div>
                    <div class="explorer-tile-grid" id="explorerTileGrid">
                      <!-- Rendered dynamically -->
                    </div>
                  </div>
                </div>
              </div>

              <!-- MODAL 2: FILE PROPERTIES & WORKFLOW EXPLAINER MODAL -->
              <div class="os-window-modal file-info-modal" id="osFileInfoModal">
                <div class="os-modal-titlebar info-bar">
                  <div class="modal-title-left">
                    <button class="win-modal-back-btn is-hidden" id="infoBackBtn" title="Go back to previous note">← Back</button>
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
                      <rect x="2" y="1" width="12" height="14" rx="1.5" fill="#FFFDEB" stroke="#000000" stroke-width="1.5" />
                      <line x1="5" y1="5" x2="11" y2="5" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
                      <line x1="5" y1="8" x2="11" y2="8" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
                      <line x1="5" y1="11" x2="9" y2="11" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                    <span class="modal-title-text" id="infoModalTitle">Notes</span>
                  </div>
                  <div class="modal-title-controls">
                    <button class="win-ctrl-btn close" id="closeFileInfoBtn">✕</button>
                  </div>
                </div>

                <div class="os-info-content">
                  <div class="info-header-summary">
                    <div class="info-big-icon" id="infoBigIcon">📄</div>
                    <div class="info-name-col">
                      <h3 class="info-filename" id="infoFilename">master_cv.md</h3>
                      <span class="info-filetype" id="infoFiletype">Markdown Source of Truth</span>
                    </div>
                  </div>

                  <div class="info-meta-box">
                    <div class="meta-row">
                      <span class="meta-label">Path:</span>
                      <span class="meta-val" id="infoFilePath">C:\openClaw\workspace\master_cv.md</span>
                    </div>
                    <div class="meta-row">
                      <span class="meta-label">Execution Role:</span>
                      <span class="meta-val highlight" id="infoFileRole">Anti-Hallucination Grounding</span>
                    </div>
                  </div>

                  <div class="info-desc-card" id="infoBodyContainer">
                    <p class="info-section-p" id="infoFileDesc">
                      The single source of truth containing 100% verified, ground-truth career history, skills, and metrics used to prevent AI hallucinations.
                    </p>
                  </div>

                  <div class="info-action-bar" id="infoActionBar">
                    <button class="info-close-btn" id="dismissFileInfoBtn">Got it</button>
                  </div>
                </div>
              </div>

              <!-- MODAL: LIVE MASTER CV (GROUND TRUTH RESUME) -->
              <div class="os-window-modal os-master-cv-window" id="osMasterCvModal">
                <div class="os-modal-titlebar master-cv-bar">
                  <div class="modal-title-left">
                    <svg viewBox="0 0 16 16" width="15" height="15" fill="none">
                      <path d="M 2 1 L 11 1 L 14 4 L 14 15 L 2 15 Z" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
                      <path d="M 11 1 L 11 4 L 14 4 Z" fill="#E4E4E7" stroke="#000000" stroke-width="1.2" />
                      <line x1="4" y1="7" x2="12" y2="7" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
                      <line x1="4" y1="10" x2="10" y2="10" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                    <span class="modal-title-text">master_cv.md: Live CV</span>
                  </div>
                  <div class="modal-title-controls">
                    <button class="win-ctrl-btn close" id="closeMasterCvBtn" title="Close Master CV">✕</button>
                  </div>
                </div>

                <!-- Sticky Topbar Navigation & Actions -->
                <header class="master-cv-topbar">
                  <div class="master-cv-top-left">
                    <button class="cv-back-to-notes-btn is-hidden" id="masterCvBackBtn" title="Back to note">← Back to Notes</button>
                    <span class="mcv-contact-email">nike.emily.olo@gmail.com</span>
                    <nav class="master-cv-nav">
                      <button class="cv-nav-btn" data-target="mcv-about">About</button>
                      <button class="cv-nav-btn" data-target="mcv-experience">Experience</button>
                      <button class="cv-nav-btn" data-target="mcv-competencies">Competencies</button>
                      <button class="cv-nav-btn" data-target="mcv-now">Currently</button>
                      <button class="cv-nav-btn" data-target="mcv-certs">Certs</button>
                    </nav>
                  </div>
                  <div class="master-cv-top-actions">
                    <button class="cv-tool-btn" id="copyMasterCvMarkdownBtn" title="Copy Markdown to clipboard">
                      📋 Copy MD
                    </button>
                    <a class="cv-download-btn-green" href="/Olanike-Olowo-Fela-CV.pdf" download="Olanike-Olowo-Fela-CV.pdf" id="downloadMasterCvBtn" title="Download Verified CV PDF">
                      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M8 2v8m0 0 3-3m-3 3-3-3M3 13h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span>Download CV</span>
                    </a>
                  </div>
                </header>

                <!-- Master CV Scrollable Body -->
                <div class="master-cv-body" id="masterCvScrollBody">
                  
                  <!-- Hero Section -->
                  <section class="mcv-hero-section">
                    <h1 class="mcv-hero-name">Olanike<br />Olowo-Fela<span class="mcv-accent-dot">.</span></h1>
                  </section>

                  <!-- Section 1: About & Education / Skills -->
                  <section class="mcv-section" id="mcv-about">
                    <div class="mcv-grid-2">
                      <div class="mcv-col">
                        <h2 class="mcv-heading">about</h2>
                        <p class="mcv-p">
                          With a background in consulting, service delivery, and project coordination, alongside technical training in full-stack development, I bridge the gap between engineering and client-facing teams.
                        </p>
                        <p class="mcv-p">
                          Naturally process-driven and analytical, I build solutions with both operational realities and business goals in mind, an adaptable approach I've applied across the public, private, and non-profit sectors.
                        </p>
                      </div>
                      <div class="mcv-col">
                        <h2 class="mcv-heading">edu.</h2>
                        <div class="mcv-edu-plain mcv-expandable-card" id="mcvEduItem" title="Click to view degree focus & modules">
                          <div class="mcv-edu-header">
                            <div class="mcv-edu-titles">
                              <p class="mcv-edu-degree">Integrated Master's in Geography with International Development</p>
                              <p class="mcv-edu-school">University of Manchester</p>
                            </div>
                            <span class="mcv-expand-toggle-badge" aria-hidden="true">
                              <span class="expand-text">+ details</span>
                              <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </span>
                          </div>

                          <div class="mcv-item-details">
                            <div class="mcv-item-details-inner">
                              <div class="mcv-edu-detail-block">
                                <strong class="mcv-edu-branch-title">MSc International Development:</strong>
                                <p class="mcv-edu-desc">
                                  Focused on analysing complex, interconnected systems involving institutions, policy, technology, and global economics. Developed strengths in systems analysis, structured research, technical writing, and project-based collaboration.
                                </p>
                              </div>
                              <div class="mcv-edu-detail-block">
                                <strong class="mcv-edu-branch-title">BA Geography:</strong>
                                <p class="mcv-edu-desc">
                                  Focused on understanding how social, economic, and environmental systems interact at local and global scales. Gained practical skills in research, data analysis, policy analysis, and problem-solving.
                                </p>
                              </div>
                            </div>
                          </div>
                        </div>

                        <h2 class="mcv-heading" style="margin-top: 16px;">skills</h2>
                        <div class="mcv-pills">
                          <span class="mcv-pill pop-yellow">AI-Assisted Automation</span>
                          <span class="mcv-pill pop-purple">Agentic Workflow Design</span>
                          <span class="mcv-pill pop-cyan">API Integration</span>
                          <span class="mcv-pill pop-lime">Process Design</span>
                          <span class="mcv-pill pop-pink">Systems Thinking</span>
                          <span class="mcv-pill">HTML / CSS / JavaScript</span>
                          <span class="mcv-pill">Node.js</span>
                          <span class="mcv-pill pop-cyan">Client Delivery & Coordination</span>
                          <span class="mcv-pill pop-yellow">Workshop Facilitation</span>
                          <span class="mcv-pill pop-lime">Stakeholder Translation</span>
                        </div>
                      </div>
                    </div>
                  </section>

                  <!-- Section 2: Work Experience (Expandable Timeline Items) -->
                  <section class="mcv-section" id="mcv-experience">
                    <h2 class="mcv-heading">work experience</h2>
                    <div class="mcv-timeline">
                      
                      <!-- 1. The Odin Project -->
                      <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements">
                        <div class="mcv-tl-main">
                          <div class="mcv-tl-left">
                            <div class="mcv-tl-header">
                              <strong class="mcv-tl-comp" style="color: #000000 !important;">The Odin Project</strong>
                              <span class="mcv-badge-sticker pop-lime">Training</span>
                            </div>
                            <span class="mcv-tl-loc" style="color: #64748B !important;">Remote · 2024 - Present</span>
                          </div>
                          <div class="mcv-tl-right">
                            <div class="mcv-tl-role-row">
                              <strong class="mcv-tl-role" style="color: #000000 !important;">Full-Stack Developer (Training)</strong>
                              <span class="mcv-expand-toggle-badge" aria-hidden="true">
                                <span class="expand-text">+ details</span>
                                <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                              </span>
                            </div>
                            <span class="mcv-tl-kw" style="color: #334155 !important;">HTML, CSS, JavaScript, Node.js, Data Structures & Algorithms, SOLID Principles</span>
                          </div>
                        </div>

                        <div class="mcv-item-details">
                          <div class="mcv-item-details-inner">
                            <p class="mcv-tl-overview">An open-source, project-based full-stack web development curriculum.</p>
                            <ul class="mcv-tl-bullets">
                              <li>Designed and deployed a multi-agent, agentic AI workflow using OpenClaw and Claude to automate the job-search process, reducing time spent by 83%.</li>
                              <li>Completing full-stack curriculum covering fundamental computer science, data structures and algorithms, SOLID principles, and debugging in HTML, CSS, and JS.</li>
                            </ul>
                          </div>
                        </div>
                      </div>

                      <!-- 2. Outer Office -->
                      <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements">
                        <div class="mcv-tl-main">
                          <div class="mcv-tl-left">
                            <div class="mcv-tl-header">
                              <strong class="mcv-tl-comp" style="color: #000000 !important;">Outer Office</strong>
                              <span class="mcv-badge-sticker pop-yellow">Freelance</span>
                            </div>
                            <span class="mcv-tl-loc" style="color: #64748B !important;">Freelance · 2024 - 2025</span>
                          </div>
                          <div class="mcv-tl-right">
                            <div class="mcv-tl-role-row">
                              <strong class="mcv-tl-role" style="color: #000000 !important;">Freelance Workflow Consultant</strong>
