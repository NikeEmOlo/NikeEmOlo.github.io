    function formatFileNameHtml(name: string) {
      const lastDot = name.lastIndexOf(".");
      if (lastDot === -1) {
        return `<span class="file-stem">${name.replaceAll("_", "_<wbr>")}</span>`;
      }
      const stem = name.substring(0, lastDot).replaceAll("_", "_<wbr>");
      const ext = name.substring(lastDot);
      return `<span class="file-stem">${stem}</span><span class="file-ext"><wbr>${ext}</span>`;
    }

    let currentExplorerFolder = "agents";

    function renderExplorerFolder(folderKey: string) {
      const folderData = explorerFoldersDB[folderKey];
      if (!folderData) return;
      currentExplorerFolder = folderKey;

      const pathEl = document.getElementById("explorerCurrentPath");
      if (pathEl) pathEl.textContent = folderData.path;

      const headerTitle = document.getElementById("explorerFolderHeaderTitle");
      if (headerTitle) headerTitle.textContent = folderData.name;

      const headerCount = document.getElementById("explorerFolderHeaderCount");
      if (headerCount) headerCount.textContent = `${folderData.files.length} item${folderData.files.length === 1 ? '' : 's'}`;

      document.querySelectorAll(".explorer-nav-btn").forEach((btn) => {
        const key = btn.getAttribute("data-folder");
        if (key === folderKey) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });

      const grid = document.getElementById("explorerTileGrid");
      if (!grid) return;
      grid.innerHTML = "";

      folderData.files.forEach((file) => {
        const svg = fileIconsSVG[file.key] || mdFileIconSvg;
        const tile = document.createElement("div");
        tile.className = "explorer-file-tile";
        tile.setAttribute("data-file-key", file.key);
        tile.setAttribute("title", `Click to open ${file.name}`);
        tile.innerHTML = `
          <div class="explorer-file-glyph">${svg}</div>
          <span class="explorer-file-label">${formatFileNameHtml(file.name)}</span>
        `;

        tile.addEventListener("click", (e) => {
          e.stopPropagation();
          ensureFullscreenOnInteraction();
          if (file.key === "master_cv") {
            openMasterCvModal();
          } else if (file.key === "mission_control_html" || file.isDirectLaunch) {
            closeExplorer();
            openMissionControl();
          } else {
            openFileInfo(file);
          }
        });

        grid.appendChild(tile);
      });
    }

    // Notes navigation history stack
    const notesHistory: any[] = [];
    let currentNoteFile: any = null;
    let masterCvReturnFile: any = null;

    function updateNotesBackButtons() {
      const topBackBtn = document.getElementById("infoBackBtn");
      if (topBackBtn) {
        if (notesHistory.length > 0) {
          topBackBtn.classList.remove("is-hidden");
          const prev = notesHistory[notesHistory.length - 1];
          topBackBtn.setAttribute("title", `Back to ${prev.name}`);
        } else {
          topBackBtn.classList.add("is-hidden");
        }
      }
    }

    function updateMasterCvBackButton() {
      const cvBackBtn = document.getElementById("masterCvBackBtn");
      if (cvBackBtn) {
        if (masterCvReturnFile) {
          cvBackBtn.classList.remove("is-hidden");
          cvBackBtn.textContent = `← Back to ${masterCvReturnFile.name}`;
        } else {
          cvBackBtn.classList.add("is-hidden");
        }
      }
    }

    function goBackNote() {
      if (notesHistory.length > 0) {
        playClickSound();
        const prevFile = notesHistory.pop();
        openFileInfo(prevFile, true);
      }
    }

    // Open Live Master CV Modal Function
    function openMasterCvModal() {
      ensureFullscreenOnInteraction();
      playPopSound();
      updateMasterCvBackButton();
      bringToFront(masterCvModal);
      if (masterCvModal) masterCvModal.classList.add("is-open");
    }

    function closeMasterCvModal() {
      playClickSound();
      if (masterCvModal) masterCvModal.classList.remove("is-open");
    }


    // Open File Info Modal Function
    function openFileInfo(file: any, isBackNav = false, skipFullscreen = false) {
      if (!skipFullscreen) {
        ensureFullscreenOnInteraction();
        playPopSound();
      }
      if (!file || !fileInfoModal) return;
      bringToFront(fileInfoModal);

      if (!isBackNav && currentNoteFile && currentNoteFile.key !== file.key) {
        notesHistory.push(currentNoteFile);
      }
      currentNoteFile = file;
      updateNotesBackButtons();

      if (infoModalTitle) infoModalTitle.textContent = "Notes";
      if (infoBigIcon) {
        if (file.iconSvg) {
          infoBigIcon.innerHTML = file.iconSvg;
        } else if (file.key && fileIconsSVG[file.key]) {
          infoBigIcon.innerHTML = fileIconsSVG[file.key];
        } else if (file.name && file.name.endsWith(".py")) {
          infoBigIcon.innerHTML = pythonLogoSvg;
        } else if (file.name && file.name.endsWith(".pdf")) {
          infoBigIcon.innerHTML = pdfFileIconSvg;
        } else if (file.name && file.name.endsWith(".html")) {
          infoBigIcon.innerHTML = htmlFileIconSvg;
        } else {
          infoBigIcon.innerHTML = mdFileIconSvg;
        }
      }
      if (infoFilename) infoFilename.textContent = file.name;
      if (infoFiletype) infoFiletype.textContent = file.type;
      if (infoFilePath) infoFilePath.textContent = file.path;
      if (infoFileRole) infoFileRole.textContent = file.role;

      const bodyContainer = document.getElementById("infoBodyContainer");
      if (bodyContainer) {
        if (file.sections && Array.isArray(file.sections)) {
          let sectionsHtml = "";
          file.sections.forEach((sec: any) => {
            sectionsHtml += `
              <div class="info-section-block">
                <h4 class="info-section-heading">${sec.title}</h4>
                <div class="info-section-body">${sec.content}</div>
              </div>
            `;
          });
          bodyContainer.innerHTML = sectionsHtml;
        } else {
          bodyContainer.innerHTML = `
            <div class="info-section-block">
              <h4 class="info-section-heading">What this file does in the workflow</h4>
              <p class="info-section-p">${file.desc || ""}</p>
            </div>
          `;
        }

        // Attach click listeners to any [file_link] inside the content
        bodyContainer.querySelectorAll(".file-jump-link").forEach((link) => {
          link.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const targetKey = link.getAttribute("data-open-file");
            if (targetKey === "master_cv") {
              masterCvReturnFile = currentNoteFile;
              updateMasterCvBackButton();
              closeFileInfo(false, false);
              openMasterCvModal();
            } else if (targetKey === "mission_control_html" || targetKey === "mission_control") {
              closeFileInfo(true, false);
              openMissionControl();
            } else if (targetKey === "faq") {
              closeFileInfo(false, false);
              openBrowserModal();
            } else if (targetKey === "readme") {
              closeFileInfo(false, false);
              openBrowserModal("job-hunt-automation");
            } else if (targetKey) {
              // Find target file in explorer DB
              for (const fKey of Object.keys(explorerFoldersDB)) {
                const match = explorerFoldersDB[fKey].files.find((f: any) => f.key === targetKey);
                if (match) {
                  openFileInfo(match);
                  break;
                }
              }
            }
          });
        });
      }

      const actionBar = document.getElementById("infoActionBar");
      if (actionBar) {
        let buttonsHtml = "";
        if (file.key === "readme") {
          buttonsHtml = `
            <div class="readme-bottom-box">
              <p class="readme-helper-text">If you're finished reading, you can watch a preview of the workflow in this interactive desktop or click on the files and icons for more information.</p>
              <div class="readme-buttons-row">
