  /* TOAST NOTIFICATION (FLOATS IN WALLPAPER STAGE)       */
  /* ---------------------------------------------------- */
  .os-toast-notification {
    position: absolute;
    bottom: 16px;
    right: 18px;
    background: #ffffff;
    border: 3px solid #000000;
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: clamp(320px, 94vw, 480px);
    box-shadow: 4px 6px 0px #000000;
    transform: translateY(100px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease;
    z-index: 35;
    pointer-events: none;
  }

  .os-toast-notification.is-visible {
