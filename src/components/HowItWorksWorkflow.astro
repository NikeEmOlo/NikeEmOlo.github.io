  /* ---------------------------------------------------- */
  /* "THIS IS CLICKABLE" AFFORDANCES                       */
  /* ---------------------------------------------------- */
  .os-icon-tip,
  .tb-tip {
    position: absolute;
    z-index: 60;
    pointer-events: none;
    white-space: nowrap;
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.03em;
    color: var(--doodle-yellow, #ffda00);
    background: #000000;
    border: 2px solid #000000;
    border-radius: 7px;
    padding: 5px 9px;
    box-shadow: 2px 3px 0px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.16s ease, transform 0.16s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Desktop icons sit in a left rail, so the tip opens to the right */
  .os-icon-tip {
    left: calc(100% + 6px);
    top: 50%;
    transform: translateY(-50%) translateX(-6px) scale(0.96);
  }

  .os-icon-item:hover .os-icon-tip,
  .os-icon-item:focus-visible .os-icon-tip {
    opacity: 1;
    transform: translateY(-50%) translateX(0) scale(1);
  }

  /* Taskbar runs along the bottom, so the tip opens upward */
  .tb-tip {
    bottom: calc(100% + 9px);
    left: 50%;
    transform: translateX(-50%) translateY(5px) scale(0.96);
  }

  /* Leftmost button: centring pushes the tip off the screen edge */
  #taskbarStartBtn .tb-tip {
    left: 0;
    transform: translateX(0) translateY(5px) scale(0.96);
  }

  #taskbarStartBtn:hover .tb-tip,
  #taskbarStartBtn:focus-visible .tb-tip {
    transform: translateX(0) translateY(0) scale(1);
  }

  .taskbar-app-btn:hover,
  .taskbar-app-btn:focus-visible {
    z-index: 70;
  }

  .taskbar-app-btn:hover .tb-tip,
  .taskbar-app-btn:focus-visible .tb-tip,
  .taskbar-win-btn.is-interactive:hover .tb-tip,
  .taskbar-win-btn.is-interactive:focus-visible .tb-tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  /* Occasional nudge so the bar reads as live. Long cycle, short active
     window, and every button offset so they never fire together. */
  /* The hop sits at the head of the cycle, so each button fires exactly at its
     own delay. Six buttons 0.55s apart run the sequence in ~3.8s, then the
     10s cycle leaves roughly 6s of quiet before it comes round again. */
  @keyframes tbNudge {
    0% { transform: translateY(0) scale(1); }
    1.6% { transform: translateY(-7px) scale(1.14); }
    3.2% { transform: translateY(0) scale(0.96); }
    4.2% { transform: translateY(-3px) scale(1.04); }
    5%, 100% { transform: translateY(0) scale(1); }
  }

  .taskbar-app-btn,
  .taskbar-win-btn.is-interactive {
    animation: tbNudge 10s ease-in-out infinite;
  }

  #taskbarStartBtn { animation-delay: 0s; }
  #taskbarEmailBtn { animation-delay: 0.55s; }
  #taskbarInternetBtn { animation-delay: 1.1s; }
  #taskbarFilesBtn { animation-delay: 1.65s; }
  #taskbarTerminalBtn { animation-delay: 2.2s; }
  #taskbarSlackBtn { animation-delay: 2.75s; }

  /* Hand control back to the hover state while pointing at a button */
  .taskbar-app-btn:hover,
  .taskbar-win-btn.is-interactive:hover {
    animation: none;
  }

  /* Pulsing ring on the workspace tip so it reads as a call to action */
  .os-interactive-hint-badge::after {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 13px;
    border: 2.5px solid var(--doodle-pink, #ff1f70);
    opacity: 0;
    pointer-events: none;
    animation: hintRing 2.4s ease-out infinite;
  }

  @keyframes hintRing {
    0% { transform: scale(1); opacity: 0.85; }
    70%, 100% { transform: scale(1.16); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .taskbar-app-btn,
    .taskbar-win-btn.is-interactive { animation: none; }
    .os-interactive-hint-badge::after { animation: none; opacity: 0; }
  }

