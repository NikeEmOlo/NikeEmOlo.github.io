    }

    function runHackerTerminal() {
      const termBody = document.getElementById("terminalOutput");
      if (!termBody || isTerminalRunning) return;
      isTerminalRunning = true;
      hasTerminalRun = true;
      hasWorkflowTriggered = true;
      if (toastLaterTimer) {
        clearTimeout(toastLaterTimer);
        toastLaterTimer = null;
      }
      if (toastNotification) {
        toastNotification.classList.remove("is-visible");
