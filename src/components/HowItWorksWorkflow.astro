    // 1-Click Role Approval Trigger with ~2s Timer to mimic Cordy agent
    function triggerApproveRole(job: (typeof missionJobsData)[0]) {
      if (job.decision === "pending") return;

      if (job.decision === "approved") {
        // Toggle back to unapproved if clicked again
        playPopSound();
        job.decision = "none";
        job.status = "NEW";
        job.statusClass = "new";
        renderMissionJobs();
        return;
      }

      // Step 1: Immediately switch status to Pending
      playChime();
      job.decision = "pending";
      job.status = "Pending";
      job.statusClass = "pending";
      renderMissionJobs();

      // Step 2: Trigger Cordy tailoring workflow on a 2-second timer
      setTimeout(() => {
        if (job.decision === "pending") {
          playChime();
          job.decision = "approved";
          job.status = "Review";
          job.statusClass = "review";
          renderMissionJobs();
        }
      }, 2000);
    }

    // Trigger simulated PDF compilation and direct download
    function triggerMakePdf(job: any, btn: HTMLButtonElement) {
      playChime();
      const origHtml = btn.innerHTML;
      btn.innerHTML = `<span>⏳ Compiling...</span>`;
      btn.style.pointerEvents = "none";
      setTimeout(() => {
        btn.innerHTML = `<span>✓ Downloaded</span>`;
        const a = document.createElement("a");
        a.href = "/Olanike-Olowo-Fela-CV.pdf";
        a.download = `CV-${job.company.replace(/[^a-zA-Z0-9]/g, "_")}.pdf`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => {
          btn.innerHTML = origHtml;
          btn.style.pointerEvents = "";
        }, 1400);
      }, 650);
    }

