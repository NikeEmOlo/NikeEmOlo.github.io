  /* INTERACTIVE OS HINT BADGE (TOP-RIGHT OF DESKTOP) */
  .os-interactive-hint-badge {
    position: absolute;
    top: 72px; /* Clearance below 01 // Case Study tag at top: 18px */
    right: 22px;
    left: auto;
    background: var(--doodle-yellow, #ffda00);
    border: 2.5px solid #000000;
    border-radius: 8px; /* Square sticker card shape */
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-shadow: 3px 4px 0px #000000;
    z-index: 25;
    pointer-events: auto;
    cursor: pointer;
    user-select: none;
    max-width: 175px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    animation: hintFloat 3.5s ease-in-out infinite;
  }

  .desktop-zoom-container.is-fullscreen .os-interactive-hint-badge {
    top: 78px;
    right: 28px;
  }

  .os-interactive-hint-badge:hover {
    background: #fef08a; /* Vibrant sticker highlight */
    transform: translateY(-2px);
    box-shadow: 4px 6px 0px #000000;
  }

  @keyframes hintFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .hint-badge-header {
    display: flex;
    align-items: center;
    gap: 6px;
