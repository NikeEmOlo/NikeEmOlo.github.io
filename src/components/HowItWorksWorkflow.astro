    height: 100% !important;
    border: var(--mockup-border, none) !important;
    border-radius: var(--mockup-radius, 0px) !important;
    padding: var(--mockup-padding, 0px) !important;
    box-shadow: var(--mockup-shadow, none) !important;
  }

  .desktop-zoom-container.is-fullscreen .mockup-top-bezel,
  .desktop-zoom-container.is-collapsing .mockup-top-bezel {
    opacity: var(--bezel-opacity, 0) !important;
    display: flex !important;
  }

  .desktop-zoom-container.is-fullscreen .mockup-screen-canvas,
  .desktop-zoom-container.is-collapsing .mockup-screen-canvas {
    width: 100% !important;
    height: 100% !important;
    border: var(--canvas-border, none) !important;
    border-radius: var(--canvas-radius, 0px) !important;
  }

  .desktop-zoom-container.is-fullscreen .desktop-wallpaper-stage,
  .desktop-zoom-container.is-collapsing .desktop-wallpaper-stage {
    width: 100% !important;
    height: calc(100% - 48px) !important;
    aspect-ratio: unset !important;
    flex: 1 1 auto !important;
  }

  .desktop-zoom-container.is-fullscreen .mockup-taskbar,
  .desktop-zoom-container.is-collapsing .mockup-taskbar {
    width: 100% !important;
    height: 48px !important;
    min-height: 48px !important;
    flex-shrink: 0 !important;
  }

  /* THE BLACK MONITOR FRAME (SURROUNDS SCREEN AT REST, DISSOLVES ON DIVE-IN) */
  .device-screen-mockup {
    width: 100%;
    height: auto;
    background: #09090b;
    border: 4px solid #000000;
    border-radius: 20px;
    padding: 20px 22px 22px;
    box-shadow: 8px 12px 0px #000000;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  /* Top Bezel Webcam (Fades out as frame dissolves) */
  .mockup-top-bezel {
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 15;
    opacity: calc(1 - var(--morph) * 3);
    pointer-events: none;
  }

  .camera-lens {
    width: 8px;
    height: 8px;
    background: #18181b;
    border: 1.5px solid #3f3f46;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lens-dot {
    width: 2.5px;
    height: 2.5px;
    background: #0284c7;
    border-radius: 50%;
  }

  /* INNER DISPLAY SCREEN CANVAS (CONTAINER HOUSING WALLPAPER + TASKBAR) */
  .mockup-screen-canvas {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: calc(2.5px * (1 - var(--morph))) solid #000000;
    border-radius: calc(6px * (1 - var(--morph)));
    overflow: hidden;
    box-sizing: border-box;
    background: #09090b;
    position: relative;
  }

  /* 1. FULL WALLPAPER VIEWPORT (FILLS SCREEN ABOVE DOCKED TASKBAR) */
  .desktop-wallpaper-stage {
    width: 100%;
    aspect-ratio: 16 / 9;
    position: relative;
    background-color: #0b4e87;
    background-image: url("/img/windows-bloom-16-9.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
    flex-shrink: 0;
    isolation: isolate;
  }

  /* ---------------------------------------------------- */
  /* REFINED CLICKABLE DESKTOP ICONS                      */
  /* ---------------------------------------------------- */
  .os-desktop-icons {
    position: absolute;
    top: 18px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    z-index: 30;
    pointer-events: auto;
  }

  .desktop-zoom-container.is-fullscreen .os-desktop-icons {
    top: 78px;
    left: 28px;
    gap: 12px;
  }

  .os-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 68px;
    cursor: pointer;
    padding: 3px 4px;
    border-radius: 6px;
    border: 1.5px solid transparent;
    pointer-events: auto !important;
    transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .os-icon-item:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .os-icon-item:active {
    transform: translateY(1px);
    background: rgba(255, 255, 255, 0.25);
  }

  .os-icon-glyph {
    width: 24px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(1.5px 2px 0px rgba(0, 0, 0, 0.5));
  }

  .os-icon-glyph svg {
    width: 100%;
    height: 100%;
  }

  .os-icon-label {
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 700;
    color: #ffffff;
    text-align: center;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(0, 0, 0, 0.9);
    padding: 2px 4px;
    border-radius: 4px;
    box-shadow: 1.5px 2px 0px rgba(0, 0, 0, 0.4);
    max-width: 66px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    user-select: none;
  }

  /* ---------------------------------------------------- */
  /* RUNTIME CHAMBER (TERMINAL CONSOLE)                   */
  /* ---------------------------------------------------- */
  .runtime-chamber {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(480px, 62vw, 760px);
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 35;
    pointer-events: none;
  }

  .hacker-terminal-console {
    width: 100%;
    height: calc(380px + 10vh);
    background: #09090b;
    border: 3.5px solid #000000;
    border-radius: 8px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.85), 6px 8px 0px #22c55e;
    display: none;
    flex-direction: column;
    overflow: hidden;
    pointer-events: auto;
  }

  .hacker-terminal-console.is-active {
    display: flex !important;
    animation: termPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes termPop {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .windows-terminal-titlebar {
    height: 36px;
    background: #18181b;
    border-bottom: 2px solid #27272a;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 0 12px;
    user-select: none;
    flex-shrink: 0;
  }

  .win-term-tab {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .win-term-title {
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: #e4e4e7;
    letter-spacing: 0.02em;
  }

  .win-term-controls {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .win-term-btn {
    width: 42px;
    height: 100%;
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .win-term-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .win-term-btn.close:hover {
    background: #ef4444;
    color: #ffffff;
  }

  .terminal-body {
    padding: 16px 20px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'SF Mono', Consolas, Monaco, monospace;
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    line-height: 1.55;
    background: #0b0f19;
    color: #4ade80;
    height: calc(100% - 36px);
    overflow-y: auto;
    scrollbar-width: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
    box-sizing: border-box;
    box-shadow: inset 0 0 32px rgba(0, 0, 0, 0.75);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .terminal-body::-webkit-scrollbar {
    display: none;
  }

  .terminal-body :global(.log-line) {
    display: block;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'SF Mono', Consolas, Monaco, monospace;
    font-size: 0.82rem;
    line-height: 1.55;
    letter-spacing: 0.01em;
    word-break: break-word;
    white-space: pre-wrap;
    animation: logFadeIn 0.15s ease-out;
  }

  .terminal-body :global(.log-cursor) {
    display: inline-block;
    color: #22c55e;
    animation: termBlink 0.85s infinite;
    line-height: 1;
  }

  @keyframes termBlink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @keyframes termLineFade {
    from { opacity: 0; transform: translateY(2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes logFadeIn {
    from { opacity: 0; transform: translateX(-4px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* ---------------------------------------------------- */
  /* RETRO INTERNET BROWSER MODAL (SEARCH & BLOG VIEWER)  */
  /* ---------------------------------------------------- */
  @keyframes browserGeniePopup {
    0% {
      opacity: 0;
      transform: translate(-50%, 75%) scale(0.2) skew(-4deg, 1.5deg);
      filter: blur(4px);
    }
    60% {
      opacity: 1;
      transform: translate(-50%, -52%) scale(1.02) skew(0.5deg, -0.2deg);
      filter: blur(0px);
    }
    80% {
      transform: translate(-50%, -49%) scale(0.995) skew(0deg, 0deg);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1) skew(0deg, 0deg);
    }
  }

  .os-window-modal.os-browser-window {
    width: 92%;
    max-width: 780px;
    height: 88%;
    max-height: 600px;
    background: #F4F4F5;
    z-index: 60;
  }

  .os-window-modal.os-browser-window.is-open {
    display: flex !important;
    opacity: 1 !important;
    animation: browserGeniePopup 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
  }

  .os-window-modal.os-browser-window.is-maximized {
    width: 98% !important;
    max-width: 98% !important;
    height: calc(100% - 10px) !important;
    max-height: calc(100% - 10px) !important;
  }

  .os-window-modal.os-browser-window.is-open.is-maximized {
    animation: none !important;
    transform: translate(-50%, -50%) scale(1) !important;
  }

  .desktop-zoom-container.is-fullscreen .os-window-modal.os-browser-window {
    max-width: 960px;
    max-height: 86vh;
  }

  .os-modal-titlebar.browser-titlebar {
    background: #0284C7;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    height: 32px;
  }

  .os-modal-titlebar.browser-titlebar .modal-title-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .os-modal-titlebar.browser-titlebar .modal-title-text {
    color: #FFFFFF;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .os-modal-titlebar.browser-titlebar .modal-title-controls {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 5px !important;
    flex-shrink: 0 !important;
  }

  .os-modal-titlebar.browser-titlebar .win-ctrl-btn {
    width: 22px;
    height: 20px;
    background: #FFFFFF;
    border: 1.5px solid #000000;
    border-radius: 3px;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: #000000;
    font-family: monospace;
    font-size: 11px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .os-modal-titlebar.browser-titlebar .win-ctrl-btn:hover {
    background: #E4E4E7;
  }

  .os-modal-titlebar.browser-titlebar .win-ctrl-btn.close:hover {
    background: #EF4444;
    color: #FFFFFF;
  }

  /* Browser Navigation & Address Toolbar */
  .browser-toolbar {
    background: #E4E4E7;
    border-bottom: 2px solid #000000;
    padding: 6px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .browser-nav-buttons {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .browser-btn {
    background: #FFFFFF;
    border: 1.5px solid #000000;
    border-radius: 4px;
    box-shadow: 1.5px 1.5px 0px #000000;
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 7px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    color: #18181B;
    transition: transform 0.1s ease, background 0.1s ease;
  }

  .browser-btn:hover:not(:disabled) {
    background: #FFD233;
    transform: translateY(-1px);
  }

  .browser-btn:active:not(:disabled) {
    transform: translate(1px, 1px);
    box-shadow: none;
  }

  .browser-btn:disabled,
  .browser-btn.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
    background: #E4E4E7;
  }

  .browser-btn-icon {
    font-size: 0.82rem;
    line-height: 1;
  }

  .browser-address-container {
    flex: 1;
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 4px;
    box-shadow: inset 1px 1px 2px rgba(0, 0, 0, 0.15);
    overflow: hidden;
    height: 28px;
  }

  .browser-security-badge {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 6px;
    background: #F4F4F5;
    border-right: 1.5px solid #D4D4D8;
    height: 100%;
    font-family: monospace;
    font-size: 0.65rem;
    color: #059669;
    font-weight: 700;
  }

  .browser-lock-icon {
    font-size: 0.62rem;
  }

  .browser-protocol {
    color: #71717A;
  }

  .browser-address-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0 8px;
    font-family: monospace;
    font-size: 0.72rem;
    color: #18181B;
    background: transparent;
    width: 100%;
  }

  .browser-go-btn {
    background: #10B981;
    color: #FFFFFF;
    border: none;
    border-left: 1.5px solid #000000;
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0 10px;
    height: 100%;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .browser-go-btn:hover {
    background: #059669;
  }

  /* Browser Viewport Area */
  .browser-viewport {
    flex: 1;
    overflow-y: auto;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* VIEW A: RETRO SEARCH ENGINE */
  .browser-search-view {
    padding: 24px 20px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .search-engine-masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 2px dashed #E4E4E7;
    padding-bottom: 20px;
    gap: 12px;
  }

  .retro-search-logo {
    display: inline-flex;
    align-items: baseline;
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    user-select: none;
  }

  .logo-o1 { color: #2563EB; }
  .logo-g1 { color: #DC2626; }
  .logo-g2 { color: #F59E0B; }
  .logo-l { color: #2563EB; }
  .logo-e { color: #16A34A; }
  .logo-excl { color: #DC2626; font-style: italic; }

  .logo-badge {
    background: #000000;
    color: #FFD233;
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 1px 5px;
    border-radius: 4px;
    margin-left: 6px;
    vertical-align: super;
  }

  .search-input-wrapper {
    width: 100%;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .search-input-box {
    width: 100%;
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 4px 14px;
    box-shadow: 2.5px 3px 0px #000000;
    gap: 8px;
    box-sizing: border-box;
  }

  .search-glass-glyph {
    font-size: 0.95rem;
    color: #71717A;
  }

  .search-query-field {
    flex: 1;
    border: none;
    outline: none;
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    color: #18181B;
    background: transparent;
  }

  .search-clear-btn {
    background: #2563EB;
    color: #FFFFFF;
    border: 1.5px solid #000000;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.75rem;
  }

  .search-actions-row {
    display: flex;
    gap: 10px;
  }

  .retro-search-btn {
    background: #F4F4F5;
    border: 1.5px solid #000000;
    border-radius: 6px;
    box-shadow: 2px 2px 0px #000000;
    padding: 5px 14px;
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    color: #18181B;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .retro-search-btn.is-primary {
    background: #FFD233;
  }

  .retro-search-btn:hover {
    transform: translateY(-1px);
    background: #E4E4E7;
  }

  .retro-search-btn.is-primary:hover {
    background: #FACC15;
  }

  .search-stats-bar {
    width: 100%;
    font-family: monospace;
    font-size: 0.68rem;
    color: #71717A;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stats-divider {
    color: #A1A1AA;
  }

  /* Search Results List */
  .search-results-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-bottom: 12px;
    border-bottom: 1px solid #F4F4F5;
  }

  .search-result-item.primary-result {
    background: #FFFBEB;
    border: 2px solid #F59E0B;
    border-radius: 8px;
    padding: 12px 14px;
    box-shadow: 2px 3px 0px rgba(0, 0, 0, 0.15);
  }

  .result-breadcrumb {
    font-family: monospace;
    font-size: 0.68rem;
    color: #15803D;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .result-domain {
    font-weight: 700;
  }

  .result-path {
    color: #16A34A;
  }

  .result-title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .search-result-link {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    color: #1D4ED8;
    cursor: pointer;
    line-height: 1.3;
    transition: color 0.15s ease;
  }

  .search-result-link:hover {
    color: #1E40AF;
    text-decoration: underline;
  }

  .result-snippet {
    margin: 0;
    font-size: 0.80rem;
    line-height: 1.45;
    color: #374151;
  }

  .result-meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .result-tag {
    font-family: monospace;
    font-size: 0.60rem;
    font-weight: 800;
    padding: 1.5px 5px;
    border-radius: 4px;
    background: #E5E7EB;
    color: #374151;
  }

  .result-tag.featured {
    background: #000000;
    color: #FFD233;
  }

  /* FAQ Divider in search results */
  .search-faq-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 6px 0;
  }

  .faq-divider-line {
    flex: 1;
    height: 1.5px;
    background: #E5E7EB;
  }

  .faq-divider-text {
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 800;
    color: #6B7280;
    letter-spacing: 0.04em;
  }

  .search-pagination-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-top: 16px;
    border-top: 1.5px solid #E5E7EB;
  }

  .pagination-logo {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .pg-o1 { color: #2563EB; }
  .pg-g1 { color: #DC2626; }
