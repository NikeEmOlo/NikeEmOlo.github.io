    // 1-Click Role Approval Trigger with ~2s Timer to mimic Cordelia agent
    function triggerApproveRole(job: (typeof missionJobsData)[0]) {
      if (job.decision === "pending") return;

      if (job.decision === "approved") {
        // Toggle back to unapproved if clicked again
        playPopSound();
        job.decision = "none";
        job.status = "NEW";
        job.statusClass = "new";
        renderMissionJobs();
        return;
      }

      // Step 1: Immediately switch status to PENDING
      playChime();
      job.decision = "pending";
      job.status = "PENDING";
      job.statusClass = "pending";
      renderMissionJobs();

      // Step 2: Trigger Cordelia tailoring workflow on a 2-second timer
      setTimeout(() => {
        if (job.decision === "pending") {
          playChime();
          job.decision = "approved";
          job.status = "VIEW CV";
          job.statusClass = "ready";
          renderMissionJobs();
        }
      }, 2000);
    }

    // Opens the Tailored CV Explainer Modal on top of Mission Control
    function openCvTailorModal(jobId?: string) {
      const tailoredFile = explorerFoldersDB.tailored_cvs.files.find((f: any) => f.key === "tailored_cv");
