  /* INTERACTIVE OS HINT BADGE (TOP-RIGHT OF DESKTOP) */
  .os-interactive-hint-badge {
    position: absolute;
    top: 72px; /* Clearance below 01 // Case Study tag at top: 18px */
    right: 22px;
    left: auto;
    background: #ffffff;
    border: 2.5px solid #000000;
    border-radius: 8px; /* Square sticker card shape */
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-shadow: 3px 4px 0px #000000;
    z-index: 25;
    pointer-events: auto;
    cursor: pointer;
    user-select: none;
    max-width: 175px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    animation: hintFloat 3.5s ease-in-out infinite;
  }

  .desktop-zoom-container.is-fullscreen .os-interactive-hint-badge {
    top: 78px;
    right: 28px;
  }

  .os-interactive-hint-badge:hover {
    background: #fef08a; /* Vibrant sticker highlight */
    transform: translateY(-2px);
    box-shadow: 4px 6px 0px #000000;
  }

  @keyframes hintFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .hint-badge-header {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hint-beacon-dot {
    width: 8px;
    height: 8px;
    background: #16a34a;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.7);
    animation: beaconPulse 1.8s infinite;
    flex-shrink: 0;
  }

  @keyframes beaconPulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 7px rgba(22, 163, 74, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(22, 163, 74, 0);
    }
  }

  .hint-badge-tag {
    font-family:
      var(--archivo-font),
      "Archivo",
      monospace;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #16a34a;
    line-height: 1;
  }

  .hint-badge-text {
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.35;
    color: #18181b;
  }

