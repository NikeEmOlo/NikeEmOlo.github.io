  /* ---------------------------------------------------- */
  /* JOB DETAIL & FEEDBACK MODAL (NEO-POP TRADING CARD)   */
  /* ---------------------------------------------------- */
  .mission-job-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 70;
    padding: 16px;
  }

  .mission-job-modal-backdrop.is-open {
    display: flex;
    animation: modalBackdropFade 0.2s ease-out;
  }

  .mission-job-modal-card {
    width: clamp(340px, 85vw, 680px);
    max-height: 88vh;
    background: #FFFFFF;
    border: 3.5px solid #000000;
    border-radius: 14px;
    box-shadow: 8px 10px 0px #000000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #0F172A;
    animation: modalZoomIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 1. Header */
  .mj-modal-header {
    padding: 16px 20px;
    background: #FEF3C7;
    border-bottom: 3px solid #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .mj-header-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mj-job-title {
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: 1.18rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .mj-job-subtitle {
    font-family: monospace;
    font-size: 0.76rem;
    font-weight: 700;
    color: #475569;
    margin: 0;
  }

  .mj-close-btn {
    width: 32px;
    height: 32px;
    background: #FF3366;
    border: 2.5px solid #000000;
    border-radius: 8px;
    color: #FFFFFF;
    font-weight: 900;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;
