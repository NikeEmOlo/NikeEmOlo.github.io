    // Attach IntersectionObserver on runway to kick off 5s notification timer when in view
    if (runway && "IntersectionObserver" in window) {
      const runwayObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio > 0.1) {
              startDesktopTimerIfNeeded();
            }
          });
        },
        { threshold: [0.1, 0.25, 0.5] }
      );
      runwayObserver.observe(runway);
    }

    // Attach Scroll listener for sticky scrollytelling runway
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => applyMorph(currentMorph));
    onScroll();
  }

  // ---- Mobile workflow carousel ----------------------------------------
  // The chain becomes a horizontal snap track below 860px (see the media
  // query). This drives the dots + arrows and keeps them in sync with
  // whatever the user swipes. Desktop keeps the vertical grid untouched.
  function initWorkflowCarousel() {
    const chain = document.querySelector(".wf-chain") as HTMLElement | null;
    const nav = document.querySelector(".wf-swipe-nav") as HTMLElement | null;
    const dotsWrap = document.querySelector("[data-wf-dots]") as HTMLElement | null;
    const prevBtn = document.querySelector("[data-wf-prev]") as HTMLButtonElement | null;
    const nextBtn = document.querySelector("[data-wf-next]") as HTMLButtonElement | null;
    if (!chain || !nav || !dotsWrap || !prevBtn || !nextBtn) return;
    if (chain.dataset.carouselBound === "true") return;
    chain.dataset.carouselBound = "true";

    const nodes = Array.from(chain.querySelectorAll<HTMLElement>(".wf-node"));
    if (!nodes.length) return;

    const isCarousel = () => window.matchMedia("(max-width: 860px)").matches;

    dotsWrap.innerHTML = "";
    const dots = nodes.map((_, i) => {
      const d = document.createElement("button");
      d.type = "button";
      d.className = "wf-dot";
      d.setAttribute("aria-label", `Go to step ${i + 1} of ${nodes.length}`);
      d.addEventListener("click", () => scrollToIndex(i));
      dotsWrap.appendChild(d);
      return d;
    });

    let current = 0;

    function collapseInactiveCards(activeIdx: number) {
      if (!isCarousel()) return;
      nodes.forEach((n, i) => {
        if (i !== activeIdx) {
          const btn = n.querySelector<HTMLElement>(".wf-expand-btn");
          const panel = n.querySelector<HTMLElement>(".wf-detail");
          const label = n.querySelector<HTMLElement>(".wf-expand-label");
          if (btn && btn.getAttribute("aria-expanded") === "true") {
            btn.setAttribute("aria-expanded", "false");
            if (panel) panel.hidden = true;
            if (label) label.textContent = "Read the techy details";
          }
        }
      });
    }

    function scrollToIndex(i: number) {
      const idx = Math.max(0, Math.min(i, nodes.length - 1));
      const target = nodes[idx];
      if (!target || !chain) return;
      collapseInactiveCards(idx);
      // centre the card in the track, matching scroll-snap-align: center
      chain.scrollTo({
        left:
          target.offsetLeft -
          chain.offsetLeft -
          (chain.clientWidth - target.offsetWidth) / 2,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
      });
    }

    let lastActive = -1;
    function syncFromScroll() {
      if (!chain) return;
      // Nearest card to the track's centre is the one in view.
      const x = chain.scrollLeft + chain.offsetLeft + chain.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      nodes.forEach((n, i) => {
        const dist = Math.abs(n.offsetLeft + n.offsetWidth / 2 - x);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      current = best;
      dots.forEach((d, i) => d.classList.toggle("is-current", i === best));
      prevBtn!.disabled = best === 0;
      nextBtn!.disabled = best === nodes.length - 1;

      if (best !== lastActive) {
        collapseInactiveCards(best);
        lastActive = best;
      }
    }

    prevBtn.addEventListener("click", () => scrollToIndex(current - 1));
    nextBtn.addEventListener("click", () => scrollToIndex(current + 1));
    chain.addEventListener("scroll", syncFromScroll, { passive: true });

    function applyMode() {
      if (isCarousel()) {
        nav.removeAttribute("hidden");
        syncFromScroll();
      } else {
        nav.setAttribute("hidden", "");
        chain!.scrollLeft = 0;
      }
    }

    window.addEventListener("resize", applyMode);
    applyMode();
  }

  function initWorkflowAll() {
    initHowItWorks();
    initWorkflowCarousel();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWorkflowAll);
  } else {
    initWorkflowAll();
  }
  document.addEventListener("astro:page-load", initWorkflowAll);
</script>
