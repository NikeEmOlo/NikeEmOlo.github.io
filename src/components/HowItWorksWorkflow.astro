  }

  /* 2. Stat Bar */
  .mj-meta-bar {
    padding: 10px 20px;
    background: #F8FAFC;
    border-bottom: 2.5px solid #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: monospace;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .mj-meta-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .mj-meta-right {
    display: flex;
    align-items: center;
  }

  .mj-meta-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #EDE9FE;
    color: #6D28D9;
    border: 1.5px solid #000000;
    border-radius: 6px;
    padding: 3px 8px;
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 1.5px 1.5px 0px #000000;
    transition: all 0.15s ease;
  }

  .mj-meta-link:hover {
    background: #DDD6FE;
    color: #4C1D95;
    transform: translateY(-1px);
    box-shadow: 2px 2.5px 0px #000000;
  }

  .mj-meta-date {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    font-family: monospace !important;
    font-size: 0.74rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    background: #E2E8F0 !important;
    border: 1.5px solid #000000 !important;
    border-radius: 6px !important;
    padding: 3px 8px !important;
    box-shadow: 1.5px 1.5px 0px #000000 !important;
    white-space: nowrap !important;
  }

  .mj-meta-date strong,
  #mjDetailPosted {
    color: #000000 !important;
    font-weight: 900 !important;
  }

  .mj-score-tag {
    background: #FFD233 !important;
    border: 2px solid #000000 !important;
    border-radius: 6px !important;
    padding: 3px 8px !important;
    color: #000000 !important;
    font-weight: 900 !important;
    box-shadow: 1.5px 1.5px 0px #000000 !important;
  }

  .mj-score-tag strong,
  #mjDetailScore {
    color: #000000 !important;
    font-weight: 900 !important;
  }

  .mj-badge {
    font-size: 0.68rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 6px;
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  .mj-badge.pink {
    background: #FF3366;
    color: #FFFFFF;
  }

  .mj-badge.cyan {
    background: #00F5D4;
    color: #000000;
  }

  .mj-badge.green {
    background: #22C55E;
    color: #FFFFFF;
  }

  .mj-badge.red {
    background: #EF4444;
    color: #FFFFFF;
  }

  .mj-badge.gold {
    background: #FFD233;
    color: #000000;
  }

  .mj-badge.salary {
    background: #DCFCE7;
    color: #15803D;
    font-weight: 800;
  }

  /* 3. Body (Job Description + Vibe Check) */
  .mj-modal-body {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    max-height: 55vh;
    background: #FFFFFF;
  }

  .mj-body-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mj-section-heading {
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: 0.98rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0;
  }

  .mj-plain-text {
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.55;
    color: #334155;
    margin: 0;
  }

  .mj-desc-truncated {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mj-body-divider {
    height: 1.5px;
    background: #E2E8F0;
    width: 100%;
  }

  /* 4. Footer (Approve & Reject Buttons) */
  .mj-modal-footer {
    padding: 14px 22px;
    background: #FAF7F2;
    border-top: 3px solid #000000;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
  }

  .mj-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 20px;
    border-radius: 8px;
    border: 2.5px solid #000000;
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: 0.84rem;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 2.5px 3px 0px #000000;
    transition: all 0.15s ease;
  }

  .mj-btn.reject {
    background: #FF3366;
    color: #FFFFFF;
  }

  .mj-btn.reject:hover {
    background: #EF4444;
    transform: translateY(-2px);
    box-shadow: 3px 5px 0px #000000;
  }

  .mj-btn.approve {
    background: #22C55E;
    color: #FFFFFF;
  }

  .mj-btn.approve:hover {
    background: #16A34A;
    transform: translateY(-2px);
    box-shadow: 3px 5px 0px #000000;
  }

  /* ---------------------------------------------------- */
