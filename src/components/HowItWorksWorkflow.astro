  :global(.mc-leave-feedback-pill) {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    background: #FF3366 !important;
    color: #FFFFFF !important;
    border: 2.5px solid #000000 !important;
    border-radius: 8px !important;
    padding: 5px 10px !important;
    font-family: var(--archivo-font), "Archivo", sans-serif !important;
    font-size: 0.76rem !important;
    font-weight: 900 !important;
    cursor: pointer !important;
    box-shadow: 2.5px 3px 0px #000000 !important;
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1) !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    transform: rotate(-1deg) !important;
    opacity: 1 !important;
    filter: none !important;
  }

  :global(.mc-leave-feedback-pill:hover) {
    background: #EF4444 !important;
    transform: rotate(0deg) translateY(-2px) scale(1.04) !important;
    box-shadow: 3.5px 5px 0px #000000 !important;
