  /* `position: sticky` makes this stage a stacking context, so the fullscreen
     desktop's z-index cannot escape it. Without lifting the stage itself, the
     workflow steps that follow (a later positioned sibling) paint over the
     desktop as soon as they scroll into view. */
  .how-sticky-viewport.has-fullscreen-desktop {
