    function renderMissionJobs() {
      if (!mcJobsTableBody) return;
      const searchVal = mcSearchInput ? mcSearchInput.value.toLowerCase().trim() : "";

      const totalCount = missionJobsData.length;
      const approvedCount = missionJobsData.filter(j => j.decision === "approved").length;
      const rejectedCount = missionJobsData.filter(j => j.decision === "rejected").length;
      const pendingCount = missionJobsData.filter(j => j.decision === "pending" || j.decision === "none").length;
      const highCount = missionJobsData.filter(j => parseFloat(j.score) >= 90).length;

      // Update counters
      const statApprovedEl = document.getElementById("statApprovedCount");
      const statPendingEl = document.getElementById("statPendingCount");
      const countAllEl = document.getElementById("countAll");
      const countApprovedEl = document.getElementById("countApproved");
      const countPendingEl = document.getElementById("countPending");
      const countHighEl = document.getElementById("countHigh");
      const mcQueueCountEl = document.getElementById("mcQueueCount");

      if (statApprovedEl) statApprovedEl.textContent = `✓ ${approvedCount} tailored`;
      if (statPendingEl) statPendingEl.textContent = `⏳ ${pendingCount} queue`;
      if (countAllEl) countAllEl.textContent = String(totalCount);
      if (countApprovedEl) countApprovedEl.textContent = String(approvedCount);
      if (countPendingEl) countPendingEl.textContent = String(pendingCount);
      if (countHighEl) countHighEl.textContent = String(highCount);
      if (mcQueueCountEl) mcQueueCountEl.textContent = `${pendingCount} priority roles ready`;

      // Update Home dashboard counters dynamically
      const homeCvsCountEl = document.getElementById("mcHomeCvsCount");
      const homeCvsLabelEl = document.getElementById("mcHomeCvsLabel");
      const homeJobsCountEl = document.getElementById("mcHomeJobsCount");
      const homeCvCardSubEl = document.getElementById("mcHomeCvCardSub");
      const readyCvsCount = missionJobsData.filter(j => j.decision === "approved" || j.status === "Review").length;
      const generatingCvsCount = missionJobsData.filter(j => j.decision === "pending" || j.status === "Pending").length;

      if (homeCvsCountEl && homeCvsLabelEl) {
        if (readyCvsCount > 0) {
          homeCvsCountEl.textContent = String(readyCvsCount);
          homeCvsLabelEl.textContent = readyCvsCount === 1 ? "CV ready for you" : "CVs ready for you";
        } else if (generatingCvsCount > 0) {
          homeCvsCountEl.textContent = String(generatingCvsCount);
          homeCvsLabelEl.textContent = generatingCvsCount === 1 ? "CV generating..." : "CVs generating...";
        } else {
          homeCvsCountEl.textContent = "0";
          homeCvsLabelEl.textContent = "CVs ready for you";
        }
      }
      if (homeJobsCountEl) {
        homeJobsCountEl.textContent = String(totalCount);
      }

      if (homeCvCardSubEl) {
        if (generatingCvsCount > 0 && readyCvsCount > 0) {
          homeCvCardSubEl.textContent = `${generatingCvsCount} CV${generatingCvsCount === 1 ? "" : "s"} in progress: ${readyCvsCount} CV${readyCvsCount === 1 ? "" : "s"} ready for your review.`;
        } else if (generatingCvsCount > 0) {
          homeCvCardSubEl.textContent = `${generatingCvsCount} CV${generatingCvsCount === 1 ? "" : "s"} in progress: 0 ready for review.`;
        } else if (readyCvsCount > 0) {
          homeCvCardSubEl.textContent = `No CVs in progress: ${readyCvsCount} CV${readyCvsCount === 1 ? "" : "s"} ready for your review.`;
        } else {
          homeCvCardSubEl.textContent = "No CVs in progress: 0 CVs ready for your review.";
        }
      }

      if (currentFunnelMode === "today") {
        updateFunnelDisplay();
      }

      const filtered = missionJobsData.filter((job) => {
        if (currentMcFilter === "approved" && job.decision !== "approved") return false;
        if (currentMcFilter === "pending" && job.decision !== "none" && job.decision !== "pending") return false;
        if (currentMcFilter === "high" && parseFloat(job.score) < 90) return false;
        if (searchVal) {
          const matchTitle = job.title.toLowerCase().includes(searchVal);
          const matchComp = job.company.toLowerCase().includes(searchVal);
          const matchLoc = job.location.toLowerCase().includes(searchVal);
          if (!matchTitle && !matchComp && !matchLoc) return false;
        }
        return true;
      });

      mcJobsTableBody.innerHTML = "";

