  /* ---------------------------------------------------- */
  /* MISSION CONTROL ULTRA-FAST TOOLTIPS                  */
  /* ---------------------------------------------------- */
  .mc-btn-tooltip-wrap,
  :global(.mc-tip-wrap) {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .mc-cron-action-btn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: 1.5px solid #CBD5E1;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: not-allowed;
    opacity: 0.85;
    transition: all 0.12s ease;
  }

  .mc-btn-tooltip-wrap:hover .mc-cron-action-btn {
    border-color: #000000;
    background: #F8FAFC;
    opacity: 1;
  }

  .mc-action-tooltip,
  :global(.mc-tip) {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: #0F172A;
    color: #FFFFFF;
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.35;
    padding: 5px 9px;
    border-radius: 6px;
    border: 1.5px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    width: max-content;
    max-width: 280px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.08s ease, transform 0.08s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0s;
    z-index: 150;
  }

  .mc-action-tooltip {
    right: 0;
    left: auto;
    transform: translateY(4px);
  }

  :global(.mc-tip.tip-top-left) {
    left: 0;
    right: auto;
    transform: translateY(4px);
  }

  :global(.mc-tip.tip-top-right) {
    left: auto;
    right: 0;
    transform: translateY(4px);
  }

  :global(.mc-tip.tip-top-center) {
    left: 50%;
    right: auto;
    transform: translateX(-50%) translateY(4px);
  }

  :global(.mc-tip.tip-bottom-center) {
    bottom: auto;
    top: calc(100% + 8px);
    left: 50%;
    right: auto;
    transform: translateX(-50%) translateY(-4px);
  }

  :global(.mc-tip.tip-nav-right) {
    left: calc(100% + 10px);
    top: 50%;
    bottom: auto;
    right: auto;
    transform: translateY(-50%) translateX(-4px);
  }

  .mc-btn-tooltip-wrap:hover .mc-action-tooltip,
  :global(.mc-tip-wrap:hover > .mc-tip),
  :global(.mc-tip-wrap:focus-within > .mc-tip) {
    opacity: 1;
    visibility: visible;
  }

  .mc-btn-tooltip-wrap:hover .mc-action-tooltip {
    transform: translateY(0);
  }

  :global(.mc-tip-wrap:hover > .mc-tip.tip-top-center) {
    transform: translateX(-50%) translateY(0);
  }

  :global(.mc-tip-wrap:hover > .mc-tip.tip-top-left) {
    transform: translateY(0);
  }

  :global(.mc-tip-wrap:hover > .mc-tip.tip-top-right) {
    transform: translateY(0);
  }

  :global(.mc-tip-wrap:hover > .mc-tip.tip-bottom-center) {
    transform: translateX(-50%) translateY(0);
  }

  :global(.mc-tip-wrap:hover > .mc-tip.tip-nav-right) {
    transform: translateY(-50%) translateX(0);
  }

  /* Table Row Quick Tooltip: "Click to see job description" */
  :global(.mc-row-tip) {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 0;
    background: #0F172A;
    color: #FFDA00;
    font-family: monospace;
    font-size: 0.70rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.08s ease, transform 0.08s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0s;
    z-index: 130;
  }

  :global(.mc-jobs-table tbody tr:hover .mc-row-tip) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Hide row tooltip when hovering action buttons or CV buttons so they don't collide */
  :global(.mc-jobs-table tbody tr:has(.mc-act-btn:hover) .mc-row-tip),
  :global(.mc-jobs-table tbody tr:has(.mc-btn-view-cv:hover) .mc-row-tip),
  :global(.mc-jobs-table tbody tr:has(.mc-btn-make-pdf:hover) .mc-row-tip),
  :global(.mc-jobs-table tbody tr:has(.mc-btn-file-loc:hover) .mc-row-tip),
  :global(.mc-jobs-table tbody tr:has(.mc-leave-feedback-pill:hover) .mc-row-tip) {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* Mobile Job Card Quick Tooltip: "Click to see job description" */
  :global(#osMissionControlDashboard li.mc-job-card),
  :global(.mc-job-card) {
    position: relative;
    list-style: none;
  }

  :global(.mc-card-tip) {
    position: absolute;
    top: -10px;
    right: 14px;
    background: #0F172A;
    color: #FFDA00;
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.08s ease, transform 0.08s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0s;
    z-index: 130;
  }

  :global(#osMissionControlDashboard li.mc-job-card:hover .mc-card-tip),
  :global(.mc-job-card:hover .mc-card-tip) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  :global(#osMissionControlDashboard li.mc-job-card:has(.mc-card-act-btn:hover) .mc-card-tip),
  :global(.mc-job-card:has(.mc-card-act-btn:hover) .mc-card-tip),
  :global(#osMissionControlDashboard li.mc-job-card:has(.mc-btn-view-cv:hover) .mc-card-tip),
  :global(.mc-job-card:has(.mc-btn-view-cv:hover) .mc-card-tip) {
