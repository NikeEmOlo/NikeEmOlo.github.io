  /* ---------------------------------------------------- */
  /* GREY TASKBAR DOCKED BENEATH WALLPAPER (ZERO OVERLAP) */
  /* ---------------------------------------------------- */
  .mockup-taskbar {
    width: 100%;
    height: 48px;
    min-height: 48px;
    background: #e4e4e7;
    border-top: 3px solid #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    box-sizing: border-box;
    flex-shrink: 0;
    position: relative;
    z-index: 40;
  }

  .taskbar-left-group {
    display: flex;
    align-items: center;
    gap: 10px;
    /* The app strip is the expendable half: let it be squeezed and clipped
       rather than shoving the clock out past the right edge of the taskbar.
       Clipped on the inline axis only, so the active-app dot that sits just
       below each button (bottom: -2px) still shows. */
    min-width: 0;
    overflow-x: clip;
    overflow-y: visible;
  }

  .taskbar-win-btn {
    background: none;
    border: none;
    padding: 2px;
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .win-logo-svg {
    width: 26px;
    height: 26px;
    filter: drop-shadow(1px 2px 0px rgba(0, 0, 0, 0.25));
  }

  .taskbar-search-pill {
    height: 26px;
    background: #ffffff;
    border: 2px solid #000000;
    border-radius: 13px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: #71717a;
    box-shadow: 1.5px 2px 0px #000000;
    cursor: default;
  }

  .taskbar-apps-container {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 4px;
  }

  .taskbar-app-btn {
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: transform 0.1s ease;
    text-decoration: none;
  }

  .taskbar-app-btn:hover {
    transform: translateY(-2px);
  }

  .taskbar-app-btn:active {
    transform: translateY(1px);
  }

  .taskbar-app-btn svg {
    width: 26px;
    height: 26px;
    filter: drop-shadow(1px 1.5px 0px rgba(0, 0, 0, 0.25));
  }

  .taskbar-app-btn.is-active-app {
    background: rgba(0, 0, 0, 0.08);
    border-radius: 6px;
  }

  .app-active-dot {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: #2563eb;
    border: 1px solid #000000;
    border-radius: 50%;
  }

  .taskbar-right-group {
    display: flex;
    align-items: center;
    gap: 14px;
    /* Systray + clock are the half that must stay legible. */
    flex-shrink: 0;
  }

  .systray-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #18181b;
  }

  .systray-icon {
    cursor: default;
    user-select: none;
  }

  .taskbar-clock-col {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 2.5px solid #000000;
    border-radius: 8px;
    padding: 4px 10px;
    box-shadow: 2px 3px 0px #000000;
    font-family: monospace;
    line-height: 1;
    cursor: default;
  }

  .clock-time {
    font-size: 0.85rem;
    font-weight: 900;
    color: #000000;
    letter-spacing: 0.04em;
    transition: color 0.3s ease;
  }

  .clock-date {
    font-size: 0.62rem;
    font-weight: 700;
    color: #71717a;
    border-left: 1.5px solid #e4e4e7;
    padding-left: 6px;
  }

  /* ---------------------------------------------------- */
  /* ANIMATION TEST CONTROLS TOOLBAR                      */
  /* ---------------------------------------------------- */
  .anim-test-toolbar {
    position: absolute;
    top: 20px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #18181b;
    border: 2.5px solid #000000;
    border-radius: 8px;
    padding: 6px 12px;
    box-shadow: 3px 4px 0px #000000;
    z-index: 100;
  }

  .test-btn {
    background: #ffd233;
    color: #000000;
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 800;
    border: 1.5px solid #000000;
    border-radius: 4px;
    padding: 4px 8px;
    cursor: pointer;
    box-shadow: 1.5px 2px 0px #000000;
    transition: transform 0.1s ease;
  }

  .test-btn:hover {
    transform: translateY(-1px);
  }

  .test-btn:active {
    transform: translateY(1px);
  }

  .test-btn.reset {
    background: #e4e4e7;
  }

  .test-slider-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
  }

  .test-label {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: #a1a1aa;
  }

  .test-slider {
    width: 80px;
    cursor: pointer;
    accent-color: #ffd233;
  }

  .test-pct {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffd233;
    min-width: 32px;
  }

  /* ---------------------------------------------------- */
  /* VERTICAL STEPS CONTAINER (BELOW TERMINAL)            */
  /* ---------------------------------------------------- */
  .workflow-vertical-steps-section {
    position: relative;
    width: 100%;
    padding: 80px 24px 120px 24px;
    background: #ffffff;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }

  .workflow-steps-container {
    width: 100%;
    max-width: 780px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .vertical-step-card {
    display: flex;
    gap: 28px;
    position: relative;
  }

  .step-badge-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .step-num {
    width: 44px;
    height: 44px;
    background: #ffd233;
    border: 3px solid #000000;
    border-radius: 10px;
    color: #000000;
    font-family: monospace;
    font-size: 1.15rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 3px 4px 0px #000000;
  }

  .step-stem-line {
    width: 3px;
    flex: 1;
    background: repeating-linear-gradient(to bottom, #d4d4d8 0px, #d4d4d8 6px, transparent 6px, transparent 12px);
    margin-top: 12px;
  }

  .step-content-box {
    flex: 1;
    background: #ffffff;
    border: 3px solid #000000;
    border-radius: 12px;
    padding: 24px 28px;
    box-shadow: 6px 8px 0px #000000;
  }

  .step-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .step-time-chip {
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 800;
    color: #71717a;
    letter-spacing: 0.08em;
  }

  .step-status-tag {
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 3px 8px;
    border: 2px solid #000000;
    border-radius: 6px;
    color: #000000;
  }

  .step-status-tag.green { background: #22c55e; }
  .step-status-tag.coral { background: #e11d48; color: #ffffff; }
  .step-status-tag.teal { background: #0d9488; color: #ffffff; }

  .step-title {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #000000;
    margin: 0 0 10px 0;
  }

  .step-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #52525b;
    margin: 0 0 18px 0;
  }

  .step-metric-tray {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 14px;
    border-top: 1.5px solid #e4e4e7;
  }

  .metric-pill {
    font-family: monospace;
    font-size: 0.7rem;
    color: #18181b;
    background: #f4f4f5;
    border: 1.5px solid #000000;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 700;
  }

  .metric-pill.highlight {
    background: #ffd233;
    border-color: #000000;
    color: #000000;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .desktop-zoom-container {
      width: 92vw;
    }
    .os-desktop-icons {
      gap: 8px;
      left: 8px;
      top: 8px;
    }
    .os-icon-item {
      width: 52px;
    }
    .os-icon-label {
      max-width: 50px;
