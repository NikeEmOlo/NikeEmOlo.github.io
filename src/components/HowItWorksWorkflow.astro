          startWorkflowBtn.innerHTML = `<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg><span>Replay</span>`;
        }
      }, 6300);
    }

    // Interactive Scroll-to-Scale Shrink Mechanic
    function applyExitScale(progress: number) {
      if (!zoomContainer) return;
      const clamped = Math.min(Math.max(progress, 0), 1);

      if (clamped <= 0) {
        zoomContainer.style.transform = "scale(1)";
        zoomContainer.style.setProperty("--mockup-border", "none");
        zoomContainer.style.setProperty("--mockup-radius", "0px");
        zoomContainer.style.setProperty("--mockup-padding", "0px");
        zoomContainer.style.setProperty("--mockup-shadow", "none");
        zoomContainer.style.setProperty("--bezel-opacity", "0");
        zoomContainer.style.setProperty("--canvas-border", "none");
        zoomContainer.style.setProperty("--canvas-radius", "0px");
      } else {
        const scale = 1 - clamped * 0.22; // 1.0 down to 0.78 (resting mockup size)
        const borderW = (clamped * 4).toFixed(1);
        const radius = (clamped * 20).toFixed(1);
        const padY = (clamped * 20).toFixed(1);
        const padX = (clamped * 22).toFixed(1);
        const shadowX = (clamped * 8).toFixed(1);
        const shadowY = (clamped * 12).toFixed(1);

        zoomContainer.style.transform = `scale(${scale.toFixed(4)})`;
        zoomContainer.style.setProperty("--mockup-border", `${borderW}px solid #000000`);
        zoomContainer.style.setProperty("--mockup-radius", `${radius}px`);
        zoomContainer.style.setProperty("--mockup-padding", `${padY}px ${padX}px ${padX}px`);
        zoomContainer.style.setProperty("--mockup-shadow", `${shadowX}px ${shadowY}px 0px #000000`);
        zoomContainer.style.setProperty("--bezel-opacity", `${clamped.toFixed(2)}`);
        zoomContainer.style.setProperty("--canvas-border", `${(clamped * 2.5).toFixed(1)}px solid #000000`);
        zoomContainer.style.setProperty("--canvas-radius", `${(clamped * 6).toFixed(1)}px`);
      }
    }

    function animateExitProgressTo(target: number, onComplete?: () => void) {
      if (exitSpringAnim) cancelAnimationFrame(exitSpringAnim);
      const step = () => {
        const diff = target - exitScrollProgress;
        if (Math.abs(diff) < 0.015) {
          exitScrollProgress = target;
          applyExitScale(exitScrollProgress);
          if (onComplete) onComplete();
          return;
        }
        exitScrollProgress += diff * 0.22;
        applyExitScale(exitScrollProgress);
        exitSpringAnim = requestAnimationFrame(step);
      };
      exitSpringAnim = requestAnimationFrame(step);
    }

    // Exit Fullscreen Mode & Return to Normal Document Flow
    function exitFullscreen(immediate = false) {
      clearLogTimers();
      isAutoPlaying = false;
      playClickSound();

      if (exitSpringAnim) cancelAnimationFrame(exitSpringAnim);
      
      // Close open modals
      if (masterCvModal) masterCvModal.classList.remove("is-open");
      if (explorerModal) {
        explorerModal.classList.remove("is-open");
        if (taskbarFilesBtn) taskbarFilesBtn.classList.remove("is-active-app");
      }
      if (fileInfoModal) fileInfoModal.classList.remove("is-open");
      if (emailModal) {
        emailModal.classList.remove("is-open");
        if (taskbarEmailBtn) taskbarEmailBtn.classList.remove("is-active-app");
      }
      if (mcDashboard) mcDashboard.classList.remove("is-open");
      if (missionJobModal) missionJobModal.classList.remove("is-open");
      if (feedbackLoopModal) feedbackLoopModal.classList.remove("is-open");
      if (terminalConsole) terminalConsole.classList.remove("is-active");
      if (slackNotification) slackNotification.classList.remove("is-visible");

      const storyHeader = document.getElementById("storyHeader") || document.querySelector(".story-header");
      if (storyHeader) {
        (storyHeader as HTMLElement).style.display = "";
        storyHeader.classList.remove("is-hidden-mc");
      }
      const headerBack = document.getElementById("headerBackBtn");
      if (headerBack) {
        headerBack.style.display = "";
        headerBack.classList.remove("is-hidden-mc");
      }
      setFullscreenHeader(false);
      if (headerOverlay) headerOverlay.classList.remove("is-faded");

      const finalizeExit = () => {
        exitScrollProgress = 0;
        if (zoomContainer) {
          zoomContainer.style.transform = "";
          zoomContainer.style.removeProperty("--mockup-border");
          zoomContainer.style.removeProperty("--mockup-radius");
          zoomContainer.style.removeProperty("--mockup-padding");
          zoomContainer.style.removeProperty("--mockup-shadow");
          zoomContainer.style.removeProperty("--bezel-opacity");
          zoomContainer.style.removeProperty("--canvas-border");
          zoomContainer.style.removeProperty("--canvas-radius");
          zoomContainer.classList.remove("is-fullscreen");
          zoomContainer.classList.remove("is-collapsing");
        }
        document.body.style.overflow = "";

        if (toastNotification) toastNotification.classList.add("is-visible");
        if (startWorkflowBtn) {
          startWorkflowBtn.classList.remove("is-running");
          startWorkflowBtn.innerHTML = `<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg><span>Replay</span>`;
        }
        if (expandWorkspaceBtn) expandWorkspaceBtn.classList.add("is-visible");
      };

      if (!immediate && zoomContainer && zoomContainer.classList.contains("is-fullscreen")) {
        zoomContainer.classList.add("is-collapsing");
        animateExitProgressTo(1, finalizeExit);
      } else {
        finalizeExit();
      }
    }

    // Helper to check if any user modal (other than the terminal) is currently open
    function isAnyModalOpen(): boolean {
      const openModal = document.querySelector(
        "#osExplorerModal.is-open, #osFileInfoModal.is-open, #osEmailModal.is-open, #osMasterCvModal.is-open, #missionJobModal.is-open, #osMissionControlDashboard.is-visible, .os-window-modal.is-open:not(#terminalConsole)"
      );
      return !!openModal;
    }

    // Scroll-to-Scale shrinking gesture listener:
    // Only DOWNWARD scroll causes shrink and exit. UPWARD scroll only recovers scale to 1.0 and never exits.
    // Exit ONLY occurs when NO user modals are open (other than the terminal).
    window.addEventListener(
      "wheel",
      (e) => {
        if (!zoomContainer || !zoomContainer.classList.contains("is-fullscreen")) return;

        // If any modal (other than terminal) is open, NEVER trigger exit-on-scroll.
        if (isAnyModalOpen()) return;

        const target = e.target as HTMLElement;
        const inTerminal = target.closest("#terminalOutput") as HTMLElement | null;
        if (inTerminal) {
          const isScrollDown = e.deltaY > 0;
          const isScrollUp = e.deltaY < 0;
          const canScrollDown = inTerminal.scrollTop + inTerminal.clientHeight < inTerminal.scrollHeight - 3;
          const canScrollUp = inTerminal.scrollTop > 3;

          // If terminal output has room to scroll, let it scroll naturally
          if ((isScrollDown && canScrollDown) || (isScrollUp && canScrollUp)) {
            return;
          }
        }

        // 1. SCROLLING UP (deltaY < 0): NEVER exits. Recovers scale if partially shrunk.
        if (e.deltaY < 0) {
          if (exitScrollProgress > 0) {
            e.preventDefault();
            if (exitSpringAnim) cancelAnimationFrame(exitSpringAnim);
            exitScrollProgress = Math.max(0, exitScrollProgress + e.deltaY / 320);
            applyExitScale(exitScrollProgress);
          }
          return;
        }

        // 2. SCROLLING DOWN (deltaY > 0): Proportionally shrinks desktop based on scroll delta
        if (e.deltaY > 0) {
          e.preventDefault();
          if (exitSpringAnim) cancelAnimationFrame(exitSpringAnim);

          exitScrollProgress = Math.min(1, exitScrollProgress + e.deltaY / 320);
          applyExitScale(exitScrollProgress);

          if (exitScrollProgress >= 1) {
            exitFullscreen(true);
          }
        }
      },
      { passive: false }
    );

    let touchStartY = 0;
    window.addEventListener(
      "touchstart",
      (e) => {
        if (e.touches && e.touches[0]) {
          touchStartY = e.touches[0].clientY;
        }
      },
      { passive: true }
    );

    window.addEventListener(
      "touchmove",
      (e) => {
        if (!zoomContainer || !zoomContainer.classList.contains("is-fullscreen")) return;
        if (!e.touches || !e.touches[0]) return;

        // If any modal (other than terminal) is open, NEVER trigger exit-on-scroll
        if (isAnyModalOpen()) return;

        const target = e.target as HTMLElement;
        const inTerminal = target.closest("#terminalOutput") as HTMLElement | null;
        if (inTerminal) return;

        // In touch: finger swiping UP (moving down in content) -> deltaY > 0
        const deltaY = touchStartY - e.touches[0].clientY;
        touchStartY = e.touches[0].clientY;

        if (deltaY > 0) {
          // Scrolling down -> shrink desktop proportionally
          exitScrollProgress = Math.min(1, exitScrollProgress + deltaY / 260);
          applyExitScale(exitScrollProgress);
          if (exitScrollProgress >= 1) {
            exitFullscreen(true);
          }
        } else if (deltaY < 0) {
          // Scrolling up -> restore scale towards 1.0, never exit
          if (exitScrollProgress > 0) {
            exitScrollProgress = Math.max(0, exitScrollProgress + deltaY / 260);
            applyExitScale(exitScrollProgress);
          }
        }
      },
      { passive: true }
    );

    // Scroll listener: Displays cron toast at 08:00 AM as user scrolls into sticky runway
    function onScroll() {
      if (!runway) return;
      const rect = runway.getBoundingClientRect();
      const runwayScrollable = rect.height - window.innerHeight;
      if (runwayScrollable <= 0) return;

      const scrolled = -rect.top;
      const progress = Math.min(Math.max(scrolled / runwayScrollable, 0), 1);

      // Reset when scrolling back above runway
      if (scrolled < -100) {
        if (!isAutoPlaying && currentMorph === 0) {
          has8AMHit = false;
          hasTerminalRun = false;
          if (animFrameId) cancelAnimationFrame(animFrameId);
          if (terminalConsole) terminalConsole.classList.remove("is-active");
          if (clockDigits) {
            clockDigits.textContent = "07:59 AM";
            clockDigits.style.color = "#000000";
          }
          if (toastNotification) toastNotification.classList.remove("is-visible");
          if (slackNotification) slackNotification.classList.remove("is-visible");
          if (expandWorkspaceBtn) expandWorkspaceBtn.classList.remove("is-visible");
          if (startWorkflowBtn) {
            startWorkflowBtn.classList.remove("is-running");
            startWorkflowBtn.innerHTML = `<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg><span>Start</span>`;
          }
          applyMorph(0);
        }
        return;
      }

      // Once user scrolls to/into sticky runway: trigger 08:00 AM alarm & toast
      if (progress >= 0.04 && !has8AMHit) {
        has8AMHit = true;
        if (clockDigits) {
          clockDigits.textContent = "08:00 AM";
          clockDigits.style.color = "#16a34a";
        }
        playChime();
        if (toastNotification) toastNotification.classList.add("is-visible");
      }
    }

    // Manual Slider Scrub
    if (scrubSlider) {
      scrubSlider.addEventListener("input", (e) => {
        if (animFrameId) cancelAnimationFrame(animFrameId);
        isAutoPlaying = false;
        const val = Number((e.target as HTMLInputElement).value) / 100;
        applyMorph(val);
      });
    }

    // Auto-Play Button in Test Sandbox
    if (playBtn) {
      playBtn.addEventListener("click", () => {
        has8AMHit = true;
        hasTerminalRun = false;
        isAutoPlaying = false;
        if (terminalConsole) terminalConsole.classList.remove("is-active");
        if (slackNotification) slackNotification.classList.remove("is-visible");
        applyMorph(0);
        setTimeout(startAutoSequence, 50);
      });
    }

    // Reset Button in Test Sandbox
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        has8AMHit = false;
        hasTerminalRun = false;
        isAutoPlaying = false;
        exitFullscreen();
        if (clockDigits) {
          clockDigits.textContent = "07:59 AM";
          clockDigits.style.color = "#000000";
        }
        if (toastNotification) toastNotification.classList.remove("is-visible");
        if (startWorkflowBtn) {
          startWorkflowBtn.classList.remove("is-running");
          startWorkflowBtn.innerHTML = `<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg><span>Start</span>`;
        }
      });
    }

    // Start Workflow Button Click Trigger
    if (startWorkflowBtn) {
      startWorkflowBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        startAutoSequence();
      });
    }

    // Exit Fullscreen Button Trigger
    if (exitFullscreenBtn) {
      exitFullscreenBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        exitFullscreen();
      });
    }

    // Escape Key Listener to exit fullscreen
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (currentMorph > 0.05 || (mcDashboard && mcDashboard.classList.contains("is-open"))) {
          exitFullscreen();
        }
      }
    });

    // Slack Notification actions
    if (closeSlackBtn) {
      closeSlackBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        playClickSound();
        if (slackNotification) slackNotification.classList.remove("is-visible");
      });
    }

    if (slackOpenMissionBtn) {
      slackOpenMissionBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (slackNotification) slackNotification.classList.remove("is-visible");
        openMissionControl();
      });
    }

    // Mission Control Header & Exit triggers
    if (closeMcHeaderBtn) closeMcHeaderBtn.addEventListener("click", closeMissionControl);
    if (exitMcBtn) exitMcBtn.addEventListener("click", closeMissionControl);

    // Job Detail Modal triggers
    if (closeMjModalBtn) closeMjModalBtn.addEventListener("click", closeMissionJobModal);

    if (mjApproveBtn) {
      mjApproveBtn.addEventListener("click", () => {
        if (!currentSelectedJobId) return;
        const job = missionJobsData.find(j => j.id === currentSelectedJobId);
        if (job) {
          closeMissionJobModal();
          triggerApproveRole(job);
        }
      });
    }



    // Rejection Feedback Explainer Modal triggers
    if (closeFbModalBtn) {
      closeFbModalBtn.addEventListener("click", closeFeedbackLoopModal);
    }

    if (cancelFbBtn) {
      cancelFbBtn.addEventListener("click", closeFeedbackLoopModal);
    }

    if (submitFbBtn) {
      submitFbBtn.addEventListener("click", () => {
        playClickSound();
        closeFeedbackLoopModal();
      });
    }

    if (mjRejectBtn) {
      mjRejectBtn.addEventListener("click", () => {
        if (!currentSelectedJobId) return;
        const job = missionJobsData.find(j => j.id === currentSelectedJobId);
        if (job) {
          playClickSound();
          job.decision = "rejected";
          renderMissionJobs();
          closeMissionJobModal();
          openFeedbackLoopModal(job.id);
        }
      });
    }

    // Auto-apply batch dispatch button
    const mcAutoApplyBtn = document.getElementById("mcAutoApplyBtn");
    if (mcAutoApplyBtn) {
      mcAutoApplyBtn.addEventListener("click", () => {
        const approvedCount = missionJobsData.filter(j => j.decision === "approved").length;
        if (approvedCount > 0) {
          playChime();
          mcAutoApplyBtn.innerHTML = `<span>🚀 Dispatched ${approvedCount} tailored roles!</span>`;
          setTimeout(() => {
            if (mcAutoApplyBtn) {
              mcAutoApplyBtn.innerHTML = `<span>⚡ Send Approved to Giles</span>`;
            }
          }, 2500);
        } else {
          playPopSound();
          mcAutoApplyBtn.innerHTML = `<span>⚠️ Approve roles first (click ✓)</span>`;
          setTimeout(() => {
            if (mcAutoApplyBtn) {
              mcAutoApplyBtn.innerHTML = `<span>⚡ Send Approved to Giles</span>`;
            }
          }, 2000);
        }
      });
    }

    // Filter Chips
    const mcFilterChips = document.querySelectorAll(".mc-filter-chip");
    mcFilterChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        playClickSound();
        mcFilterChips.forEach(c => c.classList.remove("is-active"));
        chip.classList.add("is-active");
        currentMcFilter = chip.getAttribute("data-filter") || "all";
        renderMissionJobs();
      });
    });

    if (mjSaveFeedbackBtn) {
      mjSaveFeedbackBtn.addEventListener("click", () => {
        playClickSound();
        mjSaveFeedbackBtn.textContent = "✅ Saved!";
        setTimeout(() => {
          mjSaveFeedbackBtn.textContent = "💾 Save Notes";
        }, 1800);
      });
    }

    // Filter & search events
    if (mcSearchInput) mcSearchInput.addEventListener("input", renderMissionJobs);

    // Toast cron "More ▾" expand button
    const toastMoreBtn = document.getElementById("toastMoreBtn");
    const toastCronExpanded = document.getElementById("toastCronExpanded");
    if (toastMoreBtn && toastCronExpanded) {
      toastMoreBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        playClickSound();
        const isOpen = toastCronExpanded.classList.toggle("is-open");
        toastMoreBtn.innerHTML = isOpen ? "<span>Less ▴</span>" : "<span>More ▾</span>";
      });
    }

    // ----------------------------------------------------
    // CLICK EVENTS & INTERACTIVITY
    // ----------------------------------------------------

    // Explorer Folder Nav Buttons click
    document.querySelectorAll(".explorer-nav-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const folderKey = btn.getAttribute("data-folder");
        if (folderKey && explorerFoldersDB[folderKey]) {
          playClickSound();
          renderExplorerFolder(folderKey);
        }
      });
    });

    // Desktop icons click -> open mission control, explorer, or file info modal
    const desktopFileItems = document.querySelectorAll(".os-icon-item");
    desktopFileItems.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        const key = item.getAttribute("data-file-key");
        if (key === "mission_control_html" || key === "mission_control") {
          openMissionControl();
        } else if (key === "openclaw" || item.id === "desktopFolderBtn") {
          openExplorer();
        } else if (key === "master_cv") {
          openMasterCvModal();
        } else if (key) {
          // Find file in explorer database
          for (const fKey of Object.keys(explorerFoldersDB)) {
            const match = explorerFoldersDB[fKey].files.find((f: any) => f.key === key);
            if (match) {
              openFileInfo(match);
              break;
            }
          }
        }
      });
    });

    // Master CV modal triggers
    if (closeMasterCvBtn) closeMasterCvBtn.addEventListener("click", closeMasterCvModal);
    if (copyMasterCvMarkdownBtn) {
      copyMasterCvMarkdownBtn.addEventListener("click", () => {
        playClickSound();
        const cvMd = `# Olanike Olowo-Fela
Technology Consultant & Full-Stack Automation Developer
Location: London, UK / Remote

## Summary
With a background in consulting, service delivery, and project coordination, alongside technical training in full-stack development, I bridge the gap between engineering and client-facing teams. Naturally process-driven and analytical, I build solutions with both operational realities and business goals in mind, an adaptable approach I've applied across the public, private, and non-profit sectors.

## Core Skills
AI-Assisted Automation, Agentic Workflow Design, OpenClaw, Claude, Node.js, JavaScript, Systems Thinking, Client Delivery.

## Experience
- The Odin Project (2024 - Present): Full-Stack Developer (Training)
- Outer Office (2024 - 2025): Freelance Workflow Consultant
- Highgate Transportation (2023 - 2024): Transport Planner
- Auckland Transport (2021 - 2023): Travel Demand Planner
- Asahi Beverages, Auckland Council & others (2020 - 2023): Temp Administration & Research
- Coster Content Ltd (2018 - 2020): Copywriter

## Education & Certifications
- University of Manchester: Integrated Master's in Geography with International Development
- ICAgile Certified Professional (2022)
- Project Management Institute Training (2022)`;
        navigator.clipboard?.writeText(cvMd).catch(() => {});
        copyMasterCvMarkdownBtn.textContent = "✅ Copied!";
        setTimeout(() => {
          copyMasterCvMarkdownBtn.textContent = "📋 Copy MD";
        }, 2000);
      });
    }

    // Master CV section nav button scrolling (strictly scoped to modal container)
    const masterCvScrollBody = document.getElementById("masterCvScrollBody");
    document.querySelectorAll(".cv-nav-btn[data-target]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        playClickSound();
        const targetId = btn.getAttribute("data-target");
        if (targetId && masterCvScrollBody) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            const topOffset = targetEl.offsetTop - masterCvScrollBody.offsetTop - 10;
            masterCvScrollBody.scrollTo({
              top: Math.max(0, topOffset),
              behavior: "smooth"
            });
          }
        }
      });
    });

    // Expandable cards in Master CV (work experience & education)
    document.querySelectorAll(".mcv-expandable-card").forEach((card) => {
      card.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        // Don't intercept if user clicks a link inside
        if (target.closest("a")) return;
        playClickSound();
        const isOpen = card.classList.toggle("is-expanded");
        const badgeText = card.querySelector(".expand-text");
        if (badgeText) {
          badgeText.textContent = isOpen ? "− close" : "+ details";
        }
      });
    });

    // Master CV footer email button
    const mcvEmailBtn = document.getElementById("mcvEmailBtn");
    if (mcvEmailBtn) {
      mcvEmailBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        playClickSound();
        openEmail();
      });
    }

    // Taskbar & Desktop Explorer triggers
    if (taskbarFilesBtn) {
      taskbarFilesBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        toggleExplorer();
      });
    }
    if (desktopFolderBtn) {
      desktopFolderBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        openExplorer();
      });
    }
    if (closeExplorerBtn) closeExplorerBtn.addEventListener("click", closeExplorer);

    // File Info modal triggers
    const infoBackBtn = document.getElementById("infoBackBtn");
    if (infoBackBtn) {
      infoBackBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        goBackNote();
      });
    }
    if (closeFileInfoBtn) closeFileInfoBtn.addEventListener("click", () => closeFileInfo(true));
    if (dismissFileInfoBtn) dismissFileInfoBtn.addEventListener("click", () => closeFileInfo(true));

    // Master CV Back to Notes trigger
    const masterCvBackBtn = document.getElementById("masterCvBackBtn");
    if (masterCvBackBtn) {
      masterCvBackBtn.addEventListener("click", () => {
        if (masterCvReturnFile) {
          const ret = masterCvReturnFile;
          masterCvReturnFile = null;
          updateMasterCvBackButton();
          closeMasterCvModal();
          openFileInfo(ret);
        }
      });
    }

    // Email modal triggers
    if (taskbarEmailBtn) {
      taskbarEmailBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        toggleEmail();
      });
    }
    if (closeEmailBtn) closeEmailBtn.addEventListener("click", closeEmail);

    if (copyEmailBtn) {
      copyEmailBtn.addEventListener("click", () => {
        playClickSound();
        navigator.clipboard?.writeText("nike.emily.olo@gmail.com").catch(() => {});
        copyEmailBtn.textContent = "✅ Copied!";
        setTimeout(() => {
          copyEmailBtn.textContent = "📋 Copy Email Address";
        }, 2000);
      });
    }

    // Taskbar Terminal toggle
    if (taskbarTerminalBtn) {
      taskbarTerminalBtn.addEventListener("click", () => {
        ensureFullscreenOnInteraction();
        if (terminalConsole) {
          playClickSound();
          if (terminalConsole.classList.contains("is-active")) {
            terminalConsole.classList.remove("is-active");
            taskbarTerminalBtn.classList.remove("is-active-app");
          } else {
            terminalConsole.classList.add("is-active");
            taskbarTerminalBtn.classList.add("is-active-app");
            runHackerTerminal();
          }
        }
      });
    }

    if (closeTermBtn) {
      closeTermBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        playClickSound();
        if (terminalConsole) terminalConsole.classList.remove("is-active");
        if (taskbarTerminalBtn) taskbarTerminalBtn.classList.remove("is-active-app");
      });
    }

    const minimizeTermBtn = document.getElementById("minimizeTermBtn");
    if (minimizeTermBtn) {
      minimizeTermBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        playClickSound();
        if (terminalConsole) terminalConsole.classList.remove("is-active");
        if (taskbarTerminalBtn) taskbarTerminalBtn.classList.remove("is-active-app");
      });
    }

    // Taskbar Slack toggle (only works after Slack has been triggered in the animation)
    if (taskbarSlackBtn) {
      taskbarSlackBtn.addEventListener("click", () => {
        ensureFullscreenOnInteraction();
        if (!hasSlackTriggered) return;
        playClickSound();
        if (slackNotification) {
          slackNotification.classList.toggle("is-visible");
        }
      });
    }

    // Taskbar Windows start & search shortcuts
    const taskbarWinBtn = document.querySelector(".taskbar-win-btn");
    if (taskbarWinBtn) {
      taskbarWinBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        playClickSound();
      });
    }

    const taskbarSearchPill = document.querySelector(".taskbar-search-pill");
    if (taskbarSearchPill) {
      taskbarSearchPill.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        playClickSound();
      });
    }

    const taskbarInternetBtn = document.getElementById("taskbarInternetBtn");
    if (taskbarInternetBtn) {
      taskbarInternetBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        playClickSound();
      });
    }

    const taskbarClock = document.querySelector("[data-os-clock]");
    if (taskbarClock) {
      taskbarClock.addEventListener("click", (e) => {
        e.stopPropagation();
        ensureFullscreenOnInteraction();
        playClickSound();
      });
    }

    // Desktop Wallpaper click
    const desktopWallpaperStage = document.querySelector(".desktop-wallpaper-stage");
    if (desktopWallpaperStage) {
      desktopWallpaperStage.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (
          target.classList.contains("desktop-wallpaper-stage") ||
          target.classList.contains("desktop-icons-col") ||
          target.classList.contains("screen-mockup-body") ||
          target.id === "desktopCanvas"
        ) {
          ensureFullscreenOnInteraction();
        }
      });
    }

    // Global Keyboard listener (Escape exits modal or fullscreen)
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (masterCvModal && masterCvModal.classList.contains("is-open")) {
          closeMasterCvModal();
        } else if (feedbackLoopModal && feedbackLoopModal.classList.contains("is-open")) {
          closeFeedbackLoopModal();
        } else if (missionJobModal && missionJobModal.classList.contains("is-open")) {
          closeMissionJobModal();
        } else if (mcDashboard && mcDashboard.classList.contains("is-open")) {
          closeMissionControl();
        } else if (zoomContainer && zoomContainer.classList.contains("is-fullscreen")) {
          exitFullscreen();
        }
      }
    });

    // Attach Scroll listener for sticky scrollytelling runway
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => applyMorph(currentMorph));
    onScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHowItWorks);
  } else {
    initHowItWorks();
  }
  document.addEventListener("astro:page-load", initHowItWorks);
</script>
