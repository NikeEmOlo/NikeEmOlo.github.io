---
export interface Props {
    imageUrl?: string;
    title?: string;
}

const {
    imageUrl = "/holo-card/automating-unemployment-tarot.webp",
    title = "Automating Unemployment",
} = Astro.props;
---

<!-- EXACT HTML & Structure from https://poke-holo.simey.me/ -->
<div
    class="card interactive masked"
    data-rarity="rare secret"
    data-set="swsh12pt5"
    data-number="160"
    data-poke-holo-card
>
    <div class="card__translater">
        <button class="card__rotator" aria-label={`Expand the Card; ${title}.`} tabindex="0">
            <img
                class="card__back"
                src="/img/card-back-generic.svg"
                alt="Card back"
                loading="lazy"
                width="660"
                height="921"
            />
            <div
                class="card__front"
                style={{
                    "--seedx": "0.14597468026856575",
                    "--seedy": "0.5188117694209767",
                    "--cosmosbg": "107px 664px",
                    "--mask": "url(/img/160_foil_etched_swsecret_mask.webp)",
                    "--foil": "url(/img/160_foil_etched_swsecret_foil.webp)",
                }}
            >
                <img
                    src={imageUrl}
                    alt={title}
                    loading="eager"
                    width="660"
                    height="921"
                />
                <div class="card__shine"></div>
                <div class="card__glare"></div>
            </div>
        </button>
    </div>
</div>

<style is:global>
    @import "/css/poke-holo/base.css";
    @import "/css/poke-holo/cards.css";
    @import "/css/poke-holo/swsh-pikachu.css";

    /* Container sizing & centering */
    .card[data-poke-holo-card] {
        width: clamp(280px, 28vw, 380px);
        margin: 0 auto;
        --card-scale: 1;
    }

    .card__rotator {
        cursor: pointer;
    }
</style>

<script>
    function mountPokeHoloCards() {
        document.querySelectorAll("[data-poke-holo-card]").forEach((cardEl) => {
            const card = cardEl;
            if (card.dataset.pokeMounted) return;
            card.dataset.pokeMounted = "true";

            const rotator = card.querySelector(".card__rotator");
            if (!rotator) return;

            let active = false;
            let interacting = false;

            const updatePointer = (e) => {
                const rect = card.getBoundingClientRect();
                const absolute = {
                    x: e.clientX - rect.left,
                    y: e.clientY - rect.top,
                };
                const percent = {
                    x: Math.round((100 / rect.width) * absolute.x * 100) / 100,
                    y: Math.round((100 / rect.height) * absolute.y * 100) / 100,
                };
                const center = {
                    x: percent.x - 50,
                    y: percent.y - 50,
                };

                card.classList.add("interacting");
                card.style.setProperty("--pointer-x", `${percent.x}%`);
                card.style.setProperty("--pointer-y", `${percent.y}%`);
                card.style.setProperty(
                    "--pointer-from-center",
                    `${Math.min(Math.max(Math.sqrt((center.x / 50) ** 2 + (center.y / 50) ** 2), 0), 1)}`
                );
                card.style.setProperty("--pointer-from-top", `${percent.y / 100}`);
                card.style.setProperty("--pointer-from-left", `${percent.x / 100}`);
                card.style.setProperty("--card-opacity", "1");
                card.style.setProperty("--rotate-x", `${-(center.x / 3.5)}deg`);
                card.style.setProperty("--rotate-y", `${center.y / 3.5}deg`);
                card.style.setProperty("--background-x", `${40 + (percent.x / 5)}%`);
                card.style.setProperty("--background-y", `${40 + (percent.y / 5)}%`);
            };

            card.addEventListener("pointermove", (e) => {
                interacting = true;
                updatePointer(e);
            });

            card.addEventListener("pointerenter", (e) => {
                interacting = true;
                card.classList.add("active");
                updatePointer(e);
            });

            card.addEventListener("pointerleave", () => {
                interacting = false;
                card.classList.remove("interacting");
                card.classList.remove("active");
                card.style.setProperty("--pointer-x", "50%");
                card.style.setProperty("--pointer-y", "50%");
                card.style.setProperty("--pointer-from-center", "0");
                card.style.setProperty("--pointer-from-top", "0.5");
                card.style.setProperty("--pointer-from-left", "0.5");
                card.style.setProperty("--card-opacity", "0");
                card.style.setProperty("--rotate-x", "0deg");
                card.style.setProperty("--rotate-y", "0deg");
            });

            rotator.addEventListener("click", () => {
                active = !active;
                if (active) {
                    card.classList.add("active");
                } else {
                    card.classList.remove("active");
                }
            });
        });
    }

    document.addEventListener("DOMContentLoaded", mountPokeHoloCards);
    document.addEventListener("astro:page-load", mountPokeHoloCards);
</script>
