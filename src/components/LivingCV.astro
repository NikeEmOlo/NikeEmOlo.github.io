  /* Collectible Competency Cards Grid */
  .mcv-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .mcv-cap-card {
    border: 2px solid #000000;
    border-radius: 14px;
    padding: 16px;
    box-shadow: 3.5px 3.5px 0px #000000;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #FFFFFF;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .mcv-cap-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 4.5px 0px #000000;
  }

  .card-pink { background: #FFF0F5; border-top: 6px solid var(--doodle-pink, #FF1F70); }
  .card-cyan { background: #F0FAFF; border-top: 6px solid var(--doodle-cyan, #00B3E3); }
  .card-lime { background: #F8FFE5; border-top: 6px solid var(--doodle-lime, #D1FF00); }
  .card-yellow { background: #FFFDF0; border-top: 6px solid var(--doodle-yellow, #FFDA00); }
  .card-purple { background: #F8F0FF; border-top: 6px solid var(--doodle-purple, #7A00FF); }

  .mcv-cap-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
  }

  .mcv-doodle-art {
    width: 44px;
    height: 34px;
    display: block;
    flex-shrink: 0;
    filter: drop-shadow(1.5px 1.5px 0px #000000);
  }

  .mcv-sticker-tag {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    border: 1.5px solid #000000;
    border-radius: 9999px;
    padding: 2px 7px;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  .mcv-cap-card h3 {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.96rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #000000;
    margin: 0;
  }

  .mcv-cap-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .mcv-cap-card li {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.8rem;
    color: #334155;
    line-height: 1.4;
    position: relative;
    padding-left: 14px;
    font-weight: 600;
  }

  .mcv-cap-card li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: #000000;
    font-size: 0.65rem;
  }

  /* Currently Section */
  .mcv-now-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
  }

  .mcv-now-card {
    border: 2px solid #000000;
    border-radius: 14px;
    padding: 14px 16px;
    box-shadow: 3.5px 3.5px 0px #000000;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .mcv-now-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 4.5px 0px #000000;
  }

  .mcv-now-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mcv-now-beacon {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    border: 1.5px solid #000000;
  }

  .lime-beacon { background: var(--doodle-lime, #D1FF00); box-shadow: 0 0 8px rgba(209, 255, 0, 0.9); }
  .purple-beacon { background: var(--doodle-purple, #7A00FF); box-shadow: 0 0 8px rgba(122, 0, 255, 0.7); }
  .yellow-beacon { background: var(--doodle-yellow, #FFDA00); box-shadow: 0 0 8px rgba(255, 218, 0, 0.9); }
  .pink-beacon { background: var(--doodle-pink, #FF1F70); box-shadow: 0 0 8px rgba(255, 31, 112, 0.8); }

  .mcv-now-title {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.94rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #000000 !important;
    margin: 0;
  }

  .mcv-now-desc {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.82rem;
    color: #334155;
    line-height: 1.45;
    margin: 0;
  }

  /* Certificates */
  .mcv-cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }

  .cert-card {
    background: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 12px;
    padding: 14px 18px;
    box-shadow: 3px 3px 0px #000000;
  }

  .cert-title {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #000000;
    margin: 0 0 3px 0;
  }

  .cert-meta {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    color: #64748B;
    margin: 0;
  }

  /* Footer: Bold Black Ground with Vivid Buttons */
  .mcv-footer {
    background: #000000 !important;
    border: 2.5px solid #000000 !important;
    border-radius: 18px !important;
    padding: 24px 28px !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 20px !important;
    flex-wrap: wrap !important;
    box-shadow: 5px 5px 0px #000000 !important;
    margin-top: 10px;
    color: #FFFFFF !important;
  }

  .mcv-footer-title {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 1.55rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: #FFFFFF !important;
    margin: 0 0 12px 0;
  }

  .mcv-footer-btns-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .mcv-action-btn {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    background: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 7px 16px;
    text-decoration: none;
    box-shadow: 2.5px 2.5px 0px #000000;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
  }

  .mcv-action-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px #000000;
  }

  .mcv-action-btn.email-btn:hover {
    background: var(--doodle-yellow, #FFDA00);
    color: #000000;
  }

  .mcv-action-btn.linkedin-btn:hover {
    background: var(--doodle-cyan, #00B3E3);
    color: #000000;
  }

  /* ---- Live CV, mobile ------------------------------------------------ */
  @media (max-width: 860px) {
    /* Tab row out, one plain select in. No chrome around it — the Download
       CV button is the thing that should carry weight in this bar. */
    .live-cv-topbar .master-cv-nav {
      display: none !important;
    }

    .live-cv-topbar {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 10px !important;
      padding: 12px 14px !important;
      border: none !important;
      box-shadow: none !important;
    }

    .live-cv-top-left {
      width: 100% !important;
    }

    .cv-jump {
      display: block !important;
      position: relative !important;
      width: 100% !important;
    }

    .cv-jump-trigger {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 10px !important;
      width: 100% !important;
      min-height: 44px !important;
      padding: 10px 12px !important;
      font-family: inherit !important;
      font-size: 0.95rem !important;
      font-weight: 700 !important;
      color: #18181b !important;
      background: #ffffff !important;
      border: none !important;
      border-bottom: 2px solid #d4d4d8 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      cursor: pointer !important;
    }

    .cv-jump-chevron {
      transition: transform 0.2s ease !important;
      flex: 0 0 auto !important;
    }

    .cv-jump-trigger[aria-expanded="true"] .cv-jump-chevron {
      transform: rotate(180deg) !important;
    }

    .cv-jump-list {
      position: absolute !important;
      top: calc(100% + 6px) !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 40 !important;
      margin: 0 !important;
      padding: 6px !important;
      list-style: none !important;
      background: #ffffff !important;
      border: 2.5px solid #000000 !important;
      border-radius: 14px !important;
      box-shadow: 3px 4px 0px #000000 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 2px !important;
    }

    .cv-jump-list[hidden] {
      display: none !important;
    }

    .cv-jump-item {
      display: block !important;
      width: 100% !important;
      min-height: 44px !important;
      padding: 10px 12px !important;
      text-align: left !important;
      font-family: inherit !important;
      font-size: 0.95rem !important;
      font-weight: 700 !important;
      color: #18181b !important;
      background: none !important;
      border: none !important;
      border-radius: 9px !important;
      cursor: pointer !important;
    }

    .cv-jump-item:active {
      background: var(--doodle-yellow, #FFDA00) !important;
    }

    .master-cv-top-actions {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      width: 100% !important;
    }

    /* Download is the primary action here; Copy MD steps back to a quiet
       secondary so it stops competing. */
    .live-cv-topbar .cv-download-btn-pill {
      flex: 1 1 auto !important;
      justify-content: center !important;
      min-height: 46px !important;
      font-size: 1rem !important;
      font-weight: 800 !important;
    }

    .live-cv-topbar .cv-tool-btn {
      flex: 0 0 auto !important;
      min-height: 46px !important;
      background: none !important;
      box-shadow: none !important;
      font-weight: 600 !important;
    }

    /* Work experience: the badge sat inline after the company name, so its
       position shifted with every name length. Pin it to the right edge so
       the cards share a column. Same for the "+ details" badge. */
    /* .mcv-tl-left/-right are shrink-to-fit columns with min-widths, so the
       header row only spans its own content and the badge lands wherever the
       company name ends. Force both columns full width first. */
    .mcv-tl-main {
      flex-direction: column !important;
      gap: 10px !important;
    }

    .mcv-tl-left,
    .mcv-tl-right {
      width: 100% !important;
      min-width: 0 !important;
      flex: 0 0 auto !important;
    }

    .mcv-tl-header {
      display: flex !important;
      flex-wrap: nowrap !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 10px !important;
      width: 100% !important;
    }

    .mcv-tl-comp {
      min-width: 0 !important;
    }

    .mcv-badge-sticker {
      flex: 0 0 auto !important;
      margin-left: auto !important;
    }

    /* "+ details" sat beside the role, which broke the reading order and
       added yet another pill to a page full of them. Dissolve the role row
       so role, keywords and the toggle become siblings, then order the
       toggle last — bottom of the card, as plain text. */
    .mcv-tl-right {
      display: flex !important;
      flex-direction: column !important;
    }

    .mcv-tl-role-row {
      display: contents !important;
    }

    .mcv-tl-role { order: 1 !important; }
    .mcv-tl-kw { order: 2 !important; }

    .mcv-tl-right .mcv-expand-toggle-badge {
      order: 3 !important;
      align-self: flex-start !important;
      margin: 8px 0 0 !important;
    }

    /* Plain text, not a pill — work experience only. Education and the other
       expandables keep their badge. */
    .mcv-timeline-item .mcv-expand-toggle-badge {
      background: none !important;
      border: none !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      padding: 0 !important;
      /* No min-height: the whole card is the tap target (role="button"), so
         a 44px box here only hung ~15px of empty space under the underline. */
      min-height: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 5px !important;
      font-size: 0.82rem !important;
      font-weight: 700 !important;
      color: #52525b !important;
      text-decoration: underline !important;
      text-underline-offset: 3px !important;
    }

    /* Key competencies: the code sticker jumped left whenever a card had no
       doodle, because space-between has nothing to push against. Anchoring
       the sticker right keeps every card's header on the same line. */
    .mcv-cap-card-top {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 10px !important;
      min-height: 34px !important;
    }

    .mcv-sticker-tag {
      margin-left: auto !important;
      flex: 0 0 auto !important;
    }

    /* Copy MD is a desktop convenience; nobody is pasting markdown on a
       phone, and it competes with Download CV. */
    .live-cv-topbar .cv-tool-btn {
      display: none !important;
    }

    .master-cv-top-actions .cv-download-btn-pill {
      flex: 1 1 100% !important;
    }

    /* Hero hierarchy: the name owns the full width instead of sharing a row
       with the status pill (which was squeezing it onto three lines). Then
       roles, then the quieter meta. */
    /* Name / job titles / [status + location]. The status pill and the
       location pill live in different wrappers, so both wrappers are
       dissolved with display:contents and the five items are then placed
       explicitly on a 3-row grid. */
    .mcv-hero-section {
      display: grid !important;
      grid-template-columns: max-content auto !important;
      align-items: center !important;
      justify-items: start !important;
      gap: 12px 10px !important;
    }

    .mcv-hero-top-row,
    .mcv-hero-tags {
      display: contents !important;
    }

    .mcv-hero-name {
      grid-column: 1 / -1 !important;
      grid-row: 1 !important;
    }

    .mcv-hero-tags .mcv-tag.tag-cyan {
      grid-column: 1 !important;
      grid-row: 2 !important;
    }

    .mcv-hero-tags .mcv-tag.tag-pink {
      grid-column: 2 / -1 !important;
      grid-row: 2 !important;
    }

    .mcv-hero-status-pill {
      grid-column: 1 !important;
      grid-row: 3 !important;
    }

    .mcv-hero-tags .mcv-tag.tag-white {
      grid-column: 2 / -1 !important;
      grid-row: 3 !important;
    }

    .mcv-hero-name {
      font-size: clamp(2.3rem, 11vw, 3rem) !important;
      line-height: 0.92 !important;
      letter-spacing: -0.055em !important;
    }

    /* Meta, so it steps back from the name it used to sit beside. */
    .mcv-hero-status-pill {
      padding: 4px 10px !important;
      font-size: 0.7rem !important;
      box-shadow: 1.5px 1.5px 0px #000000 !important;
      border-width: 1.8px !important;
    }

    /* Role tags become coloured text; only the location stays a pill. */
    .mcv-hero-tags .mcv-tag.tag-cyan,
    .mcv-hero-tags .mcv-tag.tag-pink {
      background: none !important;
      border: none !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      padding: 0 !important;
      /* Sized so both titles sit on one line at 360px rather than the
         second one wrapping inside its grid column. */
      font-size: 0.86rem !important;
      white-space: nowrap !important;
    }

    .mcv-hero-tags .mcv-tag.tag-cyan {
      color: var(--doodle-cyan, #00B3E3) !important;
    }

    .mcv-hero-tags .mcv-tag.tag-pink {
      color: var(--doodle-pink, #FF1F70) !important;
    }

    .mcv-hero-tags .mcv-tag.tag-white {
      font-size: 0.72rem !important;
      padding: 3px 10px !important;
      border-width: 1.6px !important;
      box-shadow: 1.5px 1.5px 0px #000000 !important;
    }

    /* Skills: flex-wrap fills strictly in source order, so a long pill can
       strand a half-empty line. Tightening the metrics is the part CSS can
       actually do — it fits more per line without reordering the list. */
    .mcv-pills {
      gap: 5px !important;
    }

    .mcv-pill {
      font-size: 0.7rem !important;
      padding: 3px 8px !important;
      box-shadow: 1.5px 1.5px 0px #000000 !important;
      border-width: 1.6px !important;
    }

    /* Footer, matched to the case-study footer: one primary button plus the
       two contact links as icons. */
    .mcv-footer {
      flex-wrap: wrap !important;
      align-items: center !important;
      justify-content: center !important;
      /* The download button plus two 48px icons need 288px; the original
         28px side padding left only 284, so they wrapped onto two rows. */
      gap: 10px !important;
      padding: 20px 12px !important;
    }

    .mcv-footer-left,
    .mcv-footer-right {
      display: contents !important;
    }

    .mcv-footer-title {
      order: 1 !important;
      flex: 0 0 100% !important;
    }

    .mcv-footer-right .cv-download-btn-pill.hero-lg {
      order: 2 !important;
      min-height: 48px !important;
    }

    .mcv-footer-btns-row {
      order: 3 !important;
      display: flex !important;
      gap: 10px !important;
    }

    .mcv-action-btn {
