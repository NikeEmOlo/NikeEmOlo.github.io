---
// LivingCV.astro - Standalone Live Master CV Modal Component
// Verified ground-truth resume & career history matching the Doodle-Pop design standard.
---

<div
  class="live-cv-modal-backdrop"
  id="liveCvModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="liveCvModalTitle"
  aria-hidden="true"
>
  <div class="live-cv-window" id="liveCvWindow" tabindex="-1">
    <!-- OS Window Titlebar -->
    <div class="live-cv-titlebar">
      <div class="live-cv-title-left">
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
          <path d="M 2 1 L 11 1 L 14 4 L 14 15 L 2 15 Z" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
          <path d="M 11 1 L 11 4 L 14 4 Z" fill="#E4E4E7" stroke="#000000" stroke-width="1.2" />
          <line x1="4" y1="7" x2="12" y2="7" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
          <line x1="4" y1="10" x2="10" y2="10" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
        </svg>
        <span class="live-cv-title-text" id="liveCvModalTitle">master_cv.md: Live CV</span>
      </div>
      <div class="live-cv-title-controls">
        <button class="live-cv-close-btn" id="closeLiveCvBtn" type="button" aria-label="Close Live CV modal" title="Close Live CV">✕</button>
      </div>
    </div>

    <!-- Sticky Topbar Navigation & Actions -->
    <header class="live-cv-topbar">
      <div class="live-cv-top-left">
        <span class="mcv-contact-email">nike.emily@pm.me</span>
        <nav class="master-cv-nav" aria-label="Live CV sections">
          <button class="cv-nav-btn" data-target="mcv-about" type="button">About</button>
          <button class="cv-nav-btn" data-target="mcv-experience" type="button">Experience</button>
          <button class="cv-nav-btn" data-target="mcv-competencies" type="button">Competencies</button>
          <button class="cv-nav-btn" data-target="mcv-now" type="button">Currently</button>
          <button class="cv-nav-btn" data-target="mcv-certs" type="button">Certs</button>
        </nav>
      </div>
      <div class="master-cv-top-actions">
        <button class="cv-tool-btn" id="copyLiveCvMarkdownBtn" type="button" title="Copy Markdown to clipboard">
          📋 Copy MD
        </button>
        <a class="cv-download-btn-green" href="/Olanike-Olowo-Fela-CV.pdf" download="Olanike-Olowo-Fela-CV.pdf" id="downloadLiveCvBtn" title="Download Verified CV PDF">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v8m0 0 3-3m-3 3-3-3M3 13h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Download CV</span>
        </a>
      </div>
    </header>

    <!-- Master CV Scrollable Body -->
    <div class="master-cv-body" id="liveCvScrollBody">
      <!-- Hero Section -->
      <section class="mcv-hero-section">
        <h1 class="mcv-hero-name">Olanike<br />Olowo-Fela<span class="mcv-accent-dot">.</span></h1>
        <div class="mcv-hero-tags">
          <span class="mcv-tag highlight">Technology Consultant</span>
          <span class="mcv-tag-sep">/</span>
          <span class="mcv-tag highlight">Full-Stack Developer</span>
          <span class="mcv-tag-sep">·</span>
          <span class="mcv-tag">London, UK</span>
        </div>
      </section>

      <!-- Section 1: About & Education / Skills -->
      <section class="mcv-section" id="mcv-about">
        <div class="mcv-grid-2">
          <div class="mcv-col">
            <h2 class="mcv-heading">about</h2>
            <p class="mcv-p">
              With a background in consulting, service delivery, and project coordination, alongside technical training in full-stack development, I bridge the gap between engineering and client-facing teams.
            </p>
            <p class="mcv-p">
              Naturally process-driven and analytical, I build solutions with both operational realities and business goals in mind, an adaptable approach I've applied across the public, private, and non-profit sectors.
            </p>
          </div>
          <div class="mcv-col">
            <h2 class="mcv-heading">edu.</h2>
            <div class="mcv-edu-plain mcv-expandable-card" id="liveCvEduItem" title="Click to view degree focus & modules" tabindex="0" role="button" aria-expanded="false">
              <div class="mcv-edu-header">
                <div class="mcv-edu-titles">
                  <p class="mcv-edu-degree">Integrated Master's in Geography with International Development</p>
                  <p class="mcv-edu-school">University of Manchester</p>
                </div>
                <span class="mcv-expand-toggle-badge" aria-hidden="true">
                  <span class="expand-text">+ details</span>
                  <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </div>

              <div class="mcv-item-details">
                <div class="mcv-item-details-inner">
                  <div class="mcv-edu-detail-block">
                    <strong class="mcv-edu-branch-title">MSc International Development:</strong>
                    <p class="mcv-edu-desc">
                      Focused on analysing complex, interconnected systems involving institutions, policy, technology, and global economics. Developed strengths in systems analysis, structured research, technical writing, and project-based collaboration.
                    </p>
                  </div>
                  <div class="mcv-edu-detail-block">
                    <strong class="mcv-edu-branch-title">BA Geography:</strong>
                    <p class="mcv-edu-desc">
                      Focused on understanding how social, economic, and environmental systems interact at local and global scales. Gained practical skills in research, data analysis, policy analysis, and problem-solving.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <h2 class="mcv-heading" style="margin-top: 16px;">skills</h2>
            <div class="mcv-pills">
              <span class="mcv-pill pop-yellow">AI-Assisted Automation</span>
              <span class="mcv-pill pop-purple">Agentic Workflow Design</span>
              <span class="mcv-pill pop-cyan">API Integration</span>
              <span class="mcv-pill pop-lime">Process Design</span>
              <span class="mcv-pill pop-pink">Systems Thinking</span>
              <span class="mcv-pill">HTML / CSS / JavaScript</span>
              <span class="mcv-pill">Node.js</span>
              <span class="mcv-pill pop-cyan">Client Delivery & Coordination</span>
              <span class="mcv-pill pop-yellow">Workshop Facilitation</span>
              <span class="mcv-pill pop-lime">Stakeholder Translation</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Work Experience (Expandable Timeline Items) -->
      <section class="mcv-section" id="mcv-experience">
        <h2 class="mcv-heading">work experience</h2>
        <div class="mcv-timeline">
          <!-- 1. The Odin Project -->
          <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements" tabindex="0" role="button" aria-expanded="false">
            <div class="mcv-tl-main">
              <div class="mcv-tl-left">
                <div class="mcv-tl-header">
                  <strong class="mcv-tl-comp">The Odin Project</strong>
                  <span class="mcv-badge-sticker pop-lime">Training</span>
                </div>
                <span class="mcv-tl-loc">Remote · 2024 - Present</span>
              </div>
              <div class="mcv-tl-right">
                <div class="mcv-tl-role-row">
                  <strong class="mcv-tl-role">Full-Stack Developer (Training)</strong>
                  <span class="mcv-expand-toggle-badge" aria-hidden="true">
                    <span class="expand-text">+ details</span>
                    <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </div>
                <span class="mcv-tl-kw">HTML, CSS, JavaScript, Node.js, Data Structures & Algorithms, SOLID Principles</span>
              </div>
            </div>

            <div class="mcv-item-details">
              <div class="mcv-item-details-inner">
                <p class="mcv-tl-overview">An open-source, project-based full-stack web development curriculum.</p>
                <ul class="mcv-tl-bullets">
                  <li>Designed and deployed a multi-agent, agentic AI workflow using OpenClaw and Claude to automate the job-search process, reducing time spent by 83%.</li>
                  <li>Completing full-stack curriculum covering fundamental computer science, data structures and algorithms, SOLID principles, and debugging in HTML, CSS, and JS.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 2. Outer Office -->
          <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements" tabindex="0" role="button" aria-expanded="false">
            <div class="mcv-tl-main">
              <div class="mcv-tl-left">
                <div class="mcv-tl-header">
                  <strong class="mcv-tl-comp">Outer Office</strong>
                  <span class="mcv-badge-sticker pop-yellow">Freelance</span>
                </div>
                <span class="mcv-tl-loc">Freelance · 2024 - 2025</span>
              </div>
              <div class="mcv-tl-right">
                <div class="mcv-tl-role-row">
                  <strong class="mcv-tl-role">Freelance Workflow Consultant</strong>
                  <span class="mcv-expand-toggle-badge" aria-hidden="true">
                    <span class="expand-text">+ details</span>
                    <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </div>
                <span class="mcv-tl-kw">Workflow Automation, Microsoft Graph, Google Workspace APIs, OpenAI</span>
              </div>
            </div>

            <div class="mcv-item-details">
              <div class="mcv-item-details-inner">
                <ul class="mcv-tl-bullets">
                  <li>Delivered freelance workflow optimisation and automation for a small-business client, identifying manual processes and designing tailored solutions.</li>
                  <li>Built an AI-powered email management tool using Microsoft Graph, Google Workspace APIs, and OpenAI. Built with AI-assisted development, which exposed the limits of working without deeper technical understanding and led directly to formal full-stack training.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 3. Highgate Transportation -->
          <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements" tabindex="0" role="button" aria-expanded="false">
            <div class="mcv-tl-main">
              <div class="mcv-tl-left">
                <div class="mcv-tl-header">
                  <strong class="mcv-tl-comp">Highgate Transportation</strong>
                  <span class="mcv-badge-sticker pop-cyan">Consultancy</span>
                </div>
                <span class="mcv-tl-loc">Bristol, UK · 2023 - 2024</span>
              </div>
              <div class="mcv-tl-right">
                <div class="mcv-tl-role-row">
                  <strong class="mcv-tl-role">Transport Planner</strong>
                  <span class="mcv-expand-toggle-badge" aria-hidden="true">
                    <span class="expand-text">+ details</span>
                    <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </div>
                <span class="mcv-tl-kw">Client Reporting, Regulatory Compliance, Transport Planning Research</span>
              </div>
            </div>

            <div class="mcv-item-details">
              <div class="mcv-item-details-inner">
                <p class="mcv-tl-overview">Highgate Transportation, Bristol, UK - Transport consultancy.</p>
                <ul class="mcv-tl-bullets">
                  <li>Produced client-facing reports, and conducted research to support transport planning proposals, recommendations, and regulatory compliance.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 4. Auckland Transport -->
          <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements" tabindex="0" role="button" aria-expanded="false">
            <div class="mcv-tl-main">
              <div class="mcv-tl-left">
                <div class="mcv-tl-header">
                  <strong class="mcv-tl-comp">Auckland Transport</strong>
                  <span class="mcv-badge-sticker pop-purple">Public Organisation</span>
                </div>
                <span class="mcv-tl-loc">Auckland, NZ · 2021 - 2023</span>
              </div>
              <div class="mcv-tl-right">
                <div class="mcv-tl-role-row">
                  <strong class="mcv-tl-role">Travel Demand Planner</strong>
                  <span class="mcv-expand-toggle-badge" aria-hidden="true">
                    <span class="expand-text">+ details</span>
                    <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </div>
                <span class="mcv-tl-kw">20+ Client Organisations, Pilot Programmes, Stakeholder Workshops, KPI Reporting</span>
              </div>
            </div>

            <div class="mcv-item-details">
              <div class="mcv-item-details-inner">
                <p class="mcv-tl-overview">Auckland Transport, Auckland, NZ - Public sector transport authority.</p>
                <ul class="mcv-tl-bullets">
                  <li>Managed a portfolio of 20+ client organisations through onboarding, engagement, and delivery milestones as primary point of contact, delivering workshops and training to drive user adoption and behavioural change.</li>
                  <li>Designed and delivered a six-month pilot of a new mobile application, covering planning, user recruitment, training, engagement tracking, and feedback collection.</li>
                  <li>Led nationwide campaign delivery, coordinating with councils and stakeholders to restore participation levels following COVID-19 disruption.</li>
                  <li>Monitored engagement and performance using data, KPIs, and qualitative feedback, producing clear reports and guidance for internal and external stakeholders.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 5. Asahi, Auckland Council & others -->
          <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements" tabindex="0" role="button" aria-expanded="false">
            <div class="mcv-tl-main">
              <div class="mcv-tl-left">
                <div class="mcv-tl-header">
                  <strong class="mcv-tl-comp">Asahi, Auckland Council & others</strong>
                  <span class="mcv-badge-sticker pop-pink">Cross-Sector</span>
                </div>
                <span class="mcv-tl-loc">Auckland, NZ · 2020 - 2023</span>
              </div>
              <div class="mcv-tl-right">
                <div class="mcv-tl-role-row">
                  <strong class="mcv-tl-role">Temp Administration, Research & Hospitality</strong>
                  <span class="mcv-expand-toggle-badge" aria-hidden="true">
                    <span class="expand-text">+ details</span>
                    <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </div>
                <span class="mcv-tl-kw">Cross-Industry Temp Roles, Process Auditing</span>
              </div>
            </div>

            <div class="mcv-item-details">
              <div class="mcv-item-details-inner">
                <p class="mcv-tl-overview">Asahi Beverages, Auckland Council, IFM Electrical, Coreiss, and others.</p>
                <ul class="mcv-tl-bullets">
                  <li>Delivered agile administration, compliance auditing, operational data entry, and research assistance across fast-paced corporate and public sector environments.</li>
                  <li>Streamlined operational coordination and stakeholder communications across diverse client accounts.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 6. Coster Content Ltd -->
          <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements" tabindex="0" role="button" aria-expanded="false">
            <div class="mcv-tl-main">
              <div class="mcv-tl-left">
                <div class="mcv-tl-header">
                  <strong class="mcv-tl-comp">Coster Content Ltd</strong>
                  <span class="mcv-badge-sticker pop-pink">Agency</span>
                </div>
                <span class="mcv-tl-loc">Manchester, UK · 2018 - 2020</span>
              </div>
              <div class="mcv-tl-right">
                <div class="mcv-tl-role-row">
                  <strong class="mcv-tl-role">Copywriter</strong>
                  <span class="mcv-expand-toggle-badge" aria-hidden="true">
                    <span class="expand-text">+ details</span>
                    <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </div>
                <span class="mcv-tl-kw">Marketing Agency Copywriting, Value Proposition Synthesis</span>
              </div>
            </div>

            <div class="mcv-item-details">
              <div class="mcv-item-details-inner">
                <p class="mcv-tl-overview">Coster Content Ltd, Manchester, UK - Marketing copy agency.</p>
                <ul class="mcv-tl-bullets">
                  <li>Produced high-converting B2B copywriting, marketing collateral, and strategic value propositions for agency clients across diverse sectors.</li>
                  <li>Synthesized complex service architectures and business requirements into clear, compelling narratives.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Key Competencies (Streetwear Doodle-Pop Cards) -->
      <section class="mcv-section" id="mcv-competencies">
        <h2 class="mcv-heading">key competencies</h2>
        <div class="mcv-cards-grid">
          <!-- AI & Automation -->
          <div class="mcv-cap-card card-yellow">
            <div class="mcv-cap-card-top">
              <svg class="mcv-doodle-art" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                <path d="M4 10L7 12" stroke="#000000" stroke-width="2" stroke-linecap="round" />
                <path d="M36 8L33 11" stroke="#000000" stroke-width="2" stroke-linecap="round" />
                <path d="M34 22L37 24" stroke="#000000" stroke-width="2" stroke-linecap="round" />
