---
// LivingCV.astro - Standalone Live Master CV Modal Component
// Driven by src/content/cv/master_cv.md and styled in the Streetwear Doodle-Pop standard.
import { getEntry } from "astro:content";

interface Props {
  title?: string;
  statusText?: string;
  tags?: Array<{ text: string; color?: string }>;
  downloadLabel?: string;
  showStatusPulse?: boolean;
}

const {
  title = "master_cv.md",
  statusText = "Open to work",
  tags = [
    { text: "Full-Stack Developer", color: "cyan" },
    { text: "Workflow Automation", color: "pink" },
    { text: "London, UK / Remote", color: "white" },
  ],
  downloadLabel = "Download CV",
  showStatusPulse = true,
} = Astro.props;

const cvEntry = await getEntry("cv", "master_cv");
if (!cvEntry) {
  throw new Error("Missing master_cv.md entry in src/content/cv/");
}
const cv = cvEntry.data;

// Generate markdown clipboard string dynamically from ground-truth data
const cvMdString = `# ${cv.name}
${tags.map(t => t.text).join(" · ")}
Location: London, UK / Remote
Email: ${cv.email} | LinkedIn: ${cv.linkedin}

## Summary
${cv.about.join("\n\n")}

## Core Skills
${cv.skills.map(s => s.name).join(", ")}

## Experience
${cv.experience.map(e => `- ${e.company} (${e.location}): ${e.role}\n  ${e.keywords}\n${e.bullets.map(b => `  * ${b}`).join("\n")}`).join("\n\n")}

## Education
- ${cv.education.school}: ${cv.education.degree}

## Key Competencies
${cv.competencies.map(c => `- ${c.title}:\n${c.items.map(i => `  * ${i}`).join("\n")}`).join("\n")}

## Certificates
${cv.certificates.map(c => `- ${c.title} (${c.meta})`).join("\n")}`;
---

<div
  class="live-cv-modal-backdrop"
  id="liveCvModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="liveCvModalTitle"
  aria-hidden="true"
>
  <div class="live-cv-window" id="liveCvWindow" tabindex="-1">
    <!-- Streetwear Doodle-Pop Titlebar -->
    <div class="live-cv-titlebar">
      <div class="live-cv-title-left">
        <span class="live-cv-doc-badge">LIVE CV</span>
        <span class="live-cv-title-text" id="liveCvModalTitle">{title}<span class="mcv-dot-pink">.</span></span>
      </div>
      <div class="live-cv-title-controls">
        <button class="live-cv-close-btn" id="closeLiveCvBtn" type="button" aria-label="Close Live CV modal" title="Close Live CV">✕</button>
      </div>
    </div>

    <!-- Sticky Topbar Navigation & Quick Actions -->
    <header class="live-cv-topbar">
      <div class="live-cv-top-left">
        <nav class="master-cv-nav" aria-label="Live CV sections">
          <button class="cv-nav-btn nav-btn-about" data-target="mcv-about" type="button">About</button>
          <button class="cv-nav-btn nav-btn-exp" data-target="mcv-experience" type="button">Experience</button>
          <button class="cv-nav-btn nav-btn-comp" data-target="mcv-competencies" type="button">Competencies</button>
          <button class="cv-nav-btn nav-btn-now" data-target="mcv-now" type="button">Currently</button>
          <button class="cv-nav-btn nav-btn-certs" data-target="mcv-certs" type="button">Certs</button>
        </nav>
      </div>
      <div class="master-cv-top-actions">
        <button class="cv-tool-btn" id="copyLiveCvMarkdownBtn" type="button" title="Copy Markdown to clipboard" data-cv-md={cvMdString}>
          <svg class="btn-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span>Copy MD</span>
        </button>
        <a class="cv-download-btn-pill" href={cv.pdfPath} download="Olanike-Olowo-Fela-CV.pdf" id="downloadLiveCvBtn" title="Download CV PDF">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{downloadLabel}</span>
        </a>
      </div>
    </header>

    <!-- Master CV Scrollable Body -->
    <div class="master-cv-body" id="liveCvScrollBody">
      <!-- Hero Section -->
      <section class="mcv-hero-section">
        <div class="mcv-hero-top-row">
          <h1 class="mcv-hero-name">Olanike<br />Olowo-Fela<span class="mcv-accent-dot">.</span></h1>
          {statusText && (
            <div class="mcv-hero-status-pill">
              {showStatusPulse && <span class="status-pulse-dot"></span>}
              <span class="status-text">{statusText}</span>
            </div>
          )}
        </div>
        {tags && tags.length > 0 && (
          <div class="mcv-hero-tags">
            {tags.map((tag) => (
              <span class={`mcv-tag tag-${tag.color || "white"}`}>{tag.text}</span>
            ))}
          </div>
        )}
      </section>

      <!-- Section 1: About & Education / Skills -->
      <section class="mcv-section" id="mcv-about">
        <div class="mcv-grid-2">
          <div class="mcv-col">
            <h2 class="mcv-heading">about</h2>
            <div class="mcv-about-card">
              {cv.about.map((p) => (
                <p class="mcv-p">{p}</p>
              ))}
            </div>
          </div>
          <div class="mcv-col">
            <h2 class="mcv-heading">edu.</h2>
            <div class="mcv-edu-plain mcv-expandable-card" id="liveCvEduItem" title="Click to view degree focus & modules" tabindex="0" role="button" aria-expanded="false">
              <div class="mcv-edu-header">
                <div class="mcv-edu-titles">
                  <p class="mcv-edu-degree">{cv.education.degree}</p>
                  <p class="mcv-edu-school">{cv.education.school}</p>
                </div>
                <span class="mcv-expand-toggle-badge" aria-hidden="true">
                  <span class="expand-text">+ details</span>
                  <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </div>

              <div class="mcv-item-details">
                <div class="mcv-item-details-inner">
                  {cv.education.details.map((detail) => (
                    <div class="mcv-edu-detail-block">
                      <strong class="mcv-edu-branch-title">{detail.title}</strong>
                      <p class="mcv-edu-desc">{detail.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <h2 class="mcv-heading" style="margin-top: 16px;">skills</h2>
            <div class="mcv-pills">
              {cv.skills.map((skill) => (
                <span class={`mcv-pill ${skill.color ? `pop-${skill.color}` : ""}`}>{skill.name}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Work Experience (Expandable Timeline Items) -->
      <section class="mcv-section" id="mcv-experience">
        <h2 class="mcv-heading">work experience</h2>
        <div class="mcv-timeline">
          {cv.experience.map((item) => (
            <div class="mcv-timeline-item mcv-expandable-card" title="Click to view role responsibilities & achievements" tabindex="0" role="button" aria-expanded="false">
              <div class="mcv-tl-main">
                <div class="mcv-tl-left">
                  <div class="mcv-tl-header">
                    <strong class="mcv-tl-comp">{item.company}</strong>
                    <span class={`mcv-badge-sticker pop-${item.badgeColor}`}>{item.badge}</span>
                  </div>
                  <span class="mcv-tl-loc">{item.location}</span>
                </div>
                <div class="mcv-tl-right">
                  <div class="mcv-tl-role-row">
                    <strong class="mcv-tl-role">{item.role}</strong>
                    <span class="mcv-expand-toggle-badge" aria-hidden="true">
                      <span class="expand-text">+ details</span>
                      <svg class="expand-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </span>
                  </div>
                  <span class="mcv-tl-kw">{item.keywords}</span>
                </div>
              </div>

              <div class="mcv-item-details">
                <div class="mcv-item-details-inner">
                  {item.overview && <p class="mcv-tl-overview">{item.overview}</p>}
                  <ul class="mcv-tl-bullets">
                    {item.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 3: Key Competencies (Streetwear Doodle-Pop Cards) -->
      <section class="mcv-section" id="mcv-competencies">
        <h2 class="mcv-heading">key competencies</h2>
        <div class="mcv-cards-grid">
          {cv.competencies.map((comp) => (
            <div class={`mcv-cap-card card-${comp.color}`}>
              <div class="mcv-cap-card-top">
                {comp.code === "AI_CORE" && (
                  <svg class="mcv-doodle-art" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                    <path d="M4 10L7 12" stroke="#000000" stroke-width="2" stroke-linecap="round" />
                    <path d="M36 8L33 11" stroke="#000000" stroke-width="2" stroke-linecap="round" />
                    <path d="M34 22L37 24" stroke="#000000" stroke-width="2" stroke-linecap="round" />
                    <path d="M23 2L9 17H19L14 30L29 13H19L23 2Z" fill="#FFDA00" stroke="#000000" stroke-width="2.5" stroke-linejoin="round" />
                    <path d="M21 5L12 15H18L15 23" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                )}
                {comp.code === "SYS_ARCH" && (
                  <svg class="mcv-doodle-art" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                    <path d="M16 6L18 6L18.5 8.5L20.5 9.5L23 8L24.5 9.5L23 12L24 14L26.5 14.5L26.5 16.5L24 17L23 19L24.5 21.5L23 23L20.5 21.5L18.5 22.5L18 25L16 25L15.5 22.5L13.5 21.5L11 23L9.5 21.5L11 19L10 17L7.5 16.5L7.5 14.5L10 14L11 12L9.5 9.5L11 8L13.5 9.5L15.5 8.5L16 6Z" fill="#00B3E3" stroke="#000000" stroke-width="2.2" stroke-linejoin="round" />
                    <circle cx="17" cy="15.5" r="3.5" fill="#FFFFFF" stroke="#000000" stroke-width="1.8" />
                    <path d="M28 8C33 11 34 18 30 23" stroke="#000000" stroke-width="2.2" stroke-linecap="round" fill="none" />
                    <path d="M33 23L29 23L31 19" fill="#D1FF00" stroke="#000000" stroke-width="2" stroke-linejoin="round" />
                    <path d="M5 6L6 8L8 9L6 10L5 12L4 10L2 9L4 8Z" fill="#FF1F70" stroke="#000000" stroke-width="1" />
                  </svg>
                )}
                {comp.code === "CODE_STACK" && (
                  <svg class="mcv-doodle-art" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                    <rect x="6" y="6" width="28" height="20" rx="5" fill="#7A00FF" stroke="#000000" stroke-width="2.5" />
                    <rect x="9" y="9" width="10" height="3" rx="1.5" fill="#FFFFFF" opacity="0.8" />
                    <path d="M14 13L11 16L14 19" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M26 13L29 16L26 19" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="19" cy="16" r="1.8" fill="#D1FF00" stroke="#000000" stroke-width="1.2" />
                    <circle cx="22" cy="16" r="1.8" fill="#FF1F70" stroke="#000000" stroke-width="1.2" />
                    <path d="M12 6L9 2" stroke="#000000" stroke-width="2" stroke-linecap="round" />
                    <circle cx="8" cy="2" r="1.5" fill="#D1FF00" stroke="#000000" stroke-width="1" />
                  </svg>
                )}
                {comp.code === "CLIENT_OPS" && (
                  <svg class="mcv-doodle-art" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                    <path d="M6 6H30C32.2 6 34 7.8 34 10V20C34 22.2 32.2 24 30 24H16L10 29V24H6C3.8 24 2 22.2 2 20V10C2 7.8 3.8 6 6 6Z" fill="#FF1F70" stroke="#000000" stroke-width="2.5" stroke-linejoin="round" />
                    <path d="M6 9H18" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                    <circle cx="10" cy="15" r="1.5" fill="#FFFFFF" />
                    <circle cx="16" cy="15" r="1.5" fill="#FFFFFF" />
                    <circle cx="22" cy="15" r="1.5" fill="#FFFFFF" />
                    <path d="M34 5L35 7L37 8L35 9L34 11L33 9L31 8L33 7Z" fill="#FFDA00" stroke="#000000" stroke-width="1.2" />
                  </svg>
                )}
                {comp.code === "AGILE_PM" && (
                  <svg class="mcv-doodle-art" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                    <circle cx="18" cy="16" r="11" fill="#D1FF00" stroke="#000000" stroke-width="2.5" />
                    <circle cx="18" cy="16" r="7" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
                    <circle cx="18" cy="16" r="3" fill="#FF1F70" stroke="#000000" stroke-width="1.8" />
                    <path d="M36 4L19 15" stroke="#000000" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M33 3L37 3L37 7" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M22 11L25 9" stroke="#FFDA00" stroke-width="2" stroke-linecap="round" />
                    <path d="M14 21L12 24" stroke="#FFDA00" stroke-width="2" stroke-linecap="round" />
                  </svg>
                )}
                {comp.code === "TOOLING" && (
                  <svg class="mcv-doodle-art" viewBox="0 0 40 32" fill="none" aria-hidden="true">
                    <path d="M5 8C5 6.9 5.9 6 7 6H15L18 9H31C32.1 9 33 9.9 33 11V23C33 24.1 32.1 25 31 25H7C5.9 25 5 24.1 5 23V8Z" fill="#00B3E3" stroke="#000000" stroke-width="2.5" stroke-linejoin="round" />
                    <path d="M9 12H21" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                    <rect x="12" y="14" width="14" height="7" rx="2" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
                    <line x1="15" y1="17" x2="23" y2="17" stroke="#000000" stroke-width="1.2" stroke-linecap="round" />
                    <path d="M33 5L34 7L36 8L34 9L33 11L32 9L30 8L32 7Z" fill="#FFDA00" stroke="#000000" stroke-width="1.2" />
                  </svg>
                )}
                <span class={`mcv-sticker-tag pop-${comp.color}`}>{comp.code}</span>
              </div>
              <h3>{comp.title}</h3>
              <ul>
                {comp.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Currently (Dedicated High-Impact Active Grid) -->
      <section class="mcv-section" id="mcv-now">
        <h2 class="mcv-heading">currently</h2>
        <div class="mcv-now-grid">
          {cv.currently.map((item) => (
            <div class={`mcv-now-card card-${item.color}`}>
              <div class="mcv-now-header">
                <span class={`mcv-now-beacon ${item.color}-beacon`} aria-hidden="true"></span>
                <span class={`mcv-sticker-tag pop-${item.color}`}>{item.tag}</span>
              </div>
              <h4 class="mcv-now-title">{item.title}</h4>
              <p class="mcv-now-desc">{item.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 5: Certificates -->
      <section class="mcv-section" id="mcv-certs">
        <h2 class="mcv-heading">certificates</h2>
        <div class="mcv-cert-grid">
          {cv.certificates.map((cert) => (
            <div class={`mcv-card cert-card card-${cert.color}`}>
              <h3 class="cert-title">{cert.title}</h3>
              <p class="cert-meta">{cert.meta}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 6: Connect & Prominent Download Footer -->
      <footer class="mcv-footer">
        <div class="mcv-footer-left">
          <h2 class="mcv-footer-title">Let's speed things up<span class="mcv-accent-dot">.</span></h2>
          <div class="mcv-footer-btns-row">
            <a href={`mailto:${cv.email}`} class="mcv-action-btn email-btn" id="liveCvEmailBtn" title="Send email to Nike">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>Email me</span>
            </a>
            <a href={cv.linkedin} target="_blank" rel="noopener noreferrer" class="mcv-action-btn linkedin-btn" title="View LinkedIn Profile">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z"/>
              </svg>
              <span>LinkedIn ↗</span>
            </a>
          </div>
        </div>

        <div class="mcv-footer-right">
          <a class="cv-download-btn-pill hero-lg" href={cv.pdfPath} download="Olanike-Olowo-Fela-CV.pdf" title="Download CV PDF">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{downloadLabel}</span>
          </a>
        </div>
      </footer>
    </div>
  </div>
</div>

<script>
  function initLiveCvModal() {
    const modal = document.getElementById("liveCvModal");
    if (!modal) return;
    if (modal.dataset.initialized === "true") return;
    modal.dataset.initialized = "true";

    const cvWindow = document.getElementById("liveCvWindow");
    const closeBtn = document.getElementById("closeLiveCvBtn");
    const copyBtn = document.getElementById("copyLiveCvMarkdownBtn");
    const scrollBody = document.getElementById("liveCvScrollBody");

    let previousActiveElement = null;

    function openModal() {
      previousActiveElement = document.activeElement;
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      cvWindow?.focus();
    }

    function closeModal() {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (previousActiveElement instanceof HTMLElement) {
        previousActiveElement.focus();
      }
    }

    // Attach to triggers across the page
    document.querySelectorAll("#open-living-cv, [data-open-cv]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });
    });

    window.addEventListener("open-living-cv", openModal);

    // Close button
    closeBtn?.addEventListener("click", closeModal);

    // Backdrop click
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("is-open")) {
        closeModal();
      }
    });

    // Copy Markdown dynamically from data attribute
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        const cvMd = copyBtn.getAttribute("data-cv-md") || "";
        navigator.clipboard?.writeText(cvMd).catch(() => {});
        const span = copyBtn.querySelector("span");
        if (span) {
          const oldText = span.textContent;
          span.textContent = "Copied! ✓";
          copyBtn.classList.add("is-copied");
          setTimeout(() => {
            span.textContent = oldText;
            copyBtn.classList.remove("is-copied");
          }, 2000);
        }
      });
    }

    // Nav button smooth scrolling
    modal.querySelectorAll(".cv-nav-btn[data-target]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = btn.getAttribute("data-target");
        if (targetId && scrollBody) {
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            const topOffset = targetEl.offsetTop - scrollBody.offsetTop - 12;
            scrollBody.scrollTo({
              top: Math.max(0, topOffset),
              behavior: "smooth",
            });
          }
        }
      });
    });

    // Expandable cards in Master CV (work experience & education)
    modal.querySelectorAll(".mcv-expandable-card").forEach((card) => {
      const toggleCard = (e) => {
        const target = e.target;
        if (target && target.closest && target.closest("a")) return;
        const isOpen = card.classList.toggle("is-expanded");
        card.setAttribute("aria-expanded", String(isOpen));
        const badgeText = card.querySelector(".expand-text");
        if (badgeText) {
          badgeText.textContent = isOpen ? "− close" : "+ details";
        }
      };

      card.addEventListener("click", toggleCard);
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggleCard(e);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initLiveCvModal);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLiveCvModal);
  } else {
    initLiveCvModal();
  }
</script>

<style>
  /* ══════════════════════════════════════════════════════════════
     STANDALONE STREETWEAR DOODLE-POP LIVE CV MODAL (NAVBAR TRIGGER)
     ══════════════════════════════════════════════════════════════ */

  /* Backdrop Overlay */
  .live-cv-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(12px, 3vh, 32px) clamp(12px, 3vw, 24px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .live-cv-modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Main Modal Window: Bold Black Vector Outlines & Cel-Shaded Offset Drop Shadow */
  .live-cv-window {
    width: min(920px, 96vw);
    max-width: 920px;
    max-height: 92vh;
    background: #FFFFFF;
    border: 3px solid #000000;
    border-radius: 20px;
    box-shadow: 7px 7px 0px #000000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95) translateY(14px);
    transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
    outline: none;
    box-sizing: border-box;
  }

  .live-cv-modal-backdrop.is-open .live-cv-window {
    transform: scale(1) translateY(0);
  }

  /* Titlebar: Bold Black Bar with Vivid Mascot Details */
  .live-cv-titlebar {
    background: #000000;
    color: #FFFFFF;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2.5px solid #000000;
    user-select: none;
  }

  .live-cv-title-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .live-cv-doc-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    background: var(--doodle-lime, #D1FF00);
    color: #000000;
    border: 1.5px solid #000000;
    padding: 2px 8px;
    border-radius: 9999px;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  .live-cv-title-text {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #FFFFFF;
  }

  .mcv-dot-pink {
    color: var(--doodle-pink, #FF1F70);
  }

  .live-cv-title-controls {
    display: flex;
    align-items: center;
  }

  /* Close Button: Circular Tactile Pill with Pink Hover */
  .live-cv-close-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid #000000;
    background: #FFFFFF;
    color: #000000;
    font-size: 0.85rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .live-cv-close-btn:hover {
    background: var(--doodle-pink, #FF1F70);
    color: #FFFFFF;
    transform: translate(-1px, -1px) rotate(90deg);
    box-shadow: 3px 3px 0px #000000;
  }

  .live-cv-close-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 0px 0px 0px #000000;
  }

  /* Sticky Topbar: Warm Cream Ground with Tactile Pills */
  .live-cv-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 22px;
    background: var(--cream, #F7F8F9);
    border-bottom: 2.5px solid #000000;
    gap: 12px;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .live-cv-top-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .master-cv-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .cv-nav-btn {
    background: #FFFFFF;
    border: 1.8px solid #000000;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0F172A;
    padding: 4px 11px;
    border-radius: 9999px;
    box-shadow: 1.5px 1.5px 0px #000000;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .cv-nav-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0px #000000;
  }

  .cv-nav-btn.nav-btn-about:hover { background: var(--doodle-yellow, #FFDA00); color: #000000; }
  .cv-nav-btn.nav-btn-exp:hover { background: var(--doodle-cyan, #00B3E3); color: #000000; }
  .cv-nav-btn.nav-btn-comp:hover { background: var(--doodle-purple, #7A00FF); color: #FFFFFF; }
  .cv-nav-btn.nav-btn-now:hover { background: var(--doodle-lime, #D1FF00); color: #000000; }
  .cv-nav-btn.nav-btn-certs:hover { background: var(--doodle-pink, #FF1F70); color: #FFFFFF; }

  .master-cv-top-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cv-tool-btn {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: #FFFFFF;
    color: #0F172A;
    border: 1.8px solid #000000;
    border-radius: 9999px;
    padding: 5px 12px;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease;
  }

  .cv-tool-btn:hover {
    background: var(--doodle-yellow, #FFDA00);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .cv-tool-btn.is-copied {
    background: var(--doodle-lime, #D1FF00) !important;
    color: #000000 !important;
  }

  /* Saturated Download Pill Button */
  .cv-download-btn-pill {
    background: var(--doodle-lime, #D1FF00);
    color: #000000;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 5px 14px;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    box-shadow: 2.5px 2.5px 0px #000000;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease;
  }

  .cv-download-btn-pill:hover {
    background: #c2ef00;
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px #000000;
  }

  .cv-download-btn-pill.hero-lg {
    padding: 10px 22px;
    font-size: 0.92rem;
    box-shadow: 3.5px 3.5px 0px #000000;
  }

  .cv-download-btn-pill.hero-lg:hover {
    box-shadow: 4.5px 4.5px 0px #000000;
  }

  /* Master CV Scrollable Body */
  .master-cv-body {
    padding: 26px 32px 40px;
    overflow-y: auto;
    max-height: calc(92vh - 90px);
    display: flex;
    flex-direction: column;
    gap: 32px;
    background: #FFFFFF;
    scroll-behavior: smooth;
    box-sizing: border-box;
  }

  .master-cv-body::-webkit-scrollbar {
    width: 7px;
  }

  .master-cv-body::-webkit-scrollbar-track {
    background: #FAF7F2;
  }

  .master-cv-body::-webkit-scrollbar-thumb {
    background: #000000;
    border-radius: 9999px;
  }

  /* Hero Section */
  .mcv-hero-section {
    padding-bottom: 22px;
    border-bottom: 2.5px solid #000000;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mcv-hero-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
  }

  .mcv-hero-name {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: clamp(2.2rem, 5.5vw, 3.2rem);
    font-weight: 900;
    color: #000000;
    margin: 0;
    line-height: 0.94;
    letter-spacing: -0.06em;
    -webkit-font-smoothing: antialiased;
  }

  .mcv-accent-dot {
    color: var(--doodle-pink, #FF1F70);
  }

  .mcv-hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 5px 12px;
    box-shadow: 2px 2px 0px #000000;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #000000;
  }

  .status-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--doodle-lime, #D1FF00);
    border: 1.5px solid #000000;
    box-shadow: 0 0 6px var(--doodle-lime, #D1FF00);
    animation: statusPulse 2s infinite;
  }

  @keyframes statusPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  .mcv-hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .mcv-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    border: 1.8px solid #000000;
    border-radius: 9999px;
    padding: 3px 10px;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: #000000;
  }

  .tag-lime { background: var(--doodle-lime, #D1FF00); }
  .tag-cyan { background: var(--doodle-cyan, #00B3E3); }
  .tag-pink { background: var(--doodle-pink, #FF1F70); color: #FFFFFF; }
  .tag-white { background: #FFFFFF; }

  /* Sections */
  .mcv-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mcv-heading {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 1.05rem;
    font-weight: 900;
    color: #000000;
    letter-spacing: -0.05em;
    text-transform: lowercase;
    margin: 0;
    border-bottom: 2.5px solid #000000;
    padding-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mcv-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 720px) {
    .mcv-grid-2 {
      grid-template-columns: 1fr;
    }
    .master-cv-body {
      padding: 18px 20px 32px;
    }
  }

  .mcv-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mcv-about-card {
    background: var(--cream, #FAF7F2);
    border: 2px solid #000000;
    border-radius: 12px;
    padding: 14px 18px;
    box-shadow: 3px 3px 0px #000000;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mcv-p {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.88rem;
    line-height: 1.55;
    color: #0F172A;
    margin: 0;
  }

  /* Education Card */
  .mcv-edu-plain.mcv-expandable-card {
    background: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: 3px 3px 0px #000000;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease;
    user-select: none;
  }

  .mcv-edu-plain.mcv-expandable-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  .mcv-edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }

  .mcv-edu-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mcv-edu-degree {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #000000;
    margin: 0;
    line-height: 1.35;
  }

  .mcv-edu-school {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    color: #64748B;
    margin: 0;
  }

  /* Expandable Toggles & Detail Drawers */
  .mcv-expand-toggle-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.7rem;
    font-weight: 800;
    color: #000000;
    background: var(--cream, #F7F8F9);
    border: 1.5px solid #000000;
    border-radius: 9999px;
    padding: 2px 8px;
    box-shadow: 1.5px 1.5px 0px #000000;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .mcv-expandable-card:hover .mcv-expand-toggle-badge {
    background: var(--doodle-yellow, #FFDA00);
    transform: translate(-0.5px, -0.5px);
  }

  .expand-chevron {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mcv-expandable-card.is-expanded .expand-chevron {
    transform: rotate(180deg);
  }

  .mcv-expandable-card.is-expanded .mcv-expand-toggle-badge {
    background: var(--doodle-cyan, #00B3E3);
    color: #000000;
  }

  .mcv-item-details {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, margin-top 0.2s ease;
    opacity: 0;
    margin-top: 0;
    width: 100%;
    overflow: hidden;
  }

  .mcv-expandable-card.is-expanded .mcv-item-details {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 12px;
  }

  .mcv-item-details-inner {
    min-height: 0;
    overflow: hidden;
    border-top: 2px dashed #000000;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mcv-edu-detail-block {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mcv-edu-branch-title {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #000000;
    margin: 0;
  }

  .mcv-edu-desc {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.82rem;
    color: #334155;
    line-height: 1.45;
    margin: 0;
  }

  /* Skills Pills */
  .mcv-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mcv-pill {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: #FFFFFF;
    color: #000000;
    border: 1.8px solid #000000;
    padding: 4px 10px;
    border-radius: 9999px;
    box-shadow: 2px 2px 0px #000000;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .mcv-pill:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0px #000000;
  }

  .pop-pink { background: var(--doodle-pink, #FF1F70) !important; color: #FFFFFF !important; }
  .pop-cyan { background: var(--doodle-cyan, #00B3E3) !important; color: #000000 !important; }
  .pop-lime { background: var(--doodle-lime, #D1FF00) !important; color: #000000 !important; }
  .pop-yellow { background: var(--doodle-yellow, #FFDA00) !important; color: #000000 !important; }
  .pop-purple { background: var(--doodle-purple, #7A00FF) !important; color: #FFFFFF !important; }

  /* Work Experience Timeline */
  .mcv-timeline {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mcv-timeline-item {
    background: #FFFFFF !important;
    border: 2px solid #000000 !important;
    border-radius: 14px !important;
    padding: 14px 18px !important;
    box-shadow: 3px 3px 0px #000000 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    color: #0F172A !important;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .mcv-timeline-item:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 4.5px 0px #000000 !important;
  }

  .mcv-timeline-item.is-expanded {
    background: #FFFFFF !important;
    box-shadow: 4px 4px 0px #000000 !important;
  }

  .mcv-tl-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    flex-wrap: wrap;
  }

  .mcv-tl-role-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .mcv-tl-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 200px;
  }

  .mcv-tl-header {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .mcv-badge-sticker {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    padding: 2px 8px;
    border: 1.5px solid #000000;
    border-radius: 9999px;
    box-shadow: 1.5px 1.5px 0px #000000;
    display: inline-block;
  }

  .mcv-tl-comp {
    font-family: var(--archivo-font, 'Archivo', sans-serif) !important;
    font-size: 0.96rem !important;
    font-weight: 900 !important;
    letter-spacing: -0.04em !important;
    color: #000000 !important;
  }

  .mcv-tl-loc {
    font-family: var(--archivo-font, 'Archivo', sans-serif) !important;
    font-size: 0.74rem !important;
    font-weight: 700 !important;
    color: #64748B !important;
  }

  .mcv-tl-right {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 220px;
  }

  .mcv-tl-role {
    font-family: var(--archivo-font, 'Archivo', sans-serif) !important;
    font-size: 0.92rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em !important;
    color: #000000 !important;
  }

  .mcv-tl-kw {
    font-family: var(--archivo-font, 'Archivo', sans-serif) !important;
    font-size: 0.78rem !important;
    color: #475569 !important;
    font-weight: 600 !important;
    line-height: 1.4 !important;
  }

  .mcv-tl-overview {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.84rem;
    font-style: italic;
    color: #475569;
    margin: 0;
    line-height: 1.4;
  }

  .mcv-tl-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mcv-tl-bullets li {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.84rem;
    color: #000000 !important;
    line-height: 1.5;
    position: relative;
    padding-left: 16px;
  }

  .mcv-tl-bullets li::before {
    content: "✦";
    position: absolute;
    left: 0;
    color: #000000;
    font-size: 0.7rem;
    top: 1px;
  }

  /* Collectible Competency Cards Grid */
  .mcv-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .mcv-cap-card {
    border: 2px solid #000000;
    border-radius: 14px;
    padding: 16px;
    box-shadow: 3.5px 3.5px 0px #000000;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #FFFFFF;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .mcv-cap-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 4.5px 0px #000000;
  }

  .card-pink { background: #FFF0F5; border-top: 6px solid var(--doodle-pink, #FF1F70); }
  .card-cyan { background: #F0FAFF; border-top: 6px solid var(--doodle-cyan, #00B3E3); }
  .card-lime { background: #F8FFE5; border-top: 6px solid var(--doodle-lime, #D1FF00); }
  .card-yellow { background: #FFFDF0; border-top: 6px solid var(--doodle-yellow, #FFDA00); }
  .card-purple { background: #F8F0FF; border-top: 6px solid var(--doodle-purple, #7A00FF); }

  .mcv-cap-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
  }

  .mcv-doodle-art {
    width: 44px;
    height: 34px;
    display: block;
    flex-shrink: 0;
    filter: drop-shadow(1.5px 1.5px 0px #000000);
  }

  .mcv-sticker-tag {
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    border: 1.5px solid #000000;
    border-radius: 9999px;
    padding: 2px 7px;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

