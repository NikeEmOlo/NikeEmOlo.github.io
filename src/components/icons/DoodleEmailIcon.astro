---
interface Props {
    size?: number;
    class?: string;
}

const { size = 24, class: className = "" } = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 36 36"
    width={size}
    height={size}
    fill="none"
    class={`doodle-icon doodle-email-icon ${className}`}
    aria-hidden="true"
>
    <!-- Grounding Hard-Edge Drop Shadow -->
    <path d="M5.5 13.5C5.5 11.29 7.29 9.5 9.5 9.5H26.5C28.71 9.5 30.5 11.29 30.5 13.5V24.5C30.5 26.71 28.71 28.5 26.5 28.5H9.5C7.29 28.5 5.5 26.71 5.5 24.5V13.5Z" fill="#000000" transform="translate(1.5, 2)"/>

    <!-- Kinetic Doodle Spark Lines (Top-Right) -->
    <path d="M29 6L32 4M33 8L36 7" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
    <path d="M30.5 4.5L33.5 2.5" stroke="#FFDA00" stroke-width="1.5" stroke-linecap="round"/>

    <!-- Peeking Letter Paper Sheet -->
    <rect x="9" y="8" width="18" height="10" rx="2" fill="#FFFFFF" stroke="#000000" stroke-width="2.2" stroke-linejoin="round"/>
    <!-- Doodle Text Scribble Lines on Paper -->
    <line x1="12" y1="11.5" x2="20" y2="11.5" stroke="#000000" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="12" y1="14" x2="24" y2="14" stroke="#FF1F70" stroke-width="1.5" stroke-linecap="round"/>

    <!-- Envelope Main Body (Cel-Shaded Saturated Magenta Pink) -->
    <path d="M5 13C5 10.79 6.79 9 9 9H27C29.21 9 31 10.79 31 13V24C31 26.21 29.21 28 27 28H9C6.79 28 5 26.21 5 24V13Z" fill="#FF1F70" stroke="#000000" stroke-width="2.4" stroke-linejoin="round"/>
    
    <!-- Stepped Darker Cel-Shadow Plane at Envelope Bottom -->
    <path d="M5.2 21L13.5 16.5L18 20L22.5 16.5L30.8 21V24C30.8 26.1 29.1 27.8 27 27.8H9C6.9 27.8 5.2 26.1 5.2 24V21Z" fill="#D60052"/>

    <!-- Envelope Fold Lines (Heavy Black Vector Inking) -->
    <path d="M5.5 11L18 20.5L30.5 11" stroke="#000000" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M5.5 26.5L13.5 19.5" stroke="#000000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M30.5 26.5L22.5 19.5" stroke="#000000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>

    <!-- Little Street-Art Heart Sticker Seal -->
    <path d="M18 19.5C18 19.5 15.5 17 15.5 15.5C15.5 14.5 16.3 13.8 17.2 14C17.6 14.1 18 14.5 18 14.5C18 14.5 18.4 14.1 18.8 14C19.7 13.8 20.5 14.5 20.5 15.5C20.5 17 18 19.5 18 19.5Z" fill="#FFDA00" stroke="#000000" stroke-width="1.6" stroke-linejoin="round"/>

    <!-- Tactile Vinyl Gloss Specular Glints -->
    <ellipse cx="10" cy="11.5" rx="2.5" ry="1" fill="#FFFFFF" transform="rotate(-6 10 11.5)"/>
    <circle cx="7" cy="14" r="0.8" fill="#FFFFFF"/>
</svg>
