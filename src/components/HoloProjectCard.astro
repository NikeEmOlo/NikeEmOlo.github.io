---
export interface Props {
    project?: any;
    title?: string;
    summary?: string;
    imageUrl?: string;
    maskUrl?: string;
    backUrl?: string;
    cardBg?: string;
    borderWidth?: string;
    holoEffect?: "secret_rare_etched" | "cosmos_galaxy" | "radiant_laser" | "rainbow_secret" | "shiny_rare" | "v_full_art" | string;
    active?: boolean;
}

const props = Astro.props;
const pData = props.project?.data || props.project || {};

const title = props.title || pData.projTitle || pData.title || "PROJECT TITLE";
const summary = props.summary !== undefined ? props.summary : (pData.summary || "");
const imageUrl = props.imageUrl !== undefined ? props.imageUrl : pData.imageUrl;
const maskUrl = props.maskUrl !== undefined ? props.maskUrl : pData.maskUrl;
const backUrl = props.backUrl || pData.backUrl || "/img/card-back-generic.svg";
const cardBg = props.cardBg || pData.cardBg || "#00B3E3";
const borderWidth = props.borderWidth || pData.borderWidth || "10px";
const holoEffect = props.holoEffect || pData.holoEffect || "secret_rare_etched";
const active = props.active !== undefined ? props.active : (pData.active !== undefined ? pData.active : true);

const EFFECT_CONFIGS: Record<string, {
    rarity: string;
    set?: string;
    number?: string;
    foil: string;
    seedx?: string;
    seedy?: string;
    cosmosbg?: string;
}> = {
    secret_rare_etched: {
        rarity: "rare secret",
        set: "swsh12pt5",
        number: "160",
        foil: "/img/160_foil_etched_swsecret_foil.webp",
        seedx: "0.14597468026856575",
        seedy: "0.5188117694209767",
        cosmosbg: "107px 664px",
    },
};

const activeEffect = EFFECT_CONFIGS[holoEffect] || EFFECT_CONFIGS["secret_rare_etched"];
---

<!-- Reusable Holographic Project Card Component -->
<div
    class:list={["card", "interactive", imageUrl && maskUrl && "masked", !active && "is-unactivated"]}
    data-rarity={activeEffect.rarity}
    data-set={activeEffect.set}
    data-number={activeEffect.number}
    data-holo-project-card
    data-card-active={active ? "true" : "false"}
    style={{
        "--card-bg": cardBg,
        "--card-border-color": cardBg,
        "--card-border-width": borderWidth,
    }}
>
    <div class="card__translater">
        <button class="card__rotator" aria-label={title} tabindex="0">
            <!-- Card Back Face -->
            <div class="card__back card-back-frame" aria-hidden="true">
                <div class="card-back-inner">
                    <span class="card-back-corner top-left">Projects</span>
                    <div class="card-back-mascot-wrap">
                        <img
                            class="card-back-mascot"
                            src={backUrl && backUrl !== "/img/card-back-generic.svg" ? backUrl : "/img/card-back-computer.png"}
                            alt="Card back mascot"
                            width="300"
                            height="300"
                            loading="eager"
                        />
                    </div>
                    <span class="card-back-corner bottom-right">Projects</span>
                </div>
            </div>

            <!-- Card Front Face -->
            <div
                class="card__front card-base-frame"
                style={{
                    "--seedx": activeEffect.seedx || "0.14597468026856575",
                    "--seedy": activeEffect.seedy || "0.5188117694209767",
                    "--cosmosbg": activeEffect.cosmosbg || "107px 664px",
                    "--mask": `url(${maskUrl})`,
                    "--foil": `url(${activeEffect.foil})`,
                    "--card-theme-color": cardBg,
                    "--card-border-color": cardBg,
                }}
            >
                <div class="card-front-inner">
                    <!-- Colored Square (Image Background) with Character Art & Hologram -->
                    <div class="artwork-square" style={{ "--square-bg": cardBg }}>
                        {imageUrl && (
                            <div class="artwork-layer" aria-hidden="true">
                                <img
                                    class="character-artwork"
                                    src={imageUrl}
                                    alt=""
                                    loading="eager"
                                    width="400"
                                    height="400"
                                />
                            </div>
                        )}

                        <!-- Multi-Pass Holographic Foil Layers (Clipped & Aligned to Image Background) -->
                        <div
                            class="card__shine"
                            style={{
                                "--seedx": activeEffect.seedx || "0.14597468026856575",
                                "--seedy": activeEffect.seedy || "0.5188117694209767",
                                "--cosmosbg": activeEffect.cosmosbg || "107px 664px",
                                "--mask": `url(${maskUrl})`,
                                "--foil": `url(${activeEffect.foil})`,
                            }}
                        ></div>
                    </div>

                    <!-- Bottom: Centered Title & Summary Text -->
                    <div class="card-bottom-info">
                        <h2 class="card-title-text">{title.endsWith('.') ? title : `${title}.`}</h2>
                        {summary && (
                            <p class="card-summary-text">{summary}</p>
                        )}
                    </div>
                </div>

                <!-- Big "Coming Soon" Stamp for Inactive Cards -->
                {!active && (
                    <div class="card-coming-soon-wrap" aria-hidden="true">
                        <div class="coming-soon-stamp">
                            <span>Coming soon</span>
                        </div>
                    </div>
                )}

                <!-- Full-Card Interactive Light Point Glare (Contained strictly inside card front) -->
                <div class="card__glare"></div>
            </div>
        </button>
    </div>
</div>

<style is:global>
    @import "../styles/holo/base.css";
    @import "../styles/holo/cards.css";
    @import "../styles/holo/swsh-pikachu.css";

    /* Root Card Dimensions & 3D Perspective Anchor — strictly preserves 600 / 921 ratio */
    .card[data-holo-project-card] {
        --card-aspect: calc(600 / 921);
        --card-radius: 12px;
        width: clamp(210px, 18.5vw, 270px);
        aspect-ratio: 600 / 921;
        margin: 0 auto;
        --card-scale: 1;
        border-radius: var(--card-radius);
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        background: transparent !important;
    }

    .card[data-holo-project-card] .card__translater,
    .card[data-holo-project-card] .card__rotator {
        cursor: pointer;
        outline: none;
        width: 100%;
        height: 100%;
        aspect-ratio: 600 / 921;
        border-radius: var(--card-radius) !important;
        background: transparent !important;
        box-shadow: none !important;
        transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        transform-style: preserve-3d;
        will-change: transform;
    }

    .card[data-holo-project-card] .card__rotator > * {
        border-radius: var(--card-radius) !important;
        aspect-ratio: 600 / 921 !important;
    }

    .card[data-holo-project-card].interacting .card__rotator {
        transition: none;
    }

    .card[data-holo-project-card].flipped .card__rotator {
        transform: rotateY(180deg) !important;
    }

    .card[data-holo-project-card].flipped .card__shine,
    .card[data-holo-project-card].flipped .card__glare {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
    }

    .deck-card-item.is-deck-stack .card__translater,
    .deck-card-item.is-deck-stack .card__rotator {
        transform: none !important;
    }

    .deck-card-item .card[data-holo-project-card] {
        width: 100%;
        height: 100%;
        aspect-ratio: 600 / 921;
        margin: 0;
    }

    .deck-card-item.is-deck-stack .card__shine,
    .deck-card-item.is-deck-stack .card__glare {
        opacity: 0 !important;
        visibility: hidden !important;
    }

    /* Card Frame & Border Styling: White card (#ffffff) with border matching image background */
    .card-base-frame {
        background-color: #FFFFFF !important;
        background: #FFFFFF !important;
        border: var(--card-border-width, 10px) solid var(--card-bg, #00B3E3);
        border-radius: var(--card-radius) !important;
        box-sizing: border-box;
        overflow: hidden;
        position: relative;
        width: 100%;
        height: 100%;
        aspect-ratio: 600 / 921;
        box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.35);
        -webkit-transform: translate3d(0px, 0px, 0.01px);
        transform: translate3d(0px, 0px, 0.01px);
        -webkit-backface-visibility: hidden !important;
        backface-visibility: hidden !important;
    }

    .card__front,
    .card__front * {
        -webkit-backface-visibility: hidden !important;
        backface-visibility: hidden !important;
    }

    /* Card Back Face Frame: Outer white border with matching smooth curve */
    .card-back-frame {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        aspect-ratio: 600 / 921;
        background-color: #FFFFFF !important;
        border-radius: var(--card-radius) !important;
        padding: var(--card-border-width, 10px);
        box-sizing: border-box;
        overflow: hidden;
        box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.35);
        -webkit-transform: rotateY(180deg) translateZ(1px);
        transform: rotateY(180deg) translateZ(1px);
        -webkit-backface-visibility: hidden !important;
        backface-visibility: hidden !important;
        user-select: none;
        pointer-events: none;
    }

    .card-back-inner {
        width: 100%;
        height: 100%;
        background-color: #121214;
        border-radius: var(--card-radius) !important;
        box-sizing: border-box;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: clamp(10px, 1.2vw, 14px) clamp(12px, 1.4vw, 16px);
    }

    .card-back-corner {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 800;
        font-size: clamp(0.95rem, 1.2vw, 1.2rem);
        line-height: 1;
        letter-spacing: -0.025em;
        color: #FFFFFF;
        text-transform: none;
    }

    .card-back-corner.top-left {
        align-self: flex-start;
    }

    .card-back-corner.bottom-right {
        align-self: flex-end;
    }

    .card-back-mascot-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        width: 100%;
    }

    .card-back-mascot {
        width: clamp(75px, 9.5vw, 115px);
        height: auto;
        max-width: 48%;
        object-fit: contain;
        display: block;
    }

    /* Inner Card Layout for Front Face */
    .card-front-inner {
        position: absolute;
        inset: 0;
        padding: clamp(10px, 1.2vw, 14px);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: clamp(18px, 2.2vh, 26px);
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        pointer-events: none;
        user-select: none;
        background-color: #FFFFFF !important;
        background: #FFFFFF !important;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        backface-visibility: hidden;
        overflow: hidden;
    }

    /* Colored Square (Image Background) — strictly max 4px radius */
    .artwork-square {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background-color: var(--square-bg, #00B3E3);
        border-radius: 4px !important;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Character Artwork Layer */
    .artwork-layer {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        padding: 8px;
        box-sizing: border-box;
    }

    .character-artwork {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        display: block;
    }

    /* Holographic Shine inside Artwork Square (Mask aligned 1:1, zero dark vignette overlay) */
    .artwork-square .card__shine {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: 4px !important;
        z-index: 2;
        pointer-events: none;
    }

    .artwork-square .card__shine:before {
        display: none !important; /* Removes dark multiply/vignette layer from poke-holo */
    }

    .artwork-square .card__shine:after {
        -webkit-mask-size: contain !important;
        mask-size: contain !important;
        -webkit-mask-position: center !important;
        mask-position: center !important;
        -webkit-mask-repeat: no-repeat !important;
        mask-repeat: no-repeat !important;
        padding: 8px;
        box-sizing: border-box;
    }

    /* Full-Card Subtle Spotlight Glare (Refined, gentle luminous sheen, zero grey tint) */
    .card-base-frame .card__glare {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: inherit;
        z-index: 20;
        pointer-events: none;
        background-image: radial-gradient(
            farthest-corner circle at var(--pointer-x) var(--pointer-y),
            hsla(0, 0%, 100%, 0.60) 0%,
            hsla(0, 0%, 100%, 0.28) 22%,
            hsla(0, 0%, 100%, 0.05) 50%,
            hsla(0, 0%, 100%, 0) 95%
        ) !important;
        filter: none !important;
        mix-blend-mode: normal !important;
        opacity: calc(var(--card-opacity, 0.8) * 0.52);
        transform: none !important;
        overflow: hidden;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
    }

    /* Bottom Info: Centered Typography */
    .card-bottom-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        margin-top: 0;
        padding-top: 0;
        gap: clamp(8px, 1.2vh, 12px);
    }

    .card-title-text {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 700;
        font-size: clamp(0.95rem, 1.25vw, 1.22rem);
        line-height: 1.02;
        letter-spacing: -0.06em;
        color: #000000;
        margin: 0;
        text-align: center;
        width: 100%;
        max-width: 100%;
        -webkit-font-smoothing: antialiased;
    }

    .card-summary-text {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 400;
        font-size: clamp(0.68rem, 0.85vw, 0.80rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: #1E293B;
        margin: 0 auto;
        text-align: center;
        width: 100%;
        max-width: 30ch;
        -webkit-font-smoothing: antialiased;
    }

    /* Inactive Card State: Completely greyed out monochrome prototype, back face untouched */
    .card.is-unactivated .card-base-frame {
        border-color: #CBD5E1 !important;
        background-color: #FFFFFF !important;
    }

    .card.is-unactivated .artwork-square {
        background-color: #E2E8F0 !important;
        border: 1.5px solid #CBD5E1 !important;
    }

    /* Heavy blur keeps the hero art a shape rather than a picture — the card
       reads as unrevealed, not as a duplicate of art used elsewhere. The
       slight scale-up hides the soft edge the blur pulls in from the bounds. */
    .card.is-unactivated .character-artwork {
        filter: grayscale(100%) contrast(0.9) brightness(0.95) blur(9px) !important;
        opacity: 0.7 !important;
        transform: scale(1.06);
    }

    .card.is-unactivated .card-title-text {
        color: #475569 !important;
    }

    .card.is-unactivated .card-summary-text {
        color: #94A3B8 !important;
    }

    .card.is-unactivated .card__shine,
    .card.is-unactivated .card__glare {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
    }

    .card.is-unactivated .card__rotator {
        cursor: not-allowed;
    }

    /* Big "Coming soon" Stamp */
    .card-coming-soon-wrap {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(12px, 1.5vw, 20px);
        z-index: 25;
        pointer-events: none;
    }

    .coming-soon-stamp {
        background: #000000;
        color: #FFFFFF;
        border: 2.5px solid #000000;
        border-radius: 8px;
        padding: clamp(8px, 1.2vh, 12px) clamp(16px, 1.8vw, 24px);
        transform: rotate(-6deg);
        box-shadow: 3.5px 3.5px 0px rgba(0, 0, 0, 0.4);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 900;
        font-size: clamp(1.05rem, 1.4vw, 1.4rem);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        line-height: 1;
        white-space: nowrap;
    }
</style>

<script>
    // Hybrid laptops report both, so this is a live query rather than a
    // one-time user-agent guess.
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

    function mountHoloProjectCards() {
        document.querySelectorAll("[data-holo-project-card]").forEach((cardEl) => {
            const card = cardEl;
            if (card.dataset.holoMounted) return;
            card.dataset.holoMounted = "true";

            const rotator = card.querySelector(".card__rotator");
            if (!rotator) return;

            // Deck-managed cards: deckController.js owns click (navigate
            // to project / deal to card) and 3D matrix transform for cards in the deck,
            // and only the currently centered card should show the tilt/shine reaction.
            const deckItem = card.closest(".deck-card-item");
            const isDeckManaged = !!deckItem;
            const isDeckActive = () => !deckItem || deckItem.classList.contains("is-active-hero");

            let isFlipped = false;

            // Initialize as active with ambient resting holographic illumination
            card.classList.add("active");
            card.style.setProperty("--card-opacity", "0.85");
            card.style.setProperty("--pointer-x", "50%");
            card.style.setProperty("--pointer-y", "35%");
            card.style.setProperty("--pointer-from-center", "0.45");
            card.style.setProperty("--pointer-from-top", "0.35");
            card.style.setProperty("--pointer-from-left", "0.5");
            card.style.setProperty("--rotate-x", "0deg");
            card.style.setProperty("--rotate-y", "0deg");

            // The tilt/shine reaction tracks a hovering cursor. On a touch
            // screen there is nothing to hover: the same handler fires off
            // the swipe itself, so dragging the deck sideways also throws the
            // card into a tilt and fights the gesture. Mouse only.
            const canTilt = (e) =>
                finePointer.matches && (!e || e.pointerType === "mouse");

            const updatePointer = (e) => {
                if (!isDeckActive()) return;
                if (!canTilt(e)) return;
                const rect = card.getBoundingClientRect();
                const absolute = {
                    x: e.clientX - rect.left,
                    y: e.clientY - rect.top,
                };
                const percent = {
                    x: Math.round((100 / rect.width) * absolute.x * 100) / 100,
                    y: Math.round((100 / rect.height) * absolute.y * 100) / 100,
                };
                const center = {
                    x: percent.x - 50,
                    y: percent.y - 50,
                };

                card.classList.add("interacting");
                card.classList.add("active");
                card.style.setProperty("--pointer-x", `${percent.x}%`);
                card.style.setProperty("--pointer-y", `${percent.y}%`);
                card.style.setProperty(
                    "--pointer-from-center",
                    `${Math.min(Math.max(Math.sqrt((center.x / 50) ** 2 + (center.y / 50) ** 2), 0), 1)}`
                );
                card.style.setProperty("--pointer-from-top", `${percent.y / 100}`);
                card.style.setProperty("--pointer-from-left", `${percent.x / 100}`);
                card.style.setProperty("--card-opacity", "1");
                card.style.setProperty("--rotate-x", `${-(center.x / 3.5)}deg`);
                card.style.setProperty("--rotate-y", `${center.y / 3.5}deg`);
                card.style.setProperty("--background-x", `${40 + percent.x / 5}%`);
                card.style.setProperty("--background-y", `${40 + percent.y / 5}%`);
            };

            card.addEventListener("pointermove", updatePointer);
            card.addEventListener("pointerenter", (e) => {
                updatePointer(e);
            });

            card.addEventListener("pointerleave", () => {
                card.classList.remove("interacting");
                // Retain active state and persistent holographic foil illumination
                card.style.setProperty("--card-opacity", "0.85");
                card.style.setProperty("--pointer-x", "50%");
                card.style.setProperty("--pointer-y", "35%");
                card.style.setProperty("--pointer-from-center", "0.45");
                card.style.setProperty("--pointer-from-top", "0.35");
                card.style.setProperty("--pointer-from-left", "0.5");
                card.style.setProperty("--rotate-x", "0deg");
                card.style.setProperty("--rotate-y", "0deg");
            });

            // Deck cards get their face-up/face-down flip entirely from
            // deckController's own wrapper rotation as they transit the
            // deck — a second, independent click-flip here would fire
            // alongside deckController's click-opens-modal handler on the
            // same click and fight it. Only attach it for standalone usage
            // (Sandbox, tarot-showcase).
            if (!isDeckManaged) {
                rotator.addEventListener("click", () => {
                    isFlipped = !isFlipped;
                    card.classList.toggle("flipped", isFlipped);
                });
            }
        });
    }

    document.addEventListener("DOMContentLoaded", mountHoloProjectCards);
    document.addEventListener("astro:page-load", mountHoloProjectCards);
</script>
