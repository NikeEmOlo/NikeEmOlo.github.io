---
interface Props {
  company?: string;
  title?: string;
  location?: string;
  autoPlay?: boolean;
  showReplay?: boolean;
}

const {
  company = "Nota Scam",
  title = "Junior role",
  location = "London, England, United Kingdom",
  autoPlay = true,
  showReplay = true,
} = Astro.props;
---

<div class="doodle-card-wrapper">
  <!-- Comic Impact Dust Shockwave (fires on slam) -->
  <div class="comic-shockwave" aria-hidden="true">
    <svg viewBox="0 0 400 120" fill="none" class="shockwave-svg">
      <path d="M40 80 Q20 50 10 70 Q0 90 30 95" stroke="#000000" stroke-width="2.5" stroke-linecap="round" fill="none" />
      <path d="M360 80 Q380 50 390 70 Q400 90 370 95" stroke="#000000" stroke-width="2.5" stroke-linecap="round" fill="none" />
      <path d="M60 100 L30 110" stroke="#000000" stroke-width="2.5" stroke-linecap="round" />
      <path d="M340 100 L370 110" stroke="#000000" stroke-width="2.5" stroke-linecap="round" />
      <path d="M80 110 L50 118" stroke="#0A66C2" stroke-width="2.5" stroke-linecap="round" />
      <path d="M320 110 L350 118" stroke="#0A66C2" stroke-width="2.5" stroke-linecap="round" />
    </svg>
  </div>

  <!-- Main Cartoon LinkedIn Card -->
  <div class="doodle-card-container" data-autoplay={autoPlay ? "true" : "false"}>
    <!-- Top Vinyl Gloss Capsule Glint -->
    <div class="card-vinyl-gloss" aria-hidden="true"></div>

    <!-- Kinetic Accent Doodles in LinkedIn Palette -->
    <div class="doodle-sparks-layer" aria-hidden="true">
      <!-- Crown scribble over company in LinkedIn Blue -->
      <svg class="doodle-crown" viewBox="0 0 32 24" fill="none">
        <path d="M2 18L6 6L16 14L26 6L30 18H2Z" fill="#0A66C2" stroke="#000000" stroke-width="2" stroke-linejoin="round" />
        <circle cx="6" cy="4" r="2" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
        <circle cx="16" cy="11" r="2" fill="#057642" stroke="#000000" stroke-width="1.5" />
        <circle cx="26" cy="4" r="2" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
      </svg>
    </div>

    <!-- Header: Cartoon Corporate Logo, Name, More Menu -->
    <div class="doodle-header">
      <div class="company-badge">
        <div class="company-logo-box">
          <!-- Stylized Cartoon LinkedIn-style Corporate Badge -->
          <svg class="company-logo-icon" viewBox="0 0 36 36" fill="none">
            <rect x="2" y="2" width="32" height="32" rx="6" fill="#0A66C2" stroke="#000000" stroke-width="2.5" />
            <!-- Pill Gloss -->
            <rect x="5" y="5" width="10" height="4" rx="2" fill="#FFFFFF" opacity="0.6" />
            <!-- Monogram in cartoon streetwear inking -->
            <path d="M11 12H18C21.3137 12 24 14.6863 24 18C24 21.3137 21.3137 24 18 24H11V12Z" fill="#FFFFFF" stroke="#000000" stroke-width="2" />
            <path d="M11 24V28" stroke="#000000" stroke-width="2.5" stroke-linecap="round" />
          </svg>
        </div>
        <div class="company-title-wrap">
          <span class="company-name">{company}</span>
        </div>
      </div>

      <button class="menu-btn" type="button" aria-label="More options">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </button>
    </div>

    <!-- Job Title: Bold Cartoon Display -->
    <h2 class="job-title">{title}</h2>

    <!-- Metadata Line: STRICT NO-WRAP SINGLE LINE -->
    <div class="job-meta-line">
      <span class="job-location">{location}</span>
      <span class="meta-dot">·</span>
      <span class="job-time-tag" data-time-tag>1 hour ago</span>
      <span class="meta-dot">·</span>
      <span class="job-applicants-wrap">
        <span class="applicant-number-box">
          <span class="applicant-number" data-applicant-num>10</span>
        </span>
        <span class="applicants-label">people clicked apply</span>
      </span>
    </div>

    <p class="job-sub-meta">Responses managed off LinkedIn</p>

    <!-- Cartoon Pill Badges (Authentic LinkedIn Colors) -->
    <div class="job-tags-group">
      <div class="job-pill">
        <svg class="pill-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Remote</span>
      </div>

      <div class="job-pill">
        <svg class="pill-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Full-time</span>
      </div>
    </div>

    <!-- Chunky Cartoon Buttons with Drop Shadows (LinkedIn Blue & White) -->
    <div class="job-actions-group">
      <button class="btn-apply" type="button">
        <span class="btn-gloss"></span>
        <span>Apply</span>
        <svg class="apply-icon" width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
          <path d="M11 3H5c-.55 0-1 .45-1 1s.45 1 1 1h3.59L3.29 10.29c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0L10 6.41V10c0 .55.45 1 1 1s1-.45 1-1V4c0-.55-.45-1-1-1z"></path>
        </svg>
      </button>

      <button class="btn-save" type="button">Save</button>

      <!-- Sandbox Replay Button -->
      {showReplay && (
        <button class="btn-replay-sim" data-replay-btn title="Replay cartoon slam & surge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          <span>REPLAY SLAM</span>
        </button>
      )}
    </div>

    <!-- Collectible Corner Stamp -->
    <div class="collectible-stamp" aria-hidden="true">
      <span>LKND-01</span>
    </div>
  </div>
</div>

<style>
  :root {
    --doodle-scale: 1;
    --doodle-motion-blur: 0px;
  }

  .doodle-card-wrapper {
    position: relative;
    width: 100%;
    max-width: 720px;
    display: flex;
    justify-content: center;
    /* How far the card is scaled up before it slams down. The scaled box is
       what the browser counts as scrollable overflow, so this is capped on
       narrow viewports (see the small-screen block at the bottom). */
    --doodle-entry-scale: 1.65;
    --doodle-entry-lift: -55px;
    --doodle-entry-lift-start: -60px;
    /* Belt-and-braces: the entry transform is decoration and must never be
       able to widen the document. Clipped horizontally only, with room left
       for the 7px cel-shadow; vertical overhang (crown, dust) stays visible. */
    overflow-x: clip;
    overflow-clip-margin: 16px;
  }

  /* Comic Impact Dust Shockwave */
  .comic-shockwave {
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 105%;
    pointer-events: none;
    opacity: 0;
    z-index: 1;
  }

  .doodle-card-wrapper.impact-active .comic-shockwave {
    animation: shockwavePuff 0.5s ease-out forwards;
  }

  @keyframes shockwavePuff {
    0% { opacity: 0; transform: translateX(-50%) scale(0.6); }
    30% { opacity: 1; transform: translateX(-50%) scale(1.1); }
    100% { opacity: 0; transform: translateX(-50%) scale(1.35) translateY(10px); }
  }

  .shockwave-svg {
    width: 100%;
    height: auto;
  }

  /* THE CARTOON CARD CONTAINER */
  .doodle-card-container {
    width: 100%;
    background: #ffffff;
    border: 3px solid #000000;
    border-radius: 12px;
    padding: 24px 28px;
    /* Hard Stepped Cel-Shadow */
    box-shadow: 7px 7px 0px #000000;
    font-family: -apple-system, system-ui, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Fira Sans", Ubuntu, sans-serif;
    color: rgba(0, 0, 0, 0.9);
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
    user-select: none;
    position: relative;
    z-index: 5;
    /* Initial state before slam */
    opacity: 0;
    transform: perspective(1000px) scale(var(--doodle-entry-scale, 1.65))
      translateY(var(--doodle-entry-lift, -55px)) rotate(-2deg);
    filter: blur(8px);
    will-change: transform, opacity, filter, box-shadow;
  }

  /* TOP VINYL GLOSS CAPSULE GLINT */
  .card-vinyl-gloss {
    position: absolute;
    top: 5px;
    left: 20px;
    width: 120px;
    height: 5px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 100%);
    border-radius: 9999px;
    pointer-events: none;
  }

  /* COMIC SLAM IMPACT & SQUASH/STRETCH WOBBLE */
  .doodle-card-container.is-slammed {
    animation: cartoonSlamImpact 0.65s cubic-bezier(0.18, 0.89, 0.32, 1.25) forwards;
  }

  @keyframes cartoonSlamImpact {
    0% {
      opacity: 0;
      transform: perspective(1000px) scale(var(--doodle-entry-scale, 1.65))
        translateY(var(--doodle-entry-lift-start, -60px)) rotate(-3deg);
      filter: blur(8px);
      box-shadow: 20px 30px 0px rgba(0, 0, 0, 0);
    }
    40% {
      opacity: 1;
      transform: perspective(1000px) scale(1.04, 0.94) translateY(6px) rotate(0.8deg);
      filter: blur(0px);
      box-shadow: 10px 10px 0px #000000;
    }
    60% {
      transform: perspective(1000px) scale(0.98, 1.02) translateY(-3px) rotate(-0.6deg);
      box-shadow: 6px 6px 0px #000000;
    }
    80% {
      transform: perspective(1000px) scale(1.008, 0.992) translateY(1px) rotate(0.2deg);
    }
    100% {
      opacity: 1;
      transform: perspective(1000px) scale(1) translateY(0) rotate(0deg);
      box-shadow: 7px 7px 0px #000000;
      filter: blur(0px);
    }
  }

  /* KINETIC DOODLE ACCENTS */
  .doodle-sparks-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  .doodle-crown {
    position: absolute;
    top: -14px;
    left: 48px;
    width: 24px;
    height: 18px;
    transform: rotate(-10deg);
    filter: drop-shadow(2px 2px 0px #000000);
  }

  /* HEADER */
  .doodle-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .company-badge {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .company-logo-box {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .company-logo-icon {
    width: 100%;
    height: 100%;
  }

  .company-title-wrap {
    display: flex;
    align-items: center;
  }

  .company-name {
    font-size: 0.95rem; /* 15px */
    font-weight: 700;
    color: rgba(0, 0, 0, 0.9);
    letter-spacing: -0.01em;
  }

  .menu-btn {
    background: #FFFFFF;
    border: 2px solid #000000;
    cursor: pointer;
    padding: 4px 7px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 3px;
    box-shadow: 2px 2px 0px #000000;
    transition: transform 0.1s ease;
  }
  .menu-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }
  .menu-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px #000000;
  }

  .dot {
    width: 4px;
    height: 4px;
    background: #000000;
    border-radius: 50%;
  }

  /* JOB TITLE */
  .job-title {
    font-size: 1.5rem; /* 24px */
    font-weight: 800;
    line-height: 1.25;
    color: rgba(0, 0, 0, 0.9);
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* METADATA LINE */
  .job-meta-line {
    font-size: 0.875rem; /* 14px */
    color: rgba(0, 0, 0, 0.6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    line-height: 1.4;
    overflow: visible;
  }

  .meta-dot {
    color: rgba(0, 0, 0, 0.4);
    font-size: 14px;
    align-self: center;
    flex-shrink: 0;
  }

  .job-location {
    color: rgba(0, 0, 0, 0.6);
    font-size: 14px;
    font-weight: 500;
    align-self: center;
    flex-shrink: 0;
  }

  /* TIME TAG */
  .job-time-tag {
    color: #057642; /* LinkedIn Green */
    font-weight: 600;
    font-size: 14px;
    line-height: 1;
    white-space: nowrap;
    align-self: center;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .job-time-tag.time-escalated {
    color: rgba(0, 0, 0, 0.6);
    font-weight: 600;
  }

  /* APPLICANTS WRAPPER */
  .job-applicants-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    align-self: center;
    flex-shrink: 0;
  }

  .applicant-number-box {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .applicant-number {
    font-weight: 700;
    color: #111827;
    font-size: 14px;
    line-height: 1;
    letter-spacing: -0.01em;
    filter: blur(var(--doodle-motion-blur, 0px));
    will-change: filter;
    display: inline-flex;
    align-items: center;
    align-self: center;
    position: relative;
    z-index: 2;
  }

  .applicants-label {
    color: rgba(0, 0, 0, 0.6);
    font-size: 14px;
    white-space: nowrap;
    align-self: center;
  }

  .job-sub-meta {
    font-size: 0.8125rem; /* 13px */
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
    margin-top: -4px;
  }

  /* CARTOON PILLS (LINKEDIN WHITE + DOODLE BORDER) */
  .job-tags-group {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .job-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 14px;
    border: 2px solid #000000;
    border-radius: 9999px;
    font-size: 0.875rem; /* 14px */
    font-weight: 700;
    color: rgba(0, 0, 0, 0.85);
    background: #FFFFFF;
    box-shadow: 2.5px 2.5px 0px #000000;
    transition: transform 0.1s ease;
  }

  /* BUTTONS (AUTHENTIC LINKEDIN BLUE + CARTOON DEPTH) */
  .job-actions-group {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
  }

  .btn-apply {
    background: #0A66C2;
    color: #ffffff;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 7px 20px;
    font-size: 0.95rem; /* 15px */
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    box-shadow: 3.5px 3.5px 0px #000000;
    position: relative;
    overflow: hidden;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .btn-gloss {
    position: absolute;
    top: 2px;
    left: 10px;
    right: 10px;
    height: 3px;
    background: rgba(255, 255, 255, 0.45);
    border-radius: 9999px;
  }

  .btn-apply:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 4.5px 0px #000000;
  }
  .btn-apply:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #000000;
  }

  .btn-save {
    background: #FFFFFF;
    color: #0A66C2;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 6px 20px;
    font-size: 0.95rem; /* 15px */
    font-weight: 700;
    cursor: pointer;
    box-shadow: 3.5px 3.5px 0px #000000;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .btn-save:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4.5px 4.5px 0px #000000;
    background: #F0F9FF;
  }
  .btn-save:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #000000;
  }

  .btn-replay-sim {
    margin-left: auto;
    background: #FFFFFF;
    border: 2px solid #000000;
    color: #0A66C2;
    border-radius: 9999px;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    box-shadow: 2.5px 2.5px 0px #000000;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .btn-replay-sim:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px #000000;
  }
  .btn-replay-sim:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px #000000;
  }

  /* COLLECTIBLE CORNER STAMP */
  .collectible-stamp {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 700;
    color: #9CA3AF;
    letter-spacing: 0.1em;
  }

  /* Once the card goes full-bleed in a single column there is no side room
     left for a 1.65x scale-up: the scaled box is counted as scrollable
     overflow and drags the whole document sideways. Drop the scale-up and
     let the drop, rotation, blur and the squash/stretch settle carry the
     slam instead. */
  @media (max-width: 860px) {
    .doodle-card-wrapper {
      --doodle-entry-scale: 1;
      --doodle-entry-lift: -68px;
      --doodle-entry-lift-start: -74px;
    }
  }

  @media (max-width: 580px) {
    .doodle-card-container {
      padding: 20px 18px;
    }
    .job-title {
      font-size: 1.25rem;
    }
    .job-actions-group {
      flex-wrap: wrap;
    }
    .btn-replay-sim {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  function initDoodleLinkedInSimulation() {
    const cards = document.querySelectorAll(".doodle-card-container");

    cards.forEach((card) => {
      const wrapper = card.closest(".doodle-card-wrapper");
      const timeTag = card.querySelector("[data-time-tag]");
      const applicantNum = card.querySelector("[data-applicant-num]");
      const replayBtn = card.querySelector("[data-replay-btn]");

      if (!timeTag || !applicantNum) return;

      let animationFrameId = null;
      let isRunning = false;
      let surgeTimeoutId = null;

      function triggerCartoonSlamAndSurge() {
        if (isRunning) cancelAnimationFrame(animationFrameId);
        if (surgeTimeoutId) clearTimeout(surgeTimeoutId);
        isRunning = false;

        // 1. Trigger the SLAM and Comic Shockwave Dust
        card.classList.remove("is-slammed");
        if (wrapper) wrapper.classList.remove("impact-active");

        void card.offsetWidth; // Force Reflow

        card.classList.add("is-slammed");
        if (wrapper) {
          setTimeout(() => {
            wrapper.classList.add("impact-active");
          }, 180);
        }

        // 2. Reset Surge Values
        card.style.setProperty("--doodle-scale", "1");
        card.style.setProperty("--doodle-motion-blur", "0px");
        timeTag.textContent = "1 hour ago";
        timeTag.classList.remove("time-escalated");
        applicantNum.textContent = "10";

        // 3. Launch exponential applicant surge right after comic bounce (~400ms)
        surgeTimeoutId = setTimeout(() => {
          runCartoonSurgeSimulation();
        }, 420);
      }

      function runCartoonSurgeSimulation() {
        if (isRunning) cancelAnimationFrame(animationFrameId);
        isRunning = true;

        const startTime = performance.now();
        const duration = 3200; // 3.2s rapid cartoon surge

        function update(currentTime) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);

          // 1. IN-FLOW SCALING (14px -> 26px in place without wrapping)
          const scaleEase = Math.pow(progress, 1.15);
          const currentScale = (1.0 + scaleEase * 0.85).toFixed(3);
          card.style.setProperty("--doodle-scale", `${currentScale}`);

          // 2. LINEAR TIME PROGRESSION (1 hour -> 2 days)
          const timeHours = 1 + progress * 47;
          if (timeHours < 24) {
            const h = Math.floor(timeHours);
            timeTag.textContent = `${h} ${h === 1 ? "hour" : "hours"} ago`;
            timeTag.classList.remove("time-escalated");
          } else {
            const days = Math.floor(timeHours / 24);
            timeTag.textContent = `${days} ${days === 1 ? "day" : "days"} ago`;
            timeTag.classList.add("time-escalated");
          }
          if (progress >= 1) {
            timeTag.textContent = "2 days ago";
          }

          // 3. EXPONENTIAL SURGE & MOTION BLUR
          const targetFinal = 6582;
          const startVal = 10;
          const logRatio = Math.log(targetFinal / startVal);
          const expPower = Math.pow(progress, 1.65) * logRatio;
          let currentApplicants = Math.round(startVal * Math.exp(expPower));

          if (progress > 0.25 && progress < 0.94) {
            const surgeIntensity = Math.sin(((progress - 0.25) / 0.69) * Math.PI);
            const motionBlurPx = (surgeIntensity * 1.1).toFixed(2);
            card.style.setProperty("--doodle-motion-blur", `${motionBlurPx}px`);
          } else {
            card.style.setProperty("--doodle-motion-blur", "0px");
          }

          if (progress >= 1) {
            currentApplicants = 6582;
            card.style.setProperty("--doodle-motion-blur", "0px");
            card.dispatchEvent(new CustomEvent("doodle:surge-complete"));
          }

          applicantNum.textContent = currentApplicants.toLocaleString();

          if (progress < 1) {
            animationFrameId = requestAnimationFrame(update);
          } else {
            isRunning = false;
          }
        }

        animationFrameId = requestAnimationFrame(update);
      }

      if (replayBtn) {
        replayBtn.addEventListener("click", () => {
          triggerCartoonSlamAndSurge();
        });
      }

      // External Control Events (for Scrollytelling Stage)
      card.addEventListener("doodle:slam", () => {
        triggerCartoonSlamAndSurge();
      });

      card.addEventListener("doodle:shock", () => {
        card.classList.add("is-shocked");
      });

      card.addEventListener("doodle:unshock", () => {
        card.classList.remove("is-shocked");
      });

      card.addEventListener("doodle:reset", () => {
        if (isRunning) cancelAnimationFrame(animationFrameId);
        if (surgeTimeoutId) clearTimeout(surgeTimeoutId);
        isRunning = false;
        card.classList.remove("is-slammed", "is-shocked");
        if (wrapper) wrapper.classList.remove("impact-active");
        card.style.setProperty("--doodle-scale", "1");
        card.style.setProperty("--doodle-motion-blur", "0px");
        timeTag.textContent = "1 hour ago";
        timeTag.classList.remove("time-escalated");
        applicantNum.textContent = "10";
      });

      const autoPlayEnabled = card.getAttribute("data-autoplay") !== "false";
      if (autoPlayEnabled) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                triggerCartoonSlamAndSurge();
              }
            });
          },
          {
            root: null,
            rootMargin: "0px 0px -50px 0px",
            threshold: 0.45,
          }
        );

        observer.observe(card);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initDoodleLinkedInSimulation);
  document.addEventListener("astro:page-load", initDoodleLinkedInSimulation);
</script>
