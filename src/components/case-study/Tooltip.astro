---
export interface Props {
    term: string;
    title?: string;
    content: string;
}

const { term, title, content } = Astro.props;
---

<span class="tooltip-wrapper" data-tooltip-wrapper>
    <button
        type="button"
        class="tooltip-trigger"
        aria-haspopup="dialog"
        aria-expanded="false"
        tabindex="0"
    >
        <span class="tooltip-term-text">{term}</span>
        <span class="tooltip-indicator" aria-hidden="true">ⓘ</span>
    </button>
    <span class="tooltip-bubble" role="tooltip" aria-hidden="true">
        {title && <strong class="tooltip-title">{title}</strong>}
        <span class="tooltip-text">{content}</span>
        <span class="tooltip-arrow" aria-hidden="true"></span>
    </span>
</span>

<style>
    .tooltip-wrapper {
        position: relative;
        display: inline-block;
        vertical-align: baseline;
    }

    .tooltip-trigger {
        display: inline-flex;
        align-items: baseline;
        gap: 4px;
        background: none;
        border: none;
        padding: 0 3px;
        margin: 0;
        font: inherit;
        color: inherit;
        font-weight: inherit;
        cursor: help;
        border-bottom: 2px dashed currentColor;
        border-radius: 3px;
        transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
        line-height: inherit;
    }

    .tooltip-trigger:hover,
    .tooltip-trigger:focus-visible,
    .tooltip-wrapper.is-active .tooltip-trigger {
        background-color: rgba(0, 0, 0, 0.08);
        outline: none;
    }

    .tooltip-indicator {
        font-size: 0.75em;
        line-height: 1;
        opacity: 0.75;
        font-weight: 800;
        color: currentColor;
        transition: opacity 0.15s ease;
    }

    .tooltip-trigger:hover .tooltip-indicator,
    .tooltip-wrapper.is-active .tooltip-indicator {
        opacity: 1;
    }

    .tooltip-bubble {
        position: absolute;
        bottom: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        width: max-content;
        max-width: min(320px, 82vw);
        padding: 10px 14px;
        background: #FFFFFF;
        color: #0F172A;
        border: 2px solid #0F172A;
        border-radius: 8px;
        box-shadow: 3.5px 3.5px 0px #0F172A;
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: 0.8125rem;
        line-height: 1.4;
        font-weight: 400;
        text-align: left;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    visibility 0.2s ease;
        z-index: 100;
        box-sizing: border-box;
    }

    .tooltip-wrapper:hover .tooltip-bubble,
    .tooltip-wrapper:focus-within .tooltip-bubble,
    .tooltip-wrapper.is-active .tooltip-bubble {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }

    .tooltip-title {
        display: block;
        font-weight: 800;
        font-size: 0.8125rem;
        margin-bottom: 4px;
        color: #0F172A;
        letter-spacing: -0.01em;
    }

    .tooltip-text {
        display: block;
        color: #334155;
    }

    .tooltip-arrow {
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -6px;
        width: 0;
        height: 0;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #0F172A;
    }

    /* Flip downward when close to top of viewport */
    .tooltip-wrapper.is-flipped .tooltip-bubble {
        bottom: auto;
        top: calc(100% + 10px);
        transform: translateX(-50%) translateY(-4px);
    }

    .tooltip-wrapper.is-flipped:hover .tooltip-bubble,
    .tooltip-wrapper.is-flipped:focus-within .tooltip-bubble,
    .tooltip-wrapper.is-flipped.is-active .tooltip-bubble {
        transform: translateX(-50%) translateY(0);
    }

    .tooltip-wrapper.is-flipped .tooltip-arrow {
        top: auto;
        bottom: 100%;
        border-top: none;
        border-bottom: 6px solid #0F172A;
    }
</style>

<script>
    function initTooltips() {
        document.querySelectorAll("[data-tooltip-wrapper]").forEach((wrapperEl) => {
            const wrapper = wrapperEl as HTMLElement;
            if (wrapper.dataset.tooltipInit === "true") return;
            wrapper.dataset.tooltipInit = "true";

            const trigger = wrapper.querySelector(".tooltip-trigger") as HTMLButtonElement | null;
            const bubble = wrapper.querySelector(".tooltip-bubble") as HTMLElement | null;
            if (!trigger || !bubble) return;

            function updatePosition() {
                const rect = trigger.getBoundingClientRect();
                if (rect.top < 130) {
                    wrapper.classList.add("is-flipped");
                } else {
                    wrapper.classList.remove("is-flipped");
                }

                // Horizontal screen boundary detection
                const bubbleRect = bubble.getBoundingClientRect();
                if (bubbleRect.left < 16) {
                    const offset = 16 - bubbleRect.left;
                    bubble.style.transform = `translateX(calc(-50% + ${offset}px)) translateY(0)`;
                } else if (bubbleRect.right > window.innerWidth - 16) {
                    const offset = (window.innerWidth - 16) - bubbleRect.right;
                    bubble.style.transform = `translateX(calc(-50% + ${offset}px)) translateY(0)`;
                }
            }

            trigger.addEventListener("click", (e) => {
                e.stopPropagation();
                const isActive = wrapper.classList.contains("is-active");
                // Close other tooltips
                document.querySelectorAll("[data-tooltip-wrapper].is-active").forEach((el) => {
                    if (el !== wrapper) {
                        el.classList.remove("is-active");
                        el.querySelector(".tooltip-trigger")?.setAttribute("aria-expanded", "false");
                    }
                });

                if (!isActive) {
                    wrapper.classList.add("is-active");
                    trigger.setAttribute("aria-expanded", "true");
                    updatePosition();
                } else {
                    wrapper.classList.remove("is-active");
                    trigger.setAttribute("aria-expanded", "false");
                }
            });

            trigger.addEventListener("mouseenter", updatePosition);
        });

        // Global click to close tooltips when clicking outside
        if (!(document as any)._tooltipGlobalBound) {
            (document as any)._tooltipGlobalBound = true;

            document.addEventListener("click", (e) => {
                const target = e.target as HTMLElement | null;
                if (!target?.closest("[data-tooltip-wrapper]")) {
                    document.querySelectorAll("[data-tooltip-wrapper].is-active").forEach((el) => {
                        el.classList.remove("is-active");
                        el.querySelector(".tooltip-trigger")?.setAttribute("aria-expanded", "false");
                    });
                }
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") {
                    document.querySelectorAll("[data-tooltip-wrapper].is-active").forEach((el) => {
                        el.classList.remove("is-active");
                        const trigger = el.querySelector(".tooltip-trigger") as HTMLElement | null;
                        trigger?.setAttribute("aria-expanded", "false");
                        trigger?.focus();
                    });
                }
            });
        }
    }

    document.addEventListener("DOMContentLoaded", initTooltips);
    document.addEventListener("astro:page-load", initTooltips);
</script>
