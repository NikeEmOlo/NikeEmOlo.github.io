<script>
    // Smooth, high-performance scroll tracking for spine progress, rider icon, and HUD ticker
    function initCinematicTimeline() {
        const timeline = document.getElementById("story-timeline");
        const spineProgress = document.getElementById("spineProgress");
        const riderMarker = document.getElementById("spineRiderMarker");
        const hudYear = document.getElementById("hudYearDisplay");
        const hudStat = document.getElementById("hudStatTicker");
        const scenes = document.querySelectorAll(".cinema-scene");

        if (!timeline || !spineProgress || !riderMarker || !scenes.length) return;

        let ticking = false;

        function updateScenePositions() {
            const rect = timeline.getBoundingClientRect();
            const windowHeight = window.innerHeight;

            // Calculate overall timeline progress (0 to 1)
            const totalScroll = rect.height - windowHeight;
            const currentScroll = -rect.top;
            const progress = Math.max(0, Math.min(1, currentScroll / totalScroll));

            // Move spine fill & bicycle icon
            spineProgress.style.height = `${progress * 100}%`;
            
            // Marker travels down along the spine
            const spineHeight = timeline.querySelector(".timeline-vertical-spine").clientHeight;
            const markerY = progress * (spineHeight - 24);
            riderMarker.style.transform = `translateY(${markerY}px)`;

            // Detect active scene based on center of viewport
            const triggerLine = windowHeight * 0.45;
            let currentActiveScene = null;

            scenes.forEach((scene) => {
                const sRect = scene.getBoundingClientRect();
                if (sRect.top <= triggerLine && sRect.bottom >= triggerLine) {
                    scene.classList.add("is-focused");
                    currentActiveScene = scene;
                } else {
                    scene.classList.remove("is-focused");
                }
            });

            // Update HUD ticker values
            if (currentActiveScene) {
                const yr = currentActiveScene.getAttribute("data-scene-year");
                const stat = currentActiveScene.getAttribute("data-scene-stat");
                if (yr && hudYear && hudYear.textContent !== yr) hudYear.textContent = yr;
                if (stat && hudStat && hudStat.textContent !== stat) hudStat.textContent = stat;
            }

            ticking = false;
        }

        function onScroll() {
            if (!ticking) {
                requestAnimationFrame(updateScenePositions);
                ticking = true;
            }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        updateScenePositions();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCinematicTimeline);
    } else {
        initCinematicTimeline();
    }
</script>
