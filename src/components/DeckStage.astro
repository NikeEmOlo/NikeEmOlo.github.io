---
import TarotCard from "./tarotCard/TarotCard.astro";
import { CATEGORY_META } from "../categories.js";
import { toRoman } from "../utils/roman.js";

const { total } = Astro.props;
const GHOST_COUNT = 6;
---

<div class="deck-stage" id="deck-stage" data-active-category="all">
    <div class="deck-ghosts" id="deck-ghosts" aria-hidden="true">
        {Array.from({ length: GHOST_COUNT }).map((_, i) => (
            <span class="ghost" data-ghost-index={i}></span>
        ))}
    </div>
    <TarotCard numeral={toRoman(total)} icon="crab" label="Selected work" />
    <p class="deck-caption" id="deck-caption">All work</p>
</div>

<style define:vars={{
    devGradient: CATEGORY_META.development.gradient,
    delGradient: CATEGORY_META.delivery.gradient,
    opsGradient: CATEGORY_META.operations.gradient,
}}>
    .deck-stage {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
        width: 100%;
        min-height: clamp(320px, 40vh, 480px);
        /* --tarot-gradient is re-scoped to this subtree only: the deck's front
           card and ghost layers read it, but nothing outside the deck (nav,
           list chips, etc.) is affected since custom properties cascade down
           the DOM, not sideways. */
        --tarot-gradient: var(--deck-gradient, linear-gradient(0.3turn, #359E9D 0%, #704898 42%, #BE83D3 82%, #359E9D 99%));
    }

    .deck-stage[data-active-category="development"] {
        --deck-gradient: var(--devGradient);
    }

    .deck-stage[data-active-category="delivery"] {
        --deck-gradient: var(--delGradient);
    }

    .deck-stage[data-active-category="operations"] {
        --deck-gradient: var(--opsGradient);
    }

    .deck-ghosts {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .ghost {
        position: absolute;
        width: var(--tarot-card-w);
        height: var(--tarot-card-h);
        border-radius: var(--tarot-card-radius);
        background: var(--tarot-gradient);
        transition: background 0.15s ease;
    }

    /* Resting fan-out, applied as a baseline in CSS; the deck-shuffle script
       overrides these with GSAP during the shuffle animation and restores
       them afterwards so JS and CSS never fight over the same property. */
    .ghost[data-ghost-index="0"] { opacity: 0.22; transform: translate(-14px, 9px) rotate(-7deg); }
    .ghost[data-ghost-index="1"] { opacity: 0.3; transform: translate(11px, 7px) rotate(6deg); }
    .ghost[data-ghost-index="2"] { opacity: 0.4; transform: translate(-9px, 5px) rotate(-5deg); }
    .ghost[data-ghost-index="3"] { opacity: 0.52; transform: translate(7px, 4px) rotate(4deg); }
    .ghost[data-ghost-index="4"] { opacity: 0.65; transform: translate(-5px, 2px) rotate(-2.5deg); }
    .ghost[data-ghost-index="5"] { opacity: 0.8; transform: translate(3px, 1px) rotate(1.5deg); }

    .deck-stage :global(.card-main) {
        position: relative;
        z-index: 10;
    }

    .deck-caption {
        font-family: var(--secondary-font);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted-text);
        transition: color 0.2s ease;
    }

    @media (prefers-reduced-motion: reduce) {
        .ghost {
            transition: none;
        }
    }
</style>
