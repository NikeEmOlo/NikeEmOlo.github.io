---
import Base from '../layouts/Base.astro';
import HoloProjectCard from '../components/HoloProjectCard.astro';
import LinkedInJobCard from '../components/LinkedInJobCard.astro';
import DoodleLinkedInJobCard from '../components/DoodleLinkedInJobCard.astro';
import DoodleVinylRecord from '../components/DoodleVinylRecord.astro';
---
<Base>
  <div class="sandbox-scroll-wrap">
    <!-- Header -->
    <header class="sandbox-intro-stage">
      <div class="intro-box">
        <span class="sandbox-badge">Component Lab // Interactive Assets</span>
        <h1 class="sandbox-title">Interactive Project Cards & Assets</h1>
        <p class="sandbox-hint">Test holographic trading cards, doodle pop assets, and UI components.</p>
        
        <div class="sandbox-nav-chips">
          <a href="#holo-trading-cards" class="nav-chip">✨ Holo Trading Cards</a>
          <a href="#vinyl-record" class="nav-chip">🎵 Vinyl Record</a>
          <a href="#job-cards" class="nav-chip">💼 Job Cards</a>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
          </svg>
        </div>
      </div>
    </header>

    <!-- SECTION 1: HOLOGRAPHIC TRADING PROJECT CARDS -->
    <section id="holo-trading-cards" class="sandbox-card-stage">
      <div class="variant-label">
        <span class="variant-tag">Interactive Asset // Secret Rare Holographic Trading Cards</span>
        <span class="variant-desc">
          Pure CSS & SVG card engine with dynamic HTML typography, Secret Rare etched foil, spectral color-dodge, 3D cursor tilt, and 3D click flip.
        </span>
      </div>

      <div class="cards-grid">
        <!-- Card 1: Automating Unemployment -->
        <div class="card-display-anchor">
          <HoloProjectCard
            title="AUTOMATING UNEMPLOYMENT"
            subtitle="Case Study"
            category="Agentic Workflow Implementation"
            statLabel="RESULTS"
            statValue="85% TIME SAVINGS"
            iconSrc="/img/robot-icon.svg"
            imageUrl="/holo-card/afro-lounger-art.webp"
            maskUrl="/holo-card/afro-lounger-mask.png"
            cardBg="#00B3E3"
            borderColor="#007A99"
            borderWidth="16px"
            holoEffect="secret_rare_etched"
          />
        </div>

        <!-- Card 2: How I Made This Website -->
        <div class="card-display-anchor">
          <HoloProjectCard
            title="HOW I MADE THIS WEBSITE"
            subtitle="Case Study"
            category="Creative Web & AI Workflows"
            statLabel="TECH STACK"
            statValue="ASTRO + CSS SHADERS"
            iconSrc="/img/robot-icon.svg"
            imageUrl="/holo-card/how-i-made-this-website-art.webp"
            maskUrl="/holo-card/how-i-made-this-website-mask.png"
            cardBg="#93619C"
            borderColor="#8353A3"
            borderWidth="16px"
            holoEffect="secret_rare_etched"
          />
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="variant-divider"></div>

    <!-- SECTION 3: VINYL RECORD COMPONENT SHOWCASE -->
    <section id="vinyl-record" class="sandbox-card-stage" style="background-color: var(--doodle-cyan, #00B3E3); border-radius: 20px; padding: 48px 24px; margin-bottom: 40px;">
      <div class="variant-label" style="margin-bottom: 32px;">
        <span class="variant-tag" style="background: #000000; color: #FFFFFF;">Interactive Asset // AI Doom Loop Vinyl Record</span>
        <span class="variant-desc" style="color: rgba(255, 255, 255, 0.9);">
          Pure vector SVG with separated rotating disc, sound grooves, center label, and stationary optical specular light sheen. <strong>Click & drag to scratch!</strong>
        </span>
      </div>
      <DoodleVinylRecord
        size={420}
        autoSpin={true}
        interactive={true}
        lightMode="stationary"
      />
    </section>

    <!-- Divider -->
    <div class="variant-divider"></div>

    <!-- SECTION 4: JOB CARDS -->
    <div id="job-cards">
      <!-- VARIANT 2: STREETWEAR DOODLE POP (CARTOON WORLD) -->
      <section class="sandbox-card-stage">
        <div class="variant-label">
          <span class="variant-tag">Option B // Streetwear Doodle Pop</span>
          <span class="variant-desc">Bold ink contours, hard cel-shadows, glossy vinyl glints, kinetic scribble doodles & comic dust puff.</span>
        </div>
        <DoodleLinkedInJobCard
          company="Nota Scam"
          title="One junior role please"
          location="London, England, United Kingdom"
          showReplay={true}
        />
      </section>

      <!-- Divider -->
      <div class="variant-divider"></div>

      <!-- VARIANT 1: REALISTIC UI -->
      <section class="sandbox-card-stage">
        <div class="variant-label">
          <span class="variant-tag">Option A // Authentic LinkedIn Desktop</span>
          <span class="variant-desc">1:1 pixel replica of native LinkedIn design system & typography.</span>
        </div>
        <LinkedInJobCard
          company="Nota Scam"
          title="One junior role please"
          location="London, England, United Kingdom"
          showReplay={true}
        />
      </section>
    </div>

    <!-- Outro Spacer -->
    <footer class="sandbox-outro-stage">
      <p class="sandbox-hint">All interactive component assets available in the portfolio design system.</p>
    </footer>
  </div>
</Base>

<style>
  body {
    background-color: #000000;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  .sandbox-scroll-wrap {
    width: 100%;
    min-height: 240vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sandbox-intro-stage,
  .sandbox-outro-stage {
    width: 100%;
    height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }

  .intro-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 700px;
  }

  .sandbox-badge {
    font-size: 0.75rem;
    font-family: monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffd233;
    background: #18181b;
    border: 1.5px solid #27272a;
    padding: 4px 14px;
    border-radius: 9999px;
  }

  .sandbox-title {
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .sandbox-hint {
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: 0.95rem;
    color: #a1a1aa;
    margin: 0;
    line-height: 1.5;
  }

  .sandbox-nav-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 8px;
  }

  .nav-chip {
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: #e4e4e7;
    background: #18181b;
    border: 1.5px solid #3f3f46;
    padding: 6px 14px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-chip:hover {
    background: #ffd233;
    color: #000000;
    border-color: #ffd233;
    transform: translateY(-2px);
  }

  .scroll-cue {
    margin-top: 24px;
    color: #a1a1aa;
    animation: bounceSlow 2s infinite ease-in-out;
  }

  @keyframes bounceSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  .sandbox-card-stage {
    width: 100%;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 60px 20px;
    scroll-margin-top: 40px;
  }

  .variant-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .variant-tag {
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffd233;
    background: #18181b;
    border: 1.5px solid #27272a;
    padding: 4px 14px;
    border-radius: 9999px;
  }

  .variant-desc {
    font-family: var(--archivo-font), "Archivo", sans-serif;
    font-size: 0.9rem;
    color: #a1a1aa;
    max-width: 580px;
    line-height: 1.5;
  }

  .cards-grid {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 0;
  }

  .card-display-anchor {
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1200px;
  }

  .tarot-grid {
    gap: 40px;
  }

  .tarot-display-anchor {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 320px;
    height: 480px;
  }

  .variant-divider {
    width: 100%;
    max-width: 700px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #27272a, transparent);
    margin: 40px 0;
  }
</style>