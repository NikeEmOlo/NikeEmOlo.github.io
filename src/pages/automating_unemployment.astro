<script>
  function initAUScrollytelling() {
    const runway = document.getElementById("hero-runway");
    const curtain = document.getElementById("heroCurtainLayer");
    const titleEl = document.querySelector("[data-hero-title]");
    const dilemmaHeader = document.querySelector("[data-dilemma-header]");
    const dilemmaBody = document.querySelector("[data-dilemma-body]");

    // Interactive choice selection & dynamic pop-up logic
    let selectionAttempts = 0;
    let lastChoice: string | null = null;
    const choice1Btn = document.getElementById("choiceOption1");
    const choice2Btn = document.getElementById("choiceOption2");
    const answerPopup = document.getElementById("dilemmaAnswerPopup");
    const popupTitle = document.getElementById("popupTitle");
    const popupText = document.getElementById("popupText");
    const popupActionBtn = document.getElementById("popupActionBtn");
    const popupActionBtnText = document.getElementById("popupActionBtnText");
    const benefitsFrameWrap = document.getElementById("benefitsFrameWrap");
    const benefitsRunway = benefitsFrameWrap;
    const benefitsCurtainLayer = document.getElementById("benefitsCurtainLayer");
    const exploreWorkflowBtn = document.getElementById("exploreWorkflowBtn");
    const scrollToWorkflowStepsBtn = document.getElementById("scrollToWorkflowStepsBtn");

    // The layout uses ClientRouter, so `astro:page-load` fires on the FIRST
    // load as well as after every view transition — and this init also runs
    // from the readyState branch below. Every handler was therefore bound
    // twice, which silently cancelled anything that toggles: click once, the
    // first listener turns it on and the second turns it straight back off.
    // Marking the element means a re-run rebinds only genuinely new DOM.
    function bindOnce(
      el: Element | null,
      type: string,
      handler: EventListenerOrEventListenerObject,
      key: string,
    ) {
      if (!el) return;
      const flag = `bound${key}`;
      if ((el as HTMLElement).dataset[flag] === "1") return;
      (el as HTMLElement).dataset[flag] = "1";
      el.addEventListener(type, handler);
    }

    function openAnswerPopup(choiceNumber: string) {
      const isRepeatChoice = lastChoice !== null && choiceNumber === lastChoice;
      if (!isRepeatChoice) {
        selectionAttempts += 1;
      }
      lastChoice = choiceNumber;

      if (choice1Btn) choice1Btn.classList.toggle("is-selected", choiceNumber === "1");
      if (choice2Btn) choice2Btn.classList.toggle("is-selected", choiceNumber === "2");

      if (selectionAttempts === 1) {
        if (popupTitle) popupTitle.textContent = "WRONG";
        if (popupActionBtnText) popupActionBtnText.textContent = "try again";

        if (choiceNumber === "1") {
          if (popupText) popupText.textContent = "You can't afford food";
        } else {
          if (popupText) {
            popupText.textContent =
              "You spend around 12 hours a day searching for and applying for jobs, leaving no time to complete your training.";
          }
        }
      } else {
        if (popupTitle) popupTitle.textContent = "ALSO WRONG";
        if (popupActionBtnText) popupActionBtnText.textContent = "wth?";

        if (choiceNumber === "1") {
          if (popupText) popupText.textContent = "You can't afford food";
        } else {
          if (popupText) {
            popupText.textContent =
              "You spend around 12 hours a day searching for and applying for jobs, leaving no time to complete your training.";
          }
        }
      }

      if (answerPopup) {
        answerPopup.classList.add("is-visible");
        answerPopup.setAttribute("aria-hidden", "false");
      }
    }

    function closeAnswerPopup() {
      if (answerPopup) {
        answerPopup.classList.remove("is-visible");
        answerPopup.setAttribute("aria-hidden", "true");
      }
      if (choice1Btn) choice1Btn.classList.remove("is-selected");
      if (choice2Btn) choice2Btn.classList.remove("is-selected");
    }

    function raiseBenefitsCurtain() {
      if (!benefitsRunway) return;
      const rect = benefitsRunway.getBoundingClientRect();
      const liftDistance = rect.height - window.innerHeight;
      if (liftDistance <= 0) return;
      window.scrollTo({
        top: window.scrollY + rect.top + liftDistance,
        behavior: "smooth",
      });
    }

    function handlePopupAction() {
      const currentBtnText = popupActionBtnText?.textContent?.trim().toLowerCase();
      if (currentBtnText === "try again") {
        closeAnswerPopup();
      } else if (currentBtnText === "wth?" || currentBtnText === "wtf" || currentBtnText === "wth") {
        closeAnswerPopup();
        // On desktop the benefits curtain is absolutely positioned inside the
        // sticky viewport and moved by a scroll-driven transform, so
        // scrollIntoView resolves to "already in place" and nothing happens.
        // Drive its runway instead — the same path the "Explore how it works"
        // button takes. Below 860px that runway is display:none, so fall back
        // to scrolling the (then static) curtain into view.
        // Scroll to the START of the runway, where the yellow curtain is
        // fully down. raiseBenefitsCurtain() goes to the END of the lift,
        // which is the "Explore how it works" behaviour and overshoots the
        // benefits entirely.
        const runway = benefitsRunway;
        if (runway && runway.getBoundingClientRect().height > window.innerHeight) {
          window.scrollTo({
            top: window.scrollY + runway.getBoundingClientRect().top,
            behavior: "smooth",
          });
        } else {
          document
            .getElementById("benefitsCurtainLayer")
            ?.scrollIntoView({ behavior: "smooth" });
        }
      } else {
        closeAnswerPopup();
      }
    }

    bindOnce(choice1Btn, "click", () => openAnswerPopup("1"), "Choice1");
    bindOnce(choice2Btn, "click", () => openAnswerPopup("2"), "Choice2");
    // The popup action button is deliberately the only way out: no ✕, no
    // backdrop dismissal. The copy is part of the argument the section makes,
    // so the reader has to acknowledge it rather than swipe past it.
    bindOnce(popupActionBtn, "click", handlePopupAction, "PopupAction");

    bindOnce(exploreWorkflowBtn, "click", raiseBenefitsCurtain, "ExploreWf");
    bindOnce(scrollToWorkflowStepsBtn, "click", () => {
      const wf = document.getElementById("workflow-steps");
      if (wf) wf.scrollIntoView({ behavior: "smooth" });
    }, "ScrollWf");

    // ----------------------------------------------------
    // MOBILE TOUCH GESTURE CONTROLLER (QUICK SWIPE VS SLOW SCROLL)
    // ----------------------------------------------------
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;

    function getSnapSections(): HTMLElement[] {
      const selectors = [
        "#hero-runway",
        "#hero",
        "#benefitsCurtainLayer",
        ".team-hierarchy-section",
        "#workflow-steps",
        "#doom-section",
        ".story-epilogue",
      ];
      return selectors
        .map((s) => document.querySelector(s) as HTMLElement)
        .filter((el): el is HTMLElement => !!el && el.offsetHeight > 0);
    }

    function scrollToSection(direction: "next" | "prev") {
      const sections = getSnapSections();
      if (!sections.length) return;

      const buffer = 50;

      if (direction === "next") {
        const next = sections.find((sec) => {
          const rect = sec.getBoundingClientRect();
          return rect.top > buffer;
        });
        if (next) {
          next.scrollIntoView({ behavior: "smooth" });
        }
      } else {
        const prevList = sections.filter((sec) => {
          const rect = sec.getBoundingClientRect();
          return rect.top < -buffer;
        });
        if (prevList.length > 0) {
          const prev = prevList[prevList.length - 1];
          prev.scrollIntoView({ behavior: "smooth" });
        } else {
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      }
    }

    window.addEventListener(
      "touchstart",
      (e) => {
        if (window.innerWidth > 860) return;
        if (e.touches.length !== 1) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      },
      { passive: true },
    );

    window.addEventListener(
      "touchend",
      (e) => {
        if (window.innerWidth > 860) return;
        if (e.changedTouches.length !== 1) return;
        const deltaX = touchStartX - e.changedTouches[0].clientX;
        const deltaY = touchStartY - e.changedTouches[0].clientY;
        const elapsed = Date.now() - touchStartTime;

        // Quick flick detection: fast duration (< 320ms), clear vertical motion (> 40px), predominantly vertical
        const isQuickFlick = elapsed < 320 && Math.abs(deltaY) > 40 && Math.abs(deltaY) > Math.abs(deltaX) * 1.25;

        if (isQuickFlick) {
          if (deltaY > 0) {
            // Quick swipe UP -> snap smoothly to next section
            scrollToSection("next");
          } else {
            // Quick swipe DOWN -> snap smoothly to previous section
            scrollToSection("prev");
          }
        }
        // Slow swipe / drag (elapsed >= 320ms) allows free natural scrolling!
      },
      { passive: true },
    );

    // Doom loop IntersectionObserver
    const doomOrbit = document.querySelector("[data-doom-orbit]");
    if (doomOrbit && !doomOrbit.hasAttribute("data-doom-bound")) {
      doomOrbit.setAttribute("data-doom-bound", "1");
      doomOrbit.classList.add("is-armed");
      const orbitObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            doomOrbit.classList.add("is-live");
            orbitObserver.disconnect();
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -20px 0px" },
      );
      orbitObserver.observe(doomOrbit);
    }

    function syncBenefitsLift() {
      if (window.innerWidth <= 860 || !benefitsRunway) return;
      const howViewport = document.querySelector(".how-sticky-viewport");
      const mockup = document.querySelector(".device-screen-mockup");
      const zoom = document.querySelector("[data-desktop-zoom]");
      if (!howViewport || !mockup) return;
      if (zoom && zoom.classList.contains("is-fullscreen")) return;

      const vh = window.innerHeight;
      const peek = vh * 0.15;
      const desktopOffset =
        mockup.getBoundingClientRect().top - howViewport.getBoundingClientRect().top;
      const lift = Math.round(vh - peek - desktopOffset + 10);
      benefitsRunway.style.setProperty(
        "--benefits-lift",
        `${Math.max(lift, Math.round(vh * 0.35))}px`,
      );
    }

    function onBenefitsScroll() {
      if (window.innerWidth <= 860 || !benefitsRunway || !benefitsCurtainLayer) {
        if (benefitsCurtainLayer && window.innerWidth <= 860) {
          benefitsCurtainLayer.style.transform = "none";
          benefitsCurtainLayer.style.pointerEvents = "auto";
        }
        return;
      }
      const rect = benefitsRunway.getBoundingClientRect();
      const liftDistance = rect.height - window.innerHeight;
      if (liftDistance <= 0) return;

      if (rect.top > 0) {
        benefitsCurtainLayer.style.transform = `translateY(${rect.top.toFixed(2)}px)`;
        benefitsCurtainLayer.style.pointerEvents = "auto";
        return;
      }

      const p = Math.min(Math.max(-rect.top / liftDistance, 0), 1);
      const translateY = Math.min(p * 105, 105);
      benefitsCurtainLayer.style.transform = `translateY(-${translateY.toFixed(2)}%)`;
      benefitsCurtainLayer.style.pointerEvents = p >= 0.95 ? "none" : "auto";
    }

    window.addEventListener("scroll", onBenefitsScroll, { passive: true });
    window.addEventListener("resize", () => {
      syncBenefitsLift();
      onBenefitsScroll();
    });
    syncBenefitsLift();
    onBenefitsScroll();

    if (!runway || !curtain) return;

    function onScroll() {
      if (!runway || !curtain) return;
      const rect = runway.getBoundingClientRect();
      const runwayHeight = rect.height - window.innerHeight;
      if (runwayHeight <= 0) return;

      const scrolled = -rect.top;
      const p = Math.min(Math.max(scrolled / runwayHeight, 0), 1);

      // Smooth translation of hero curtain on both mobile and desktop
      const translateY = Math.min(p * 105, 105);
      curtain.style.transform = `translateY(-${translateY.toFixed(2)}%)`;
      curtain.style.pointerEvents = p >= 0.92 ? "none" : "auto";

      if (titleEl) {
        const titleOp = Math.max(0, 1 - p * 2.2);
        (titleEl as HTMLElement).style.opacity = titleOp.toFixed(3);
      }

      if (dilemmaHeader) {
        (dilemmaHeader as HTMLElement).style.opacity = "1";
      }
      if (dilemmaBody) {
        (dilemmaBody as HTMLElement).style.opacity = "1";
      }
    }

    // Footer Copy Email Quick Action
    const footerCopyBtn = document.getElementById("footerCopyEmailBtn");
    if (footerCopyBtn) {
      bindOnce(footerCopyBtn, "click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const email = "nike.emily@pm.me";
        navigator.clipboard?.writeText(email).then(() => {
          const copyText = footerCopyBtn.querySelector(".copy-btn-text");
          if (copyText) {
            const prevText = copyText.textContent;
            copyText.textContent = "Copied! ✓";
            footerCopyBtn.classList.add("is-copied");
            setTimeout(() => {
              copyText.textContent = prevText;
              footerCopyBtn.classList.remove("is-copied");
            }, 2000);
          }
        }).catch(() => {
          const copyText = footerCopyBtn.querySelector(".copy-btn-text");
          if (copyText) {
            copyText.textContent = "nike.emily@pm.me";
          }
        });
      }, "FooterCopy");
    }

    // Agent cards collapse to banner + name + role below 860px; this toggles
    // the brief and telemetry tray back in. The button itself is display:none
    // on desktop, so nothing here has any effect there.
    document.querySelectorAll(".node-expand-btn").forEach((btn) => {
      if (btn.hasAttribute("data-expand-bound")) return;
      btn.setAttribute("data-expand-bound", "1");
      btn.addEventListener("click", () => {
        const card = btn.closest(".agent-node-card");
        if (!card) return;
        const open = card.classList.toggle("is-expanded");
        btn.setAttribute("aria-expanded", String(open));
        const label = btn.querySelector(".node-expand-label");
        if (label) label.textContent = open ? "Read less" : "Read more";
      });
    });

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAUScrollytelling);
  } else {
    initAUScrollytelling();
  }
  document.addEventListener("astro:page-load", initAUScrollytelling);
</script>
