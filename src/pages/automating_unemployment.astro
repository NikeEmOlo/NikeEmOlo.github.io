  .doom-orbit-centre {
    grid-column: 2;
    grid-row: 1 / span 2;
    /* The grid centres its items, which would size this to content and shrink
       the card; stretch it so the listing fills the full centre track. */
    justify-self: stretch;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    /* The card slams in; hold its ground so the notes do not jump */
    min-height: 100%;
  }

  .doom-orbit-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
