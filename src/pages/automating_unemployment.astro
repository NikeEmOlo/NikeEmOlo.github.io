  /* 1. Return to Home Button */
  .footer-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    text-decoration: none;
    border-radius: 9999px;
    padding: 10px 22px;
    background: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2.5px 3.5px 0px #000000;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .footer-home-btn:hover {
    background: var(--doodle-yellow, #FFDA00);
    transform: translateY(-2px);
    box-shadow: 2.5px 5px 0px #000000;
  }
  .footer-home-btn:active {
    transform: translateY(1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* 2 & 3. Contact Sticker Nodes */
  .footer-contact-node {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    padding: 2px;
    border-radius: 12px;
    transition: transform 0.15s ease;
  }

  .footer-contact-icon-img {
    display: block;
    height: auto;
    transition: transform 0.15s ease;
    user-select: none;
    filter: drop-shadow(2px 3px 0px rgba(0, 0, 0, 0.4));
  }

  .footer-icon-link:hover .footer-contact-icon-img {
    animation: iconVibrate 0.25s linear infinite;
    transform: scale(1.1);
  }

  /* Pop-out copy email tooltip button */
  .footer-copy-email-btn {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(8px) scale(0.85);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    border: 2px solid #000000;
    border-radius: 9999px;
    background: #ffffff;
    color: #0F172A;
    font-family: var(--archivo-font, 'Archivo', sans-serif);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    box-shadow: 2px 3px 0px #000000;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease, visibility 0.2s ease, background-color 0.15s ease;
    z-index: 20;
  }

  .footer-copy-email-btn::after {
    content: "";
    position: absolute;
    top: 100%;
    bottom: -16px;
    left: -12px;
    right: -12px;
    background: transparent;
    z-index: -1;
  }

  .footer-contact-node.node-email:hover .footer-copy-email-btn,
  .footer-contact-node.node-email:focus-within .footer-copy-email-btn,
  .footer-copy-email-btn:hover,
  .footer-copy-email-btn:focus,
  .footer-copy-email-btn.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .footer-copy-email-btn:hover {
    background: var(--doodle-yellow, #FFDA00);
    box-shadow: 2.5px 4px 0px #000000;
  }

  .footer-copy-email-btn.is-copied {
    background: var(--doodle-lime, #D1FF00) !important;
    color: #000000 !important;
  }

