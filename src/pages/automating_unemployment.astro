      display: flex !important;
    }

    /* 2. Hero Section */
    .hero-float-center {
      left: 50% !important;
      top: 40% !important;
      transform: translate(-50%, -50%) !important;
      width: 90% !important;
      max-width: 360px !important;
      text-align: center !important;
    }

    .hero-title-text {
      text-align: center !important;
      align-items: center !important;
      justify-content: center !important;
      font-size: clamp(1.2rem, 5.5vw, 1.55rem) !important;
      line-height: 1.28 !important;
      font-weight: 800 !important;
    }

    .hero-lounger-corner {
      bottom: 24px !important;
      left: 50% !important;
      right: auto !important;
      transform: translateX(-50%) !important;
    }

    .hero-lounger-img {
      width: clamp(140px, 38vw, 180px) !important;
    }

    /* 3. Dilemma White Stage (Screenshot 1 Redesign & Spacing Fix) */
    .hero-scrolly-runway {
      height: 180dvh !important;
      min-height: 180dvh !important;
    }

    .figma-hero-stage {
      height: 100dvh !important;
      min-height: 100dvh !important;
      background-color: #ffffff !important;
    }

    .dilemma-white-stage {
      padding: 56px 16px 20px !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
      box-sizing: border-box !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch !important;
      display: flex !important;
      flex-direction: column !important;
      /* flex-start + auto block margins on the child centres the content when
         it fits and lets it scroll from the top when it doesn't. Centring via
         justify-content strands the overflow beyond the scroll origin. */
      justify-content: flex-start !important;
      align-items: center !important;
      background: #ffffff !important;
    }

    /* Container: vertically centered with 1rem gap */
    .dilemma-content-wrapper {
      height: auto !important;
      min-height: 0 !important;
      flex: 0 0 auto !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      width: 100% !important;
      max-width: 420px !important;
      margin: auto !important;
      gap: 1rem !important;
    }

    /* Group 1: Title Header (Eyebrow + Title with 1rem gap) */
    .dilemma-header-group {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      gap: 1rem !important;
      width: 100% !important;
      margin: 0 !important;
      flex-shrink: 0 !important;
    }

    .desktop-sub-lead {
      display: none !important;
    }

    /* An eyebrow should sit under the body text, not over it. At 0.88rem/800
       the uppercase, letter-spaced monospace was out-weighing the 1rem lead
       it was meant to introduce — more so now the title is hidden. */
    .dilemma-eyebrow {
      font-size: 0.7rem !important;
      font-family: monospace !important;
      font-weight: 700 !important;
      letter-spacing: 0.1em !important;
      color: #8a8a93 !important;
    }

    /* The question ("Do you know how time consuming it is to be unemployed?
       I do.") is dropped on mobile — the eyebrow and the sub-lead already set
       up the scenario, and the height it frees is what lets the choice cards
       and the character breathe inside the one-screen stage. */
    .dilemma-title {
      display: none !important;
    }

    .dilemma-punchline {
      display: inline-block !important;
      vertical-align: middle !important;
      font-size: 0.88em !important;
      padding: 1px 11px !important;
      margin-left: 6px !important;
      background: var(--doodle-yellow, #FFDA00) !important;
      border: 2.5px solid #000000 !important;
      border-radius: 9999px !important;
      box-shadow: 2px 2.5px 0px #000000 !important;
      color: #000000 !important;
    }

    /* Group 2: Prompt + Decision Stage (gap set to 2rem) */
    .dilemma-decision-stage {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 2rem !important;
      width: 100% !important;
      margin: 0 !important;
    }

    /* With the title hidden this is the section's lead, so it steps up above
       the card copy (1rem/700) instead of matching it. Width is pinned to the
       cards' 340px rather than a ch measure, which would drift wider as the
       size grows and break the shared left/right edge. */
    .mobile-sub-lead {
      display: block !important;
      order: 0 !important;
      font-size: 1.12rem !important;
      line-height: 1.42 !important;
