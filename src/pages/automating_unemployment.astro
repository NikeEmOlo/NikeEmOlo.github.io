  /* ---------------------------------------------------- */
  /* THE LOOP: LISTING LANDS CENTRE, NOTES ASSEMBLE ROUND  */
  /* ---------------------------------------------------- */
  .doom-orbit {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: clamp(18px, 2.6vw, 40px);
    align-items: center;
    justify-items: center;
  }

  .doom-orbit-notes {
    display: contents;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .doom-orbit-centre {
    grid-column: 2;
    grid-row: 1 / span 2;
    /* The grid centres its items, which would size this to content and shrink
       the card; stretch it so the listing fills the full centre track. */
    justify-self: stretch;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    /* The card slams in; hold its ground so the notes do not jump */
    min-height: 100%;
  }

  .doom-orbit-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 320px;
    background: #ffffff;
    border: 2.5px solid #000000;
    border-radius: 14px;
    box-shadow: 4px 5px 0px #000000;
    padding: 14px 16px;
    box-sizing: border-box;
  }

  .doom-orbit-note.note-1 { grid-column: 1; grid-row: 1; }
  .doom-orbit-note.note-2 { grid-column: 3; grid-row: 1; }
  .doom-orbit-note.note-3 { grid-column: 1; grid-row: 2; }
  .doom-orbit-note.note-4 { grid-column: 3; grid-row: 2; }

  .doom-note-num {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--note-accent, #FFDA00);
    border: 2.5px solid #000000;
    border-radius: 9px;
    box-shadow: 2px 2px 0px #000000;
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 900;
    color: #000000;
  }

  .doom-note-text {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.5;
    color: #18181b;
    margin: 0;
  }

  /* Sequential reveal, kicked off once the section is on screen. The delay
     offset leaves room for the listing to land first.
     The hidden state is scoped to .is-armed, which only JS adds, so the notes
     stay readable if the script never runs. */
  .doom-orbit.is-armed .doom-orbit-note {
    opacity: 0;
    transform: translateY(16px) scale(0.95);
  }

  .doom-orbit.is-armed.is-live .doom-orbit-note {
    animation: doomNoteIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 260ms + 460ms);
  }

  @keyframes doomNoteIn {
    from { opacity: 0; transform: translateY(16px) scale(0.95); }
    60%  { opacity: 1; transform: translateY(-3px) scale(1.02); }
    to   { opacity: 1; transform: none; }
  }

  .doom-closing {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: clamp(0.92rem, 1.15vw, 1.05rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
    text-align: center;
    max-width: 60ch;
    margin: 0 auto;
    text-wrap: balance;
  }

  @media (max-width: 900px) {
    .doom-orbit {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 18px;
    }
    .doom-orbit-centre {
      grid-column: 1;
      grid-row: 1;
      min-height: 0;
      margin-bottom: 6px;
    }
    .doom-orbit-note.note-1,
    .doom-orbit-note.note-2,
    .doom-orbit-note.note-3,
    .doom-orbit-note.note-4 {
      grid-column: 1;
      grid-row: auto;
      max-width: 460px;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .doom-orbit.is-armed .doom-orbit-note { opacity: 1; transform: none; }
    .doom-orbit.is-armed.is-live .doom-orbit-note { animation: none; }
  }

  /* ---------------------------------------------------- */
  /* EPILOGUE & FOOTER                                    */
  /* ---------------------------------------------------- */
  .story-epilogue {
    width: 100%;
    max-width: 900px;
