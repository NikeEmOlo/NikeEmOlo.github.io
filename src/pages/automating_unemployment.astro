---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import DoodleLinkedInJobCard from "../components/DoodleLinkedInJobCard.astro";
import AgentTreeIcons from "../components/mascots/AgentTreeIcons.astro";
import GraffitiMarks from "../components/mascots/GraffitiMarks.astro";
import HowItWorksWorkflow from "../components/HowItWorksWorkflow.astro";

const project = await getEntry("projects", "automating_unemployment");
const story = project?.data?.story || {};
const agents = story?.agents || story?.vignette3?.agents || [];
---

<Base>
  <div class="height-story-wrap">
    <!-- Minimalist Top Navigation -->
    <header class="story-header" id="storyHeader">
      <a href="/" class="header-back" id="headerBackBtn" aria-label="Return to portfolio home">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span id="headerBackText">Home</span>
      </a>
      <div class="header-case-no">01 // Case Study</div>
    </header>

    <!-- ============================================================ -->
    <!-- 01 // HERO SCROLLYTELLING RUNWAY (STAGE CURTAIN + DILEMMA FRAME) -->
    <!-- ============================================================ -->
    <div class="hero-scrolly-runway" id="hero-runway">
      <section class="figma-hero-stage" id="hero">
        
        <!-- FRAME 2: WHITE CANVAS (REVEALED UNDERNEATH THE CURTAIN) -->
        <div class="dilemma-white-stage" data-dilemma-stage>
          
          <!-- STATE A: Dilemma Questions & Choice Stage -->
          <div class="dilemma-content-wrapper" id="dilemmaQuestionsWrap">
            
            <!-- Top-Left Title & Punchline -->
            <div class="dilemma-header-group" data-dilemma-header>
              <span class="dilemma-eyebrow">01 // THE REALITY OF UNEMPLOYMENT</span>
              <h2 class="dilemma-title">
                Do you know how time consuming it is to be unemployed?
                <span class="dilemma-punchline">I do.</span>
              </h2>
              <p class="dilemma-sub-lead">
                You're a career changer who has just moved to London. You want to transition into tech, but you're currently mid-way through your training. Do you:
              </p>
            </div>

            <!-- Centered Choice Stage: Left Option, Center Character, Right Option -->
            <div class="dilemma-decision-stage" data-dilemma-body>
              
              <!-- Option 1 (Selectable Button Card) -->
              <button
                class="dilemma-choice-btn choice-left"
                id="choiceOption1"
                data-choice="1"
                type="button"
                aria-label="Option 1: Finish your training course which will take months, then apply for jobs in the industry you're training for"
              >
                <!-- Corner Doodle Sparks -->
                <div class="card-doodle-spark top-right" aria-hidden="true">
                  <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
                    <path d="M16 2 L18.5 11.5 L28 14 L18.5 16.5 L16 26 L13.5 16.5 L4 14 L13.5 11.5 Z" fill="#000000" />
                    <circle cx="16" cy="14" r="2.5" fill="#FFFFFF" />
                  </svg>
                </div>

                <div class="choice-tag-row">
                  <span class="choice-num-badge">1</span>
                  <span class="choice-hint">Choice A</span>
                </div>
                <p class="choice-main-text">
                  Finish your training course which will take months, then apply for jobs in the industry you're training for
                </p>
                <div class="choice-bottom-bar">
                  <span class="choice-pick-pill">Pick this one</span>
                </div>
              </button>

              <!-- Center Confused Mascot -->
              <div class="dilemma-center-character">
                <img
                  src="/img/au-character-confused.png"
                  alt="Character standing in confusion choosing between two options"
                  class="dilemma-standing-img"
                />
              </div>

              <!-- Option 2 (Selectable Button Card) -->
              <button
                class="dilemma-choice-btn choice-right"
                id="choiceOption2"
                data-choice="2"
                type="button"
                aria-label="Option 2: Work and train at the same time"
              >
                <!-- Corner Doodle Sparks -->
                <div class="card-doodle-spark top-left" aria-hidden="true">
                  <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
                    <path d="M16 2 L18.5 11.5 L28 14 L18.5 16.5 L16 26 L13.5 16.5 L4 14 L13.5 11.5 Z" fill="#000000" />
                    <circle cx="16" cy="14" r="2.5" fill="#FFFFFF" />
                  </svg>
                </div>

                <div class="choice-tag-row">
                  <span class="choice-num-badge">2</span>
                  <span class="choice-hint">Choice B</span>
                </div>
                <p class="choice-main-text">
                  Work and train at the same time
                </p>
                <div class="choice-bottom-bar">
                  <span class="choice-pick-pill">Pick this one</span>
                </div>
              </button>

            </div>
          </div>

          <!-- Dynamic Interactive Pop-up Answer Modal (Overlays entire stage with pure solid white) -->
          <div class="dilemma-popup-overlay" id="dilemmaAnswerPopup" aria-hidden="true">
            <div class="dilemma-popup-card">
              <div class="popup-header-row">
                <h3 class="popup-answer-title" id="popupTitle">WRONG</h3>
                <button class="popup-close-btn" id="closePopupBtn" aria-label="Close answer">✕</button>
              </div>
              <div class="popup-body-content">
                <p class="popup-answer-p" id="popupText">
                  You can't afford food.
                </p>
                
                <!-- Primary Action Button ("try again" / "wth?") -->
                <div class="popup-action-row">
                  <button class="popup-action-btn" id="popupActionBtn" type="button">
                    <span id="popupActionBtnText">try again</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- FRAME 1: TEAL STAGE CURTAIN (SLIDES UP LIKE A THEATER CURTAIN ON SCROLL) -->
        <div class="hero-curtain-layer" id="heroCurtainLayer" data-hero-curtain>
          <!-- Floating Hero Title -->
          <div class="hero-float-center" data-hero-title>
            <h1 class="hero-title-text">
              <span>Automating</span>
              <span>Unemployment.</span>
            </h1>
          </div>

          <!-- Lounger Character Anchored in Bottom-Right Corner -->
          <div class="hero-lounger-corner" data-hero-lounger>
            <img
              src="/img/au-hero-character-cutout.png"
              alt="Character lounging on deckchair"
              class="hero-lounger-img"
            />
          </div>
        </div>

      </section>
    </div>

    <!-- ============================================================ -->
    <!-- 02 // AGENTIC WORKFLOW BENEFITS (OWN SCROLLABLE SECTION)     -->
    <!-- ============================================================ -->
    <!-- Scroll runway for the benefits curtain. The curtain itself is rendered -->
    <!-- into the How It Works stage below so it can sit in front of that       -->
    <!-- section's title but behind its device mockup.                          -->
    <div class="benefits-scrolly-runway" id="benefitsFrameWrap"></div>

    <!-- ============================================================ -->
    <!-- 03 // HOW IT WORKS: INTERACTIVE WORKFLOW & DIVE-IN RUNTIME   -->
    <!-- Pulled up beneath the yellow curtain so the desktop peeks at -->
    <!-- the bottom, then is revealed as the curtain rises.           -->
    <!-- ============================================================ -->
    <div class="how-it-works-lift">
      <HowItWorksWorkflow>

        <!-- YELLOW CURTAIN (LIFTS ON SCROLL TO REVEAL "HOW IT WORKS" BENEATH) -->
        <div slot="stage-curtain" class="benefits-curtain-layer" id="benefitsCurtainLayer" style="transform: translateY(100vh);">
          <div class="benefits-content-wrapper">

            <!-- Centered Title Group -->
            <div class="benefits-header-group">
              <span class="benefits-eyebrow">Automating Unemployment</span>
              <h2 class="benefits-main-title">
                This case study details how I designed a multi-agent AI team to automate the job-hunt, freeing up <span class="benefits-highlight-pill">83% of my time</span>.
              </h2>
            </div>

            <!-- Graffiti-bulleted payoff row -->
            <ul class="benefits-free-list">

              <li class="benefit-doodle-item">
                <span class="benefit-mark"><GraffitiMarks type="chevrons" size="100%" /></span>
                <p class="benefit-item-text">More free time to study</p>
              </li>

              <li class="benefit-doodle-item">
                <span class="benefit-mark"><GraffitiMarks type="crown-soft" size="100%" /></span>
                <p class="benefit-item-text">More studying <em>=</em> better job prospects</p>
              </li>

              <li class="benefit-doodle-item">
                <span class="benefit-mark"><GraffitiMarks type="star" size="100%" /></span>
                <p class="benefit-item-text">Less stress, improved mental clarity</p>
              </li>

              <li class="benefit-doodle-item">
                <span class="benefit-mark"><GraffitiMarks type="crown-spike" size="100%" /></span>
                <p class="benefit-item-text">Time spent on the jobs with the biggest ROI</p>
              </li>

            </ul>

            <!-- CTA Row -->
            <div class="benefits-action-row">
              <button class="benefits-scroll-cta" id="exploreWorkflowBtn" type="button">
                <span>Explore how it works</span>
                <span class="cta-arrow-down">↓</span>
              </button>
            </div>

          </div>
        </div>

      </HowItWorksWorkflow>
    </div>

    <!-- ============================================================ -->
    <!-- 04 // MEET THE TEAM: 2-TIER AUTONOMOUS AGENT HIERARCHY      -->
    <!-- ============================================================ -->
    <section class="team-hierarchy-section" id="team-section">
      <div class="team-section-container">
        <div class="team-header-box">
          <span class="team-eyebrow">04 // AUTONOMOUS AGENT HIERARCHY</span>
          <h2 class="team-main-title">Meet the team</h2>
        </div>

        <!-- Tree Hierarchy Container -->
        <div class="agent-tree-wrapper">
          
          <!-- TOP LEVEL: ROOT AGENT (GILES - THE ORCHESTRATOR / BOSS) -->
          <div class="tree-root-row">
            {agents[0] && (
              <div class="agent-node-card root-node" style="--node-accent: #D97706;">
                <div class="node-chassis-top">
                  <div class="node-tag-group">
                    <span class="node-rivet">+</span>
                    <span class="node-level-id">AGENT // 01</span>
                  </div>
                  <div class="node-status-chip">
                    <span class="node-live-led" style="background-color: #D97706;" />
                    <span class="node-status-label">ONLINE</span>
                    <span class="node-rivet">+</span>
                  </div>
                </div>

                <div class="node-chassis-body">
                  <div class="node-icon-col">
                    <AgentTreeIcons type="boss" size="52px" />
                  </div>
                  <div class="node-info-col">
                    <div class="node-title-row">
                      <h3 class="node-agent-name">{agents[0].name}</h3>
                      <span class="node-chip-badge">ORCHESTRATOR</span>
                    </div>
                    <span class="node-agent-role" style="color: #D97706;">{agents[0].role}</span>
                    <p class="node-brief-text">{agents[0].brief}</p>
                  </div>
                </div>

                <div class="node-telemetry-tray">
                  <span class="telemetry-item"><strong>SESSION:</strong> MAIN ORCHESTRATOR</span>
                  <span class="telemetry-dot">&middot;</span>
                  <span class="telemetry-item"><strong>TRIAGE:</strong> REAL-TIME ALERTS</span>
                </div>
              </div>
            )}
          </div>

          <!-- CONNECTING FORK BUS SVG (FLOWS FROM GILES TO CORDELIA & WILLOW ONLY) -->
          <div class="tree-fork-connector" aria-hidden="true">
            <svg class="tree-conduit-svg" viewBox="0 0 680 44" fill="none">
              <path d="M 340 0 L 340 22" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 340 0 L 340 22" stroke="#D97706" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-stem" />

              <path d="M 170 22 L 510 22" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 170 22 L 510 22" stroke="#71717A" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-split" />

              <path d="M 170 22 L 170 44" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 170 22 L 170 44" stroke="#E11D48" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-left" />

              <path d="M 510 22 L 510 44" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 510 22 L 510 44" stroke="#0D9488" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-right" />

              <circle r="4" fill="#E11D48" stroke="#000000" stroke-width="1.5">
                <animateMotion path="M 340 0 L 340 22 L 170 22 L 170 44" dur="2.2s" repeatCount="indefinite" />
                <animate attributeName="opacity" values="0; 1; 1; 0" keyTimes="0; 0.08; 0.92; 1" dur="2.2s" repeatCount="indefinite" />
              </circle>

              <circle r="4" fill="#0D9488" stroke="#000000" stroke-width="1.5">
                <animateMotion path="M 340 0 L 340 22 L 510 22 L 510 44" dur="2.2s" begin="0.35s" repeatCount="indefinite" />
                <animate attributeName="opacity" values="0; 1; 1; 0" keyTimes="0; 0.08; 0.92; 1" dur="2.2s" begin="0.35s" repeatCount="indefinite" />
              </circle>
            </svg>
          </div>

          <!-- BOTTOM LEVEL: 2 SUB-AGENTS -->
          <div class="tree-branches-row">
            {agents[1] && (
              <div class="agent-node-card branch-node" style="--node-accent: #E11D48;">
                <div class="node-chassis-top">
                  <div class="node-tag-group">
                    <span class="node-rivet">+</span>
                    <span class="node-level-id">SUB-AGENT // 01</span>
                  </div>
                  <div class="node-status-chip">
                    <span class="node-live-led" style="background-color: #E11D48;" />
                    <span class="node-status-label">ANALYZING</span>
                    <span class="node-rivet">+</span>
                  </div>
                </div>

                <div class="node-chassis-body">
                  <div class="node-icon-col">
                    <AgentTreeIcons type="tailor" size="48px" />
                  </div>
                  <div class="node-info-col">
                    <div class="node-title-row">
                      <h3 class="node-agent-name">{agents[1].name}</h3>
                      <span class="node-chip-badge">TAILOR &amp; VIBE</span>
                    </div>
                    <span class="node-agent-role" style="color: #E11D48;">{agents[1].role}</span>
                    <p class="node-brief-text">{agents[1].brief}</p>
                  </div>
                </div>

                <div class="node-telemetry-tray">
                  <span class="telemetry-item"><strong>EVAL:</strong> 100% FACT GROUNDED</span>
                  <span class="telemetry-dot">&middot;</span>
                  <span class="telemetry-item"><strong>PRECISION:</strong> ZERO HALLUCINATION</span>
                </div>
              </div>
            )}

            {agents[2] && (
              <div class="agent-node-card branch-node" style="--node-accent: #0D9488;">
                <div class="node-chassis-top">
                  <div class="node-tag-group">
                    <span class="node-rivet">+</span>
                    <span class="node-level-id">SUB-AGENT // 02</span>
                  </div>
                  <div class="node-status-chip">
                    <span class="node-live-led" style="background-color: #0D9488;" />
                    <span class="node-status-label">READY</span>
                    <span class="node-rivet">+</span>
                  </div>
                </div>

                <div class="node-chassis-body">
                  <div class="node-icon-col">
                    <AgentTreeIcons type="developer" size="48px" />
                  </div>
                  <div class="node-info-col">
                    <div class="node-title-row">
                      <h3 class="node-agent-name">{agents[2].name}</h3>
                      <span class="node-chip-badge">CODE BUILDER</span>
                    </div>
                    <span class="node-agent-role" style="color: #0D9488;">{agents[2].role}</span>
                    <p class="node-brief-text">{agents[2].brief}</p>
                  </div>
                </div>

                <div class="node-telemetry-tray">
                  <span class="telemetry-item"><strong>MODEL:</strong> CLAUDE OPUS</span>
                  <span class="telemetry-dot">&middot;</span>
                  <span class="telemetry-item"><strong>SCOPE:</strong> CODEBASE &amp; APIS</span>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 05 // THE AI DOOM LOOP & MARKET REALITY                      -->
    <!-- ============================================================ -->
    <section class="doom-loop-standalone-section" id="doom-section">
      <div class="doom-section-container">
        <!-- Section Header -->
        <div class="doom-standalone-header">
          <span class="doom-section-eyebrow">05 // MARKET CONTEXT</span>
          <h2 class="doom-standalone-title">
            How this can help other candidates
          </h2>
          <p class="doom-standalone-lead">
            Job seekers are stuck in what we are calling the <strong>"AI doom loop"</strong>. This workflow
            provides a way for candidates to maintain the quality of their
            applications, and their sanity, in a difficult job market. 
            The cost of setting this up is just a few pounds, yet the time saved is invaluable.
          </p>
        </div>

        <!-- The listing lands in the middle, the loop assembles around it -->
        <div class="doom-orbit" data-doom-orbit>
          <ul class="doom-orbit-notes">
          <li class="doom-orbit-note note-1" style="--i: 0; --note-accent: var(--doodle-pink, #FF1F70);">
            <span class="doom-note-num">01</span>
            <p class="doom-note-text">A competitive job market pushes candidates to reach for AI. With it they write CVs and fill in application forms, applying for far more jobs than they could manually. But what happens to the quality of those applications?</p>
          </li>
          <li class="doom-orbit-note note-2" style="--i: 1; --note-accent: var(--doodle-cyan, #00B3E3);">
            <span class="doom-note-num">02</span>
            <p class="doom-note-text">Employers receive thousands of applications per role, often filled with obviously AI-generated content, so they turn to AI to filter the vast majority of candidates out.</p>
          </li>
          <li class="doom-orbit-note note-3" style="--i: 2; --note-accent: var(--doodle-lime, #D1FF00);">
            <span class="doom-note-num">03</span>
            <p class="doom-note-text">Those filters push the competition higher still. Applicant tracking systems now demand match rates as high as 95% against their requirements, scoring keywords rather than people.</p>
          </li>
          <li class="doom-orbit-note note-4" style="--i: 3; --note-accent: var(--doodle-yellow, #FFDA00);">
            <span class="doom-note-num">04</span>
            <p class="doom-note-text">Competition climbs, candidates have to do more to get noticed, and so they reach for AI. Round it goes again.</p>
          </li>
          </ul>

          <div class="doom-orbit-centre">
            <DoodleLinkedInJobCard
              company="Nota Scam"
              title="Junior role"
              location="London, England, United Kingdom"
              autoPlay={false}
              showReplay={false}
            />
          </div>
        </div>

        <p class="doom-closing">
          The point isn't "don't use AI" to escape this cycle. Candidates currently have no other choice. 
          But, choosing to design an intelligent system that harnesses the skills of AI while controlling the downsides could be a better strategy for approaching the market.
        </p>
      </div>
    </section>

    <!-- EPILOGUE / RETURN -->
    <footer class="story-epilogue">
      <div class="epilogue-links">
        <!-- 1. Return to home button -->
        <a href="/" class="footer-home-btn" aria-label="Return to home">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          <span>Return to home</span>
        </a>

        <!-- 2. Email button (same pink one as home page) -->
        <div class="footer-contact-node node-email">
          <button
            type="button"
            class="copy-email-btn footer-copy-email-btn"
            id="footerCopyEmailBtn"
            title="Copy email address to clipboard"
            aria-label="Copy email address"
          >
            <svg class="copy-icon-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-btn-text">or copy email address</span>
          </button>
          <a
            href="mailto:nike.emily@pm.me"
            class="footer-icon-link email-link"
            title="Send email to nike.emily@pm.me"
            aria-label="Send Email"
          >
            <img
              src="/img/contact-email.png"
              alt="Email"
              class="footer-contact-icon-img"
              width="52"
              height="37"
              loading="eager"
            />
          </a>
        </div>

        <!-- 3. LinkedIn button (same blue one as home page) -->
        <div class="footer-contact-node node-linkedin">
          <a
            href="https://www.linkedin.com/in/NikeEmilyO/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-icon-link linkedin-link"
            title="Visit LinkedIn Profile"
            aria-label="LinkedIn Profile"
          >
            <img
              src="/img/contact-linkedin.webp"
              alt="LinkedIn"
              class="footer-contact-icon-img"
              width="52"
              height="38"
              loading="eager"
            />
          </a>
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* ---------------------------------------------------- */
  /* HEIGHT-INSPIRED ULTRA-MINIMALIST DESIGN SYSTEM       */
  /* ---------------------------------------------------- */
  :root {
    --bg-void: #000000;
    --text-pure: #ffffff;
    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-subtle: #64748b;
    --wire-line: rgba(255, 255, 255, 0.12);

    --purple: #704898;
    --orchid: #be83d3;
    --orange: #e8722c;
    --cyan: #00B3E3;
  }

  body {
    background-color: var(--bg-void) !important;
    color: var(--text-primary);
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  .height-story-wrap {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #000000;
  }

  /* ---------------------------------------------------- */
  /* MINIMALIST HEADER                                    */
  /* ---------------------------------------------------- */
  .story-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 18px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 1005;
    pointer-events: none;
  }

  .header-back,
  .header-case-no {
    pointer-events: auto;
  }

  .header-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 7px 16px;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow: 2px 3px 0px #000000;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .header-back:hover {
    background: #000000;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 2px 5px 0px #000000;
  }

  .header-case-no {
    font-size: 0.75rem;
    font-family: monospace;
    font-weight: 700;
    color: #0f172a;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 7px 16px;
    letter-spacing: 0.06em;
    box-shadow: 2px 3px 0px #000000;
  }

  /* ---------------------------------------------------- */
  /* HERO STAGE (STICKY SCROLLYTELLING RUNWAY)            */
  /* ---------------------------------------------------- */
  .hero-scrolly-runway {
    position: relative;
    width: 100%;
    height: 250vh; /* Smooth scrollytelling runway */
    background-color: #FFFFFF;
  }

  .figma-hero-stage {
    width: 100%;
    min-height: 100vh;
    height: 100vh;
    position: sticky;
    top: 0;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 5;
  }

  /* ============================================================ */
  /* FRAME 1: TEAL STAGE CURTAIN (LIFTS ON SCROLL)               */
  /* ============================================================ */
  .hero-curtain-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--doodle-cyan, #00B3E3);
    z-index: 20;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    will-change: transform;
    pointer-events: auto;
  }

  .hero-float-center {
    position: absolute;
    top: 36%;
    left: 56%;
    transform: translate(-50%, -50%);
    z-index: 8;
    will-change: opacity, transform;
    pointer-events: auto;
  }

  .hero-title-text {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 1.0625rem; /* ~17px matching project card font */
    font-weight: 700; /* Bold Archivo for brand continuity */
    line-height: 1.35;
    color: #ffffff;
    letter-spacing: -0.015em;
    margin: 0;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .hero-lounger-corner {
    position: absolute;
    bottom: clamp(16px, 3vh, 32px);
    right: clamp(16px, 3vw, 36px);
    z-index: 9;
    pointer-events: auto;
    transform-origin: bottom right;
    will-change: transform, opacity;
  }

  .hero-lounger-img {
    width: clamp(140px, 17vw, 220px);
    height: auto;
    display: block;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.2));
  }

  /* ============================================================ */
  /* FRAME 2: WHITE DILEMMA FRAME (UNDERNEATH CURTAIN)           */
  /* ============================================================ */
  .dilemma-white-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #FFFFFF;
    color: #000000;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 4vw, 64px);
    box-sizing: border-box;
  }

  .dilemma-content-wrapper {
    width: 100%;
    max-width: 1160px;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6.5vh, 72px);
    box-sizing: border-box;
    position: relative;
  }

  .dilemma-header-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 900px;
  }

  .dilemma-eyebrow {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #71717A;
    text-transform: uppercase;
  }

  .dilemma-title {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: clamp(1.85rem, 3vw, 2.9rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: #000000;
    margin: 0;
  }

  .dilemma-punchline {
    display: inline-block;
    background: #FFD233;
    color: #000000;
    padding: 2px 14px;
    border-radius: 8px;
    border: 2px solid #000000;
    box-shadow: 2px 3px 0px #000000;
    font-weight: 900;
    margin-left: 8px;
    transform: rotate(-2deg);
  }

  .dilemma-sub-lead {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    font-weight: 600;
    line-height: 1.45;
    color: #3F3F46;
    margin: 4px 0 0;
  }

  /* ---------------------------------------------------- */
  /* CENTERED DECISION STAGE                              */
  /* ---------------------------------------------------- */
  .dilemma-decision-stage {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 3vw, 40px);
    width: 100%;
    position: relative;
    margin-top: clamp(16px, 3vh, 36px);
  }

  @media (max-width: 860px) {
    .dilemma-decision-stage {
      flex-direction: column;
      gap: 20px;
    }
  }

  /* SELECTABLE OPTION BUTTON CARDS (STREETWEAR DOODLE-POP) */
  .dilemma-choice-btn {
    flex: 1;
    max-width: 380px;
    background: #FAF8F5;
    border: 3px solid #000000;
    border-radius: 18px;
    padding: clamp(20px, 2.5vw, 28px);
    box-shadow: 4px 6px 0px #000000;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 190px;
    cursor: pointer;
    text-align: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background 0.25s ease;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
    position: relative;
  }

  /* Choice 1 Hover: Cyber Lime Green from Doodle-Pop Palette */
  .dilemma-choice-btn.choice-left:hover {
    transform: translateY(-6px) rotate(-1deg);
    box-shadow: 6px 11px 0px #000000, 0 14px 28px rgba(209, 255, 0, 0.45);
    background: var(--doodle-lime, #D1FF00);
  }

  .dilemma-choice-btn.choice-left:hover .choice-pick-pill {
    background: #000000;
    color: var(--doodle-lime, #D1FF00);
    transform: scale(1.06);
  }

  /* Choice 2 Hover: Electric Cyan from Doodle-Pop Palette */
  .dilemma-choice-btn.choice-right:hover {
    transform: translateY(-6px) rotate(1deg);
    box-shadow: 6px 11px 0px #000000, 0 14px 28px rgba(0, 179, 227, 0.45);
    background: var(--doodle-cyan, #00B3E3);
  }

  .dilemma-choice-btn.choice-right:hover .choice-pick-pill {
    background: #000000;
    color: var(--doodle-cyan, #00B3E3);
    transform: scale(1.06);
  }

  .dilemma-choice-btn:active,
  .dilemma-choice-btn.is-selected {
    transform: translateY(2px);
    box-shadow: 2px 3px 0px #000000;
    background: #FFF9E6;
  }

  /* Corner Doodle Sparks */
  .card-doodle-spark {
    position: absolute;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.3) rotate(0deg);
    transition: opacity 0.25s cubic-bezier(0.18, 0.89, 0.32, 1.28), transform 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  }

  .card-doodle-spark.top-right {
    top: -14px;
    right: -14px;
  }

  .card-doodle-spark.top-left {
    top: -14px;
    left: -14px;
  }

  .dilemma-choice-btn:hover .card-doodle-spark {
    opacity: 1;
    transform: scale(1.15) rotate(12deg);
    animation: doodleSparkWiggle 0.8s ease-in-out infinite alternate;
  }

  @keyframes doodleSparkWiggle {
    0% { transform: scale(1.15) rotate(10deg); }
    100% { transform: scale(1.3) rotate(22deg); }
  }

  .choice-tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .choice-num-badge {
    background: #000000;
    color: #FFFFFF;
    font-family: monospace;
    font-weight: 900;
    font-size: 0.9rem;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .choice-hint {
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: 800;
    color: #71717A;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .choice-main-text {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    font-weight: 700;
    line-height: 1.45;
    color: #0F172A;
    margin: 0;
  }

  .choice-bottom-bar {
    display: flex;
    align-items: center;
  }

  .choice-pick-pill {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 900;
    color: #000000;
    background: #FFD233;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 4px 14px;
    box-shadow: 2px 2px 0px #000000;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  /* CENTER CHARACTER */
  .dilemma-center-character {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dilemma-standing-img {
    height: clamp(180px, 26vh, 260px);
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.18));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dilemma-standing-img:hover {
    transform: scale(1.05) rotate(-1.5deg);
  }

  /* ---------------------------------------------------- */
  /* POP-UP ANSWER OVERLAY & MODAL                        */
  /* ---------------------------------------------------- */
  .dilemma-popup-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #FFFFFF; /* Pure clean solid white background */
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dilemma-popup-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .dilemma-popup-card {
    background: #FAF8F5;
    border: 3.5px solid #000000;
    border-radius: 20px;
    box-shadow: 8px 10px 0px #000000;
    max-width: 540px;
    width: 100%;
    padding: clamp(24px, 3.5vw, 36px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 18px;
    transform: scale(0.92) translateY(12px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dilemma-popup-overlay.is-visible .dilemma-popup-card {
    transform: scale(1) translateY(0);
  }

  .popup-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2.5px solid #000000;
    padding-bottom: 12px;
  }

  .popup-answer-title {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: clamp(1.3rem, 1.8vw, 1.6rem);
    font-weight: 900;
    color: #E11D48;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.015em;
  }

  .popup-close-btn {
    background: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 900;
    color: #000000;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 2px 2px 0px #000000;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .popup-close-btn:hover {
    background: var(--doodle-yellow, #FFDA00);
    transform: scale(1.06);
  }

  .popup-body-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .popup-answer-p {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 1.08rem;
    line-height: 1.55;
    color: #1F2937;
    margin: 0;
    font-weight: 500;
  }

  .popup-action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 8px;
  }

  .popup-action-btn {
    background: var(--doodle-yellow, #FFDA00);
    color: #000000;
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 0.98rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 2.5px solid #000000;
    border-radius: 12px;
    padding: 10px 24px;
    box-shadow: 3px 4px 0px #000000;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .popup-action-btn:hover {
    background: #FFE566;
    transform: translateY(-2px);
    box-shadow: 4px 6px 0px #000000;
  }

  .popup-action-btn:active {
    transform: translateY(2px);
    box-shadow: 1px 2px 0px #000000;
  }

  /* ============================================================ */
  /* FRAME 2: STAGE                                               */
  /* ============================================================ */
  .dilemma-white-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #FFFFFF;
    color: #000000;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 4vw, 64px);
    box-sizing: border-box;
  }

  /* ============================================================ */
  /* BENEFITS: STAGE-CURTAIN RUNWAY                               */
  /* The yellow panel is a curtain that lifts on scroll, revealing */
  /* the real "How it works" section pulled up underneath it.     */
  /* --benefits-lift  = how far we scroll to raise the curtain, and how far   */
  /*   How-It-Works starts below the fold — which sets how much of the device */
  /*   peeks out in front of the curtain. Measured by syncBenefitsLift().     */
  /* ============================================================ */
  /* Pure scroll spacer — supplies the distance the curtain travels. */
  .benefits-scrolly-runway {
    --benefits-lift: 62vh;
    position: relative;
    width: 100%;
    height: calc(100vh + var(--benefits-lift));
  }

  /* Rendered into the How It Works stage via its stage-curtain slot, so it
     shares that stage's stacking context: above .how-header-overlay (20),
     below .desktop-zoom-container (30). Fixed so it fills the viewport even
     though the stage it lives in is still sliding up underneath it. */
  .benefits-curtain-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 25;
    transform: translateY(100vh);
    background-color: var(--doodle-yellow, #FFDA00);
    border-bottom: 3px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(32px, 6vh, 64px) 24px;
    box-sizing: border-box;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    will-change: transform;
  }

  /* How It Works is lifted so its top sits --benefits-lift below the fold, */
  /* letting the desktop peek out under the curtain's hem. */
  .how-it-works-lift {
    position: relative;
    z-index: 10;
    width: 100%;
    margin-top: -100vh;
  }

  .benefits-content-wrapper {
    width: 100%;
    max-width: 1180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    gap: clamp(44px, 7.5vh, 88px);
    box-sizing: border-box;
    position: relative;
  }

  .benefits-header-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    max-width: 920px;
    margin: 0 auto;
  }

  .benefits-eyebrow {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    color: #000000;
    background: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 9999px;
    padding: 3px 12px;
    box-shadow: 2px 2px 0px #000000;
    text-transform: uppercase;
  }

  .benefits-main-title {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #000000;
    margin: 0;
    text-align: center;
  }

  .benefits-highlight-pill {
    display: inline-block;
    background: #000000;
    color: #FFFFFF;
    padding: 2px 14px;
    border-radius: 10px;
    border: 2px solid #000000;
    box-shadow: 2px 3px 0px rgba(0, 0, 0, 0.4);
    font-weight: 900;
    transform: rotate(-1.5deg);
  }

  /* Payoff row: four graffiti-bulleted columns, split by hand-drawn rules */
  .benefits-free-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 2.2vw, 34px);
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }

  .benefit-doodle-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(10px, 1.6vh, 18px);
    padding: 4px clamp(6px, 1vw, 14px);
  }

  /* Dashed rule between columns, drawn on the gap rather than as a border */
  .benefit-doodle-item + .benefit-doodle-item::before {
    content: "";
    position: absolute;
    left: calc(-1 * clamp(7px, 1.1vw, 17px));
    top: 8%;
    bottom: 8%;
    width: 2px;
    background-image: linear-gradient(
      to bottom,
      #000000 0 8px,
      transparent 8px 16px
    );
    opacity: 0.32;
  }

  .benefit-mark {
    display: block;
    width: clamp(48px, 5.2vw, 76px);
    height: clamp(48px, 5.2vw, 76px);
    flex-shrink: 0;
    /* Sits square at rest; the tilt is the hover payoff */
    transform: rotate(0deg);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Kick alternating directions so a scan across the row feels hand-thrown */
  .benefit-doodle-item:hover .benefit-mark {
    transform: rotate(-6deg) scale(1.08);
  }

  .benefit-doodle-item:nth-child(even):hover .benefit-mark {
    transform: rotate(6deg) scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-mark,
    .benefit-doodle-item:hover .benefit-mark,
    .benefit-doodle-item:nth-child(even):hover .benefit-mark {
      transform: none;
      transition: none;
    }
  }

  .benefit-item-text {
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: clamp(0.92rem, 1.05vw, 1.08rem);
    font-weight: 700;
    line-height: 1.34;
    letter-spacing: -0.01em;
    color: #000000;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }

  /* The "=" just carries extra weight, no chip */
  .benefit-item-text em {
    font-style: normal;
    font-weight: 900;
  }

  @media (max-width: 900px) {
    .benefits-free-list {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(18px, 3vh, 28px) 20px;
    }
    /* Rule only between the two columns, not across the row break */
    .benefit-doodle-item + .benefit-doodle-item::before {
      display: none;
    }
    .benefit-doodle-item:nth-child(even)::before {
      display: block;
      left: -10px;
    }
  }

  @media (max-width: 560px) {
    .benefits-free-list {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .benefit-doodle-item {
      flex-direction: row;
      text-align: left;
      gap: 14px;
    }
    .benefit-doodle-item:nth-child(even)::before {
      display: none;
    }
    .benefit-mark {
      width: 46px;
      height: 46px;
    }
    .benefit-item-text {
      max-width: none;
    }
  }

  .benefits-action-row {
    display: flex;
    justify-content: center;
    margin-top: 4px;
    z-index: 10;
  }

  .benefits-scroll-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #000000;
    color: #FFFFFF;
    font-family:
      var(--archivo-font),
      "Archivo",
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    border: 2.5px solid #000000;
    border-radius: 9999px;
    padding: 10px 24px;
    box-shadow: 3px 4px 0px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .benefits-scroll-cta:hover {
    transform: translateY(-2px);
    box-shadow: 4px 6px 0px rgba(0, 0, 0, 0.45);
    background: #27272A;
  }

  .cta-arrow-down {
    font-size: 1.15rem;
    font-weight: 900;
    transition: transform 0.2s ease;
  }

  .benefits-scroll-cta:hover .cta-arrow-down {
    transform: translateY(3px);
  }


  /* ============================================================ */
  /* 04 // MEET THE TEAM SECTION                                  */
  /* ============================================================ */
  .team-hierarchy-section {
    width: 100%;
    background-color: #000000;
    padding: clamp(80px, 12vh, 140px) 24px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    border-top: 3px solid #000000;
  }

  .team-section-container {
