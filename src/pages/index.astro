---
import Base from '../layouts/Base.astro'
import Navigation from '../components/Navigation.astro'
import AskCard from '../components/AskCard.astro'
import SmokeResponse from '../components/SmokeResponse.astro'
import LivingCV from '../components/LivingCV.astro'
---

  <Base>
      <main>
        <Navigation />
      </main>
      <AskCard />
      <SmokeResponse />
      <LivingCV />
      <div class="character-wrapper">
        <video id="character-intro" autoplay muted playsinline preload="auto">
          <source src="/intro_dark.webm" type="video/webm">
        </video>
        <video id="character-idle" muted playsinline loop preload="auto">
          <source src="/idle_dark.webm" type="video/webm">
        </video>
      </div>


    <script>
      import "../index.js"
    </script>


    <style>
      @property --bg-1 { syntax: '<color>'; initial-value: #091A1B; inherits: false; }
      @property --bg-2 { syntax: '<color>'; initial-value: #070F11; inherits: false; }
      @property --bg-3 { syntax: '<color>'; initial-value: #050A0E; inherits: false; }
      @property --bg-4 { syntax: '<color>'; initial-value: #03050A; inherits: false; }

      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;
        padding: 0;
        background: radial-gradient(
          in oklab
          ellipse 50vw 130vh at 50vw 90vh,
          var(--bg-1) 5%,
          var(--bg-2) 35%,
          var(--bg-3) 52%,
          var(--bg-4) 70%) fixed;
        transition: --bg-1 2s ease, --bg-2 2s ease, --bg-3 2s ease, --bg-4 2s ease;
      }

      body.fill-background {
        --bg-1: var(--overview-bg);
        --bg-2: var(--overview-bg);
        --bg-3: var(--overview-bg);
        --bg-4: var(--overview-bg);
      }
      main {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        width: 100%;
        min-height: 100dvh;
        padding: 40px;
        padding-top: calc(25vh + 60px);
        gap: 25vh;
      }
      @media (max-width: 480px) {
        main {
          padding-top: 20dvh;
          padding-inline: 16px;
        }
      }

      /* Flip-to-page transition overlay (built in tarotInteractions.js, appended
         to <body>, so these rules must be global). */
      :global(.flip-overlay) {
        position: fixed;
        inset: 0;
        z-index: 1000;
        pointer-events: none;
      }
      :global(.flip-scaler) {
        perspective: 1600px;
        will-change: top, left, width, height;
      }
      :global(.flip-card) {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
      }
      :global(.flip-face) {
        position: absolute;
        inset: 0;
        backface-visibility: hidden;
        overflow: hidden;
      }
      :global(.flip-card .flip-front) {
        width: 100%;
        height: 100%;
      }
      :global(.flip-back) {
        background-color: var(--overview-bg);
        transform: rotateY(180deg);
      }

      .character-wrapper {
        position: fixed;
        bottom: 0;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        pointer-events: none;
        z-index: -1;
        transform-origin: bottom center;
        transition: opacity 2s ease;

        video {
          position: absolute;
          bottom: 0;
          left: 50%;
          transform: translateX(-50%);
          width: 1400px;
          max-width: unset;
          height: auto;
          pointer-events: none;
        }
      }

      #character-idle {
        opacity: 0;
      }

      body.fill-background .character-wrapper {
        opacity: 0;
      }

      @media (max-width: 480px) {
        .character-wrapper video {
          width: 900px;
        }
      }
    </style>
  </Base>

