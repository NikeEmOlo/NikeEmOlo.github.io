---
import Base from '../layouts/Base.astro'
import Navigation from '../components/Navigation.astro'
import CategoryRail from '../components/CategoryRail.astro'
import HoloProjectCard from '../components/HoloProjectCard.astro'
import { getCollection, getEntry } from 'astro:content'
import { CATEGORIES } from '../categories.js'

const homeEntries = await getCollection('home')
const home = homeEntries[0]?.data || (await getEntry('home', 'index'))?.data || {
    title: "Olanike Olowo-Fela",
    subtitle: "I build systems and software that\nmake life easier.",
    projectsTitle: "projects",
    tickerLabel: "Currently working on:",
    currentlyWorkingOn: [
        "Finishing this portfolio",
        "Finishing The Odin Project course in full-stack development so my AI agent doesn't think I'm an idiot",
    ],
}

const projects = (await getCollection('projects'))
    .sort((a, b) => a.data.order - b.data.order)

const counts = Object.fromEntries(
    CATEGORIES.map((category) => [
        category,
        projects.filter((p) => {
            const cats = Array.isArray(p.data.category) ? p.data.category : [p.data.category];
            return cats.includes(category);
        }).length,
    ])
);

const employers = [
    "The Odin Project",
    "Outer Office",
    "Highgate Transportation",
    "Auckland Transport",
    "Asahi Beverages",
    "Auckland Council",
    "IFM Electrical",
    "Coster Content Ltd",
]

const tickerItems = (home.currentlyWorkingOn || []).map((item) => {
    if (typeof item === "object" && item.url) {
        return {
            html: `<a href="${item.url}" target="_blank" rel="noopener noreferrer" class="ticker-link">${item.text} <span class="ticker-link-arrow">↗</span></a>`,
        };
    }

    const rawText = typeof item === "string" ? item : item.text;

    let htmlContent = rawText.replace(
        /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer" class="ticker-link">$1 <span class="ticker-link-arrow">↗</span></a>'
    );

    htmlContent = htmlContent.replace(
        /\$\{(https?:\/\/[^\s}]+)\}/g,
        '<a href="$1" target="_blank" rel="noopener noreferrer" class="ticker-link">$1 <span class="ticker-link-arrow">↗</span></a>'
    );

    return { html: htmlContent };
});
---

<Base>
    <main class="home-page">
        <!-- Top Hero Header: Semi-bold Title with Pink Dot & Regular Subtitle -->
        <header class="hero-header">
            <h1 class="hero-title">{home.title}<span class="hero-dot">.</span></h1>
            <p class="hero-subtitle">{home.subtitle}</p>
        </header>

        <!-- Top Navigation -->
        <Navigation />

        <p id="filter-announcement" class="visually-hidden" role="status" aria-live="polite"></p>

        <!-- Main Interactive Work Center: Dedicated flex column with gap -->
        <div class="deck-flex-container" aria-label="Selected work card deck">
            <!-- Top Section: Projects Title & Discipline Filters -->
            <div class="deck-top-group">
                <div class="projects-title-wrap">
                    <h1 class="projects-main-title">{home.projectsTitle || "projects"}</h1>
                </div>
                <!-- 1. Top Discipline Filters -->
                <CategoryRail counts={counts} total={projects.length} />
            </div>

            <!-- 2. 3D Dual-Stack Dealing Stage -->
            <div
                class="deck-stage"
                data-deck-stage
                tabindex="0"
                role="region"
                aria-label="Project card dealing deck. Drag or scroll to deal cards from deck to discard."
            >
                <!-- Playmat Zone: Discard Pile (Left) -->
                <div class="playmat-slot discard-slot" aria-hidden="true">
                    <div class="playmat-card-body">
                        <div class="playmat-center-art">
                            <div class="playmat-sticker-graphic">
                                <svg width="40" height="40" viewBox="0 0 64 64" fill="none" class="doodle-svg-icon" stroke="currentColor">
                                    <rect x="12" y="16" width="40" height="34" rx="6" stroke-width="2" stroke-dasharray="3 3" />
                                    <rect x="16" y="10" width="40" height="34" rx="6" stroke-width="2" fill="rgba(255,255,255,0.7)" />
                                    <path d="M36 17v15m0 0l-5-5m5 5l5-5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <div class="playmat-label">Discard pile</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Playmat Zone: Draw Pile (Right) -->
                <div class="playmat-slot draw-slot" aria-hidden="true">
                    <div class="playmat-card-body">
                        <div class="playmat-center-art">
                            <div class="playmat-sticker-graphic">
                                <svg width="40" height="40" viewBox="0 0 64 64" fill="none" class="doodle-svg-icon" stroke="currentColor">
                                    <rect x="16" y="8" width="34" height="42" rx="6" stroke-width="2" transform="rotate(-5 16 8)" stroke-dasharray="3 3" />
                                    <rect x="14" y="14" width="36" height="42" rx="6" stroke-width="2" fill="rgba(255,255,255,0.7)" />
                                    <path d="M25 32a8 8 0 1 1 2.5 5.8" stroke-width="2.2" stroke-linecap="round" />
                                    <path d="M28 38h-6v-6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <div class="playmat-label">Draw pile</div>
                            </div>
                        </div>
                    </div>
                </div>

                {projects.map((project) => (
                    <div
                        class="deck-card-item"
                        data-project-id={project.id}
                        data-project-href={`/${project.id}`}
                        data-category={Array.isArray(project.data.category) ? project.data.category.join(" ") : project.data.category}
                        data-active={project.data.active !== false ? "true" : "false"}
                        role="button"
                        tabindex="0"
                        aria-label={`View ${project.data.projTitle} ${project.data.active !== false ? "project details" : "(Coming Soon)"}`}
                    >
                        <HoloProjectCard project={project} />
                    </div>
                ))}
            </div>

            <!-- 3. Navigation Controls: Normal flex item directly beneath cards -->
            <div class="deck-bottom-controls">
                <button type="button" class="nav-arrow-btn" id="carouselPrevBtn" aria-label="Return card to deck" title="Return card to deck">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>
                
                <div class="deck-scroll-indicator" title="Scroll mouse wheel, trackpad, or swipe to deal cards">
                    <span class="scroll-cue-arrow" aria-hidden="true">‹</span>
                    <span class="scroll-cue-text scroll-cue-desktop">scroll</span>
                    <span class="scroll-cue-text scroll-cue-mobile">swipe</span>
                    <span class="scroll-cue-arrow" aria-hidden="true">›</span>
                </div>

                <button type="button" class="nav-arrow-btn" id="carouselNextBtn" aria-label="Deal next card" title="Deal next card">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Footer Strip with Rotating Slide-Up Text -->
        <footer class="trusted-by">
            <span class="trusted-by-label">{home.tickerLabel || "Currently working on:"}</span>
            <div class="ticker-container" id="footerTicker" aria-live="polite">
                {tickerItems.map((item, index) => (
                    <span
                        class={`ticker-item ${index === 0 ? "is-active" : ""}`}
                        data-index={index}
                        set:html={item.html}
                    />
                ))}
            </div>
        </footer>
    </main>

    <script>
        import { initCardDeckEngine } from "../lib/deckController.js"

        function initFooterTicker() {
            const container = document.getElementById("footerTicker")
            if (!container || container.dataset.tickerInit === "true") return
            container.dataset.tickerInit = "true"

            const items = container.querySelectorAll(".ticker-item")
            if (items.length <= 1) return

            let currentIndex = 0
            setInterval(() => {
                const prevIndex = currentIndex
                currentIndex = (currentIndex + 1) % items.length

                const prevItem = items[prevIndex]
                const nextItem = items[currentIndex]

                prevItem.classList.remove("is-active")
                prevItem.classList.add("is-exiting")

                nextItem.classList.remove("is-exiting")
                nextItem.classList.add("is-active")

                setTimeout(() => {
                    prevItem.classList.remove("is-exiting")
                }, 550)
            }, 4200)
        }

        function initPage() {
            initCardDeckEngine()
            initFooterTicker()
        }

        document.addEventListener("astro:page-load", initPage)
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initPage)
        } else {
            initPage()
        }
    </script>
</Base>

<style>
    /* Doodle-Pop clean off-white canvas — neutral ground so the deck's bold
       white (#ffffff) color-blocked cards and thick black linework stand out clearly. */
    body {
        background-color: var(--cream, #F7F8F9);
        background-image: 
            radial-gradient(rgba(15, 23, 42, 0.08) 1.2px, transparent 1.2px),
            url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.035'/%3E%3C/svg%3E");
        background-size: 22px 22px, auto;
        color: #0F172A;
        min-height: 100dvh;
        overflow-x: hidden;
    }

    .home-page {
        --pw-ink: #0F172A;
        --pw-muted: #64748B;
        --pw-border: rgba(15, 23, 42, 0.12);
        --pw-accent: var(--doodle-yellow, #FFDA00);
        --pw-sans: var(--archivo-font, 'Archivo', -apple-system, sans-serif);

        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100dvh;
        padding: clamp(24px, 3vh, 40px) clamp(24px, 4vw, 56px) clamp(16px, 2vh, 24px);
        gap: clamp(10px, 1.5vh, 18px);
        overflow: hidden;
        box-sizing: border-box;
    }

    /* Top Hero Header: Semi-bold Title with Pink Dot & Regular Subtitle */
    .hero-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        width: 100%;
        max-width: 640px;
        flex-shrink: 0;
        z-index: 10;
    }

    .hero-title {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 600;
        font-size: clamp(1.75rem, 3.2vw, 3rem); /* 48px at 3rem */
        line-height: 1.0;
        letter-spacing: -0.06em;
        color: #0F172A;
        margin: 0;
        -webkit-font-smoothing: antialiased;
    }

    .hero-dot {
        color: var(--doodle-pink, #FF1F70);
    }

    .hero-subtitle {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-weight: 400;
        font-size: clamp(1rem, 1.6vw, 1.5rem); /* 24px at 1.5rem */
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: #0F172A;
        max-width: 32ch;
        text-wrap: pretty;
        margin-top: clamp(4px, 0.6vh, 8px);
        margin-bottom: 0;
        -webkit-font-smoothing: antialiased;
    }

    /* Main Interactive Work Center: Centered in available screen height */
    .deck-flex-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: clamp(1.75rem, 3vh, 2.5rem);
        width: 100%;
        flex: 1;
        min-height: 0;
        padding-top: clamp(16px, 4vh, 36px);
        padding-bottom: clamp(16px, 4vh, 36px);
    }

    /* Top Section: Title & Category Rail */
    .deck-top-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(12px, 1.8vh, 18px);
        width: 100%;
        flex-shrink: 0;
    }

    .projects-title-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .projects-main-title {
        position: relative;
        font-family: var(--pw-sans);
        font-weight: 900;
        font-size: clamp(1.85rem, 2.8vw, 2.5rem);
        color: #0F172A;
        letter-spacing: -0.06em;
        margin: 0;
        line-height: 1;
        display: inline-block;
        padding-bottom: 7px;
    }

    .projects-main-title::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: -14px;
        right: -14px;
        height: 3.5px;
        background-color: #0F172A;
        border-radius: 2px;
    }

    /* Deck Stage 3D Perspective Area */
    .deck-stage {
        position: relative;
        width: 100%;
        height: clamp(350px, 47vh, 430px);
        display: flex;
        align-items: center;
        justify-content: center;
        perspective: 1400px;
        perspective-origin: center center;
        cursor: grab;
        user-select: none;
        outline: none;
    }

    .deck-stage.is-dragging {
        cursor: grabbing;
    }

    /* Navigation Controls: Normal flow item directly below the card stage */
    .deck-bottom-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        z-index: 40;
        pointer-events: auto;
        flex-shrink: 0;
    }

    .nav-arrow-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #000000;
        color: #0F172A;
        box-shadow: 2px 2px 0px #000000;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }

    .nav-arrow-btn:hover {
        background: var(--doodle-yellow, #FFDA00);
        transform: translate(-1px, -1px);
        box-shadow: 3px 3px 0px #000000;
    }

    .nav-arrow-btn:active {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0px #000000;
    }

    /* Tactile Doodle-Pop "scroll" Indicator Badge */
    .deck-scroll-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        border: 2px solid #000000;
        border-radius: 9999px;
        padding: 3px 12px;
        box-shadow: 2px 2px 0px #000000;
        font-family: monospace;
        font-size: 0.6875rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #0F172A;
        user-select: none;
        cursor: default;
        transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .deck-scroll-indicator:hover {
        background: #FAF7F2;
        transform: translateY(-1px);
    }

    .scroll-cue-arrow {
        font-size: 0.85rem;
        font-weight: 900;
        color: var(--doodle-pink, #FF1F70);
    }

    .scroll-cue-text {
        color: #000000;
    }

    /* There is no wheel on a phone — the deck is dealt by dragging. */
    .scroll-cue-mobile {
        display: none;
    }

    /* ── Playmat Card Zones (Subtle Tabletop Monochrome Print) ── */
    .playmat-slot {
        position: absolute;
        left: 50%;
        top: 50%;
        margin-left: calc(-0.5 * clamp(200px, 17.5vw, 255px));
        margin-top: calc(-0.5 * (clamp(200px, 17.5vw, 255px) * 921 / 600));
        width: clamp(200px, 17.5vw, 255px);
        aspect-ratio: 600 / 921;
        pointer-events: none;
        user-select: none;
        z-index: 0;
        box-sizing: border-box;
        opacity: 0.44;
    }

    .discard-slot {
        transform: translateX(calc(-1 * var(--deck-separation, 320px))) scale(0.88) rotate(-2deg);
    }

    .draw-slot {
        transform: translateX(var(--deck-separation, 320px)) scale(0.88) rotate(2deg);
    }

    .playmat-card-body {
        position: relative;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.5);
        border: 2px dashed rgba(0, 0, 0, 0.45);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 14px 10px 16px;
        box-sizing: border-box;
    }

    .playmat-center-art {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

    .playmat-sticker-graphic {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #000000;
    }

    .doodle-svg-icon {
        opacity: 0.8;
    }

    /* Plain type, not a pill: the playmat is a drop zone, and bordered
       white labels on it read as buttons you could press. */
    .playmat-label {
        font-family: monospace;
        font-size: 0.625rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #000000;
        text-align: center;
    }

    .deck-card-item {
        position: absolute;
        left: 50%;
        top: 50%;
        margin-left: calc(-0.5 * clamp(200px, 17.5vw, 255px));
        margin-top: calc(-0.5 * (clamp(200px, 17.5vw, 255px) * 921 / 600));
        width: clamp(200px, 17.5vw, 255px);
        aspect-ratio: 600 / 921;
        border-radius: 12px;
        transform-origin: center center;
        transform-style: preserve-3d;
        cursor: pointer;
        will-change: transform, z-index;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    .deck-card-item[data-active="false"].is-active-hero {
        cursor: not-allowed;
    }

    @keyframes lockedShake {
        0%, 100% { transform: translate3d(var(--card-tx, 0px), var(--card-ty, 0px), var(--card-tz, 0px)) rotateY(var(--card-ry, 0deg)) rotateZ(var(--card-rz, 0deg)) scale(var(--card-scale, 1)); }
        20%, 60% { transform: translate3d(calc(var(--card-tx, 0px) - 6px), var(--card-ty, 0px), var(--card-tz, 0px)) rotateY(var(--card-ry, 0deg)) rotateZ(calc(var(--card-rz, 0deg) - 2deg)) scale(var(--card-scale, 1)); }
        40%, 80% { transform: translate3d(calc(var(--card-tx, 0px) + 6px), var(--card-ty, 0px), var(--card-tz, 0px)) rotateY(var(--card-ry, 0deg)) rotateZ(calc(var(--card-rz, 0deg) + 2deg)) scale(var(--card-scale, 1)); }
    }

    .deck-card-item.is-locked-shake {
        animation: lockedShake 0.35s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    /* Footer Strip with Rotating Slide-Up Text */
    .trusted-by {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        width: 100%;
        margin: 0;
        padding-top: clamp(10px, 1.4vh, 18px);
        padding-bottom: clamp(2px, 0.4vh, 6px);
        border-top: 2px solid #000000;
        font-family: var(--pw-sans);
        font-size: clamp(0.8125rem, 1vw, 0.875rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.25;
        color: var(--pw-muted);
        overflow: hidden;
    }

    .trusted-by-label {
        font-weight: 800;
        color: #0F172A;
        margin-right: 0.4em;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .ticker-container {
        position: relative;
        display: inline-flex;
        align-items: center;
        height: 1.4em;
        flex: 1;
        min-width: 0;
        overflow: hidden;
    }

    .ticker-item {
        position: absolute;
        left: 0;
        top: 0;
        display: inline-block;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
        max-width: 100%;
        color: #475569;
        font-weight: 600;
        transform: translateY(100%);
        opacity: 0;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
        pointer-events: none;
    }

    .ticker-item.is-active {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }

    .ticker-item.is-exiting {
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
    }

    .ticker-item :global(a),
    .ticker-item :global(.ticker-link) {
        color: #000000;
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 2px;
    }

    .ticker-item :global(a:hover),
    .ticker-item :global(.ticker-link:hover) {
        color: var(--doodle-cyan, #00B3E3);
        text-decoration-color: var(--doodle-cyan, #00B3E3);
    }

    .ticker-item :global(.ticker-link-arrow) {
        font-size: 0.85em;
        line-height: 1;
        transition: transform 0.15s ease;
    }

    .ticker-item :global(.ticker-link:hover .ticker-link-arrow) {
        transform: translate(1px, -1px);
    }

    /* Mobile Responsive Adaptation */
    @media (max-width: 900px) {
        .home-page {
            height: auto;
            min-height: 100dvh;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 24px 20px 32px;
            gap: 12px;
        }

        /* Centred on mobile. The right padding that used to keep the
           left-aligned block clear of the hamburger would pull the optical
           centre off-axis, so the block clears the button vertically instead. */
        .hero-header {
            align-items: center;
            text-align: center;
            padding-right: 0;
            /* Sits low in its own band: clears the hamburger above and closes
               the run of empty canvas down to the "projects" heading. */
            padding-top: 72px;
        }

        /* The deck-top-group below gives up height (smaller "projects"
           heading, tighter gap, collapsed filter), so the hero can carry it. */
        .hero-title {
            font-size: clamp(1.75rem, 7.4vw, 2.5rem);
        }

        .hero-subtitle {
            font-size: clamp(1.15rem, 4.6vw, 1.5rem);
            margin: 8px auto 0;
        }

        .deck-flex-container {
            flex: none;
            gap: 10px;
            /* The filter rail no longer occupies three wrapped rows here, so
               the deck can sit closer to the title. */
            padding-top: 0;
        }

        .deck-top-group {
            gap: 8px;
        }

        .projects-main-title {
            font-size: 1.3rem;
            padding-bottom: 5px;
        }

        .projects-main-title::after {
            height: 2.5px;
            left: -10px;
            right: -10px;
        }

        .scroll-cue-desktop {
            display: none;
        }

        .scroll-cue-mobile {
            display: inline;
        }

        /* The card is ~352px tall and sits centred in the stage, so every
           pixel of extra stage height became dead space above and below it. */
        .deck-stage {
            height: 380px;
        }

        .playmat-slot {
            display: none;
        }
    }
