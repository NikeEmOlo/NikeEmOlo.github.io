</style>

<script>
    /**
     * Aotearoa Bike Challenge case study.
     *
     * Everything registered here is torn down before Astro swaps the document,
     * so client-side navigation does not stack listeners up over a session.
     */
    let teardown: Array<() => void> = [];

    function onWindow(type: string, handler: EventListener) {
        window.addEventListener(type, handler, { passive: true });
        teardown.push(() => window.removeEventListener(type, handler));
    }

    const reducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);

    /** Smoothstep, so fades ease in and out instead of running linearly. */
    const ease = (t: number) => t * t * (3 - 2 * t);

    /** One rAF-throttled scroll loop for the page: subscribers run at most
     *  once a frame, which keeps layout reads off the scroll event itself. */
    function createScrollLoop() {
        const subscribers: Array<() => void> = [];
        let ticking = false;

        function run() {
            ticking = false;
            for (const fn of subscribers) fn();
        }

        function request() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(run);
        }

        onWindow("scroll", request);
        onWindow("resize", request);

        return {
            subscribe: (fn: () => void) => subscribers.push(fn),
            run,
        };
    }

    /** Slides and stack panels fade their contents in the first time they
     *  are reached. Once shown, they stay shown. */
    function initReveals() {
        const targets = document.querySelectorAll<HTMLElement>(
            ".abc-cover, .slide, .stack:not(.is-pinned) .panel"
        );
        if (!targets.length) return;

        if (reducedMotion() || typeof IntersectionObserver === "undefined") {
            targets.forEach((el) => el.classList.add("is-in"));
            return;
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("is-in");
                    observer.unobserve(entry.target);
                }
            },
            { rootMargin: "0px 0px -22% 0px", threshold: 0 }
        );

        targets.forEach((el) => observer.observe(el));
        teardown.push(() => observer.disconnect());
    }

    const SVG_NS = "http://www.w3.org/2000/svg";

    /**
     * Slide 6. Scatters bicycle marks across the landmass. Candidate points are
     * tested against the real map geometry with isPointInFill, so no bike ever
     * lands in the sea or hangs over a coastline.
     */
    function buildBikes(svg: SVGSVGElement) {
        const paths = Array.from(svg.querySelectorAll<SVGPathElement>("g > path"));
        if (!paths.length) return [];

        const group = paths[0].parentElement as unknown as SVGGraphicsElement | null;
        if (!group) return [];

        // Bikes are appended to the <svg>, so their coordinates are viewBox
        // units, while the paths live inside a flipped, scaled <g>. Going via
        // screen space converts between the two; getCTM alone would not,
        // because it resolves to CSS pixels rather than viewBox units.
        let svgCTM = svg.getScreenCTM();
        let groupCTM = group.getScreenCTM();
        if (!svgCTM || !groupCTM) return [];

        // The shared map's viewBox carries a lot of empty ocean, which would
        // leave the map small and off-centre here. Crop to the coastline
        // before anything is measured or placed.
        const toViewBox = svgCTM.inverse().multiply(groupCTM);
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        for (const path of paths) {
            const b = path.getBBox();
            for (const [bx, by] of [
                [b.x, b.y],
                [b.x + b.width, b.y],
                [b.x, b.y + b.height],
                [b.x + b.width, b.y + b.height],
            ]) {
                const v = new DOMPoint(bx, by).matrixTransform(toViewBox);
                if (v.x < minX) minX = v.x;
                if (v.x > maxX) maxX = v.x;
                if (v.y < minY) minY = v.y;
                if (v.y > maxY) maxY = v.y;
            }
        }
        if (Number.isFinite(minX) && maxX > minX && maxY > minY) {
            const pad = 18;
            svg.setAttribute(
                "viewBox",
                `${(minX - pad).toFixed(1)} ${(minY - pad).toFixed(1)} ` +
                    `${(maxX - minX + pad * 2).toFixed(1)} ${(maxY - minY + pad * 2).toFixed(1)}`
            );
            // Cropping changes the viewBox transform, so re-read the matrices.
            svgCTM = svg.getScreenCTM();
            groupCTM = group.getScreenCTM();
            if (!svgCTM || !groupCTM) return [];
        }

        const toUser = groupCTM.inverse().multiply(svgCTM);

        // The map is about ninety separate paths. Testing every candidate
        // against all of them is far too slow, so cache each path's bounding
        // box and run the real fill test only on the few that could contain it.
        const boxes = paths.map((path) => {
            const b = path.getBBox();
            return { path, x1: b.x, y1: b.y, x2: b.x + b.width, y2: b.y + b.height };
        });

        const vb = svg.viewBox.baseVal;
        const rect = svg.getBoundingClientRect();

        // On a small rendered map, keep the glyph readable by drawing fewer,
        // proportionally larger bikes rather than a mush of tiny ones.
        const drawnW = Math.min(rect.width || vb.width, (rect.height || vb.height) * (vb.width / vb.height));
        const scale = drawnW < 340 ? 1.55 : drawnW < 460 ? 1.25 : 1;

        const BIKE_W = 26 * scale;
        const BIKE_H = 17 * scale;
        const STEP_X = 28 * scale;
        const STEP_Y = 19 * scale;

        const probe = new DOMPoint();
        function inside(x: number, y: number) {
            probe.x = x;
            probe.y = y;
            const u = probe.matrixTransform(toUser);
            for (const b of boxes) {
                if (u.x < b.x1 || u.x > b.x2 || u.y < b.y1 || u.y > b.y2) continue;
                if (b.path.isPointInFill(u)) return true;
            }
            return false;
        }

        // Auckland, so the fill spreads out from where the story happened.
        const AKL_X = 678;
        const AKL_Y = 228;

        const spots: Array<{ x: number; y: number; order: number }> = [];
        for (let gy = vb.y + STEP_Y; gy < vb.y + vb.height; gy += STEP_Y) {
            for (let gx = vb.x + STEP_X; gx < vb.x + vb.width; gx += STEP_X) {
                const x = gx + (Math.random() - 0.5) * STEP_X * 0.45;
                const y = gy + (Math.random() - 0.5) * STEP_Y * 0.45;
                if (!inside(x, y)) continue;
                // Keep the whole glyph on land, not just its centre.
                if (!inside(x - BIKE_W * 0.35, y)) continue;
                if (!inside(x + BIKE_W * 0.35, y)) continue;
                if (!inside(x, y - BIKE_H * 0.3)) continue;
                if (!inside(x, y + BIKE_H * 0.3)) continue;

                spots.push({ x, y, order: Math.hypot(x - AKL_X, y - AKL_Y) + Math.random() * 80 });
            }
        }

        spots.sort((a, b) => a.order - b.order);

        // A re-init without a document swap would otherwise stack a second
        // layer of bikes on top of the first.
        svg.querySelectorAll(".bike-layer").forEach((old) => old.remove());

        const layer = document.createElementNS(SVG_NS, "g");
        layer.setAttribute("class", "bike-layer");
        const frag = document.createDocumentFragment();
        const marks: SVGGElement[] = [];

        const k = (n: number) => (n * scale).toFixed(2);

        for (const spot of spots) {
            // Position lives on an outer group. The animated class goes on an
            // inner one, because a CSS transform would otherwise replace the
            // transform attribute outright and stack every bike on the origin.
            const pos = document.createElementNS(SVG_NS, "g");
            pos.setAttribute("transform", `translate(${spot.x.toFixed(1)} ${spot.y.toFixed(1)})`);

            const g = document.createElementNS(SVG_NS, "g");
            g.setAttribute("class", "bike-mark");
            pos.appendChild(g);

            const bike = document.createElementNS(SVG_NS, "g");
            bike.setAttribute("fill", "none");
            bike.setAttribute("stroke", "currentColor");
            bike.setAttribute("stroke-width", (2.1 * scale).toFixed(2));
            bike.setAttribute("stroke-linecap", "round");
            bike.setAttribute("stroke-linejoin", "round");

            for (const cx of [-7.8, 7.8]) {
                const wheel = document.createElementNS(SVG_NS, "circle");
                wheel.setAttribute("cx", k(cx));
                wheel.setAttribute("cy", k(3.6));
                wheel.setAttribute("r", k(4.8));
                bike.appendChild(wheel);
            }

            const frame = document.createElementNS(SVG_NS, "path");
            frame.setAttribute(
                "d",
                `M${k(-7.8)} ${k(3.6)} L${k(-1.4)} ${k(-4.8)} L${k(7.8)} ${k(3.6)} ` +
                    `M${k(-1.4)} ${k(-4.8)} L${k(3.4)} ${k(-4.8)} ` +
                    `M${k(-4.5)} ${k(3.6)} L${k(1.7)} ${k(-4.8)}`
            );
            bike.appendChild(frame);

            g.appendChild(bike);
            frag.appendChild(pos);
            marks.push(g);
        }

        layer.appendChild(frag);
        svg.appendChild(layer);
        return marks;
    }

    /**
     * Fills the results map with bikes the first time the slide is reached.
     * Built lazily, because placing them costs a few hundred hit tests and
     * nobody should pay for that on first paint.
     */
    function initResultsBikes() {
        const holder = document.getElementById("rs-map");
        if (!holder || typeof IntersectionObserver === "undefined") return;

        let done = false;

        function fill() {
            if (done) return;
            done = true;

            const svg = holder!.querySelector<SVGSVGElement>(".nz-map-svg");
            if (!svg) return;

            const bikes = buildBikes(svg);
            if (!bikes.length) return;

            if (reducedMotion()) {
                bikes.forEach((bike) => bike.classList.add("is-on"));
                return;
            }

            // Spread the reveal over a fixed span rather than per-frame, so the
            // run takes the same time however many bikes ended up on the map.
            const DURATION = 1700;
            const start = performance.now();
            let shown = 0;
            let frame = 0;

            function step(now: number) {
                const target = Math.round(clamp01((now - start) / DURATION) * bikes.length);
                while (shown < target) bikes[shown++].classList.add("is-on");
                if (shown < bikes.length) frame = requestAnimationFrame(step);
            }

            frame = requestAnimationFrame(step);
            teardown.push(() => cancelAnimationFrame(frame));
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    observer.unobserve(entry.target);
                    fill();
                }
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0 }
        );

        observer.observe(holder);
        teardown.push(() => observer.disconnect());
    }

    /**
     * Slide 5. Four panels share one sticky viewport and cross-fade on scroll
     * position. Only runs where the viewport can actually hold a whole panel;
     * everywhere else the panels stay a plain vertical column.
     */
    function initStack() {
        const stack = document.querySelector<HTMLElement>(".stack");
        if (!stack) return null;

        const panels = Array.from(stack.querySelectorAll<HTMLElement>(".panel"));
        const ticks = Array.from(stack.querySelectorAll<HTMLElement>(".stack-ticks li"));
        if (!panels.length) return null;

        const wideEnough = () =>
            !reducedMotion() &&
            window.matchMedia("(min-width: 1101px) and (min-height: 700px)").matches;

        // A pinned panel is clipped by the sticky viewport, so pinning is only
        // safe while every panel actually fits one. Measured rather than
        // assumed, because the copy and the fonts decide the answer, not the
        // breakpoint. Only re-measured when the viewport changes size.
        //
        // Slack a panel has to clear the viewport by before the deck will pin.
        // A panel that only just fits reads as cramped, and without a margin
        // the whole deck flips between pinned and unpinned on a difference of
        // a pixel or two -- a webfont swapping in, a scrollbar appearing.
        const FIT_SLACK = 24;

        let lastW = -1;
        let lastH = -1;
        let fits = false;

        function refit() {
            if (window.innerWidth === lastW && window.innerHeight === lastH) return;
            lastW = window.innerWidth;
            lastH = window.innerHeight;

            if (!wideEnough()) {
                fits = false;
                return;
            }

            const wasPinned = stack.classList.contains("is-pinned");
            if (!wasPinned) stack.classList.add("is-pinned");

            fits = panels.every((el) => {
                const inner = el.firstElementChild as HTMLElement | null;
                if (!inner) return false;
                const cs = getComputedStyle(el);
                const box =
                    inner.scrollHeight +
                    parseFloat(cs.paddingTop) +
                    parseFloat(cs.paddingBottom);
                return box + FIT_SLACK <= window.innerHeight;
            });

            if (!wasPinned) stack.classList.remove("is-pinned");
        }

        // The first measurement can run before the webfonts have swapped in,
        // on fallback metrics that are not the ones the panels will settle at.
        // The viewport has not changed by then, so refit() would keep its stale
        // answer: invalidate it and measure once the real faces are in.
        let disposed = false;
        teardown.push(() => {
            disposed = true;
        });

        if (document.fonts) {
            document.fonts.ready.then(() => {
                if (disposed) return;
                lastW = -1;
                lastH = -1;
                update();
            });
        }

        /** Scroll distance each panel is held for, as a share of a viewport. */
        const HOLD = 0.9;

        let pinned = false;

        function enable() {
            if (pinned) return;
            pinned = true;
            stack.classList.add("is-pinned");
            stack.style.height = `calc(100dvh + ${panels.length * HOLD * 100}dvh)`;
        }

        function disable() {
            if (!pinned) return;
            pinned = false;
            stack.classList.remove("is-pinned");
            stack.style.height = "";
            panels.forEach((p) => {
                p.style.opacity = "";
                p.style.transform = "";
                p.style.visibility = "";
                p.classList.add("is-in");
                p.removeAttribute("aria-hidden");
            });
            ticks.forEach((t) => t.classList.remove("is-on"));
        }

        function update() {
            refit();

            if (fits) enable();
            else {
                disable();
                return;
            }

            const vh = window.innerHeight;
            const travel = stack.offsetHeight - vh;
            if (travel <= 0) return;

            const p = clamp01(-stack.getBoundingClientRect().top / travel);
            const n = panels.length;
            // Offset by the half-width of the cross-fade, so the ticks flip
            // when the next panel takes over visually rather than a moment late.
            const active = Math.min(n - 1, Math.max(0, Math.floor(p * n + 0.1)));

            for (let i = 0; i < n; i++) {
                // Where this panel sits in its own segment: 0 at the start of
                // its hold, 1 at the end.
                const d = p * n - i;

                let opacity = 0;
                let y = 0;

                // The last panel never exits: it has to still be on screen
                // when the results slide scrolls up over the pin.
                const holds = i === n - 1;

                if (d > -0.2 && (holds || d < 1)) {
                    if (d < 0) {
                        const t = ease((d + 0.2) / 0.2);
                        opacity = t;
                        y = 26 * (1 - t);
                    } else if (d <= 0.82 || holds) {
                        opacity = 1;
                    } else {
                        const t = ease((d - 0.82) / 0.18);
                        opacity = 1 - t;
                        y = -26 * t;
                    }
                }

                const el = panels[i];
                const visible = opacity > 0.01;
                el.style.opacity = opacity.toFixed(3);
                el.style.transform = y === 0 ? "translate3d(0,0,0)" : `translate3d(0, ${y.toFixed(1)}px, 0)`;
                el.style.visibility = visible ? "visible" : "hidden";
                if (visible) el.removeAttribute("aria-hidden");
                else el.setAttribute("aria-hidden", "true");
            }

            // Children of a panel stagger in the first time it is reached.
            panels[active].classList.add("is-in");

            for (let i = 0; i < ticks.length; i++) {
                ticks[i].classList.toggle("is-on", i <= active);
            }
        }

        return update;
    }

    /** Rail marks the slide you are on, and the furniture flips to
     *  light-on-dark while the one dark slide owns the viewport. */
    function initChrome() {
        const page = document.querySelector<HTMLElement>(".abc");
        const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-slide]"));
        const dots = Array.from(document.querySelectorAll<HTMLElement>(".rail-dot"));
        if (!page || !sections.length) return () => {};

        let lastIndex = -1;
        let lastDark: boolean | null = null;

        return function update() {
            const vh = window.innerHeight;
            const mark = vh * 0.42;

            let index = 0;
            let dark = false;

            for (const section of sections) {
                const rect = section.getBoundingClientRect();
                if (rect.top <= mark) index = Number(section.dataset.slide);
                if (
                    section.dataset.tone === "dark" &&
                    rect.top <= mark &&
                    rect.bottom > mark
                ) {
                    dark = true;
                }
            }

            if (index !== lastIndex) {
                lastIndex = index;
                dots.forEach((dot, i) => dot.classList.toggle("is-current", i === index));
            }

            if (dark !== lastDark) {
                lastDark = dark;
                page.classList.toggle("is-dark-ui", dark);
            }
        };
    }

    /** Snap is a nicety, not the layout. It is only switched on where a
     *  slide fits the viewport, and never under reduced motion. */
    function initSnap() {
        const root = document.documentElement;
        const query = window.matchMedia("(min-width: 1101px) and (min-height: 640px)");

        function apply() {
            const on = query.matches && !reducedMotion();
            root.classList.toggle("abc-snap", on);
            root.classList.toggle("abc-smooth", on);
        }

        apply();
        query.addEventListener("change", apply);
        teardown.push(() => {
            query.removeEventListener("change", apply);
            root.classList.remove("abc-snap", "abc-smooth");
        });
    }

    function initAll() {
        teardown.forEach((fn) => fn());
        teardown = [];

        if (!document.querySelector(".abc")) return;

        initSnap();

        const loop = createScrollLoop();
        const stack = initStack();

        // Settle the stack first: initReveals needs to know whether the panels
        // are pinned before it decides to observe them.
        if (stack) stack();

        initReveals();
        initResultsBikes();

        if (stack) loop.subscribe(stack);
        loop.subscribe(initChrome());
        loop.run();
    }

    document.addEventListener("astro:page-load", initAll);
    document.addEventListener("astro:before-swap", () => {
        teardown.forEach((fn) => fn());
        teardown = [];
    });
</script>
