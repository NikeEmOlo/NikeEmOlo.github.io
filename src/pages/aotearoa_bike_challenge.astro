---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import NewZealandMap from "../components/case-study/NewZealandMap.astro";

// Six slides, in order. Drives the progress rail so the rail and the page can
// never disagree about how many slides there are or what they are called.
const SLIDES = [
    { id: "cover", num: "00", label: "Cover" },
    { id: "overview", num: "01", label: "Overview" },
    { id: "programme", num: "02", label: "The task" },
    { id: "challenge", num: "03", label: "The challenge" },
    { id: "handled", num: "04", label: "How I handled it" },
    { id: "results", num: "05", label: "The results" },
];

// Who paid for it and who built it. Drop a real logo into
// public/img/aotearoa/logos and it replaces the wordmark automatically; the
// check runs at build time so a missing file never ships as a broken image.
const LOGO_DIR = path.join(process.cwd(), "public", "img", "aotearoa", "logos");

const PARTNERS = [
    { name: "NZ Transport Agency", role: "Co-funder", file: "nzta" },
    { name: "Auckland Transport", role: "Delivery and co-funder", file: "auckland-transport" },
    { name: "Love To Ride", role: "Platform and prizes", file: "love-to-ride" },
].map((partner) => {
    const found = ["svg", "png", "webp"]
        .map((ext) => `${partner.file}.${ext}`)
        .find((name) => fs.existsSync(path.join(LOGO_DIR, name)));
    return { ...partner, src: found ? `/img/aotearoa/logos/${found}` : null };
});
---

<Base>
    <noscript>
        <style>
            .reveal { opacity: 1 !important; transform: none !important; }
            .bar-fill { width: var(--w) !important; }
        </style>
    </noscript>

    <div class="abc">
        <!-- Back to the card deck. Flips to light-on-dark over the black slide. -->
        <a href="/" class="abc-back" id="abc-back" aria-label="Return to portfolio deck">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6"></path>
            </svg>
            <span>Deck</span>
        </a>

        <!-- Slide rail. Doubles as a table of contents and as the only place on
             the page where the accent is used purely for wayfinding. -->
        <nav class="abc-rail" id="abc-rail" aria-label="Case study slides">
            <ol>
                {SLIDES.map((s, i) => (
                    <li>
                        <a href={`#${s.id}`} class="rail-dot" data-rail={i} aria-label={`${s.num}. ${s.label}`}>
                            <span class="rail-num" aria-hidden="true">{s.num}</span>
                            <span class="rail-tick" aria-hidden="true"></span>
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <!-- ==========================================================
             SLIDE 1: Cover. Carried over from the previous build.
             ========================================================== -->
        <header class="abc-cover" id="cover" data-slide="0" data-tone="light" aria-label="The Aotearoa Bike Challenge">
            <div class="cover-row">
                <div class="cover-text">
                    <h1 class="cover-title">
                        <span class="title-line">The Aotearoa</span>
                        <span class="title-line">Bike Challenge</span>
                    </h1>

                    <div class="cover-meta">
                        <div class="cover-meta-col">
                            <span class="cover-meta-label">My role</span>
                            <span class="cover-meta-val">Project coordinator</span>
                        </div>
                        <div class="cover-meta-col">
                            <span class="cover-meta-label">Organisation</span>
                            <span class="cover-meta-val">Auckland Transport</span>
                        </div>
                        <div class="cover-meta-col">
                            <span class="cover-meta-label">When</span>
                            <span class="cover-meta-val">2023</span>
                        </div>
                    </div>
                </div>
            </div>

            <p class="cover-scroll" aria-hidden="true">
                <span class="cover-scroll-line"></span>
                <span class="cover-scroll-word">Scroll</span>
            </p>
        </header>

        <!-- ==========================================================
             SLIDE 2: Overview
             ========================================================== -->
        <section class="slide slide--paper" id="overview" data-slide="1" data-tone="light" aria-label="Overview">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">01 / Overview</p>

                <div class="slide-head ov-head">
                    <h2 class="title reveal" style="--d: 1">The ask</h2>

                    <div class="head-col">
                        <p class="lead reveal" style="--d: 2">
                            In late 2022 I was asked to coordinate the Aotearoa Bike Challenge for the Auckland region. I had just under three months to plan.
                        </p>
                        <p class="body reveal" style="--d: 3">
                            The ABC is an annual challenge for individuals and businesses to compete to find out who can cycle the most. It is run by local councils, in this case Auckland Transport, in partnership with a private contractor called Love To Ride.
                        </p>
                    </div>

                    <div class="head-col">
                        <p class="body reveal" style="--d: 4">
                            They bring the digital platform which logs riders&rsquo; trips and collects the data, and they source the prizes for the winners. The funding comes from the NZ Transport Agency and Auckland Transport, specifically my team: the Sustainable Mobility Team.
                        </p>
                    </div>
                </div>

                <figure class="ov-map reveal" style="--d: 5">
                    <NewZealandMap class="ov-map-svg" />
                    <figcaption class="body">
                        Nation-wide challenge.<br /><strong>Regionally managed.</strong>
                    </figcaption>
                </figure>

                <div class="ov-partners reveal" style="--d: 6">
                    <p class="label-micro ov-partners-label">Funded and delivered with</p>
                    <ul class="ov-logos">
                        {PARTNERS.map((partner) => (
                            <li>
                                <span class="label-micro ov-logo-role">{partner.role}</span>
                                {partner.src ? (
                                    <img src={partner.src} alt={partner.name} loading="lazy" />
                                ) : (
                                    <span class="body ov-logo-mark">{partner.name}</span>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>

                <aside class="ov-brief reveal" style="--d: 7">
                    <p class="label-micro brief-label">The brief</p>
                    <p class="statement brief-text">
                        Hold participation as close to last year&rsquo;s as possible, and secure the programme&rsquo;s future. On a shoestring budget.
                    </p>
                </aside>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 3: The programme, and my part in it
             ========================================================== -->
        <section class="slide slide--paper" id="programme" data-slide="2" data-tone="light" aria-label="The task">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">02 / The task</p>

                <div class="slide-head pr-head">
                    <h2 class="title reveal" style="--d: 1">Why run<br />this project?</h2>

                    <div class="head-col">
                        <p class="lead reveal" style="--d: 2">
                            NZ had significant <strong>carbon reduction</strong> targets to meet. As the biggest city, a lot of that reduction needed to come from Auckland. This was one of the methods.
                        </p>
                    </div>

                    <div class="head-col">
                        <p class="body reveal" style="--d: 3">
                            My team&rsquo;s purpose was to get more people travelling by modes other than the private vehicle. The ABC was one way to do it: prizes went to the most trips, kilometres, commutes and sign-ups.
                        </p>
                    </div>
                </div>

                <figure class="pr-poster reveal" style="--d: 3">
                    <img
                        src="/img/aotearoa/aotearoa-challenge-poster.webp"
                        alt="Aotearoa Bike Challenge campaign artwork: a cyclist riding through native bush, captioned a fun, friendly bike challenge"
                        width="1024"
                        height="1024"
                        loading="eager"
                    />
                    <figcaption class="label-micro">The 2023 campaign artwork</figcaption>
                </figure>

                <div class="pr-role">
                    <p class="statement pr-job reveal" style="--d: 4">
                        As project coordinator, my job was to make the challenge a success by <mark>retaining participation,</mark> so we could secure funding for the next one.
                    </p>
                    <div class="pr-mine reveal" style="--d: 5">
                        <p class="label-micro pr-mine-label">My part</p>
                        <p class="body pr-mine-text">
                            Communications, marketing, event planning and delivery, keeping contractors on track, and all the administration.
                        </p>
                    </div>
                </div>

                <section class="pr-why">
                    <h3 class="label-micro pr-why-title reveal" style="--d: 5">The benefits to Auckland</h3>
                    <ol>
                        <li class="reveal" style="--d: 6">
                            <span class="label-micro why-n">01</span>
                            <h4>More new cyclists</h4>
                            <p class="body-sm">Gets people onto a bike who otherwise never would have.</p>
                        </li>
                        <li class="reveal" style="--d: 7">
                            <span class="label-micro why-n">02</span>
                            <h4>Safer, confident cyclists</h4>
                            <p class="body-sm">Free skills training, so the road stops being frightening.</p>
                        </li>
                        <li class="reveal" style="--d: 8">
                            <span class="label-micro why-n">03</span>
                            <h4>Removes barriers to cycling</h4>
                            <p class="body-sm">Bikes to borrow, free repairs, and someone to ask.</p>
                        </li>
                        <li class="reveal" style="--d: 9">
                            <span class="label-micro why-n">04</span>
                            <h4>Promotes the cycle network</h4>
                            <p class="body-sm">Shows people cycleways they did not know were there.</p>
                        </li>
                        <li class="reveal" style="--d: 10">
                            <span class="label-micro why-n">05</span>
                            <h4>Makes cycling a habit</h4>
                            <p class="body-sm">A month is long enough for one to stick.</p>
                        </li>
                    </ol>
                </section>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 4: The challenge. The one dark slide on the page.
             ========================================================== -->
        <section class="slide slide--night" id="challenge" data-slide="3" data-tone="dark" aria-label="The challenge">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">03 / The challenge</p>

                <div class="ch-head">
                    <h2 class="title reveal" style="--d: 1">Then four things<br />went wrong</h2>
                </div>

                <ol class="ch-timeline">
                    <li class="reveal" style="--d: 3">
                        <span class="label-micro ch-n">01</span>
                        <p class="label-micro ch-date">October 2022</p>
                        <h3 class="ch-title">A new mayor, a smaller budget</h3>
                        <p class="body-sm ch-text">
                            Auckland elected a new mayor who had campaigned against sustainability in favour of cars. A couple of weeks into the planning phase, I discovered AT&rsquo;s funding was slashed, and the budget for this project went with it. I had to execute the same programme, for the same results, on a fraction of the budget.
                        </p>
                    </li>
                    <li class="reveal" style="--d: 4">
                        <span class="label-micro ch-n">02</span>
                        <p class="label-micro ch-date">The year before</p>
                        <h3 class="ch-title">An inflated benchmark</h3>
                        <p class="body-sm ch-text">
                            The 2022 challenge ran during lockdown, when a bike ride was one of the few things you were allowed to do outdoors. Participation was artificially high. A drop was already certain, and on paper it would read as failure.
                        </p>
                    </li>
                    <li class="reveal" style="--d: 5">
                        <span class="label-micro ch-n">03</span>
                        <p class="label-micro ch-date">27 January 2023</p>
                        <h3 class="ch-title">Floods, three days to launch</h3>
                        <p class="body-sm ch-text">
                            The worst flooding in Auckland&rsquo;s modern history. Cycleways were damaged and closed, the weather was miserable and dangerous, and people had lost their homes. Marketing a bike competition during this needed some serious re-thinking.
                        </p>
                    </li>
                    <li class="reveal" style="--d: 6">
                        <span class="label-micro ch-n">04</span>
                        <p class="label-micro ch-date">February 2023</p>
                        <h3 class="ch-title">Cyclone Gabrielle</h3>
                        <p class="body-sm ch-text">
                            Two weeks into the month, another storm hit, the strongest in decades. It took out even more of the cycle network, and for a lot of the city, cycling became an unreasonable mode of transport.
                        </p>
                    </li>
                </ol>

                <p class="statement ch-kicker reveal" style="--d: 7">
                    Yet the goal had not moved: <mark>hold participation, and keep the programme alive.</mark>
                </p>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 5: How I handled it. Four panels sharing one pinned
             viewport once the layout can carry it. Without JS, below the
             desktop breakpoint, and for reduced motion, the same four
             panels read as a plain vertical column.
             ========================================================== -->
        <section class="stack" id="handled" data-slide="4" data-tone="light" aria-label="How I handled it">
            <div class="stack-vp">
                <div class="slide-inner grid12 stack-head">
                    <p class="eyebrow">04 / How I handled it</p>
                    <ol class="stack-ticks" aria-hidden="true">
                        <li data-tick="0"></li>
                        <li data-tick="1"></li>
                        <li data-tick="2"></li>
                        <li data-tick="3"></li>
                    </ol>
                </div>

                <div class="stack-panels">

                    <article class="panel" data-panel="0">
                        <div class="slide-inner grid12">
                            <p class="label-micro panel-step"><span>01</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Find the data first</h2>
                                <p class="lead reveal" style="--d: 1">
                                    Years of the challenge had produced plenty of data, and no single place to look at it.
                                </p>
                                <p class="body reveal" style="--d: 2">
                                    It sat with Love To Ride, with contractors, with individual colleagues, and with other teams. Nobody was hiding it. It had just never been anybody&rsquo;s job to put it in one place.
                                </p>
                            </div>
                            <aside class="panel-aside reveal" style="--d: 3">
                                <h3 class="label-micro">One spreadsheet</h3>
                                <p class="body">
                                    I pulled as much as possible into a single source of truth: a spreadsheet. Not for elegance, but because most people can open a spreadsheet without being taught how.
                                </p>
                                <p class="body">
                                    Then I wrote the documentation. Where each figure comes from, who is responsible for it, who to contact. The next coordinator would inherit a process instead of a scavenger hunt.
                                </p>
                            </aside>
                        </div>
                    </article>

                    <article class="panel" data-panel="1">
                        <div class="slide-inner grid12">
                            <p class="label-micro panel-step"><span>02</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Ask the data</h2>
                                <p class="lead reveal" style="--d: 1">
                                    With no budget for broad advertising, every scrap of attention had to be aimed at someone specific.
                                </p>
                            </div>
                            <ol class="qa-grid">
                                <li class="reveal" style="--d: 2">
                                    <p class="label-micro qa-q">Who comes back?</p>
                                    <h3 class="qa-a">Big businesses</h3>
                                    <p class="body-sm">The large workplaces with a history of high sign-ups. I went to them first and had big numbers registered before the campaign even opened.</p>
                                </li>
                                <li class="reveal" style="--d: 3">
                                    <p class="label-micro qa-q">Who brings others?</p>
                                    <h3 class="qa-a">Previous high performers</h3>
                                    <p class="body-sm">Love To Ride tracks who recruits the most riders, and there is a prize for it. I went straight to last year&rsquo;s winners and workplace champions and asked them to do it again.</p>
                                </li>
                                <li class="reveal" style="--d: 4">
                                    <p class="label-micro qa-q">Where are the people?</p>
                                    <h3 class="qa-a">Concentrated in the CBD</h3>
                                    <p class="body-sm">The busiest cycle and walking routes in the city. Posters, Q&amp;A stalls, and my own time in person all went where the traffic already was.</p>
                                </li>
                                <li class="reveal" style="--d: 5">
                                    <p class="label-micro qa-q">What is wasted?</p>
                                    <h3 class="qa-a">Expensive events</h3>
                                    <p class="body-sm">Events with thin turnout were cut, and the rest were run leaner. The saved money went into the most popular events, so they could take more riders.</p>
                                </li>
                            </ol>
                        </div>
                    </article>

                    <article class="panel" data-panel="2">
                        <div class="slide-inner grid12">
                            <p class="label-micro panel-step"><span>03</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Collaborate</h2>
                                <p class="lead reveal" style="--d: 1">
                                    Previous years had big-budget advertisements on buses and billboards. I had social media, word of mouth, and a little help from my friends at partner councils.
                                </p>
                                <p class="body reveal" style="--d: 2">
                                    So I wrote the posts myself (years as a digital marketing copywriter finally paid off), and I set up weekly calls with the coordinators at the other councils. Anything that worked for one of us got passed around: social copy, email sequences, cheaper ways to run an event. Tested material, free.
                                </p>
                                <p class="body reveal" style="--d: 3">
                                    And a lot of what contractors used to do, I did. Putting up the posters. Standing on the cycleway talking to riders. Helping run the bike maintenance sessions.
                                </p>
                            </div>
                            <figure class="panel-figure reveal" style="--d: 3">
                                <!-- The tag and arrow are positioned as percentages of the image
                                     box, so they stay locked to her face at any size. -->
                                <div class="fig-frame">
                                    <img
                                        src="/img/aotearoa/project-coordinator-flyer.jpg"
                                        alt="Auckland Transport flyer reading Discover Auckland all over again, free adult bike skills and guided rides"
                                        width="497"
                                        height="1024"
                                        loading="lazy"
                                    />
                                    <svg class="fig-arrow" viewBox="0 0 100 80" fill="none" aria-hidden="true">
                                        <path d="M6 72 C 4 40, 30 16, 78 18" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" />
                                        <path d="M64 8 L 82 18 L 64 29" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    <p class="fig-tag">Hey, that&rsquo;s me!</p>
                                </div>
                                <figcaption class="body-sm">Some events that survived the cuts</figcaption>
                            </figure>
                        </div>
                    </article>

                    <article class="panel" data-panel="3">
                        <div class="slide-inner grid12">
                            <p class="label-micro panel-step"><span>04</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Know when<br />to stop pushing</h2>
                                <p class="lead reveal" style="--d: 1">
                                    Three days before launch, the city flooded. Going quiet in the launch window is one of the worst things you can do for engagement, but it also meant no one had to defend a tone-deaf council, and preserved the goodwill needed when participants returned.
                                </p>
                                <p class="body reveal" style="--d: 2">
                                    Working for a council organisation, I was called into the emergency response, in the journey planning team: helping people who had lost their homes and vehicles get where they needed to be on our fleets.
                                </p>
                                <p class="body reveal" style="--d: 3">
                                    I called an emergency meeting with contractors and we reworked our approach. Marketing was scaled right back, event conduct and locations changed, and the tone shifted. When the cyclone hit, I was on the ground helping clean up the cycle network.
                                </p>
                            </div>
                            <aside class="panel-aside reveal" style="--d: 4">
                                <h3 class="label-micro">The trade</h3>
                                <p class="body">
                                    It cost participation.
                                </p>
                                <p class="body">
                                    Pushing for sign-ups amid a crisis would have been the wrong call, and damaging to the reputation of Auckland Transport.
                                </p>
                            </aside>
                        </div>
                    </article>

                </div>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 6: The results. Back to the cover's yellow to close.
             ========================================================== -->
        <section class="slide slide--accent" id="results" data-slide="5" data-tone="light" aria-label="The results">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">05 / The results</p>

                <div class="rs-head">
                    <h2 class="title reveal" style="--d: 1">Auckland,<br />February 2023</h2>

                    <figure class="rs-bars reveal" style="--d: 2">
                        <figcaption class="label-micro">Auckland participants, year on year</figcaption>
                        <div class="bar-row">
                            <span class="bar-year">2022</span>
                            <span class="bar-track"><span class="bar-fill" style="--w: 100%"></span></span>
                            <span class="bar-val">6,153</span>
                            <span class="body-sm bar-note">lockdown year</span>
                        </div>
                        <div class="bar-row">
                            <span class="bar-year">2023</span>
                            <span class="bar-track"><span class="bar-fill is-now" style="--w: 87.2%"></span></span>
                            <span class="bar-val">5,365</span>
                        </div>
                    </figure>

                    <p class="body rs-note reveal" style="--d: 3">
                        A 13% drop, against a lockdown-inflated all-time high, with no mass advertising and two of the four weeks lost to the worst weather in the event&rsquo;s history.
                    </p>

                    <p class="statement rs-kicker reveal" style="--d: 4">The challenge was funded again the next year.</p>
                </div>

                <!-- The map fills with bikes once the slide is reached: the
                     country on bikes for a month, which is the whole point. -->
                <div class="rs-map reveal" style="--d: 2" id="rs-map">
                    <NewZealandMap class="rs-map-svg" />
                </div>

                <dl class="rs-stats">
                    <div class="stat reveal" style="--d: 3">
                        <dt>Total participants</dt>
                        <dd class="num">5,365</dd>
                    </div>
                    <div class="stat reveal" style="--d: 4">
                        <dt>Riders new to the challenge</dt>
                        <dd class="num">817</dd>
                    </div>
                    <div class="stat reveal" style="--d: 5">
                        <dt>Of last year&rsquo;s participation held</dt>
                        <dd class="num">87.2%</dd>
                    </div>
                </dl>
            </div>
        </section>

    </div>
</Base>

<style>
    /* =============================================================
       AOTEAROA BIKE CHALLENGE

       Six slides. Mostly monochrome on warm paper, with one accent
       (Doodle-Pop yellow, taken from this project's card colour) and one
       inverted slide. The accent is only ever used where it does work:
       wayfinding on the rail, the brief, the one line that carries the
       stakes, and the closing numbers. Everything else is type and rules.
       ============================================================= */
    .abc {
        /* Ink */
        --ink: #111111;
        --ink-2: #4F4F53;
        --ink-3: #6E6E72;
        --paper: #FAF8F5;
        --line: rgba(17, 17, 17, 0.14);
        --line-soft: rgba(17, 17, 17, 0.08);

        /* The one accent on the page */
        --accent: #FFDA00;

        /* The one dark slide */
        --night: #0C0C0D;
        --on-night: #F5F5F3;
        --on-night-2: rgba(245, 245, 243, 0.66);
        --night-line: rgba(245, 245, 243, 0.18);

        /* Rhythm. One gutter and one column gap for the whole page, so
           every slide lines up with every other slide. */
        --gut: clamp(24px, 5.4vw, 108px);
        --pad-y: clamp(70px, 8.8vh, 112px);
        /* Space the fixed slide rail sits in, so it never lands on content. */
        --rail-gap: clamp(30px, 3vw, 54px);
        --col-gap: clamp(14px, 1.7vw, 26px);
        --row-gap: clamp(24px, 4vh, 50px);

        /* ---------------------------------------------------------
           SPACING
           One scale, used for every gap, margin and pad on the deck.
           Steps are roughly 1.5x apart, so two of them never read as
           the same amount of air.
           --------------------------------------------------------- */
        --s-1: 6px;
        --s-2: 10px;
        --s-3: 16px;
        --s-4: clamp(20px, 2.2vh, 28px);
        --s-5: clamp(28px, 3.4vh, 42px);
        --s-6: clamp(40px, 5vh, 64px);

        /* ---------------------------------------------------------
           TYPE SYSTEM
           One ladder for the whole deck. Every piece of text picks a
           role from this list; a slide never invents a size.

             cover    the cover title, and nothing else
             display  a figure read as a number, not as a word
             title    the one headline per slide
             lead     the opening paragraph, and any single sentence
                      set apart to carry the stakes
             body     prose
             body-sm  prose inside a multi-column row, where the
                      column is too narrow for body to set well
             micro    a small-caps label naming what follows it

           Weight does one job: it separates a label from its content.
           Labels and figures are black (800), sub-headings and the
           emphasis inside prose are bold (700), and everything a
           reader actually reads is regular (400). Nothing else.
           --------------------------------------------------------- */
        --t-cover: clamp(2.6rem, 8.9vw, 150px);
        --t-display: clamp(2.2rem, 1.4rem + 2.5vw, 4.4rem);
        --t-title: clamp(2.3rem, 1.55rem + 2.7vw, 5rem);
        --t-lead: clamp(1.1rem, 0.86rem + 0.6vw, 1.5rem);
        --t-body: clamp(1rem, 0.86rem + 0.28vw, 1.16rem);
        --t-body-sm: clamp(0.9rem, 0.82rem + 0.2vw, 1.02rem);
        --t-micro: clamp(0.8rem, 0.74rem + 0.16vw, 0.9rem);

        --w-regular: 400;
        --w-bold: 700;
        --w-black: 800;

        /* Tracking follows size: the bigger the type, the tighter it
           sets, and small-caps labels open up instead. */
        --track-display: -0.05em;
        --track-title: -0.045em;
        --track-text: -0.012em;
        --track-micro: 0.1em;

        --sans: var(--archivo-font, 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);

        background-color: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        overflow-x: clip;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    /* Snap is opt-in from the script, and only where the viewport can
       actually hold a slide. Everywhere else this is an ordinary page. */
    :global(html.abc-snap) {
        scroll-snap-type: y proximity;
    }

    :global(html.abc-snap) .slide,
    :global(html.abc-snap) .abc-cover,
    :global(html.abc-snap) .stack:not(.is-pinned) .panel {
        scroll-snap-align: start;
    }

    :global(html.abc-smooth) {
        scroll-behavior: smooth;
    }

    /* ---------- Shared slide frame ---------- */
    .slide {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: var(--pad-y) var(--gut);
        box-sizing: border-box;
    }

    .slide--paper {
        background-color: var(--paper);
        color: var(--ink);
    }

    .slide--night {
        background-color: var(--night);
        color: var(--on-night);
    }

    .slide--accent {
        background-color: var(--accent);
        color: var(--ink);
    }

    .slide-inner {
        width: 100%;
        max-width: 1480px;
        margin-inline: auto;
    }

    .grid12 {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--col-gap);
        row-gap: var(--row-gap);
        align-items: start;
    }

    /* ---------- Shared type ---------- */
    /* MICRO. Every label on the deck is this one class, set in small
       caps: a label is recognised by its case, not by being tiny. */
    .label-micro,
    .eyebrow {
        font-size: var(--t-micro);
        font-weight: var(--w-black);
        font-variant-caps: all-small-caps;
        letter-spacing: var(--track-micro);
        line-height: 1.2;
        color: var(--ink-3);
        margin: 0;
    }

    /* The section marker is the same label, given a rule and the full
       width of the grid: position tells you it is the top of a slide. */
    .eyebrow {
        grid-column: 1 / -1;
        padding-bottom: var(--s-3);
        border-bottom: 1px solid var(--line);
    }

    .slide--night .eyebrow {
        color: var(--on-night-2);
        border-bottom-color: var(--night-line);
    }

    .title {
        font-size: var(--t-title);
        font-weight: var(--w-black);
        line-height: 0.97;
        letter-spacing: var(--track-title);
        margin: 0;
    }

    /* LEAD. The opening paragraph, and every sentence the deck sets
       apart to carry a point. A statement is marked out by the block it
       sits in, not by being bigger or heavier than the writing around
       it, so it runs at exactly the size and weight of a lead. */
    .lead,
    .statement {
        font-size: var(--t-lead);
        font-weight: var(--w-regular);
        line-height: 1.45;
        letter-spacing: var(--track-text);
        color: var(--ink);
        margin: 0;
    }

    /* A statement is the one sentence on a slide that has to be read even
       by someone skimming, so it takes bold - never black, which is
       reserved for labels and figures. */
    .statement { font-weight: var(--w-bold); }

    .lead { max-width: 46ch; }

    .body {
        font-size: var(--t-body);
        font-weight: var(--w-regular);
        line-height: 1.62;
        letter-spacing: -0.008em;
        color: var(--ink-2);
        margin: 0;
        max-width: 54ch;
    }

    /* Prose in a narrow column of a multi-column row. */
    .body-sm {
        font-size: var(--t-body-sm);
        font-weight: var(--w-regular);
        line-height: 1.55;
        letter-spacing: -0.006em;
        color: var(--ink-2);
        margin: 0;
    }

    .body strong,
    .lead strong,
    .statement strong { font-weight: var(--w-bold); color: inherit; }

    .slide--night .lead,
    .slide--night .statement { color: var(--on-night); }

    .slide--night .body,
    .slide--night .body-sm { color: var(--on-night-2); }

    .label {
        font-size: var(--t-micro);
        font-weight: var(--w-black);
        font-variant-caps: all-small-caps;
        letter-spacing: var(--track-micro);
        color: var(--ink-3);
    }

    /* ---------- Shared head block ----------
       Title first, at full width, then the prose beneath it in two
       columns of the page grid. The block is a subgrid, so its columns
       are the page's columns: the text lines up with the rows further
       down the slide instead of merely looking as though it does. */
    .slide-head {
        grid-column: 1 / span 8;
        display: grid;
        grid-template-columns: subgrid;
        row-gap: var(--s-4);
        align-content: start;
    }

    .slide-head > .title { grid-column: 1 / -1; }

    .slide-head > .head-col {
        grid-column: span 4;
        display: flex;
        flex-direction: column;
        gap: var(--s-4);
        min-width: 0;
    }

    .slide-head .lead,
    .slide-head .body { max-width: none; }

    /* ---------- Reveal. One transition, staggered by --d ---------- */
    .reveal {
        opacity: 0;
        transform: translateY(15px);
        transition:
            opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d, 0) * 45ms),
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d, 0) * 45ms);
    }

    .is-in .reveal {
        opacity: 1;
        transform: none;
    }

    /* =============================================================
       PAGE FURNITURE: back button and slide rail
       ============================================================= */
    .abc-back {
        position: fixed;
        top: clamp(16px, 2.2vh, 28px);
        left: clamp(20px, 3.4vw, 44px);
        z-index: 60;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 15px 6px 11px;
        border: 1.5px solid var(--ink);
        border-radius: 999px;
        background-color: rgba(250, 248, 245, 0.82);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        color: var(--ink);
        font-size: var(--t-micro);
        font-weight: var(--w-black);
        font-variant-caps: all-small-caps;
        letter-spacing: var(--track-micro);
        text-decoration: none;
        transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
    }

    .abc-back:hover {
        background-color: var(--ink);
        color: var(--paper);
        transform: translateX(-2px);
    }

    .abc.is-dark-ui .abc-back {
        background-color: rgba(12, 12, 13, 0.7);
        border-color: rgba(245, 245, 243, 0.4);
        color: var(--on-night);
    }

    .abc.is-dark-ui .abc-back:hover {
        background-color: var(--on-night);
        color: var(--night);
    }

    /* Slide rail. The tick is the whole control; the number only appears
       for the slide you are on, or the one you are pointing at. */
    .abc-rail {
        position: fixed;
        top: 50%;
        right: clamp(16px, 1.9vw, 28px);
        transform: translateY(-50%);
        z-index: 60;
    }

    .abc-rail ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 13px;
    }

    .rail-dot {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        padding: 5px 0;
        text-decoration: none;
        cursor: pointer;
    }

    .rail-num {
        font-size: var(--t-micro);
        font-weight: var(--w-black);
        letter-spacing: var(--track-micro);
        color: var(--ink-3);
        opacity: 0;
        transform: translateX(5px);
        transition: opacity 0.3s ease, transform 0.3s ease, color 0.3s ease;
    }

    .rail-tick {
        display: block;
        width: 18px;
        height: 2px;
        background-color: var(--ink);
        opacity: 0.28;
        transition: width 0.34s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, background-color 0.3s ease;
    }

    .rail-dot:hover .rail-num,
    .rail-dot.is-current .rail-num {
        opacity: 1;
        transform: none;
    }

    .rail-dot:hover .rail-tick {
        opacity: 0.6;
        width: 26px;
    }

    .rail-dot.is-current .rail-tick {
        width: 34px;
        opacity: 1;
        background-color: var(--ink);
    }

    /* The accent marks where you are. It is the only job it does here. */
    .abc.is-accent-ui .rail-dot.is-current .rail-tick {
        background-color: var(--ink);
    }

    .abc.is-dark-ui .rail-num {
        color: var(--on-night-2);
    }

    .abc.is-dark-ui .rail-tick {
        background-color: var(--on-night);
    }

    .abc.is-dark-ui .rail-dot.is-current .rail-tick {
        background-color: var(--accent);
    }

    .abc.is-dark-ui .rail-dot.is-current .rail-num {
        color: var(--accent);
    }

    @media (max-width: 1100px) {
        .abc-rail { display: none; }
    }

    /* =============================================================
       SLIDE 1: COVER
       ============================================================= */
    .abc-cover {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(28px, 4.5vh, 48px) clamp(24px, 8.6vw, 130px);
        background-color: var(--accent);
        color: #000000;
        box-sizing: border-box;
        overflow: hidden;
    }

    .cover-row {
        width: 100%;
        margin-block: auto;
        padding-block: clamp(16px, 2.5vh, 32px);
    }

    .cover-text {
        display: flex;
        flex-direction: column;
        gap: clamp(24px, 3.8vh, 44px);
        align-items: flex-start;
        min-width: 0;
    }

    .cover-title {
        font-size: var(--t-cover);
        font-weight: var(--w-black);
        line-height: 0.94;
        letter-spacing: -0.06em;
        color: #000000;
        margin: 0;
    }

    .title-line {
        display: block;
        white-space: nowrap;
    }

    .cover-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, auto));
        justify-content: start;
        column-gap: clamp(28px, 3.8vw, 68px);
        width: 100%;
        align-items: start;
    }

    .cover-meta-col {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* The cover states the same label-then-answer pattern the slides
       use, at the only size on the deck that is allowed to be this
       large: the label carries the weight, the answer is set plainly. */
    .cover-meta-label {
        font-size: clamp(1.35rem, 2.5vw, 36px);
        font-weight: var(--w-black);
        letter-spacing: -0.03em;
        line-height: 1.15;
    }

    .cover-meta-val {
        font-size: clamp(1.05rem, 1.66vw, 24px);
        font-weight: var(--w-regular);
        letter-spacing: -0.03em;
        line-height: 1.25;
    }

    /* A quiet cue that the cover is the first of six, not the whole page. */
    .cover-scroll {
        position: absolute;
        left: clamp(24px, 8.6vw, 130px);
        bottom: clamp(26px, 4.6vh, 54px);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cover-scroll-line {
        position: relative;
        display: block;
        width: 46px;
        height: 2px;
        background-color: rgba(0, 0, 0, 0.22);
        overflow: hidden;
    }

    .cover-scroll-line::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 16px;
        background-color: #000000;
        animation: scrollCue 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    .cover-scroll-word {
        font-size: var(--t-micro);
        font-weight: var(--w-black);
        font-variant-caps: all-small-caps;
        letter-spacing: var(--track-micro);
        color: rgba(0, 0, 0, 0.62);
    }

    @keyframes scrollCue {
        0%   { transform: translateX(-100%); }
        55%  { transform: translateX(188%); }
        100% { transform: translateX(188%); }
    }

    /* =============================================================
       SLIDE 2: OVERVIEW
       ============================================================= */
    /* The head is the shared block; the map is the slide's one figure. */
    .ov-map  { grid-column: 10 / span 3; margin: 0; justify-self: end; text-align: right; }
    .ov-partners { grid-column: 1 / -1; }
    .ov-brief { grid-column: 1 / -1; }

    .ov-map :global(.ov-map-svg) {
        height: clamp(170px, 25vh, 280px);
        min-height: 0;
        min-width: 0;
        color: rgba(17, 17, 17, 0.19);
        margin-inline-start: auto;
    }

    /* The map is a quiet locator, so it loses the glow and the pin takes
       the accent: the one thing on it that carries information. */
    .ov-map :global(.nz-map-svg) { filter: none; }
    .ov-map :global(.auckland-beacon circle) { stroke: var(--accent); }
    .ov-map :global(.beacon-core) { fill: var(--ink); filter: none; r: 26; }

    .ov-map figcaption {
        margin-top: var(--s-3);
        margin-inline-start: auto;
        color: var(--ink-3);
        max-width: 24ch;
    }

    .ov-map figcaption strong { color: var(--ink); }

    /* Partners. Monochrome by design: these are other people's marks, so
       they sit quietly on a rule rather than competing with the brief. */
    .ov-partners {
        display: grid;
        grid-template-columns: subgrid;
        row-gap: var(--s-3);
    }

    .ov-partners-label { grid-column: 1 / -1; }

    /* The row runs on the page grid, two columns per partner, so the
       third partner starts exactly where the second column of prose
       above it starts and the first two sit under the first column. */
    .ov-logos {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1 / -1;
        grid-auto-rows: auto;
        row-gap: var(--s-4);
    }

    /* Label above the thing it names, the same way the cover reads
       "My role" and then the answer. The label carries the weight; the
       answer is set plainly, because it is the part being read. The
       rows are shared, so a label that wraps cannot push one partner's
       name out of line with the others. */
    .ov-logos li {
        grid-column: span 2;
        display: grid;
        grid-template-rows: subgrid;
        grid-row: span 2;
        align-content: start;
        row-gap: var(--s-2);
        min-width: 0;
        border-top: 1px solid var(--line);
        padding-top: var(--s-3);
    }

    .ov-logo-role { color: var(--ink); }

    .ov-logos img {
        height: clamp(24px, 2.4vw, 38px);
        width: auto;
        object-fit: contain;
        object-position: left top;
    }

    .ov-logo-mark {
        font-weight: var(--w-bold);
        letter-spacing: var(--track-text);
        color: var(--ink);
        max-width: none;
    }

    /* The last thing read before the trouble starts. It is the widest
       block on the slide and the only one on accent, which is what
       makes it loud: the sentence inside runs at the same size and
       weight as any other lead on the deck. */
    .ov-brief {
        background-color: var(--accent);
        border-radius: 3px;
        padding: var(--s-5) var(--s-5);
        display: grid;
        grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);
        column-gap: var(--s-5);
        align-items: start;
    }

    .brief-label {
        color: var(--ink);
        border-top: 2px solid var(--ink);
        padding-top: var(--s-2);
    }

    .brief-text { max-width: 52ch; }

    /* =============================================================
       SLIDE 3: THE PROGRAMME
       ============================================================= */
    /* The lead runs at a larger size than the body, so it gets the wider
       column and the two land at roughly the same depth. */
    /* Layout comes from .slide-head; slide 02 adds nothing to it. */

    .pr-poster {
        grid-column: 10 / span 3;
        margin: 0;
        align-self: center;
    }

    .pr-poster img {
        width: 100%;
        height: auto;
        border-radius: 4px;
    }

    .pr-poster figcaption {
        margin-top: var(--s-3);
        text-align: center;
    }

    /* The brief restated as the job, next to the shape of the job. The
       block is the same component as the brief on slide 01, because it is
       the same kind of statement: what success had to look like. */
    .pr-role {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        column-gap: clamp(20px, 3vw, 44px);
        row-gap: 16px;
        align-items: start;
    }

    .pr-job {
        background-color: var(--accent);
        border-radius: 3px;
        padding: var(--s-4);
    }

    /* Yellow on yellow, so the emphasis has to become a rule rather than
       a fill. It still lands on the clause the whole page answers to. */
    .pr-job mark {
        background: none;
        color: inherit;
        padding: 0;
        border-bottom: 2px solid var(--ink);
    }

    .pr-mine {
        align-self: start;
        border-top: 2px solid var(--ink);
        padding-top: var(--s-3);
    }

    .pr-mine-label { margin-bottom: var(--s-2); }

    .pr-why { grid-column: 1 / -1; }

    .pr-why-title {
        margin: 0 0 var(--s-3);
    }

    .pr-why ol {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        column-gap: var(--col-gap);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .pr-why li {
        border-top: 1px solid var(--line);
        padding-top: var(--s-3);
    }

    .why-n {
        display: block;
        margin-bottom: var(--s-2);
    }

    .pr-why h4 {
        font-size: var(--t-body);
        font-weight: var(--w-bold);
        letter-spacing: var(--track-text);
        margin: 0 0 var(--s-1);
    }

    /* This slide carries four rows of content against everyone else's three,
       so it runs a little tighter to stay one screen tall. */
    #programme .pr-head .lead { line-height: 1.38; }
    #programme .pr-head .body { line-height: 1.55; }
    #programme .pr-why p { line-height: 1.45; }

    /* =============================================================
       SLIDE 4: THE CHALLENGE
       ============================================================= */
    .ch-head {
        grid-column: 1 / -1;
    }

    .ch-timeline {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: var(--col-gap);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .ch-timeline li {
        position: relative;
        border-top: 1px solid var(--night-line);
        padding-top: var(--s-4);
    }

    /* The marker that walks the timeline. Accent, because it is the only
       thing telling you these four happened in an order. */
    .ch-timeline li::before {
        content: "";
        position: absolute;
        top: -3px;
        left: 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--accent);
    }

    .ch-n {
        display: block;
        color: var(--on-night-2);
        margin-bottom: var(--s-3);
    }

    .ch-date {
        color: var(--accent);
        margin-bottom: var(--s-1);
    }

    .ch-title {
        font-size: var(--t-lead);
        font-weight: var(--w-bold);
        letter-spacing: var(--track-text);
        line-height: 1.15;
        margin: 0 0 var(--s-2);
    }

    .ch-kicker {
        grid-column: 1 / -1;
        border-top: 1px solid var(--night-line);
        padding-top: var(--s-5);
    }

    .ch-kicker mark {
        background: none;
        color: var(--accent);
        font-weight: var(--w-bold);
    }

    /* =============================================================
       SLIDE 5: HOW I HANDLED IT
       Four panels. Plain vertical column by default; the script adds
       .is-pinned when the viewport can hold one panel at a time.
       ============================================================= */
    .stack {
        position: relative;
        background-color: var(--paper);
    }

    .stack-head {
        padding: var(--pad-y) var(--gut) 0;
        max-width: none;
    }

    .stack-head .eyebrow {
        grid-column: 1 / span 8;
        margin-bottom: 0;
        border-bottom: none;
        padding-bottom: 0;
    }

    .stack-ticks {
        grid-column: 10 / -1;
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .stack-ticks li {
        width: 26px;
        height: 2px;
        background-color: var(--line);
        transition: background-color 0.35s ease;
    }

    .stack-ticks li.is-on { background-color: var(--ink); }

    /* The ticks track the pinned sequence. Read as a plain column, there is
       no sequence for them to track, so they go. */
    .stack:not(.is-pinned) .stack-ticks { display: none; }

    .panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: var(--pad-y) var(--gut);
        box-sizing: border-box;
    }

    .panel-step {
        grid-column: 1 / -1;
        padding-bottom: var(--s-3);
        border-bottom: 1px solid var(--line);
    }

    .panel-step span { color: var(--ink); }

    .panel-main {
        grid-column: 1 / span 7;
        display: flex;
        flex-direction: column;
        gap: clamp(14px, 1.7vh, 22px);
    }

    .panel-aside {
        grid-column: 9 / span 4;
        border-top: 2px solid var(--ink);
        padding-top: var(--s-3);
        display: flex;
        flex-direction: column;
        gap: var(--s-3);
    }

    .panel-aside h3 { color: var(--ink); }

    /* Full column width, so the frame below has a definite percentage to
       resolve against instead of shrink-to-fitting around its own contents. */
    .panel-figure {
        grid-column: 9 / span 4;
        margin: 0;
    }

    /* A definite width, taken from the height the panel can spare, so the
       frame never sizes itself from its own contents: the tag below is laid
       out in container units and would otherwise feed back into the width.
       Percentages then keep the tag and the arrow locked to her at any size. */
    .fig-frame {
        position: relative;
        display: block;
        width: min(100%, calc(54vh * 497 / 1024));
        margin-inline-start: auto;
