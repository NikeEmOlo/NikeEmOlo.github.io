---
import Base from "../layouts/Base.astro";
import NewZealandMap from "../components/case-study/NewZealandMap.astro";

// Six slides, in order. Drives the progress rail so the rail and the page can
// never disagree about how many slides there are or what they are called.
const SLIDES = [
    { id: "cover", num: "00", label: "Cover" },
    { id: "overview", num: "01", label: "Overview" },
    { id: "programme", num: "02", label: "The programme" },
    { id: "challenge", num: "03", label: "The challenge" },
    { id: "handled", num: "04", label: "How I handled it" },
    { id: "results", num: "05", label: "The results" },
];
---

<Base>
    <noscript>
        <style>
            .reveal { opacity: 1 !important; transform: none !important; }
            .bar-fill { width: var(--w) !important; }
        </style>
    </noscript>

    <div class="abc">
        <!-- Back to the card deck. Flips to light-on-dark over the black slide. -->
        <a href="/" class="abc-back" id="abc-back" aria-label="Return to portfolio deck">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6"></path>
            </svg>
            <span>Deck</span>
        </a>

        <!-- Slide rail. Doubles as a table of contents and as the only place on
             the page where the accent is used purely for wayfinding. -->
        <nav class="abc-rail" id="abc-rail" aria-label="Case study slides">
            <ol>
                {SLIDES.map((s, i) => (
                    <li>
                        <a href={`#${s.id}`} class="rail-dot" data-rail={i} aria-label={`${s.num}. ${s.label}`}>
                            <span class="rail-num" aria-hidden="true">{s.num}</span>
                            <span class="rail-tick" aria-hidden="true"></span>
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <!-- ==========================================================
             SLIDE 1: Cover. Carried over from the previous build.
             ========================================================== -->
        <header class="abc-cover" id="cover" data-slide="0" data-tone="light" aria-label="The Aotearoa Bike Challenge">
            <div class="cover-row">
                <div class="cover-text">
                    <h1 class="cover-title">
                        <span class="title-line">The Aotearoa</span>
                        <span class="title-line">Bike Challenge</span>
                    </h1>

                    <div class="cover-meta">
                        <div class="cover-meta-col">
                            <span class="cover-meta-label">My role</span>
                            <span class="cover-meta-val">Project coordinator</span>
                        </div>
                        <div class="cover-meta-col">
                            <span class="cover-meta-label">Organisation</span>
                            <span class="cover-meta-val">Auckland Transport</span>
                        </div>
                        <div class="cover-meta-col">
                            <span class="cover-meta-label">When</span>
                            <span class="cover-meta-val">2023</span>
                        </div>
                    </div>
                </div>

                <div class="cover-arrow-col">
                    <div class="cover-doodle">
                        <img
                            src="/img/aotearoa/abc-challenge-arrow.png"
                            alt=""
                            class="doodle-arrow"
                            width="130"
                            height="228"
                            loading="eager"
                        />
                        <div class="doodle-pill">
                            <span class="pill-line">Emphasis on</span>
                            <span class="pill-line">&ldquo;challenge&rdquo;</span>
                        </div>
                    </div>
                </div>
            </div>

            <p class="cover-scroll" aria-hidden="true">
                <span class="cover-scroll-line"></span>
                <span class="cover-scroll-word">Scroll</span>
            </p>
        </header>

        <!-- ==========================================================
             SLIDE 2: Overview
             ========================================================== -->
        <section class="slide slide--paper" id="overview" data-slide="1" data-tone="light" aria-label="Overview">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">01 / Overview</p>

                <div class="ov-head">
                    <h2 class="title reveal" style="--d: 1">What I was<br />asked to do</h2>
                </div>

                <div class="ov-body">
                    <p class="lead reveal" style="--d: 2">
                        In late 2022 I was asked to coordinate the Aotearoa Bike Challenge for the following February. I had about three months.
                    </p>
                    <p class="body reveal" style="--d: 3">
                        The challenge is run by Auckland Transport, the council organisation I worked for, co-funded with Waka Kotahi (NZTA), and delivered with a contractor called Love To Ride. Their platform logs riders&rsquo; trips, runs the leaderboards, and sources the prizes.
                    </p>
                </div>

                <figure class="ov-map reveal" style="--d: 4">
                    <NewZealandMap class="ov-map-svg" />
                    <figcaption>
                        Nation-wide challenge.<br /><strong>Auckland was my patch.</strong>
                    </figcaption>
                </figure>

                <dl class="ov-facts reveal" style="--d: 5">
                    <div class="fact">
                        <dt>My role</dt>
                        <dd>Project coordinator, end to end</dd>
                    </div>
                    <div class="fact">
                        <dt>Team</dt>
                        <dd>Sustainable Mobility, Auckland Transport</dd>
                    </div>
                    <div class="fact">
                        <dt>Partners</dt>
                        <dd>Waka Kotahi (NZTA), Love To Ride</dd>
                    </div>
                    <div class="fact">
                        <dt>Runway</dt>
                        <dd>Three months to launch</dd>
                    </div>
                </dl>

                <aside class="ov-brief reveal" style="--d: 6">
                    <p class="brief-label">The brief</p>
                    <p class="brief-text">
                        Hold participation as close to last year&rsquo;s as possible, and secure the programme&rsquo;s future. On a shoestring budget.
                    </p>
                </aside>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 3: The programme, and my part in it
             ========================================================== -->
        <section class="slide slide--paper" id="programme" data-slide="2" data-tone="light" aria-label="The programme">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">02 / The programme</p>

                <div class="pr-head">
                    <h2 class="title reveal" style="--d: 1">The whole country,<br />on bikes, every February</h2>
                    <p class="lead reveal" style="--d: 2">
                        Individuals, workplaces, and organisations compete to see who can cycle the most. Riders log their trips in the app, and prizes go to the most kilometres, the most commutes, and whoever signs up the most people.
                    </p>
                    <p class="body reveal" style="--d: 3">
                        I worked in Auckland Transport&rsquo;s Sustainable Mobility team, where the job was behaviour change: getting people out of cars and onto bikes. New Zealand cannot hit its climate targets without cutting transport emissions, and as the biggest city, much of that has to happen here.
                    </p>
                </div>

                <figure class="pr-poster reveal" style="--d: 3">
                    <img
                        src="/img/aotearoa/aotearoa-challenge-poster.webp"
                        alt="Aotearoa Bike Challenge campaign artwork: a cyclist riding through native bush, captioned a fun, friendly bike challenge"
                        width="1024"
                        height="1024"
                        loading="eager"
                    />
                    <figcaption>The 2023 campaign artwork</figcaption>
                </figure>

                <ol class="pr-why">
                    <li class="reveal" style="--d: 5">
                        <span class="why-n">01</span>
                        <h3>First rides</h3>
                        <p>Gets people onto a bike who otherwise never would have.</p>
                    </li>
                    <li class="reveal" style="--d: 6">
                        <span class="why-n">02</span>
                        <h3>Confidence</h3>
                        <p>Free skills training, so the road stops being frightening.</p>
                    </li>
                    <li class="reveal" style="--d: 7">
                        <span class="why-n">03</span>
                        <h3>Fewer barriers</h3>
                        <p>Bikes to borrow, free repairs, and someone to ask.</p>
                    </li>
                    <li class="reveal" style="--d: 8">
                        <span class="why-n">04</span>
                        <h3>The network</h3>
                        <p>Shows people cycleways they did not know were there.</p>
                    </li>
                    <li class="reveal" style="--d: 9">
                        <span class="why-n">05</span>
                        <h3>A habit</h3>
                        <p>A month is long enough for one to stick.</p>
                    </li>
                </ol>

                <div class="pr-mine reveal" style="--d: 10">
                    <p class="pr-mine-label">My part</p>
                    <p class="pr-mine-text">
                        All of it. Keeping contractors on schedule for a launch date that could not move, keeping partner councils in the loop, and writing most of the public, social, and internal copy myself.
                    </p>
                </div>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 4: The challenge. The one dark slide on the page.
             ========================================================== -->
        <section class="slide slide--night" id="challenge" data-slide="3" data-tone="dark" aria-label="The challenge">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">03 / The challenge</p>

                <div class="ch-head">
                    <h2 class="title reveal" style="--d: 1">Then four things<br />went wrong</h2>
                    <p class="lead reveal" style="--d: 2">
                        None of them were in the plan, and none of them were mine to control.
                    </p>
                </div>

                <ol class="ch-timeline">
                    <li class="reveal" style="--d: 3">
                        <span class="ch-n">01</span>
                        <p class="ch-date">October 2022</p>
                        <h3 class="ch-title">A new mayor</h3>
                        <p class="ch-text">
                            Auckland elected a mayor who had campaigned against cycling. Auckland Transport&rsquo;s funding was cut, and this project&rsquo;s budget went with it. Same target, a fraction of the money.
                        </p>
                    </li>
                    <li class="reveal" style="--d: 4">
                        <span class="ch-n">02</span>
                        <p class="ch-date">The year before</p>
                        <h3 class="ch-title">An inflated benchmark</h3>
                        <p class="ch-text">
                            The 2022 challenge ran during lockdown, when a bike ride was one of the few things you were allowed to do outdoors. Participation was artificially high. A drop was already certain, and on paper it would read as failure.
                        </p>
                    </li>
                    <li class="reveal" style="--d: 5">
                        <span class="ch-n">03</span>
                        <p class="ch-date">27 January 2023</p>
                        <h3 class="ch-title">Floods, three days out</h3>
                        <p class="ch-text">
                            The worst flooding in Auckland&rsquo;s modern history. Cycleways were damaged and closed, the weather was miserable, and people had lost their homes. Marketing a bike competition into that was not an option.
                        </p>
                    </li>
                    <li class="reveal" style="--d: 6">
                        <span class="ch-n">04</span>
                        <p class="ch-date">February 2023</p>
                        <h3 class="ch-title">Cyclone Gabrielle</h3>
                        <p class="ch-text">
                            Two weeks into the month, another storm took out more of the network. For most of the city, cycling had stopped being a reasonable way to get to work.
                        </p>
                    </li>
                </ol>

                <p class="ch-kicker reveal" style="--d: 7">
                    The goal had not moved: <mark>hold participation, and keep the programme alive.</mark>
                </p>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 5: How I handled it. Four panels sharing one pinned
             viewport once the layout can carry it. Without JS, below the
             desktop breakpoint, and for reduced motion, the same four
             panels read as a plain vertical column.
             ========================================================== -->
        <section class="stack" id="handled" data-slide="4" data-tone="light" aria-label="How I handled it">
            <div class="stack-vp">
                <div class="slide-inner grid12 stack-head">
                    <p class="eyebrow">04 / How I handled it</p>
                    <ol class="stack-ticks" aria-hidden="true">
                        <li data-tick="0"></li>
                        <li data-tick="1"></li>
                        <li data-tick="2"></li>
                        <li data-tick="3"></li>
                    </ol>
                </div>

                <div class="stack-panels">

                    <article class="panel" data-panel="0">
                        <div class="slide-inner grid12">
                            <p class="panel-step"><span>01</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Find the data first</h2>
                                <p class="lead reveal" style="--d: 1">
                                    Years of the challenge had produced plenty of data, and no single place to look at it.
                                </p>
                                <p class="body reveal" style="--d: 2">
                                    It sat with Love To Ride, with contractors, with individual colleagues, and with other teams. Nobody was hiding it. It had just never been anybody&rsquo;s job to put it in one place.
                                </p>
                            </div>
                            <aside class="panel-aside reveal" style="--d: 3">
                                <h3>One spreadsheet</h3>
                                <p>
                                    I pulled the lot into a single spreadsheet. Not because a spreadsheet is elegant, but because every team could open one without being taught how.
                                </p>
                                <p>
                                    Then I wrote down how each number gets collected and by whom, so the next coordinator would inherit a process instead of a scavenger hunt.
                                </p>
                            </aside>
                        </div>
                    </article>

                    <article class="panel" data-panel="1">
                        <div class="slide-inner grid12">
                            <p class="panel-step"><span>02</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Ask it four questions</h2>
                                <p class="lead reveal" style="--d: 1">
                                    With no budget for broad advertising, every scrap of attention had to be aimed at someone specific.
                                </p>
                            </div>
                            <ol class="qa-grid">
                                <li class="reveal" style="--d: 2">
                                    <h3>Who comes back?</h3>
                                    <p>The big workplaces with a history of high sign-ups. I went to them first and got large numbers registered early.</p>
                                </li>
                                <li class="reveal" style="--d: 3">
                                    <h3>Who brings others?</h3>
                                    <p>Love To Ride tracks who recruits the most riders, and there is a prize for it. I went straight to the people who had won it before.</p>
                                </li>
                                <li class="reveal" style="--d: 4">
                                    <h3>Where are the people?</h3>
                                    <p>The busiest routes and spots in the city. Posters, stalls, and my own time in person went there, and nowhere else.</p>
                                </li>
                                <li class="reveal" style="--d: 5">
                                    <h3>What is wasted?</h3>
                                    <p>Expensive events with thin turnout. Those got cut, and the money moved to the events people actually showed up to, so they could take more riders.</p>
                                </li>
                            </ol>
                        </div>
                    </article>

                    <article class="panel" data-panel="2">
                        <div class="slide-inner grid12">
                            <p class="panel-step"><span>03</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Spend nothing,<br />borrow everything</h2>
                                <p class="lead reveal" style="--d: 1">
                                    Previous years had bus adverts, bus stop posters, and radio. I had social media and word of mouth.
                                </p>
                                <p class="body reveal" style="--d: 2">
                                    So I wrote the posts myself, and set up weekly calls with the coordinators at the other councils. Anything that worked for one of us got passed around: social copy, email sequences, cheaper ways to run an event. Tested material, free.
                                </p>
                                <p class="body reveal" style="--d: 3">
                                    And a lot of what contractors used to do, I did. Putting up the posters. Standing on the cycleway talking to riders. Helping run the bike maintenance sessions.
                                </p>
                            </div>
                            <figure class="panel-figure reveal" style="--d: 3">
                                <img
                                    src="/img/aotearoa/project-coordinator-flyer.jpg"
                                    alt="Auckland Transport flyer reading Discover Auckland all over again, free adult bike skills and guided rides"
                                    width="497"
                                    height="1024"
                                    loading="lazy"
                                />
                                <figcaption>Free skills and guided rides: the events that survived the cuts</figcaption>
                            </figure>
                        </div>
                    </article>

                    <article class="panel" data-panel="3">
                        <div class="slide-inner grid12">
                            <p class="panel-step"><span>04</span> / 04</p>
                            <div class="panel-main">
                                <h2 class="title reveal" style="--d: 0">Know when<br />to stop talking</h2>
                                <p class="lead reveal" style="--d: 1">
                                    Three days before launch, the city flooded. The instinct in a campaign is to push harder.
                                </p>
                                <p class="body reveal" style="--d: 2">
                                    It would have been the wrong call, and it would have made Auckland Transport look oblivious to people who had just lost their houses.
                                </p>
                                <p class="body reveal" style="--d: 3">
                                    I called an emergency meeting with the contractors and we reworked it. Marketing scaled right back, event conduct changed, and the tone shifted to match a city that was still cleaning up. We went quiet, then came back when it was appropriate to.
                                </p>
                            </div>
                            <aside class="panel-aside reveal" style="--d: 4">
                                <h3>The trade</h3>
                                <p>
                                    Going quiet in the launch window is the most expensive thing you can do to a month-long campaign. It cost participation.
                                </p>
                                <p>
                                    It also meant nobody had to defend a cheerful bike advert on the same page as the flood coverage, and the programme kept the goodwill it needed to run again.
                                </p>
                            </aside>
                        </div>
                    </article>

                </div>
            </div>
        </section>

        <!-- ==========================================================
             SLIDE 6: The results. Back to the cover's yellow to close.
             ========================================================== -->
        <section class="slide slide--accent" id="results" data-slide="5" data-tone="light" aria-label="The results">
            <div class="slide-inner grid12">
                <p class="eyebrow reveal" style="--d: 0">05 / The results</p>

                <div class="rs-head">
                    <h2 class="title reveal" style="--d: 1">Auckland,<br />February 2023</h2>
                </div>

                <dl class="rs-stats">
                    <div class="stat reveal" style="--d: 2">
                        <dt>Total participants</dt>
                        <dd class="num">5,365</dd>
                    </div>
                    <div class="stat reveal" style="--d: 3">
                        <dt>Riders new to the challenge</dt>
                        <dd class="num">817</dd>
                    </div>
                    <div class="stat reveal" style="--d: 4">
                        <dt>Of last year&rsquo;s participation held</dt>
                        <dd class="num">87.2%</dd>
                    </div>
                </dl>

                <figure class="rs-bars reveal" style="--d: 5">
                    <figcaption>Auckland participants, year on year</figcaption>
                    <div class="bar-row">
                        <span class="bar-year">2022</span>
                        <span class="bar-track"><span class="bar-fill" style="--w: 100%"></span></span>
                        <span class="bar-val">6,153</span>
                        <span class="bar-note">lockdown year</span>
                    </div>
                    <div class="bar-row">
                        <span class="bar-year">2023</span>
                        <span class="bar-track"><span class="bar-fill is-now" style="--w: 87.2%"></span></span>
                        <span class="bar-val">5,365</span>
                        <span class="bar-note">the year above</span>
                    </div>
                </figure>

                <div class="rs-close reveal" style="--d: 6">
                    <p class="rs-note">
                        A 13% drop, in a year with a fraction of the budget, no mass-market advertising, two weeks of the month unrideable, and a lockdown number to be measured against.
                    </p>
                    <p class="rs-kicker">The challenge was funded again the next year.</p>
                </div>
            </div>
        </section>

    </div>
</Base>

<style>
    /* =============================================================
       AOTEAROA BIKE CHALLENGE

       Six slides. Mostly monochrome on warm paper, with one accent
       (Doodle-Pop yellow, taken from this project's card colour) and one
       inverted slide. The accent is only ever used where it does work:
       wayfinding on the rail, the brief, the one line that carries the
       stakes, and the closing numbers. Everything else is type and rules.
       ============================================================= */
    .abc {
        /* Ink */
        --ink: #111111;
        --ink-2: #4F4F53;
        --ink-3: #6E6E72;
        --paper: #FAF8F5;
        --line: rgba(17, 17, 17, 0.14);
        --line-soft: rgba(17, 17, 17, 0.08);

        /* The one accent on the page */
        --accent: #FFDA00;

        /* The one dark slide */
        --night: #0C0C0D;
        --on-night: #F5F5F3;
        --on-night-2: rgba(245, 245, 243, 0.66);
        --night-line: rgba(245, 245, 243, 0.18);

        /* Rhythm. One gutter and one column gap for the whole page, so
           every slide lines up with every other slide. */
        --gut: clamp(24px, 5.4vw, 108px);
        --pad-y: clamp(70px, 8.8vh, 112px);
        /* Space the fixed slide rail sits in, so it never lands on content. */
        --rail-gap: clamp(30px, 3vw, 54px);
        --col-gap: clamp(14px, 1.7vw, 26px);
        --row-gap: clamp(24px, 4vh, 50px);

        --sans: var(--archivo-font, 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);

        background-color: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        overflow-x: clip;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    /* Snap is opt-in from the script, and only where the viewport can
       actually hold a slide. Everywhere else this is an ordinary page. */
    :global(html.abc-snap) {
        scroll-snap-type: y proximity;
    }

    :global(html.abc-snap) .slide,
    :global(html.abc-snap) .abc-cover,
    :global(html.abc-snap) .stack:not(.is-pinned) .panel {
        scroll-snap-align: start;
    }

    :global(html.abc-smooth) {
        scroll-behavior: smooth;
    }

    /* ---------- Shared slide frame ---------- */
    .slide {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: var(--pad-y) var(--gut);
        box-sizing: border-box;
    }

    .slide--paper {
        background-color: var(--paper);
        color: var(--ink);
    }

    .slide--night {
        background-color: var(--night);
        color: var(--on-night);
    }

    .slide--accent {
        background-color: var(--accent);
        color: var(--ink);
    }

    .slide-inner {
        width: 100%;
        max-width: 1480px;
        margin-inline: auto;
    }

    .grid12 {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--col-gap);
        row-gap: var(--row-gap);
        align-items: start;
    }

    /* ---------- Shared type ---------- */
    .eyebrow {
        grid-column: 1 / -1;
        font-size: clamp(0.68rem, 0.78vw, 0.78rem);
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ink-3);
        padding-bottom: 0.85em;
        border-bottom: 1px solid var(--line);
    }

    .slide--night .eyebrow {
        color: var(--on-night-2);
        border-bottom-color: var(--night-line);
    }

    .title {
        font-size: clamp(2.3rem, 1.55rem + 2.7vw, 5rem);
        font-weight: 800;
        line-height: 0.97;
        letter-spacing: -0.045em;
        margin: 0;
    }

    .lead {
        font-size: clamp(1.1rem, 0.86rem + 0.6vw, 1.5rem);
        font-weight: 450;
        line-height: 1.45;
        letter-spacing: -0.016em;
        color: var(--ink);
        max-width: 46ch;
    }

    .slide--night .lead {
        color: var(--on-night);
    }

    .body {
        font-size: clamp(1rem, 0.86rem + 0.28vw, 1.16rem);
        font-weight: 400;
        line-height: 1.62;
        letter-spacing: -0.008em;
        color: var(--ink-2);
        max-width: 54ch;
    }

    .slide--night .body {
        color: var(--on-night-2);
    }

    .label {
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ink-3);
    }

    /* ---------- Reveal. One transition, staggered by --d ---------- */
    .reveal {
        opacity: 0;
        transform: translateY(15px);
        transition:
            opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d, 0) * 45ms),
            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d, 0) * 45ms);
    }

    .is-in .reveal {
        opacity: 1;
        transform: none;
    }

    /* =============================================================
       PAGE FURNITURE: back button and slide rail
       ============================================================= */
    .abc-back {
        position: fixed;
        top: clamp(16px, 2.2vh, 28px);
        left: clamp(20px, 3.4vw, 44px);
        z-index: 60;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 15px 6px 11px;
        border: 1.5px solid var(--ink);
        border-radius: 999px;
        background-color: rgba(250, 248, 245, 0.82);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        color: var(--ink);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-decoration: none;
        transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
    }

    .abc-back:hover {
        background-color: var(--ink);
        color: var(--paper);
        transform: translateX(-2px);
    }

    .abc.is-dark-ui .abc-back {
        background-color: rgba(12, 12, 13, 0.7);
        border-color: rgba(245, 245, 243, 0.4);
        color: var(--on-night);
    }

    .abc.is-dark-ui .abc-back:hover {
        background-color: var(--on-night);
        color: var(--night);
    }

    /* Slide rail. The tick is the whole control; the number only appears
       for the slide you are on, or the one you are pointing at. */
    .abc-rail {
        position: fixed;
        top: 50%;
        right: clamp(16px, 1.9vw, 28px);
        transform: translateY(-50%);
        z-index: 60;
    }

    .abc-rail ol {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 13px;
    }

    .rail-dot {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        padding: 5px 0;
        text-decoration: none;
        cursor: pointer;
    }

    .rail-num {
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: var(--ink-3);
        opacity: 0;
        transform: translateX(5px);
        transition: opacity 0.3s ease, transform 0.3s ease, color 0.3s ease;
    }

    .rail-tick {
        display: block;
        width: 18px;
        height: 2px;
        background-color: var(--ink);
        opacity: 0.28;
        transition: width 0.34s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, background-color 0.3s ease;
    }

    .rail-dot:hover .rail-num,
    .rail-dot.is-current .rail-num {
        opacity: 1;
        transform: none;
    }

    .rail-dot:hover .rail-tick {
        opacity: 0.6;
        width: 26px;
    }

    .rail-dot.is-current .rail-tick {
        width: 34px;
        opacity: 1;
        background-color: var(--ink);
    }

    /* The accent marks where you are. It is the only job it does here. */
    .abc.is-accent-ui .rail-dot.is-current .rail-tick {
        background-color: var(--ink);
    }

    .abc.is-dark-ui .rail-num {
        color: var(--on-night-2);
    }

    .abc.is-dark-ui .rail-tick {
        background-color: var(--on-night);
    }

    .abc.is-dark-ui .rail-dot.is-current .rail-tick {
        background-color: var(--accent);
    }

    .abc.is-dark-ui .rail-dot.is-current .rail-num {
        color: var(--accent);
    }

    @media (max-width: 1100px) {
        .abc-rail { display: none; }
    }

    /* =============================================================
       SLIDE 1: COVER
       ============================================================= */
    .abc-cover {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(28px, 4.5vh, 48px) clamp(24px, 8.6vw, 130px);
        background-color: var(--accent);
        color: #000000;
        box-sizing: border-box;
        overflow: hidden;
    }

    .cover-row {
        display: flex;
        align-items: flex-end;
        justify-content: flex-start;
        gap: clamp(8px, 1.2vw, 18px);
        width: 100%;
        margin-block: auto;
        padding-block: clamp(16px, 2.5vh, 32px);
    }

    .cover-text {
        display: flex;
        flex-direction: column;
        gap: clamp(24px, 3.8vh, 44px);
        align-items: flex-start;
        flex: 0 1 auto;
        min-width: 0;
    }

    .cover-title {
        font-size: clamp(2.6rem, 8.9vw, 150px);
        font-weight: 800;
        line-height: 0.94;
        letter-spacing: -0.06em;
        color: #000000;
        margin: 0;
    }

    .title-line {
        display: block;
        white-space: nowrap;
    }

    .cover-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, auto));
        justify-content: start;
        column-gap: clamp(28px, 3.8vw, 68px);
        width: 100%;
        align-items: start;
    }

    .cover-meta-col {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cover-meta-label {
        font-size: clamp(1.35rem, 2.5vw, 36px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.15;
    }

    .cover-meta-val {
        font-size: clamp(1.05rem, 1.66vw, 24px);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.25;
    }

    .cover-arrow-col {
        display: flex;
        align-items: flex-end;
        flex: 0 0 auto;
        margin-left: clamp(-10px, -1vw, 6px);
    }

    .cover-doodle {
        display: inline-flex;
        align-items: flex-end;
        gap: clamp(10px, 1.2vw, 16px);
        user-select: none;
    }

    .doodle-arrow {
        width: clamp(88px, 8.5vw, 142px);
        height: auto;
        transform-origin: top left;
        animation:
            arrowPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.25s backwards,
            arrowBob 3.6s ease-in-out 0.8s infinite alternate;
        transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .doodle-arrow:hover {
        transform: scale(1.08) rotate(-4deg);
    }

    .doodle-pill {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: clamp(8px, 1vh, 12px) clamp(12px, 1.2vw, 18px);
        border: 2px solid #000000;
        border-radius: 10px;
        background-color: #FFFFFF;
        box-shadow: 3px 3.5px 0 #000000;
        white-space: nowrap;
        transform-origin: bottom left;
        animation:
            pillPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 0.45s backwards,
            pillWobble 4s ease-in-out 0.95s infinite alternate;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }

    .doodle-pill:hover {
        transform: scale(1.06) rotate(2deg) translateY(-2px);
        box-shadow: 4px 5px 0 #000000;
    }

    .pill-line {
        display: block;
        font-size: clamp(0.88rem, 1.05vw, 1.15rem);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.02em;
        text-align: center;
    }

    @keyframes arrowPop {
        0%   { opacity: 0; transform: scale(0.18) rotate(-22deg) translateY(-28px); }
        60%  { opacity: 1; transform: scale(1.12) rotate(4deg) translateY(4px); }
        80%  { transform: scale(0.96) rotate(-2deg) translateY(-1px); }
        100% { opacity: 1; transform: none; }
    }

    @keyframes pillPop {
        0%   { opacity: 0; transform: scale(0) translateY(14px) rotate(8deg); }
        65%  { opacity: 1; transform: scale(1.14) translateY(-3px) rotate(-2deg); }
        85%  { transform: scale(0.97) translateY(1px) rotate(1deg); }
        100% { opacity: 1; transform: none; }
    }

    @keyframes arrowBob {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50%      { transform: translateY(-5px) rotate(1.5deg); }
    }

    @keyframes pillWobble {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50%      { transform: translateY(-3px) rotate(-1.2deg); }
    }

    /* A quiet cue that the cover is the first of six, not the whole page. */
    .cover-scroll {
        position: absolute;
        left: clamp(24px, 8.6vw, 130px);
        bottom: clamp(26px, 4.6vh, 54px);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cover-scroll-line {
        position: relative;
        display: block;
        width: 46px;
        height: 2px;
        background-color: rgba(0, 0, 0, 0.22);
        overflow: hidden;
    }

    .cover-scroll-line::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 16px;
        background-color: #000000;
        animation: scrollCue 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    .cover-scroll-word {
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, 0.62);
    }

    @keyframes scrollCue {
        0%   { transform: translateX(-100%); }
        55%  { transform: translateX(188%); }
        100% { transform: translateX(188%); }
    }

    /* =============================================================
       SLIDE 2: OVERVIEW
       ============================================================= */
    .ov-head { grid-column: 1 / span 5; }
    .ov-body { grid-column: 6 / span 4; display: flex; flex-direction: column; gap: 1.1em; }
    .ov-map  { grid-column: 10 / span 3; margin: 0; justify-self: end; text-align: right; }
    .ov-facts { grid-column: 1 / span 8; }
    .ov-brief { grid-column: 9 / span 4; }

    .ov-map :global(.ov-map-svg) {
        height: clamp(180px, 27vh, 300px);
        min-height: 0;
        min-width: 0;
        color: rgba(17, 17, 17, 0.19);
        margin-inline-start: auto;
    }

    /* The map is a quiet locator, so it loses the glow and the pin takes
       the accent: the one thing on it that carries information. */
    .ov-map :global(.nz-map-svg) { filter: none; }
    .ov-map :global(.auckland-beacon circle) { stroke: var(--accent); }
    .ov-map :global(.beacon-core) { fill: var(--ink); filter: none; r: 26; }

    .ov-map figcaption {
        margin-top: 16px;
        font-size: 0.84rem;
        line-height: 1.5;
        letter-spacing: -0.01em;
        color: var(--ink-3);
    }

    .ov-map figcaption strong { color: var(--ink); font-weight: 700; }

    .ov-facts {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: var(--col-gap);
        margin: 0;
        border-top: 1px solid var(--line);
        padding-top: 18px;
    }

    .fact dt {
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-3);
        margin-bottom: 7px;
    }

    .fact dd {
        margin: 0;
        font-size: clamp(0.95rem, 0.86rem + 0.2vw, 1.1rem);
        font-weight: 550;
        line-height: 1.35;
        letter-spacing: -0.018em;
    }

    .ov-brief {
        background-color: var(--accent);
        padding: clamp(18px, 2vw, 26px) clamp(18px, 2vw, 26px) clamp(20px, 2.2vw, 28px);
        border-radius: 3px;
    }

    .brief-label {
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .brief-text {
        font-size: clamp(1.04rem, 0.9rem + 0.32vw, 1.25rem);
        font-weight: 600;
        line-height: 1.42;
        letter-spacing: -0.022em;
    }

    /* =============================================================
       SLIDE 3: THE PROGRAMME
       ============================================================= */
    .pr-head {
        grid-column: 1 / span 8;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--col-gap);
        row-gap: clamp(16px, 2.2vh, 30px);
        align-content: start;
    }

    .pr-head .title { grid-column: 1 / -1; }
    .pr-head .lead { grid-column: 1; max-width: none; }
    .pr-head .body { grid-column: 2; max-width: none; }

    .pr-poster {
        grid-column: 10 / span 3;
        margin: 0;
        align-self: start;
    }

    .pr-poster img {
        width: 100%;
        height: auto;
        border-radius: 4px;
    }

    .pr-poster figcaption {
        margin-top: 12px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--ink-3);
    }

    .pr-mine {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
        column-gap: clamp(14px, 1.6vw, 24px);
        align-items: baseline;
        border-left: 3px solid var(--accent);
        padding-left: clamp(14px, 1.4vw, 20px);
    }

    .pr-mine-label {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-3);
    }

    .pr-mine-text {
        font-size: clamp(0.98rem, 0.86rem + 0.26vw, 1.14rem);
        font-weight: 500;
        line-height: 1.5;
        letter-spacing: -0.016em;
        max-width: 74ch;
    }

    .pr-why {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        column-gap: var(--col-gap);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .pr-why li {
        border-top: 1px solid var(--line);
        padding-top: 12px;
    }

    .why-n {
        display: block;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: var(--ink-3);
        margin-bottom: 9px;
    }

    .pr-why h3 {
        font-size: clamp(1.02rem, 0.9rem + 0.26vw, 1.2rem);
        font-weight: 700;
        letter-spacing: -0.024em;
        margin: 0 0 5px;
    }

    .pr-why p {
        font-size: clamp(0.86rem, 0.78rem + 0.16vw, 0.96rem);
        line-height: 1.5;
        letter-spacing: -0.008em;
        color: var(--ink-2);
    }

    /* =============================================================
       SLIDE 4: THE CHALLENGE
       ============================================================= */
    .ch-head {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--col-gap);
        align-items: end;
    }

    .ch-head .title { grid-column: 1 / span 6; }
    .ch-head .lead  { grid-column: 8 / span 5; color: var(--on-night-2); }

    .ch-timeline {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: var(--col-gap);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .ch-timeline li {
        position: relative;
        border-top: 1px solid var(--night-line);
        padding-top: 18px;
    }

    /* The marker that walks the timeline. Accent, because it is the only
       thing telling you these four happened in an order. */
    .ch-timeline li::before {
        content: "";
        position: absolute;
        top: -3px;
        left: 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--accent);
    }

    .ch-n {
        display: block;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: var(--on-night-2);
        margin-bottom: 14px;
    }

    .ch-date {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 6px;
    }

    .ch-title {
        font-size: clamp(1.2rem, 1rem + 0.44vw, 1.7rem);
        font-weight: 700;
        letter-spacing: -0.032em;
        line-height: 1.1;
        margin: 0 0 10px;
    }

    .ch-text {
        font-size: clamp(0.9rem, 0.82rem + 0.18vw, 1.02rem);
        line-height: 1.6;
        letter-spacing: -0.006em;
        color: var(--on-night-2);
    }

    .ch-kicker {
        grid-column: 1 / -1;
        border-top: 1px solid var(--night-line);
        padding-top: clamp(20px, 2.6vh, 30px);
        font-size: clamp(1.1rem, 0.88rem + 0.55vw, 1.7rem);
        font-weight: 600;
        letter-spacing: -0.028em;
        color: var(--on-night-2);
    }

    .ch-kicker mark {
        background: none;
        color: var(--accent);
        font-weight: 700;
    }

    /* =============================================================
       SLIDE 5: HOW I HANDLED IT
       Four panels. Plain vertical column by default; the script adds
       .is-pinned when the viewport can hold one panel at a time.
       ============================================================= */
    .stack {
        position: relative;
        background-color: var(--paper);
    }

    .stack-head {
        padding: var(--pad-y) var(--gut) 0;
        max-width: none;
    }

    .stack-head .eyebrow {
        grid-column: 1 / span 8;
        margin-bottom: 0;
        border-bottom: none;
        padding-bottom: 0;
    }

    .stack-ticks {
        grid-column: 10 / -1;
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .stack-ticks li {
        width: 26px;
        height: 2px;
        background-color: var(--line);
        transition: background-color 0.35s ease;
    }

    .stack-ticks li.is-on { background-color: var(--ink); }

    /* The ticks track the pinned sequence. Read as a plain column, there is
       no sequence for them to track, so they go. */
    .stack:not(.is-pinned) .stack-ticks { display: none; }

    .panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100vh;
        min-height: 100dvh;
        padding: var(--pad-y) var(--gut);
        box-sizing: border-box;
    }

    .panel-step {
        grid-column: 1 / -1;
        font-size: clamp(0.68rem, 0.78vw, 0.78rem);
        font-weight: 800;
        letter-spacing: 0.2em;
        color: var(--ink-3);
        padding-bottom: 0.85em;
        border-bottom: 1px solid var(--line);
    }

    .panel-step span { color: var(--ink); }

    .panel-main {
        grid-column: 1 / span 7;
        display: flex;
        flex-direction: column;
        gap: clamp(14px, 1.7vh, 22px);
    }

    .panel-aside {
        grid-column: 9 / span 4;
        border-top: 2px solid var(--ink);
        padding-top: 16px;
        display: flex;
        flex-direction: column;
        gap: 0.95em;
    }

    .panel-aside h3 {
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin: 0;
    }

    .panel-aside p {
        font-size: clamp(0.96rem, 0.86rem + 0.22vw, 1.1rem);
        line-height: 1.6;
        letter-spacing: -0.008em;
        color: var(--ink-2);
    }

    .panel-figure {
        grid-column: 9 / span 4;
        margin: 0;
        justify-self: end;
    }

    .panel-figure img {
        width: 100%;
        height: auto;
        max-height: 54vh;
        width: auto;
        border-radius: 3px;
        margin-inline-start: auto;
    }

    .panel-figure figcaption {
        margin-top: 12px;
        font-size: 0.72rem;
        line-height: 1.45;
        color: var(--ink-3);
        text-align: right;
        max-width: 30ch;
        margin-inline-start: auto;
    }

    .qa-grid {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: var(--col-gap);
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: qa;
    }

    .qa-grid li {
        border-top: 1px solid var(--line);
        padding-top: 15px;
    }

    .qa-grid h3 {
        font-size: clamp(1.1rem, 0.94rem + 0.42vw, 1.5rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin: 0 0 9px;
    }

    /* The question mark is the pop: it marks the four things the data
       was actually asked, which is the point of the panel. */
    .qa-grid h3::after {
        content: "";
        display: block;
        width: 20px;
        height: 3px;
        margin-top: 9px;
        background-color: var(--accent);
    }

    .qa-grid p {
        font-size: clamp(0.88rem, 0.8rem + 0.18vw, 1.0rem);
        line-height: 1.58;
        letter-spacing: -0.006em;
        color: var(--ink-2);
    }

    /* Pinned mode. Panels share one sticky viewport and are cross-faded
       by scroll position. */
    .stack.is-pinned .stack-vp {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
    }

    .stack.is-pinned .stack-head {
        position: absolute;
        top: var(--pad-y);
        padding-top: 0;
        left: 0;
        right: 0;
        z-index: 3;
        pointer-events: none;
    }

    .stack.is-pinned .stack-panels {
        position: absolute;
        inset: 0;
    }

    .stack.is-pinned .panel {
        position: absolute;
        inset: 0;
        min-height: 0;
        opacity: 0;
        will-change: opacity, transform;
    }

    .stack.is-pinned .panel-step {
        grid-column: 1 / -1;
        border-bottom: none;
        padding-bottom: 0;
        font-size: clamp(2.2rem, 1.3rem + 2.8vw, 4.6rem);
        font-weight: 800;
        letter-spacing: -0.05em;
        line-height: 1;
        color: rgba(17, 17, 17, 0.14);
    }

    .stack.is-pinned .panel-step span { color: rgba(17, 17, 17, 0.34); }

    .stack.is-pinned .panel .title {
        font-size: clamp(2.4rem, 1.6rem + 2.8vw, 5.2rem);
    }

    /* Extra head room so a tall panel can never ride up under the pinned
       section header. */
    .stack.is-pinned .panel {
        padding-top: calc(var(--pad-y) + 3rem);
    }

    .stack.is-pinned .panel .lead {
        font-size: clamp(1.16rem, 0.9rem + 0.68vw, 1.7rem);
        max-width: 40ch;
    }

    /* =============================================================
       SLIDE 6: THE RESULTS
       ============================================================= */
    .slide--accent .eyebrow {
        color: rgba(17, 17, 17, 0.62);
        border-bottom-color: rgba(17, 17, 17, 0.22);
    }

    .rs-head { grid-column: 1 / span 4; }

    .rs-stats {
        grid-column: 6 / span 7;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        column-gap: var(--col-gap);
        margin: 0;
        align-self: end;
    }

    .stat {
        border-top: 2px solid var(--ink);
        padding-top: 13px;
    }

    .stat dt {
        font-size: clamp(0.74rem, 0.68rem + 0.12vw, 0.86rem);
        font-weight: 700;
        letter-spacing: 0.02em;
        line-height: 1.35;
        color: rgba(17, 17, 17, 0.7);
        min-height: 2.7em;
    }

    .stat .num {
        margin: 4px 0 0;
        font-size: clamp(2.2rem, 1.4rem + 2.5vw, 4.4rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.05em;
        font-variant-numeric: tabular-nums;
    }

    .rs-bars {
        grid-column: 1 / span 7;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .rs-bars figcaption {
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(17, 17, 17, 0.62);
        padding-bottom: 6px;
    }

    .bar-row {
        display: grid;
        grid-template-columns: 3.4rem minmax(0, 1fr) 4.4rem 8rem;
        align-items: center;
        gap: 14px;
    }

    .bar-year {
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .bar-track {
        display: block;
        height: 18px;
        background-color: rgba(17, 17, 17, 0.1);
    }

    /* Last year is drawn as an outline and this year as solid ink: the
       reference against the actual, without inventing a second colour. */
    .bar-fill {
        display: block;
        box-sizing: border-box;
        height: 100%;
        width: 0;
        border: 1.5px solid rgba(17, 17, 17, 0.55);
        transition: width 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.25s;
    }

    .bar-fill.is-now {
        border: none;
        background-color: var(--ink);
    }

    .is-in .bar-fill { width: var(--w); }

    .bar-val {
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
    }

    .bar-note {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        color: rgba(17, 17, 17, 0.58);
    }

    .rs-close {
        grid-column: 9 / span 4;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .rs-note {
        font-size: clamp(0.96rem, 0.86rem + 0.22vw, 1.1rem);
        line-height: 1.6;
        letter-spacing: -0.008em;
        color: rgba(17, 17, 17, 0.78);
    }

    /* The last line of the case study, and the only inverted block on a
       yellow slide. It is the actual result. */
    .rs-kicker {
        background-color: var(--ink);
        color: var(--accent);
        padding: clamp(16px, 1.8vw, 24px);
        border-radius: 3px;
        font-size: clamp(1.08rem, 0.9rem + 0.45vw, 1.5rem);
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: -0.03em;
    }

    /* The fixed rail gets its own lane on the right, so nothing on any
       slide ever runs underneath it. Declared here so it outranks the
       per-slide padding above. */
    @media (min-width: 1101px) {
        .abc .slide,
        .abc .panel,
        .abc .stack-head {
            padding-right: calc(var(--gut) + var(--rail-gap));
        }
    }

    /* =============================================================
       RESPONSIVE
       Below the desktop breakpoint every slide collapses to a single
       readable column and stops pretending to be one screen tall.
       ============================================================= */
    @media (max-width: 1100px) {
        .ov-head { grid-column: 1 / span 6; }
        .ov-body { grid-column: 7 / span 6; }
        .ov-map  { grid-column: 1 / span 4; justify-self: start; text-align: left; }
        .ov-map :global(.ov-map-svg) { margin-inline-start: 0; }
        .ov-facts { grid-column: 5 / span 8; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 20px; }
        .ov-brief { grid-column: 1 / -1; }

        .pr-head { grid-column: 1 / span 7; }
        .pr-poster { grid-column: 8 / span 5; }
        .pr-why { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 22px; }

        .ch-head .title { grid-column: 1 / span 7; }
        .ch-head .lead  { grid-column: 1 / span 7; }
        .ch-timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 28px; }

        .panel-main { grid-column: 1 / span 7; }
        .panel-aside { grid-column: 8 / span 5; }
        .panel-figure { grid-column: 8 / span 5; }
        .qa-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 24px; }

        .rs-head { grid-column: 1 / span 5; }
        .rs-stats { grid-column: 6 / span 7; }
        .rs-bars { grid-column: 1 / span 12; }
        .rs-close { grid-column: 1 / span 12; }
        .bar-row { grid-template-columns: 3rem minmax(0, 1fr) 4rem 7rem; }
    }

    @media (max-width: 820px) {
        .abc { --pad-y: clamp(72px, 9vh, 96px); }

        .slide, .panel {
            min-height: 0;
            justify-content: flex-start;
        }

        .grid12 { grid-template-columns: minmax(0, 1fr); }

        .ov-head, .ov-body, .ov-map, .ov-facts, .ov-brief,
        .pr-head, .pr-poster, .pr-why,
        .ch-head, .ch-timeline, .ch-kicker,
        .panel-step, .panel-main, .panel-aside, .panel-figure, .qa-grid,
        .rs-head, .rs-stats, .rs-bars, .rs-close {
            grid-column: 1 / -1;
        }

        .ov-map { justify-self: start; text-align: left; }
        .ov-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 20px; }
        .pr-poster { max-width: 400px; }
        .pr-why { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 22px; }

        /* align-items: end is a grid instruction on desktop; in a column
           flexbox it would shove the copy to the right edge. */
        .ch-head { display: flex; flex-direction: column; align-items: stretch; gap: 16px; }

        .pr-mine { grid-template-columns: minmax(0, 1fr); row-gap: 8px; }
        .pr-head { grid-template-columns: minmax(0, 1fr); }

        /* Section label and progress ticks stay on one line on a phone. */
        .stack-head { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
        .stack-head .eyebrow { grid-column: 1; }
        .stack-ticks { grid-column: 2; }
        .ch-timeline { grid-template-columns: minmax(0, 1fr); row-gap: 26px; }

        .qa-grid { grid-template-columns: minmax(0, 1fr); row-gap: 22px; }
        .panel-figure { justify-self: start; }
        .panel-figure img { max-height: none; max-width: 320px; margin-inline-start: 0; }
        .panel-figure figcaption { text-align: left; margin-inline-start: 0; }

        .rs-stats { grid-template-columns: minmax(0, 1fr); row-gap: 22px; }
        .stat dt { min-height: 0; }
        .bar-row { grid-template-columns: 2.8rem minmax(0, 1fr) 4rem; row-gap: 4px; }
        .bar-note { grid-column: 2 / -1; }

        .cover-row { flex-direction: column; align-items: flex-start; gap: 28px; }
        .cover-arrow-col { margin-left: 0; }
        .title-line { white-space: normal; }

        /* Three metadata columns will not fit a phone, so they pair up. */
        .cover-meta {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: 20px;
            row-gap: 22px;
        }
    }

    /* =============================================================
       REDUCED MOTION
       ============================================================= */
    @media (prefers-reduced-motion: reduce) {
        .reveal {
            opacity: 1 !important;
            transform: none !important;
            transition: none;
        }

        .bar-fill { width: var(--w); transition: none; }

        .doodle-arrow,
        .doodle-pill,
        .cover-scroll-line::after {
            animation: none;
        }

        :global(html.abc-smooth) { scroll-behavior: auto; }
    }
</style>

<script>
    /**
     * Aotearoa Bike Challenge case study.
     *
     * Everything registered here is torn down before Astro swaps the document,
     * so client-side navigation does not stack listeners up over a session.
     */
    let teardown: Array<() => void> = [];

    function onWindow(type: string, handler: EventListener) {
        window.addEventListener(type, handler, { passive: true });
        teardown.push(() => window.removeEventListener(type, handler));
    }

    const reducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);

    /** Smoothstep, so fades ease in and out instead of running linearly. */
    const ease = (t: number) => t * t * (3 - 2 * t);

    /** One rAF-throttled scroll loop for the page: subscribers run at most
     *  once a frame, which keeps layout reads off the scroll event itself. */
    function createScrollLoop() {
        const subscribers: Array<() => void> = [];
        let ticking = false;

        function run() {
            ticking = false;
            for (const fn of subscribers) fn();
        }

        function request() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(run);
        }

        onWindow("scroll", request);
        onWindow("resize", request);

        return {
            subscribe: (fn: () => void) => subscribers.push(fn),
            run,
        };
    }

    /** Slides and stack panels fade their contents in the first time they
     *  are reached. Once shown, they stay shown. */
    function initReveals() {
        const targets = document.querySelectorAll<HTMLElement>(
            ".abc-cover, .slide, .stack:not(.is-pinned) .panel"
        );
        if (!targets.length) return;

        if (reducedMotion() || typeof IntersectionObserver === "undefined") {
            targets.forEach((el) => el.classList.add("is-in"));
            return;
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("is-in");
                    observer.unobserve(entry.target);
                }
            },
            { rootMargin: "0px 0px -22% 0px", threshold: 0 }
        );

        targets.forEach((el) => observer.observe(el));
        teardown.push(() => observer.disconnect());
    }

    /**
     * Slide 5. Four panels share one sticky viewport and cross-fade on scroll
     * position. Only runs where the viewport can actually hold a whole panel;
     * everywhere else the panels stay a plain vertical column.
     */
    function initStack() {
        const stack = document.querySelector<HTMLElement>(".stack");
        if (!stack) return null;

        const panels = Array.from(stack.querySelectorAll<HTMLElement>(".panel"));
        const ticks = Array.from(stack.querySelectorAll<HTMLElement>(".stack-ticks li"));
        if (!panels.length) return null;

        const wideEnough = () =>
            !reducedMotion() &&
            window.matchMedia("(min-width: 1101px) and (min-height: 700px)").matches;

        // A pinned panel is clipped by the sticky viewport, so pinning is only
        // safe while every panel actually fits one. Measured rather than
        // assumed, because the copy and the fonts decide the answer, not the
        // breakpoint. Only re-measured when the viewport changes size.
        let lastW = -1;
        let lastH = -1;
        let fits = false;

        function refit() {
            if (window.innerWidth === lastW && window.innerHeight === lastH) return;
            lastW = window.innerWidth;
            lastH = window.innerHeight;

            if (!wideEnough()) {
                fits = false;
                return;
            }

            const wasPinned = stack.classList.contains("is-pinned");
            if (!wasPinned) stack.classList.add("is-pinned");

            fits = panels.every((el) => {
                const inner = el.firstElementChild as HTMLElement | null;
                if (!inner) return false;
                const cs = getComputedStyle(el);
                const box =
                    inner.scrollHeight +
                    parseFloat(cs.paddingTop) +
                    parseFloat(cs.paddingBottom);
                return box <= window.innerHeight;
            });

            if (!wasPinned) stack.classList.remove("is-pinned");
        }

        /** Scroll distance each panel is held for, as a share of a viewport. */
        const HOLD = 0.9;

        let pinned = false;

        function enable() {
            if (pinned) return;
            pinned = true;
            stack.classList.add("is-pinned");
            stack.style.height = `calc(100dvh + ${panels.length * HOLD * 100}dvh)`;
        }

        function disable() {
            if (!pinned) return;
            pinned = false;
            stack.classList.remove("is-pinned");
            stack.style.height = "";
            panels.forEach((p) => {
                p.style.opacity = "";
                p.style.transform = "";
                p.style.visibility = "";
                p.classList.add("is-in");
                p.removeAttribute("aria-hidden");
            });
            ticks.forEach((t) => t.classList.remove("is-on"));
        }

        function update() {
            refit();

            if (fits) enable();
            else {
                disable();
                return;
            }

            const vh = window.innerHeight;
            const travel = stack.offsetHeight - vh;
            if (travel <= 0) return;

            const p = clamp01(-stack.getBoundingClientRect().top / travel);
            const n = panels.length;
            // Offset by the half-width of the cross-fade, so the ticks flip
            // when the next panel takes over visually rather than a moment late.
            const active = Math.min(n - 1, Math.max(0, Math.floor(p * n + 0.1)));

            for (let i = 0; i < n; i++) {
                // Where this panel sits in its own segment: 0 at the start of
                // its hold, 1 at the end.
                const d = p * n - i;

                let opacity = 0;
                let y = 0;

                // The last panel never exits: it has to still be on screen
                // when the results slide scrolls up over the pin.
                const holds = i === n - 1;

                if (d > -0.2 && (holds || d < 1)) {
                    if (d < 0) {
                        const t = ease((d + 0.2) / 0.2);
                        opacity = t;
                        y = 26 * (1 - t);
                    } else if (d <= 0.82 || holds) {
                        opacity = 1;
                    } else {
                        const t = ease((d - 0.82) / 0.18);
                        opacity = 1 - t;
                        y = -26 * t;
                    }
                }

                const el = panels[i];
                const visible = opacity > 0.01;
                el.style.opacity = opacity.toFixed(3);
                el.style.transform = y === 0 ? "translate3d(0,0,0)" : `translate3d(0, ${y.toFixed(1)}px, 0)`;
                el.style.visibility = visible ? "visible" : "hidden";
                if (visible) el.removeAttribute("aria-hidden");
                else el.setAttribute("aria-hidden", "true");
            }

            // Children of a panel stagger in the first time it is reached.
            panels[active].classList.add("is-in");

            for (let i = 0; i < ticks.length; i++) {
                ticks[i].classList.toggle("is-on", i <= active);
            }
        }

        return update;
    }

    /** Rail marks the slide you are on, and the furniture flips to
     *  light-on-dark while the one dark slide owns the viewport. */
    function initChrome() {
        const page = document.querySelector<HTMLElement>(".abc");
        const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-slide]"));
        const dots = Array.from(document.querySelectorAll<HTMLElement>(".rail-dot"));
        if (!page || !sections.length) return () => {};

        let lastIndex = -1;
        let lastDark: boolean | null = null;

        return function update() {
            const vh = window.innerHeight;
            const mark = vh * 0.42;

            let index = 0;
            let dark = false;

            for (const section of sections) {
                const rect = section.getBoundingClientRect();
                if (rect.top <= mark) index = Number(section.dataset.slide);
                if (
                    section.dataset.tone === "dark" &&
                    rect.top <= mark &&
                    rect.bottom > mark
                ) {
                    dark = true;
                }
            }

            if (index !== lastIndex) {
                lastIndex = index;
                dots.forEach((dot, i) => dot.classList.toggle("is-current", i === index));
            }

            if (dark !== lastDark) {
                lastDark = dark;
                page.classList.toggle("is-dark-ui", dark);
            }
        };
    }

    /** Snap is a nicety, not the layout. It is only switched on where a
     *  slide fits the viewport, and never under reduced motion. */
    function initSnap() {
        const root = document.documentElement;
        const query = window.matchMedia("(min-width: 1101px) and (min-height: 640px)");

        function apply() {
            const on = query.matches && !reducedMotion();
            root.classList.toggle("abc-snap", on);
            root.classList.toggle("abc-smooth", on);
        }

        apply();
        query.addEventListener("change", apply);
        teardown.push(() => {
            query.removeEventListener("change", apply);
            root.classList.remove("abc-snap", "abc-smooth");
        });
    }

    function initAll() {
        teardown.forEach((fn) => fn());
        teardown = [];

        if (!document.querySelector(".abc")) return;

        initSnap();

        const loop = createScrollLoop();
        const stack = initStack();

        // Settle the stack first: initReveals needs to know whether the panels
        // are pinned before it decides to observe them.
        if (stack) stack();

        initReveals();

        if (stack) loop.subscribe(stack);
        loop.subscribe(initChrome());
        loop.run();
    }

    document.addEventListener("astro:page-load", initAll);
    document.addEventListener("astro:before-swap", () => {
        teardown.forEach((fn) => fn());
        teardown = [];
    });
</script>
