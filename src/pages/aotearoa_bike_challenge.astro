    /* =============================================================
       WHAT I DID: NUMBERED SLIDE DECK

       Two layouts from one markup. The base rules below are the plain
       vertical read: six chapters stacked down the yellow ground, each
       revealing on scroll. Script adds .is-deck on wide viewports, and
       that turns the same list into a pinned horizontal deck — every
       chapter slides in from the right over the last, which parks and
       keeps only its numbered spine visible at the left edge.
       ============================================================= */
    .abc-did-section {
        --did-pad-x: clamp(24px, 5vw, 80px);
        --did-spine-w: clamp(46px, 4.4vw, 64px);

        position: relative;
        z-index: 14;
        width: 100vw;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        background-color: var(--doodle-yellow, #FFDA00);
        color: #000000;
        box-sizing: border-box;
        padding: clamp(96px, 14vh, 168px) var(--did-pad-x) clamp(96px, 16vh, 190px);
        /* Label sits in its own gutter so the copy can never run underneath it. */
        display: grid;
        grid-template-columns: clamp(110px, 12vw, 180px) minmax(0, 1fr);
        align-items: start;
    }

    /* Rides along in the gutter, below the fixed deck button. */
    .did-section-label {
        grid-column: 1;
        position: sticky;
        top: clamp(72px, 9.5vh, 104px);
        z-index: 3;
        margin: 0;
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(1.15rem, 1.75vw, 1.7rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        color: #FFFFFF;
        padding-right: clamp(16px, 2vw, 32px);
        pointer-events: none;
    }

    .did-runway {
        grid-column: 2;
        position: relative;
        max-width: 1240px;
    }

    .did-deck {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: clamp(80px, 13vh, 168px);
    }

    .did-slide {
        position: relative;
    }

    /* The spine is the deck's chapter index; it has nothing to say in the
       vertical read, where the folio above each title already numbers it. */
    .did-spine {
        display: none;
    }

    /* Wide left column for the argument, narrower right column for the asides. */
    .did-slide-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        column-gap: clamp(40px, 7vw, 132px);
        align-items: start;
    }

    .did-slide.is-single .did-slide-inner {
        grid-template-columns: minmax(0, 1fr);
    }

    /* Reveal belongs to the vertical read only. In deck mode the script owns
       the slide's transform, so the two must never both write to it. */
    .abc-did-section:not(.is-deck) .did-slide-inner {
        opacity: 0;
        transform: translateY(26px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .abc-did-section:not(.is-deck) .did-slide.is-revealed .did-slide-inner {
        opacity: 1;
        transform: translateY(0);
    }

    .did-main {
        max-width: 62ch;
    }

    .did-aside {
        display: flex;
        flex-direction: column;
        gap: clamp(26px, 4vh, 44px);
        max-width: 46ch;
    }

    /* Folio above the title: small, quiet, and tabular so the numbers line up
       chapter to chapter. */
    .did-step {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(0.72rem, 0.85vw, 0.84rem);
        font-weight: 800;
        letter-spacing: 0.16em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        color: #000000;
        margin: 0 0 clamp(14px, 2vh, 22px);
    }

    .did-step-of {
        font-weight: 600;
        opacity: 0.45;
    }

    .did-title {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(1.85rem, 3.3vw, 3.1rem);
        font-weight: 800;
        line-height: 1.03;
        letter-spacing: -0.035em;
        color: #000000;
        margin: 0 0 clamp(18px, 2.6vh, 30px);
        text-wrap: balance;
    }

    .did-note-title {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(1.05rem, 1.5vw, 1.4rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.025em;
        color: #000000;
        margin: 0 0 clamp(8px, 1.2vh, 12px);
    }

    .did-body {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(0.92rem, 1.05vw, 1.05rem);
        font-weight: 400;
        line-height: 1.58;
        letter-spacing: -0.005em;
        color: #000000;
        margin: 0 0 clamp(12px, 1.8vh, 18px);
        text-wrap: pretty;
    }

    .did-body:last-child {
        margin-bottom: 0;
    }

    .did-body strong {
        font-weight: 700;
    }

    .did-note + .did-note {
        margin-top: clamp(22px, 3.4vh, 38px);
    }

    /* Numbers hang in the margin so the text edge stays flush with the heading. */
    .did-list {
        list-style: none;
        counter-reset: did-item;
        margin: 0 0 clamp(18px, 2.6vh, 28px);
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: clamp(5px, 0.8vh, 9px);
    }

    .did-list:last-child {
        margin-bottom: 0;
    }

    .did-list li {
        counter-increment: did-item;
        position: relative;
        padding-left: 2.1em;
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(0.92rem, 1.05vw, 1.05rem);
        font-weight: 400;
        line-height: 1.5;
        letter-spacing: -0.005em;
        color: #000000;
        text-wrap: pretty;
    }

    .did-list li::before {
        content: counter(did-item) ".";
        position: absolute;
        left: 0;
        top: 0;
        width: 1.6em;
        text-align: right;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .did-pull {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(1.15rem, 1.75vw, 1.6rem);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: #000000;
        margin: 0;
        text-wrap: pretty;
    }

    /* -------------------------------------------------------------
       DECK MODE
       ------------------------------------------------------------- */

    /* The runway is the scroll budget: one viewport per chapter, plus half a
       one so the last chapter holds still before the page runs out. */
    .is-deck .did-runway {
        height: calc((var(--did-count, 6) + 0.5) * 100vh);
        height: calc((var(--did-count, 6) + 0.5) * 100dvh);
        max-width: none;
    }

    .is-deck .did-viewport {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
        /* Bleed back out to the section gutter so chapters enter and leave at
           the true screen edge rather than at the text margin. */
        margin-right: calc(-1 * var(--did-pad-x));
    }

    .is-deck .did-deck {
        display: block;
        height: 100%;
        gap: 0;
    }

    .is-deck .did-slide {
        position: absolute;
        inset: 0;
        z-index: var(--i);
        display: flex;
        align-items: center;
        box-sizing: border-box;
        /* Opaque, so a chapter arriving from the right wipes the one behind it.
           The rule is the only seam you actually see: same ground, new column. */
        background-color: var(--doodle-yellow, #FFDA00);
        border-left: 2px solid #000000;
        padding-left: var(--did-spine-w);
        /* Everything to the right of the screen edge is off-stage, so the copy
           column is inset by however many spines are parked to the left. */
        padding-right: calc(var(--did-pad-x) + var(--i) * var(--did-spine-w));
        /* Off to the right until the first frame of the scroll loop lands. */
        transform: translate3d(100%, 0, 0);
        will-change: transform;
    }

    .is-deck .did-slide-inner {
        width: 100%;
        max-height: 100%;
    }

    .is-deck .did-spine {
        display: block;
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: var(--did-spine-w);
        padding-top: clamp(88px, 12vh, 136px);
        text-align: center;
        box-sizing: border-box;
    }

    .did-spine-num {
        font-family: var(--archivo-font, 'Archivo', sans-serif);
        font-size: clamp(0.7rem, 0.8vw, 0.84rem);
        font-weight: 800;
        letter-spacing: 0.1em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        color: #000000;
        /* Parked chapters read as a passed index; the live one is full black. */
        opacity: 0.34;
        transition: opacity 0.45s ease;
    }

    .did-slide.is-current .did-spine-num {
        opacity: 1;
    }

    /* The folio would only repeat the spine sitting an inch to its left. */
    .is-deck .did-step {
        display: none;
    }

    /* A chapter has one screen, so the display sizes come down a step and the
       longest list runs in two columns rather than off the bottom edge. */
    .is-deck .did-title {
        font-size: clamp(1.7rem, 2.9vw, 2.7rem);
    }

    .is-deck .did-pull {
        font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    }

    .is-deck .did-list.is-two-col {
        display: block;
        columns: 2;
        column-gap: clamp(28px, 3.4vw, 56px);
    }

    .is-deck .did-list.is-two-col li {
        break-inside: avoid;
        margin-bottom: clamp(5px, 0.8vh, 9px);
    }

    @media (prefers-reduced-motion: reduce) {
        .did-slide-inner {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

