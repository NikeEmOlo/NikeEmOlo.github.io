</style>

<script>
    // Everything registered during a page init, torn down before Astro swaps the
    // document. Without this the window scroll listeners stack up on every
    // client-side navigation and the page gets progressively jankier.
    let teardown: Array<() => void> = [];

    function onWindow(type: string, handler: EventListener) {
        window.addEventListener(type, handler, { passive: true });
        teardown.push(() => window.removeEventListener(type, handler));
    }

    const prefersReducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /**
     * One rAF-throttled scroll loop for the whole page. Each subscriber runs at
     * most once per frame, so layout reads stay off the scroll event itself.
     */
    function createScrollLoop() {
        const subscribers: Array<() => void> = [];
        let ticking = false;

        function run() {
            ticking = false;
            for (const fn of subscribers) fn();
        }

        function request() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(run);
        }

        onWindow("scroll", request);
        onWindow("resize", request);

        return {
            subscribe(fn: () => void) {
                subscribers.push(fn);
            },
            run,
            request
        };
    }

    /**
     * Shared reveal for every full-height section. Fires when a section's top
     * edge passes the middle of the viewport, which is the same trigger point
     * the WHY section used to compute by hand.
     */
    function initSectionReveals() {
        const sections = document.querySelectorAll<HTMLElement>(".abc-editorial-slide");
        if (!sections.length) return;

        if (prefersReducedMotion() || typeof IntersectionObserver === "undefined") {
            sections.forEach((el) => el.classList.add("is-revealed"));
            return;
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("is-revealed");
                    observer.unobserve(entry.target);
                }
            },
            { rootMargin: "0px 0px -50% 0px", threshold: 0 }
        );

        sections.forEach((el) => observer.observe(el));
        teardown.push(() => observer.disconnect());
    }

    /**
     * Reveal for the individual chapters of "What I did" while they are a
     * vertical read. Uses a gentler trigger than the full-height sections,
     * since these are shorter than a viewport and would otherwise never cross
     * the halfway line. In deck mode the CSS ignores the class it sets.
     */
    function initBlockReveals() {
        const blocks = document.querySelectorAll<HTMLElement>(".did-slide");
        if (!blocks.length) return;

        if (prefersReducedMotion() || typeof IntersectionObserver === "undefined") {
            blocks.forEach((el) => el.classList.add("is-revealed"));
            return;
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.classList.add("is-revealed");
                    observer.unobserve(entry.target);
                }
            },
            { rootMargin: "0px 0px -12% 0px", threshold: 0 }
        );

        blocks.forEach((el) => observer.observe(el));
        teardown.push(() => observer.disconnect());
    }

    function initMouseScrollSignal() {
        const btn = document.getElementById("fixed-scroll-signal");
        if (!btn) return;

        const handler = () => {
            const vh = window.innerHeight;

            // Pinned stages are checked first. If we are already inside one, the
            // next stop is its next phase, not whatever section comes after it.
            const didRunway = document.getElementById("did-runway");
            const didIsDeck = document
                .getElementById("what-i-did")
                ?.classList.contains("is-deck");

            const pinned: Array<{ el: HTMLElement | null; steps: number }> = [
                { el: document.getElementById("reveal-stage"), steps: 4 },
                { el: document.getElementById("results-stage"), steps: 4 },
                // Only while the chapters are pinned; in the vertical read the
                // runway is just ordinary page height with no phases in it.
                {
                    el: didIsDeck ? didRunway : null,
                    steps: didRunway?.querySelectorAll(".did-slide").length ?? 0
                }
            ];

            for (const { el, steps } of pinned) {
                if (!el) continue;
                // Not offsetTop: the deck's runway sits inside a positioned
                // section, so its offsetParent is not the document.
                const top = el.getBoundingClientRect().top + window.scrollY;
                const phase = Math.floor((window.scrollY - top) / vh);
                if (phase >= 0 && phase < steps - 1) {
                    window.scrollTo({ top: top + (phase + 1) * vh, behavior: "smooth" });
                    return;
                }
            }

            const sections = [
                "cover-landing",
                "intro-slide-1",
                "intro-slide-2",
                "why-section",
                "beat1-section",
                "reveal-stage",
                "results-stage"
            ]
                .map((id) => document.getElementById(id))
                .filter((s): s is HTMLElement => Boolean(s));

            for (const section of sections) {
                if (section.getBoundingClientRect().top > 40) {
                    section.scrollIntoView({ behavior: "smooth" });
                    return;
                }
            }

            window.scrollBy({ top: vh * 0.85, behavior: "smooth" });
        };

        btn.addEventListener("click", handler);
        teardown.push(() => btn.removeEventListener("click", handler));
    }

    function initBeat1Typewriter() {
        const textContainer = document.getElementById("typewriter-text");
        const outputElem = textContainer?.querySelector(".type-text") as HTMLElement | null;
        const restElem = textContainer?.querySelector(".type-rest") as HTMLElement | null;
        if (!textContainer || !outputElem || !restElem) {
            return { start: () => {}, complete: () => {} };
        }

        const part1 = "Coordinating a city-wide cycling campaign. ";
        const fullText = part1 + "Simple enough...";

        // Remainder carries the untyped tail so the box never changes shape.
        restElem.textContent = fullText;
        outputElem.textContent = "";

        let isCompleted = false;
        let hasStarted = false;
        let typeTimer: ReturnType<typeof setTimeout> | null = null;

        function complete() {
            if (isCompleted) return;
            isCompleted = true;
            if (typeTimer) clearTimeout(typeTimer);
            outputElem!.textContent = fullText;
            restElem!.textContent = "";
            textContainer!.classList.add("is-typed");
        }

        function start() {
            if (hasStarted || isCompleted) return;
            hasStarted = true;

            if (prefersReducedMotion()) {
                complete();
                return;
            }

            let charIndex = 0;
            (function typeNextChar() {
                if (isCompleted) return;
                if (charIndex >= fullText.length) {
                    restElem!.textContent = "";
                    textContainer!.classList.add("is-typed");
                    return;
                }
                outputElem!.textContent = fullText.slice(0, charIndex + 1);
                restElem!.textContent = fullText.slice(charIndex + 1);
                charIndex++;
                const delay = charIndex === part1.length ? 440 : 30 + Math.random() * 22;
                typeTimer = setTimeout(typeNextChar, delay);
            })();
        }

        teardown.push(() => {
            if (typeTimer) clearTimeout(typeTimer);
        });

        return { start, complete };
    }

    /**
     * Recolours the fixed deck button and scroll signal to suit whatever is
     * actually behind them. Panels are listed in paint order, so the last one
     * covering the control wins; that matters because light and dark panels
     * slide over each other during the transitions.
     */
    function createThemeSync() {
        const controls: Array<{ el: HTMLElement; cls: string }> = [];
        const deckBtn = document.getElementById("case-study-deck-btn");
        const scrollBtn = document.getElementById("fixed-scroll-signal");
        if (deckBtn) controls.push({ el: deckBtn, cls: "is-dark-nav" });
        if (scrollBtn) controls.push({ el: scrollBtn, cls: "is-dark-mouse" });
        if (!controls.length) return () => {};

        const panels = (
            [
                ["intro-slide-2", false],
                ["why-section", true],
                ["beat1-section", false],
                ["cinematic-stage", true],
                ["results-panel", false],
                ["what-i-did", false]
            ] as Array<[string, boolean]>
        )
            .map(([id, dark]) => ({ el: document.getElementById(id), dark }))
            .filter((p): p is { el: HTMLElement; dark: boolean } => Boolean(p.el));

        return function syncTheme() {
            const boxes = panels.map((p) => ({ dark: p.dark, r: p.el.getBoundingClientRect() }));

            for (const { el, cls } of controls) {
                const rect = el.getBoundingClientRect();
                const x = rect.left + rect.width / 2;
                const y = rect.top + rect.height / 2;

                let isDark = false;
                for (let i = boxes.length - 1; i >= 0; i--) {
                    const { dark, r } = boxes[i];
                    if (y >= r.top && y <= r.bottom && x >= r.left && x <= r.right) {
                        isDark = dark;
                        break;
                    }
                }
                el.classList.toggle(cls, isDark);
            }
        };
    }

    function initStoryBeats(onEnterStage: () => void) {
        const stage = document.getElementById("cinematic-stage");
        const stageWrapper = document.getElementById("reveal-stage");
        if (!stage || !stageWrapper) return () => {};

        const track = document.getElementById("sidebar-track");
        const sidebar = document.querySelector(".stage-sidebar-history") as HTMLElement | null;

        // offsetTop forces a reflow, so measure it on resize rather than per frame.
        let stageTop = stageWrapper.offsetTop;
        const remeasure = () => {
            stageTop = stageWrapper.offsetTop;
        };
        onWindow("resize", remeasure);

        function updateSidebarScroll() {
            if (!track || !sidebar) return;
            const overflow = track.scrollHeight - sidebar.clientHeight;
            track.style.transform =
                stage!.classList.contains("is-beat5") && overflow > 0
                    ? `translateY(-${overflow}px)`
                    : "translateY(0px)";
        }

        if (typeof ResizeObserver !== "undefined" && track) {
            const ro = new ResizeObserver(updateSidebarScroll);
            ro.observe(track);
            if (sidebar) ro.observe(sidebar);
            teardown.push(() => ro.disconnect());
        }

        // Beats are cumulative: reaching beat 4 means beats 2 and 3 stay applied,
        // which is what keeps the sidebar history stacked up.
        const BEATS = ["is-beat2", "is-beat3", "is-beat4", "is-beat5"];
        let lastIndex = -1;

        return function updateBeats() {
            const vh = window.innerHeight;
            const progress = (window.scrollY - stageTop) / vh;

            // Each beat owns exactly 1vh of pinned scroll. A small hysteresis band
            // stops the state flickering when a scroll lands right on a boundary.
            const hysteresis = 0.08;
            let index = Math.floor(progress);
            if (index < 0) index = 0;
            if (index > 3) index = 3;

            if (index < lastIndex && progress > index + 1 - hysteresis) {
                index = lastIndex;
            }

            if (progress > 0) onEnterStage();

            // The shutter runs from progress -1 to 0; hold the content until it lands.
            stage!.classList.toggle("is-armed", progress >= -0.02);
            stage!.classList.toggle("is-slammed", progress >= -0.02);

            if (index !== lastIndex) {
                BEATS.forEach((cls, i) => stage!.classList.toggle(cls, i <= index));
                lastIndex = index;
            }

            updateSidebarScroll();
        };
    }

    /**
     * Generic typewriter over a typed span plus a hidden remainder that holds
     * the layout, so the line never reflows while it types.
     */
    function createTypewriter(root: HTMLElement | null, text: string) {
        const out = root?.querySelector<HTMLElement>("[data-type-out]");
        const rest = root?.querySelector<HTMLElement>("[data-type-rest]");
        if (!root || !out || !rest) return { start: () => {}, complete: () => {} };

        rest.textContent = text;
        out.textContent = "";

        let started = false;
        let done = false;
        let timer: ReturnType<typeof setTimeout> | null = null;

        function complete() {
            if (done) return;
            done = true;
            if (timer) clearTimeout(timer);
            out!.textContent = text;
            rest!.textContent = "";
            root!.classList.add("is-typed");
        }

        function start() {
            if (started || done) return;
            started = true;
            if (prefersReducedMotion()) {
                complete();
                return;
            }
            root!.classList.add("is-typing");
            let i = 0;
            (function step() {
                if (done) return;
                if (i >= text.length) {
                    rest!.textContent = "";
                    root!.classList.add("is-typed");
                    return;
                }
                out!.textContent = text.slice(0, i + 1);
                rest!.textContent = text.slice(i + 1);
                i++;
                timer = setTimeout(step, 26 + Math.random() * 20);
            })();
        }

        teardown.push(() => {
            if (timer) clearTimeout(timer);
        });

        return { start, complete };
    }

    const SVG_NS = "http://www.w3.org/2000/svg";

    /**
     * Scatters bicycle marks across the landmass. Candidate points are tested
     * against the actual map geometry with isPointInFill, so no bike ever lands
     * in the sea or hangs over a coastline.
     */
    function buildBikes(svg: SVGSVGElement) {
        const paths = Array.from(svg.querySelectorAll<SVGPathElement>("g > path"));
        if (!paths.length) return [];

        const group = paths[0].parentElement as unknown as SVGGraphicsElement | null;
        if (!group) return [];

        // Bikes are appended to the <svg>, so their coordinates are viewBox
        // units, while the paths live inside a flipped/scaled <g>. Going via
        // screen space converts between the two correctly; getCTM alone would
        // not, because it resolves to CSS pixels rather than viewBox units.
        let svgCTM = svg.getScreenCTM();
        let groupCTM = group.getScreenCTM();
        if (!svgCTM || !groupCTM) return [];

        // The shared map's viewBox has a lot of empty ocean around the land, so
        // on this panel it would sit off-centre and undersized. Crop the viewBox
        // to the coastline itself before anything is measured or placed.
        const toViewBox = svgCTM.inverse().multiply(groupCTM);
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        for (const path of paths) {
            const b = path.getBBox();
            for (const [bx, by] of [
                [b.x, b.y],
                [b.x + b.width, b.y],
                [b.x, b.y + b.height],
                [b.x + b.width, b.y + b.height]
            ]) {
                const v = new DOMPoint(bx, by).matrixTransform(toViewBox);
                if (v.x < minX) minX = v.x;
                if (v.x > maxX) maxX = v.x;
                if (v.y < minY) minY = v.y;
                if (v.y > maxY) maxY = v.y;
            }
        }
        if (Number.isFinite(minX) && maxX > minX && maxY > minY) {
            const pad = 18;
            svg.setAttribute(
                "viewBox",
                `${(minX - pad).toFixed(1)} ${(minY - pad).toFixed(1)} ` +
                    `${(maxX - minX + pad * 2).toFixed(1)} ${(maxY - minY + pad * 2).toFixed(1)}`
            );
            // Cropping changes the viewBox transform, so re-read the matrices.
            svgCTM = svg.getScreenCTM();
            groupCTM = group.getScreenCTM();
            if (!svgCTM || !groupCTM) return [];
        }

        const toUser = groupCTM.inverse().multiply(svgCTM);

        // The map is ~90 separate paths. Testing every point against every one
        // is far too slow, so cache each path's bounding box and only run the
        // real fill test on the few whose box could contain the point.
        const boxes = paths.map((path) => {
            const b = path.getBBox();
            return { path, x1: b.x, y1: b.y, x2: b.x + b.width, y2: b.y + b.height };
        });

        const vb = svg.viewBox.baseVal;

        // On a small rendered map, keep the glyph readable by drawing fewer,
        // proportionally larger bikes rather than a mush of tiny ones.
        const renderedW = svg.getBoundingClientRect().width || vb.width;
        const drawnW = Math.min(renderedW, (svg.getBoundingClientRect().height || vb.height) * (vb.width / vb.height));
        const scale = drawnW < 340 ? 1.55 : drawnW < 460 ? 1.25 : 1;

        const BIKE_W = 26 * scale;
        const BIKE_H = 17 * scale;
        const STEP_X = 28 * scale;
        const STEP_Y = 19 * scale;

        const probe = new DOMPoint();
        function inside(x: number, y: number) {
            probe.x = x;
            probe.y = y;
            const u = probe.matrixTransform(toUser);
            for (const b of boxes) {
                if (u.x < b.x1 || u.x > b.x2 || u.y < b.y1 || u.y > b.y2) continue;
                if (b.path.isPointInFill(u)) return true;
            }
            return false;
        }

        // Auckland, so the fill spreads out from where the story happened.
        const AKL_X = 678;
        const AKL_Y = 228;

        const spots: Array<{ x: number; y: number; order: number }> = [];
        for (let gy = vb.y + STEP_Y; gy < vb.y + vb.height; gy += STEP_Y) {
            for (let gx = vb.x + STEP_X; gx < vb.x + vb.width; gx += STEP_X) {
                const x = gx + (Math.random() - 0.5) * STEP_X * 0.45;
                const y = gy + (Math.random() - 0.5) * STEP_Y * 0.45;
                if (!inside(x, y)) continue;
                // Keep the glyph on land, not just its centre.
                if (!inside(x - BIKE_W * 0.35, y)) continue;
                if (!inside(x + BIKE_W * 0.35, y)) continue;
                if (!inside(x, y - BIKE_H * 0.3)) continue;
                if (!inside(x, y + BIKE_H * 0.3)) continue;

                const d = Math.hypot(x - AKL_X, y - AKL_Y);
                spots.push({ x, y, order: d + Math.random() * 80 });
            }
        }

        spots.sort((a, b) => a.order - b.order);

        // A re-init without a DOM swap would otherwise stack a second layer of
        // bikes on top of the first.
        svg.querySelectorAll(".bike-layer").forEach((old) => old.remove());

        const layer = document.createElementNS(SVG_NS, "g");
        layer.setAttribute("class", "bike-layer");
        const frag = document.createDocumentFragment();
        const marks: SVGGElement[] = [];

        for (const spot of spots) {
            // Position lives on an outer group. The animated class goes on an
            // inner one, because a CSS transform would otherwise replace the
            // transform attribute outright and stack every bike on the origin.
            const pos = document.createElementNS(SVG_NS, "g");
            pos.setAttribute("transform", `translate(${spot.x.toFixed(1)} ${spot.y.toFixed(1)})`);

            const g = document.createElementNS(SVG_NS, "g");
            g.setAttribute("class", "bike-mark");
            pos.appendChild(g);

            const bike = document.createElementNS(SVG_NS, "g");
            bike.setAttribute("fill", "none");
            bike.setAttribute("stroke", "#FFDA00");
            bike.setAttribute("stroke-width", (2.1 * scale).toFixed(2));
            bike.setAttribute("stroke-linecap", "round");
            bike.setAttribute("stroke-linejoin", "round");

            const k = (n: number) => (n * scale).toFixed(2);
            for (const cx of [-7.8, 7.8]) {
                const wheel = document.createElementNS(SVG_NS, "circle");
                wheel.setAttribute("cx", k(cx));
                wheel.setAttribute("cy", k(3.6));
                wheel.setAttribute("r", k(4.8));
                bike.appendChild(wheel);
            }

            const frame = document.createElementNS(SVG_NS, "path");
            frame.setAttribute(
                "d",
                `M${k(-7.8)} ${k(3.6)} L${k(-1.4)} ${k(-4.8)} L${k(7.8)} ${k(3.6)} ` +
                    `M${k(-1.4)} ${k(-4.8)} L${k(3.4)} ${k(-4.8)} ` +
                    `M${k(-4.5)} ${k(3.6)} L${k(1.7)} ${k(-4.8)}`
            );
            bike.appendChild(frame);

            g.appendChild(bike);
            frag.appendChild(pos);
            marks.push(g);
        }

        layer.appendChild(frag);
        svg.appendChild(layer);
        return marks;
    }

    function initResultsStage() {
        const stage = document.getElementById("results-stage");
        const panel = document.getElementById("results-panel");
        if (!stage || !panel) return () => {};

        const heading = document.getElementById("results-heading");
        const typer = createTypewriter(
            heading,
            "So let’s keep all that in mind when we look at the numbers"
        );

        let stageTop = stage.offsetTop;
        onWindow("resize", () => {
            stageTop = stage.offsetTop;
        });

        let bikes: SVGGElement[] = [];
        let bikesBuilt = false;
        let shown = 0;

        function ensureBikes() {
            if (bikesBuilt) return;
            const svg = document.querySelector<SVGSVGElement>(
                "#results-map-holder .nz-map-svg"
            );
            if (!svg) return;
            bikesBuilt = true;
            bikes = buildBikes(svg);
            teardown.push(() => {
                svg.querySelectorAll(".bike-layer").forEach((layer) => layer.remove());
            });
        }

        // The fill runs on its own clock once the map is in view, rather than
        // being dragged frame by frame by the scrollbar.
        const FILL_MS = 2800;
        let fillStart = 0;
        let filling = false;
        let fillRaf = 0;

        function paint(fraction: number) {
            if (!bikes.length) return;
            const target = Math.round(Math.max(0, Math.min(1, fraction)) * bikes.length);
            // Only touch the elements that actually changed state this frame.
            while (shown < target) bikes[shown++].classList.add("is-on");
            while (shown > target) bikes[--shown].classList.remove("is-on");
        }

        function step(now: number) {
            const t = Math.min(1, (now - fillStart) / FILL_MS);
            // Ease out, so the island crowds up quickly then settles.
            paint(1 - Math.pow(1 - t, 2));
            if (t < 1) {
                fillRaf = requestAnimationFrame(step);
            } else {
                fillRaf = 0;
            }
        }

        function startFill() {
            if (filling || !bikes.length) return;
            filling = true;
            if (prefersReducedMotion()) {
                paint(1);
                return;
            }
            fillStart = performance.now();
            fillRaf = requestAnimationFrame(step);
        }

        teardown.push(() => {
            if (fillRaf) cancelAnimationFrame(fillRaf);
        });

        return function updateResults() {
            const vh = window.innerHeight;
            const p = (window.scrollY - stageTop) / vh;

            // Build the bikes just before they are needed, never on first paint.
            if (p > -1.4) ensureBikes();

            if (p >= 0) typer.start();

            panel!.classList.toggle("is-map-in", p >= 0.9);
            panel!.classList.toggle("is-stats-in", p >= 1.1);

            if (p >= 1.55) startFill();
        };
    }

    /**
     * Drives the panel-to-panel transitions: the WHY slam once its shutter has
     * landed, and the horizontal handover where beat 1 slides in from the left
     * and carries the WHY copy off to the right.
     */
    function initPanelTransitions(onBeat1Ready: () => void) {
        const pinWhy = document.getElementById("pin-why");
        const pinBeat1 = document.getElementById("pin-beat1");
        const why = document.getElementById("why-section");
        const beat1 = document.getElementById("beat1-section");
        const whyInner = document.querySelector<HTMLElement>(".why-inner-container");
        if (!pinWhy || !pinBeat1 || !why || !beat1 || !whyInner) return () => {};

        let whyTop = pinWhy.offsetTop;
        let slideTop = pinBeat1.offsetTop;
        onWindow("resize", () => {
            whyTop = pinWhy.offsetTop;
            slideTop = pinBeat1.offsetTop;
        });

        const reduced = prefersReducedMotion();
        let slid = -1;

        return function updatePanels() {
            const vh = window.innerHeight;
            const y = window.scrollY;

            // WHY lands when its shutter reaches the top of the viewport.
            why.classList.toggle("is-slammed", y >= whyTop - 2);

            // Beat 1 takes over across the vh that follows.
            let p = (y - slideTop) / vh;
            p = p < 0 ? 0 : p > 1 ? 1 : p;
            // Ease so the handover starts and finishes softly.
            const e = reduced ? (p < 1 ? 0 : 1) : p * p * (3 - 2 * p);

            if (e !== slid) {
                slid = e;
                beat1.style.transform = `translate3d(${(e - 1) * 100}%, 0, 0)`;
                whyInner.style.transform = `translate3d(${e * 108}%, 0, 0)`;
            }

            if (p >= 1) onBeat1Ready();
        };
    }

    /**
     * The "What I did" deck. Every chapter shares one pinned viewport and is
     * absolutely positioned on top of the last, so scrolling only has to move
     * them sideways: chapter i slides in from the right edge across the
     * viewport of scroll before it, then parks at i spine widths from the left
     * and stays there while the rest arrive over the top of it. What is left
     * showing of a parked chapter is its spine, which turns the stack into a
     * running index of where you are.
     *
     * Wide viewports only. Narrow ones have no room for the spines, and the
     * whole thing is a scroll hijack, so reduced motion opts out too — both
     * fall back to the plain vertical read the base CSS already describes.
     */
    function initDidDeck() {
        const section = document.getElementById("what-i-did");
        const runway = document.getElementById("did-runway");
        const viewport = runway?.querySelector<HTMLElement>(".did-viewport");
        const slides = Array.from(
            runway?.querySelectorAll<HTMLElement>(".did-slide") ?? []
        );
        if (!section || !runway || !viewport || slides.length < 2) return () => {};

        // The runway's height is one viewport per chapter, so the count has to
        // come from the DOM rather than being kept in step by hand.
        runway.style.setProperty("--did-count", String(slides.length));

        const wide = window.matchMedia("(min-width: 1025px)");
        const still = window.matchMedia("(prefers-reduced-motion: reduce)");

        let deck = false;
        let runwayTop = 0;
        let stageWidth = 0;
        let spineWidth = 0;

        // These all force layout, so they are read on resize and on mode
        // changes rather than every frame.
        function measure() {
            runwayTop = runway!.getBoundingClientRect().top + window.scrollY;
            stageWidth = viewport!.clientWidth;
            // The slide pads itself by exactly one spine, which is the only
            // place the clamped width resolves to a number we can read back.
            spineWidth = parseFloat(getComputedStyle(slides[0]).paddingLeft) || 0;
        }

        function setMode() {
            const next = wide.matches && !still.matches;
            if (next === deck) return;
            deck = next;
            section!.classList.toggle("is-deck", deck);
            if (!deck) {
                for (const slide of slides) {
                    slide.style.transform = "";
                    slide.classList.remove("is-current");
                }
            }
            measure();
        }

        // Resize covers the width query as well: a viewport emulator or a
        // desktop window drag does not always deliver a matchMedia change.
        onWindow("resize", () => {
            setMode();
            measure();
        });
        for (const query of [wide, still]) {
            const onChange = () => {
                setMode();
                update();
            };
            query.addEventListener("change", onChange);
            teardown.push(() => query.removeEventListener("change", onChange));
        }

        setMode();

        function update() {
            if (!deck) return;

            const vh = window.innerHeight;
            const last = slides.length - 1;
            let p = (window.scrollY - runwayTop) / vh;
            p = p < 0 ? 0 : p > last ? last : p;

            // The live chapter is the highest one that has finished arriving.
            const current = Math.min(last, Math.floor(p));

            for (let i = 0; i < slides.length; i++) {
                // Chapter i travels across the viewport of scroll that ends on
                // it, so slide 0 is already home at p = 0.
                let t = p - i + 1;
                t = t < 0 ? 0 : t > 1 ? 1 : t;
                const e = t * t * (3 - 2 * t);

                const rest = i * spineWidth;
                const x = rest + (1 - e) * (stageWidth - rest);

                slides[i].style.transform = `translate3d(${x.toFixed(2)}px, 0, 0)`;
                slides[i].classList.toggle("is-current", i === current);
            }
        }

        return update;
    }

    function initAll() {
        // Tear down anything left over from the previous page before rebinding.
        teardown.forEach((fn) => fn());
        teardown = [];

        if (!document.querySelector(".abc-page")) return;

        const loop = createScrollLoop();
        const typewriter = initBeat1Typewriter();

        initMouseScrollSignal();
        initSectionReveals();
        initBlockReveals();

        loop.subscribe(initPanelTransitions(typewriter.start));
        loop.subscribe(initStoryBeats(typewriter.complete));
        loop.subscribe(createThemeSync());
        loop.subscribe(initResultsStage());
        loop.subscribe(initDidDeck());
        loop.run();
    }

    document.addEventListener("astro:page-load", initAll);
    document.addEventListener("astro:before-swap", () => {
        teardown.forEach((fn) => fn());
        teardown = [];
    });
</script>
