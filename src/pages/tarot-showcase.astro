---
import Base from "../layouts/Base.astro";
import Navigation from "../components/Navigation.astro";
import HoloProjectCard from "../components/HoloProjectCard.astro";
---

<Base>
    <Navigation activeSection="projects" />

    <main class="showcase-main">
        <header class="showcase-header">
            <span class="showcase-eyebrow">DYNAMIC HOLOGRAPHIC CARD</span>
            <h1 class="showcase-title">Automated Unemployment</h1>
            <p class="showcase-subtitle">
                Interactive pure CSS/SVG card engine with dynamic HTML typography and Secret Rare etched holographic foil.
            </p>
        </header>

        <section class="card-stage-section">
            <div class="cards-grid">
                <!-- Card 1: Automating Unemployment -->
                <div class="card-display-anchor">
                    <HoloProjectCard
                        title="AUTOMATING UNEMPLOYMENT"
                        subtitle="Case Study"
                        category="Agentic Workflow Implementation"
                        statLabel="RESULTS"
                        statValue="85% TIME SAVINGS"
                        iconSrc="/img/robot-icon.svg"
                        imageUrl="/holo-card/afro-lounger-art.webp"
                        maskUrl="/holo-card/afro-lounger-mask.png"
                        cardBg="#4ca5ac"
                        borderColor="#1d767d"
                        borderWidth="16px"
                        holoEffect="secret_rare_etched"
                    />
                </div>

                <!-- Card 2: How I Made This Website -->
                <div class="card-display-anchor">
                    <HoloProjectCard
                        title="HOW I MADE THIS WEBSITE"
                        subtitle="Case Study"
                        category="Creative Web & AI Workflows"
                        statLabel="TECH STACK"
                        statValue="ASTRO + CSS SHADERS"
                        iconSrc="/img/robot-icon.svg"
                        imageUrl="/holo-card/how-i-made-this-website-art.webp"
                        maskUrl="/holo-card/how-i-made-this-website-mask.png"
                        cardBg="#93619C"
                        borderColor="#8353A3"
                        borderWidth="16px"
                        holoEffect="secret_rare_etched"
                    />
                </div>
            </div>
        </section>

        <!-- Controls / Finish Info -->
        <footer class="showcase-footer">
            <div class="feature-tag-strip">
                <span class="feature-tag">✨ Spectral Color-Dodge Foil</span>
                <span class="feature-tag">🎯 Dynamic Specular Spotlight</span>
                <span class="feature-tag">✦ Starlight Twinkle Field</span>
                <span class="feature-tag">🛡️ 1.5mm Chamfered Edge Bevel</span>
                <span class="feature-tag">🔄 3D Flip Backface</span>
            </div>
            <div class="nav-links">
                <a href="/projects" class="back-link">← Back to Projects Deck</a>
            </div>
        </footer>
    </main>
</Base>

<style>
    .showcase-main {
        min-height: 100vh;
        background: radial-gradient(circle at 50% 20%, #0f1e3d 0%, #081226 50%, #030712 100%);
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 80px 24px 40px;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    .showcase-header {
        text-align: center;
        width: 100%;
        max-width: 720px;
        margin: 20px auto 16px auto;
        position: relative;
        z-index: 10;
    }

    .showcase-eyebrow {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        color: #00f2fe;
        text-transform: uppercase;
        display: block;
        margin-bottom: 8px;
    }

    .showcase-title {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 800;
        margin: 0 0 12px 0;
        letter-spacing: -0.02em;
        line-height: 1.2;
        background: linear-gradient(135deg, #ffffff 0%, #00f2fe 50%, #f72585 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .showcase-subtitle {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-size: 0.95rem;
        color: #94a3b8;
        line-height: 1.6;
        margin: 0 auto;
        max-width: 580px;
    }

    .card-stage-section {
        position: relative;
        width: 100%;
        max-width: 1100px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 20px 0;
    }

    .cards-grid {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 40px;
        flex-wrap: wrap;
        width: 100%;
        z-index: 1;
    }

    .card-display-anchor {
        position: relative;
        z-index: 1;
    }

    .showcase-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 20px;
    }

    .feature-tag-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }

    .feature-tag {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-size: 0.75rem;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(0, 242, 254, 0.25);
        color: #cbd5e1;
        backdrop-filter: blur(8px);
    }

    .back-link {
        font-family: var(--secondary-font, 'DM Sans', sans-serif);
        font-size: 0.875rem;
        color: #00f2fe;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: #ffffff;
        text-decoration: underline;
    }
</style>
