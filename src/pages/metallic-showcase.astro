---
import Base from '../layouts/Base.astro'
import Navigation from '../components/Navigation.astro'
import CategoryRail from '../components/CategoryRail.astro'
import MetallicTarotCard from '../components/MetallicTarotCard.astro'
import ProjectModal from '../components/ProjectModal.astro'
import { getCollection, render } from 'astro:content'
import { CATEGORIES } from '../categories.js'

const rawProjects = (await getCollection('projects', ({ data }) => data.active))
    .sort((a, b) => a.data.order - b.data.order)

const ROMAN_NUMERALS = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"]
const ICONS = ["crab", "sun", "astrolabe", "eye", "moon", "serpent", "crystal"]
const THEMES = ["teal", "purple", "amber", "cyan", "rose", "emerald", "purple"]

const projects = await Promise.all(
    rawProjects.map(async (project, index) => {
        const { Content } = await render(project)
        const numeral = ROMAN_NUMERALS[index] || `N-${index + 1}`
        const icon = ICONS[index % ICONS.length]
        const accentTheme = THEMES[index % THEMES.length]

        let stat = "+100 Tranquility"
        if (project.data.category === "operations") stat = "+100 Efficiency"
        else if (project.data.category === "delivery") stat = "+100 Delivery"
        else if (project.data.category === "development") stat = "+100 Full-Stack"

        return {
            project,
            Content,
            numeral,
            icon,
            accentTheme,
            stat,
        }
    })
)

const counts = Object.fromEntries(
    CATEGORIES.map((category) => [category, projects.filter((p) => p.project.data.category === category).length])
)

const employers = [
    "The Odin Project",
    "Outer Office",
    "Highgate Transportation",
    "Auckland Transport",
    "Asahi Beverages",
    "Auckland Council",
    "IFM Electrical",
    "Coster Content Ltd",
]
---

<Base>
    <main class="projects-page light-theme">
        <!-- Top Navigation -->
        <Navigation />

        <!-- Header Section -->
        <div class="intro">
            <div class="identity-block">
                <p class="identity-name">Olanike Olowo-Fela.</p>
                <p class="identity-tagline">Technology Consultant · Full-Stack Developer</p>
            </div>

            <header class="work-header">
                <p class="work-eyebrow">Metallic Tarot Edition / Projects</p>
                <h1 class="work-headline">
                    <strong>8 years</strong> of hands-on delivery — from AI-assisted automation to national transport programmes — where I've been, and what I built.
                </h1>
            </header>
        </div>

        <p id="filter-announcement" class="visually-hidden" role="status" aria-live="polite"></p>

        <!-- Main Work Stage: Category Rail (Left) + Metallic Tarot Track (Right) -->
        <div class="work-stage">
            <CategoryRail counts={counts} total={projects.length} />

            <section class="carousel-section" aria-label="Selected work showcase">
                <div class="carousel-header">
                    <div class="carousel-controls">
                        <button type="button" class="nav-arrow-btn" id="carouselPrevBtn" aria-label="Scroll left">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                                <path d="M15 18l-6-6 6-6" />
                            </svg>
                        </button>
                        <button type="button" class="nav-arrow-btn" id="carouselNextBtn" aria-label="Scroll right">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                                <path d="M9 18l6-6-6-6" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Floating Metallic Tarot Card Track Area -->
                <div class="carousel-track-wrapper" id="carouselTrackWrapper">
                    <div
                        class="carousel-track"
                        id="carouselTrack"
                        tabindex="0"
                        role="region"
                        aria-label="Projects Metallic Tarot Card carousel"
                    >
                        {projects.map(({ project, numeral, icon, accentTheme, stat }) => (
                            <div
                                class="carousel-card-item"
                                data-project-id={project.id}
                                data-category={project.data.category}
                            >
                                <MetallicTarotCard
                                    id={`metallic-${project.id}`}
                                    numeral={numeral}
                                    icon={icon}
                                    accentTheme={accentTheme}
                                    title={project.data.projTitle}
                                    subtitle={project.data.summary}
                                    category={project.data.projType || project.data.category}
                                    stat={stat}
                                />
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        </div>

        <!-- Trusted By Strip -->
        <footer class="trusted-by">
            <span class="trusted-by-label">Trusted by</span>
            {employers.map((name, i) => (
                <>
                    <span class="trusted-by-name">{name}</span>
                    {i < employers.length - 1 && <span class="trusted-by-sep" aria-hidden="true">·</span>}
                </>
            ))}
        </footer>

        <!-- Detail Modal -->
        <ProjectModal projects={projects} />
    </main>

    <script>
        import "../projects.js"
    </script>
</Base>

<style>
    /* Cool Platinum / Silvery Mist Light Theme (Zero Cream / Pure Crisp Ethereal Light) */
    body {
        background: radial-gradient(
            ellipse 85vw 120vh at 50vw 45vh,
            #FFFFFF 0%,
            #F4F7FA 30%,
            #E8F0F6 60%,
            #DCE6EF 85%,
            #CFDCE7 100%
        ) fixed;
        color: #0F172A;
        min-height: 100dvh;
        overflow-x: hidden;
    }

    .projects-page {
        --pw-ink: #0F172A;
        --pw-muted: #64748B;
        --pw-border: rgba(15, 23, 42, 0.08);
        --pw-accent: #0D9488;
        --pw-sans: var(--secondary-font, 'DM Sans', -apple-system, sans-serif);

        display: flex;
        flex-direction: column;
        height: 100dvh;
        padding: clamp(56px, 6.5vh, 80px) clamp(24px, 4vw, 56px) clamp(16px, 2vh, 24px);
        gap: clamp(14px, 1.8vh, 22px);
        overflow: hidden;
        box-sizing: border-box;
    }

    /* Top Navigation Adaptation for Light Background */
    :global(nav:not(.category-rail)) {
        background: rgba(255, 255, 255, 0.8) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06) !important;
    }

    :global(#pages-list button),
    :global(#pages-list a) {
        color: #64748B !important;
    }

    :global(#pages-list button:hover),
    :global(#pages-list a:hover) {
        color: #0F172A !important;
    }

    :global(#pages-list a[aria-current="page"]),
    :global(button[aria-pressed="true"]) {
        background: #0F172A !important;
        color: #FFFFFF !important;
    }

    /* Category Rail Adaptation (Frameless / Seamless on Light Canvas) */
    :global(.category-rail) {
        background: transparent !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
        border: none !important;
    }

    :global(.rail-title) {
        color: #64748B !important;
        font-weight: 700 !important;
    }

    :global(.rail-node) {
        color: #475569 !important;
    }

    :global(.rail-node:hover) {
        background: rgba(15, 23, 42, 0.04) !important;
    }

    :global(.rail-node[aria-pressed="true"]) {
        background: rgba(255, 255, 255, 0.9) !important;
        border-color: rgba(15, 23, 42, 0.12) !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06) !important;
    }

    :global(.rail-node[aria-pressed="true"] .node-label) {
        color: #0F172A !important;
        font-weight: 700 !important;
    }

    :global(.node-label) {
        color: #475569 !important;
    }

    :global(.node-count) {
        color: #94A3B8 !important;
    }

    :global(.node-dot) {
        background: #CBD5E1 !important;
    }

    :global(.rail-node[aria-pressed="true"] .node-dot) {
        background: var(--cat-accent, #0D9488) !important;
        box-shadow: 0 0 8px var(--cat-accent, #0D9488) !important;
    }

    /* Intro Block */
    .intro {
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        width: 100%;
        gap: 8px;
    }

    .identity-block {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .identity-name {
        font-family: var(--pw-sans);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: #0F172A;
        margin: 0;
    }

    .identity-tagline {
        font-family: var(--pw-sans);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pw-muted);
        margin: 0;
    }

    .work-header {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 4px;
    }

    .work-eyebrow {
        font-family: var(--pw-sans);
        font-weight: 600;
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pw-accent);
        margin: 0;
    }

    .work-headline {
        max-width: 54ch;
        font-family: var(--pw-sans);
        font-weight: 400;
        font-size: clamp(1.05rem, 1.4vw, 1.22rem);
        line-height: 1.45;
        color: #334155;
        margin: 0;
    }

    .work-headline strong {
        font-weight: 700;
        color: #0F172A;
    }

    /* Work Stage */
    .work-stage {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        align-items: center;
        gap: clamp(24px, 3.5vw, 48px);
        width: 100%;
        flex: 1;
        min-height: 0;
    }

    /* Carousel Section */
    .carousel-section {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        width: 100%;
        height: 100%;
    }

    .carousel-header {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        z-index: 10;
    }

    .carousel-controls {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .nav-arrow-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(15, 23, 42, 0.12);
        color: #334155;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .nav-arrow-btn:hover {
        background: #0F172A;
        color: #FFFFFF;
        border-color: #0F172A;
    }

    /* Track Wrapper */
    .carousel-track-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
    }

    /* Smooth Drag-to-Scroll Track */
    .carousel-track {
        display: flex;
        align-items: center;
        gap: clamp(22px, 2.8vw, 40px);
        width: 100%;
        height: 100%;
        padding: 20px 8px;
        overflow-x: auto;
        overflow-y: hidden;
        cursor: grab;
        overscroll-behavior-x: contain;
        -ms-overflow-style: none;
        scrollbar-width: none;
        box-sizing: border-box;
        user-select: none;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .carousel-track.is-dragging {
        cursor: grabbing;
    }

    .carousel-track:focus-visible {
        outline: none;
    }

    /* Individual Card Item */
    .carousel-card-item {
        position: relative;
        flex-shrink: 0;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .carousel-card-item:hover {
        transform: translateY(-8px);
    }

    /* Trusted By Strip */
    .trusted-by {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        flex-shrink: 0;
        gap: 0.5em;
        width: 100%;
        margin: 0;
        padding-top: 10px;
        border-top: 1px solid var(--pw-border);
        font-family: var(--pw-sans);
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        color: var(--pw-muted);
    }

    .trusted-by-label {
        font-weight: 700;
        text-transform: uppercase;
        color: #0F172A;
        margin-right: 0.4em;
    }

    .trusted-by-name {
        color: #64748B;
        transition: color 0.2s ease;
    }

    .trusted-by-name:hover {
        color: #0F172A;
    }

    .trusted-by-sep {
        opacity: 0.4;
    }

    @media (max-width: 900px) {
        .projects-page {
            height: auto;
            min-height: 100dvh;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 48px 20px 32px;
            gap: 20px;
        }

        .work-stage {
            grid-template-columns: minmax(0, 1fr);
            flex: none;
            gap: 20px;
        }

        .carousel-track-wrapper {
            height: 440px;
        }

        .carousel-header {
            position: static;
            margin-bottom: 8px;
        }
    }
</style>
