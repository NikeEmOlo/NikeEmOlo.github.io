---
import Base from '../layouts/Base.astro'
import Navigation from '../components/Navigation.astro'
import CategoryRail from '../components/CategoryRail.astro'
import HoloCard from '../components/HoloCard.astro'
import ProjectModal from '../components/ProjectModal.astro'
import { getCollection, render } from 'astro:content'
import { CATEGORIES } from '../categories.js'

const rawProjects = (await getCollection('projects', ({ data }) => data.active))
    .sort((a, b) => a.data.order - b.data.order)

// Harmonic Mystic Tarot Color Presets
const ORB_PALETTE: Array<"purple" | "teal" | "amber" | "rose" | "blue" | "cyan" | "coral" | "emerald"> = [
    "purple",
    "teal",
    "amber",
    "rose",
    "blue",
    "cyan",
    "coral",
    "emerald",
]

const projects = await Promise.all(
    rawProjects.map(async (project, index) => {
        const { Content } = await render(project)
        const orbColor = ORB_PALETTE[index % ORB_PALETTE.length]

        let stat = "+100 Tranquility"
        if (project.data.category === "operations") stat = "+100 Efficiency"
        else if (project.data.category === "delivery") stat = "+100 Delivery"
        else if (project.data.category === "development") stat = "+100 Full-Stack"

        return {
            project,
            Content,
            orbColor,
            stat,
        }
    })
)

const counts = Object.fromEntries(
    CATEGORIES.map((category) => [category, projects.filter((p) => p.project.data.category === category).length])
)

const employers = [
    "The Odin Project",
    "Outer Office",
    "Highgate Transportation",
    "Auckland Transport",
    "Asahi Beverages",
    "Auckland Council",
    "IFM Electrical",
    "Coster Content Ltd",
]
---

<Base>
    <main class="projects-page light-theme">
        <!-- Top Navigation -->
        <Navigation />

        <!-- Header Section -->
        <div class="intro">
            <div class="identity-block">
                <p class="identity-name">Olanike Olowo-Fela.</p>
                <p class="identity-tagline">Technology Consultant · Full-Stack Developer</p>
            </div>

            <header class="work-header">
                <p class="work-eyebrow">02 / Projects</p>
                <h1 class="work-headline">
                    <strong>8 years</strong> of hands-on delivery — from AI-assisted automation to national transport programmes — where I've been, and what I built.
                </h1>
            </header>
        </div>

        <p id="filter-announcement" class="visually-hidden" role="status" aria-live="polite"></p>

        <!-- Main Work Stage: Category Rail (Left) + Dual-Stack Tarot Deck (Right) -->
        <div class="work-stage">
            <CategoryRail counts={counts} total={projects.length} />

            <section class="deck-section" aria-label="Selected work tarot deck">
                <!-- Stack Labels & Controls -->
                <div class="deck-header">
                    <div class="deck-stack-indicators" aria-hidden="true">
                        <span class="stack-indicator-label discard-label">Discard Pile</span>
                        <span class="stack-indicator-sep">⇄</span>
                        <span class="stack-indicator-label draw-label">Draw Deck</span>
                    </div>

                    <div class="deck-controls">
                        <button type="button" class="nav-arrow-btn" id="carouselPrevBtn" aria-label="Return card to deck">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                                <path d="M15 18l-6-6 6-6" />
                            </svg>
                        </button>
                        <button type="button" class="nav-arrow-btn" id="carouselNextBtn" aria-label="Deal next card">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                                <path d="M9 18l6-6-6-6" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- 3D Dual-Stack Dealing Stage -->
                <div class="deck-stage-wrapper">
                    <div
                        class="deck-stage"
                        data-deck-stage
                        tabindex="0"
                        role="region"
                        aria-label="Tarot card dealing deck. Drag or scroll to deal cards from deck to discard."
                    >
                        {projects.map(({ project, orbColor, stat }) => (
                            <div
                                class="deck-card-item"
                                data-project-id={project.id}
                                data-category={project.data.category}
                                role="button"
                                tabindex="0"
                                aria-label={`View ${project.data.projTitle} project details`}
                            >
                                <HoloCard
                                    id={`deck-${project.id}`}
                                    title={project.data.projTitle}
                                    subtitle={project.data.summary}
                                    badge={project.data.projType || project.data.category}
                                    stat={stat}
                                    orbColor={orbColor}
                                    autoFlip={false}
                                    flipOnClick={false}
                                    startFront={true}
                                    showVortex={false}
                                />
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        </div>

        <!-- Trusted By Strip -->
        <footer class="trusted-by">
            <span class="trusted-by-label">Trusted by</span>
            {employers.map((name, i) => (
                <>
                    <span class="trusted-by-name">{name}</span>
                    {i < employers.length - 1 && <span class="trusted-by-sep" aria-hidden="true">·</span>}
                </>
            ))}
        </footer>

        <!-- Sandbox-Style Two-Column Detail Modal -->
        <ProjectModal projects={projects} />
    </main>

    <script>
        import { initTarotDeckEngine } from "../lib/deckController.js"

        document.addEventListener("astro:page-load", initTarotDeckEngine)
        document.addEventListener("DOMContentLoaded", initTarotDeckEngine)
    </script>
</Base>

<style>
    /* Cool Platinum / Silvery Arctic Mist Light Theme (Zero Cream / Pure Crisp Ethereal Light) */
    body {
        background: radial-gradient(
            ellipse 85vw 120vh at 50vw 45vh,
            #FFFFFF 0%,
            #F4F7FA 30%,
            #E8F0F6 60%,
            #DCE6EF 85%,
            #CFDCE7 100%
        ) fixed;
        color: #0F172A;
        min-height: 100dvh;
        overflow-x: hidden;
    }

    .projects-page {
        --pw-ink: #0F172A;
        --pw-muted: #64748B;
        --pw-border: rgba(15, 23, 42, 0.08);
        --pw-accent: #0D9488;
        --pw-sans: var(--secondary-font, 'DM Sans', -apple-system, sans-serif);

        display: flex;
        flex-direction: column;
        height: 100dvh;
        padding: clamp(56px, 6.5vh, 80px) clamp(24px, 4vw, 56px) clamp(16px, 2vh, 24px);
        gap: clamp(14px, 1.8vh, 22px);
        overflow: hidden;
        box-sizing: border-box;
    }

    /* Top Navigation Adaptation for Light Background */
    :global(nav:not(.category-rail)) {
        background: rgba(255, 255, 255, 0.8) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06) !important;
    }

    :global(#pages-list button),
    :global(#pages-list a) {
        color: #64748B !important;
    }

    :global(#pages-list button:hover),
    :global(#pages-list a:hover) {
        color: #0F172A !important;
    }

    :global(#pages-list a[aria-current="page"]),
    :global(button[aria-pressed="true"]) {
        background: #0F172A !important;
        color: #FFFFFF !important;
    }

    /* Category Rail Adaptation */
    :global(.category-rail) {
        background: transparent !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
        border: none !important;
    }

    :global(.rail-title) {
        color: #64748B !important;
        font-weight: 700 !important;
    }

    :global(.rail-node) {
        color: #475569 !important;
    }

    :global(.rail-node:hover) {
        background: rgba(15, 23, 42, 0.04) !important;
    }

    :global(.rail-node[aria-pressed="true"]) {
        background: rgba(255, 255, 255, 0.9) !important;
        border-color: rgba(15, 23, 42, 0.12) !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06) !important;
    }

    :global(.rail-node[aria-pressed="true"] .node-label) {
        color: #0F172A !important;
        font-weight: 700 !important;
    }

    :global(.node-label) {
        color: #475569 !important;
    }

    :global(.node-count) {
        color: #94A3B8 !important;
    }

    :global(.node-dot) {
        background: #CBD5E1 !important;
    }

    :global(.rail-node[aria-pressed="true"] .node-dot) {
        background: var(--cat-accent, #0D9488) !important;
        box-shadow: 0 0 8px var(--cat-accent, #0D9488) !important;
    }

    /* Intro Block */
    .intro {
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        width: 100%;
        gap: 8px;
    }

    .identity-block {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .identity-name {
        font-family: var(--pw-sans);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: #0F172A;
        margin: 0;
    }

    .identity-tagline {
        font-family: var(--pw-sans);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pw-muted);
        margin: 0;
    }

    .work-header {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 4px;
    }

    .work-eyebrow {
        font-family: var(--pw-sans);
        font-weight: 600;
        font-size: 0.6875rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pw-accent);
        margin: 0;
    }

    .work-headline {
        max-width: 54ch;
        font-family: var(--pw-sans);
        font-weight: 400;
        font-size: clamp(1.05rem, 1.4vw, 1.22rem);
        line-height: 1.45;
        color: #334155;
        margin: 0;
    }

    .work-headline strong {
        font-weight: 700;
        color: #0F172A;
    }

    /* Work Stage: Category Rail on Left & Tarot Deck on Right */
    .work-stage {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        align-items: center;
        gap: clamp(24px, 3.5vw, 48px);
        width: 100%;
        flex: 1;
        min-height: 0;
    }

    /* Deck Section */
    .deck-section {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        width: 100%;
        height: 100%;
    }

    .deck-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 20;
        pointer-events: none;
    }

    .deck-stack-indicators {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--pw-sans);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #64748B;
        opacity: 0.75;
    }

    .stack-indicator-sep {
        color: var(--pw-accent);
        font-size: 0.85rem;
    }

    .deck-controls {
        display: flex;
        align-items: center;
        gap: 6px;
        pointer-events: auto;
    }

    .nav-arrow-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(15, 23, 42, 0.12);
        color: #334155;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.05);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .nav-arrow-btn:hover {
        background: #0F172A;
        color: #FFFFFF;
        border-color: #0F172A;
    }

    /* Deck Stage 3D Perspective Area */
    .deck-stage-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .deck-stage {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        perspective: 1400px;
        perspective-origin: center center;
        cursor: grab;
        user-select: none;
        outline: none;
    }

    .deck-stage.is-dragging {
        cursor: grabbing;
    }

    .deck-card-item {
        position: absolute;
        width: clamp(240px, 18vw, 280px);
        aspect-ratio: 3.6 / 5.2;
        transform-style: preserve-3d;
        cursor: pointer;
        will-change: transform, z-index;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    .deck-card-item.is-deck-stack .holo-card-flipper {
        transform: none !important;
    }

    /* Trusted By Strip */
    .trusted-by {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        flex-shrink: 0;
        gap: 0.5em;
        width: 100%;
        margin: 0;
        padding-top: 10px;
        border-top: 1px solid var(--pw-border);
        font-family: var(--pw-sans);
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        color: var(--pw-muted);
    }

    .trusted-by-label {
        font-weight: 700;
        text-transform: uppercase;
        color: #0F172A;
        margin-right: 0.4em;
    }

    .trusted-by-name {
        color: #64748B;
        transition: color 0.2s ease;
    }

    .trusted-by-name:hover {
        color: #0F172A;
    }

    .trusted-by-sep {
        opacity: 0.4;
    }

    /* Mobile Responsive Adaptation */
    @media (max-width: 900px) {
        .projects-page {
            height: auto;
            min-height: 100dvh;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 48px 20px 32px;
            gap: 20px;
        }

        .work-stage {
            grid-template-columns: minmax(0, 1fr);
            flex: none;
            gap: 20px;
        }

        .deck-stage-wrapper {
            height: 480px;
        }

        .deck-header {
            position: static;
            margin-bottom: 12px;
        }
    }
</style>
