---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import DoodleLinkedInJobCard from "../components/DoodleLinkedInJobCard.astro";
import DoodleVinylRecord from "../components/DoodleVinylRecord.astro";
import AgentTreeIcons from "../components/mascots/AgentTreeIcons.astro";
import HowItWorksWorkflow from "../components/HowItWorksWorkflow.astro";

const project = await getEntry("projects", "automating_unemployment");
const story = project?.data?.story || {};
const {
  vignette3 = {},
  footer = {},
} = story;

const agents = vignette3?.agents || [];
---

<Base>
  <div class="height-story-wrap">
    <!-- Minimalist Top Navigation -->
    <header class="story-header" id="storyHeader">
      <a href="/" class="header-back" id="headerBackBtn" aria-label="Return to portfolio deck">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span id="headerBackText">Deck</span>
      </a>
      <div class="header-case-no">01 // Case Study</div>
    </header>

    <!-- ============================================================ -->
    <!-- 01 // HERO SCROLLYTELLING RUNWAY (STAGE CURTAIN + DILEMMA FRAME) -->
    <!-- ============================================================ -->
    <div class="hero-scrolly-runway" id="hero-runway">
      <section class="figma-hero-stage" id="hero">
        
        <!-- FRAME 2: WHITE CANVAS (REVEALED UNDERNEATH THE CURTAIN) -->
        <div class="dilemma-white-stage" data-dilemma-stage>
          
          <!-- STATE A: Dilemma Questions & Choice Stage -->
          <div class="dilemma-content-wrapper" id="dilemmaQuestionsWrap">
            
            <!-- Top-Left Title & Punchline -->
            <div class="dilemma-header-group" data-dilemma-header>
              <span class="dilemma-eyebrow">01 // THE REALITY OF UNEMPLOYMENT</span>
              <h2 class="dilemma-title">
                Do you know how time consuming it is to be unemployed?
                <span class="dilemma-punchline">I do.</span>
              </h2>
              <p class="dilemma-sub-lead">
                You're a career changer who has just moved to London. You want to move into tech, and you're currently mid-way through your training. Do you:
              </p>
            </div>

            <!-- Centered Choice Stage: Left Option, Center Character, Right Option -->
            <div class="dilemma-decision-stage" data-dilemma-body>
              
              <!-- Option 1 (Selectable Button Card) -->
              <button
                class="dilemma-choice-btn choice-left"
                id="choiceOption1"
                data-choice="1"
                type="button"
                aria-label="Option 1: Finish your training course which will take months, then apply for jobs in the industry you're training for"
              >
                <!-- Corner Doodle Sparks -->
                <div class="card-doodle-spark top-right" aria-hidden="true">
                  <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
                    <path d="M16 2 L18.5 11.5 L28 14 L18.5 16.5 L16 26 L13.5 16.5 L4 14 L13.5 11.5 Z" fill="#000000" />
                    <circle cx="16" cy="14" r="2.5" fill="#FFFFFF" />
                  </svg>
                </div>

                <div class="choice-tag-row">
                  <span class="choice-num-badge">1</span>
                  <span class="choice-hint">Choice A</span>
                </div>
                <p class="choice-main-text">
                  Finish your training course which will take months, then apply for jobs in the industry you're training for
                </p>
                <div class="choice-bottom-bar">
                  <span class="choice-pick-pill">Pick this one</span>
                </div>
              </button>

              <!-- Center Confused Mascot -->
              <div class="dilemma-center-character">
                <img
                  src="/img/au-character-confused.png"
                  alt="Character standing in confusion choosing between two options"
                  class="dilemma-standing-img"
                />
              </div>

              <!-- Option 2 (Selectable Button Card) -->
              <button
                class="dilemma-choice-btn choice-right"
                id="choiceOption2"
                data-choice="2"
                type="button"
                aria-label="Option 2: Work and train at the same time"
              >
                <!-- Corner Doodle Sparks -->
                <div class="card-doodle-spark top-left" aria-hidden="true">
                  <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
                    <path d="M16 2 L18.5 11.5 L28 14 L18.5 16.5 L16 26 L13.5 16.5 L4 14 L13.5 11.5 Z" fill="#000000" />
                    <circle cx="16" cy="14" r="2.5" fill="#FFFFFF" />
                  </svg>
                </div>

                <div class="choice-tag-row">
                  <span class="choice-num-badge">2</span>
                  <span class="choice-hint">Choice B</span>
                </div>
                <p class="choice-main-text">
                  Work and train at the same time
                </p>
                <div class="choice-bottom-bar">
                  <span class="choice-pick-pill">Pick this one</span>
                </div>
              </button>

            </div>
          </div>

          <!-- STATE B: The Benefits Frame (Revealed when clicking "wth?") -->
          <div class="benefits-content-wrapper is-hidden" id="benefitsFrameWrap">
            
            <!-- Centered Title Group -->
            <div class="benefits-header-group">
              <span class="benefits-eyebrow">02 // AGENTIC WORKFLOW</span>
              <h2 class="benefits-main-title">
                The case study shows how I used a multi-agent team to automate the job-hunt, freeing up <span class="benefits-highlight-pill">83% of my time</span>.
              </h2>
            </div>

            <!-- Free Text List with Cool Doodle-Pop Urban Icons (No Card Boxes) -->
            <div class="benefits-free-list">
              
              <!-- Benefit 1: Stylised Sparkly Brain -->
              <div class="benefit-doodle-item">
                <div class="benefit-doodle-icon-wrap brain-glow">
                  <svg viewBox="0 0 120 120" width="104" height="104" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20 28 L23 18 L26 28 L36 31 L26 34 L23 44 L20 34 L10 31 Z" fill="#000000" />
                    <circle cx="23" cy="31" r="2.5" fill="#FFFFFF" />
                    <path d="M96 22 L98 14 L100 22 L108 24 L100 26 L98 34 L96 26 L88 24 Z" fill="#FF1F70" stroke="#000000" stroke-width="2" />
                    <path d="M102 78 L104 72 L106 78 L112 80 L106 82 L104 88 L102 82 L96 80 Z" fill="#00B3E3" stroke="#000000" stroke-width="1.8" />
                    <path d="M60 12 L65 24 L56 26 L63 38" stroke="#000000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M42 42 C32 42, 24 50, 24 60 C24 68, 30 74, 34 78 C30 84, 35 94, 46 94 C51 94, 55 91, 58 88 C59 88, 59 44, 42 42 Z" fill="#FF1F70" stroke="#000000" stroke-width="3.5" stroke-linejoin="round" />
                    <path d="M78 42 C88 42, 96 50, 96 60 C96 68, 90 74, 86 78 C90 84, 85 94, 74 94 C69 94, 65 91, 62 88 C61 88, 61 44, 78 42 Z" fill="#FF528F" stroke="#000000" stroke-width="3.5" stroke-linejoin="round" />
                    <path d="M38 54 C46 54, 48 64, 42 70 C36 76, 44 84, 52 82" stroke="#000000" stroke-width="3.2" stroke-linecap="round" />
                    <path d="M82 54 C74 54, 72 64, 78 70 C84 76, 76 84, 68 82" stroke="#000000" stroke-width="3.2" stroke-linecap="round" />
                    <path d="M50 46 C56 50, 56 60, 50 64" stroke="#000000" stroke-width="3" stroke-linecap="round" />
                    <path d="M70 46 C64 50, 64 60, 70 64" stroke="#000000" stroke-width="3" stroke-linecap="round" />
                    <ellipse cx="36" cy="48" rx="5" ry="2.5" transform="rotate(-30 36 48)" fill="#FFFFFF" />
                    <ellipse cx="84" cy="48" rx="5" ry="2.5" transform="rotate(30 84 48)" fill="#FFFFFF" />
                  </svg>
                </div>
                <p class="benefit-item-text">
                  Free time can be used on personal development and studying, further improving my job prospects.
                </p>
              </div>

              <!-- Benefit 2: Zen Chill Sunglasses Smiley -->
              <div class="benefit-doodle-item">
                <div class="benefit-doodle-icon-wrap chill-glow">
                  <svg viewBox="0 0 120 120" width="104" height="104" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M60 10 L60 20 M18 60 L28 60 M92 60 L102 60 M30 30 L38 38 M90 30 L82 38" stroke="#000000" stroke-width="3" stroke-linecap="round" />
                    <path d="M16 22 L18 16 L20 22 L26 24 L20 26 L18 32 L16 26 L10 24 Z" fill="#D1FF00" stroke="#000000" stroke-width="1.8" />
                    <path d="M104 26 L106 20 L108 26 L114 28 L108 30 L106 36 L104 30 L98 28 Z" fill="#000000" />
                    <circle cx="60" cy="64" r="34" fill="#00B3E3" stroke="#000000" stroke-width="3.5" />
                    <path d="M36 54 L56 54 L54 66 C54 70, 40 70, 38 66 Z" fill="#000000" stroke="#000000" stroke-width="2" />
                    <path d="M64 54 L84 54 L82 66 C82 70, 68 70, 66 66 Z" fill="#000000" stroke="#000000" stroke-width="2" />
                    <path d="M54 57 L66 57" stroke="#000000" stroke-width="3.5" stroke-linecap="round" />
                    <path d="M42 56 L40 64" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
                    <path d="M46 56 L44 60" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M70 56 L68 64" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
                    <path d="M74 56 L72 60" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M46 76 C52 85, 68 85, 74 76" stroke="#000000" stroke-width="3.5" stroke-linecap="round" fill="none" />
                    <ellipse cx="38" cy="74" rx="4" ry="2.5" fill="#FF1F70" />
                    <ellipse cx="82" cy="74" rx="4" ry="2.5" fill="#FF1F70" />
                  </svg>
                </div>
                <p class="benefit-item-text">
                  Improved mental clarity and reduced stress
                </p>
              </div>

              <!-- Benefit 3: Auto-Mode Rocket Robot -->
              <div class="benefit-doodle-item">
                <div class="benefit-doodle-icon-wrap auto-glow">
                  <svg viewBox="0 0 120 120" width="104" height="104" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 48 L26 48 M10 62 L22 62 M14 76 L28 76" stroke="#000000" stroke-width="3" stroke-linecap="round" />
                    <path d="M96 20 L98 12 L100 20 L108 22 L100 24 L98 32 L96 24 L88 22 Z" fill="#FF1F70" stroke="#000000" stroke-width="2" />
                    <path d="M102 68 L104 62 L106 68 L112 70 L106 72 L104 78 L102 72 L96 70 Z" fill="#000000" />
                    <path d="M60 36 L60 22" stroke="#000000" stroke-width="3.5" stroke-linecap="round" />
                    <circle cx="60" cy="18" r="5" fill="#FFDA00" stroke="#000000" stroke-width="2.5" />
                    <path d="M68 14 L73 18 L70 21 L75 25" stroke="#FF1F70" stroke-width="2" stroke-linecap="round" />
                    <rect x="36" y="36" width="48" height="42" rx="12" fill="#D1FF00" stroke="#000000" stroke-width="3.5" />
                    <rect x="44" y="46" width="32" height="18" rx="6" fill="#000000" />
                    <rect x="48" y="52" width="24" height="6" rx="3" fill="#00B3E3" />
                    <circle cx="60" cy="55" r="3.5" fill="#FFFFFF" />
                    <rect x="29" y="49" width="7" height="14" rx="3.5" fill="#00B3E3" stroke="#000000" stroke-width="2.5" />
                    <rect x="84" y="49" width="7" height="14" rx="3.5" fill="#00B3E3" stroke="#000000" stroke-width="2.5" />
                    <path d="M50 78 L60 98 L70 78 Z" fill="#FF1F70" stroke="#000000" stroke-width="3" stroke-linejoin="round" />
                    <path d="M54 78 L60 90 L66 78 Z" fill="#FFDA00" />
                    <ellipse cx="45" cy="42" rx="4" ry="2" fill="#FFFFFF" />
                  </svg>
                </div>
                <p class="benefit-item-text">
                  Removal of repetitive tasks
                </p>
              </div>

            </div>

            <!-- CTA Row -->
            <div class="benefits-action-row">
              <button class="benefits-scroll-cta" id="exploreWorkflowBtn" type="button">
                <span>Explore interactive desktop</span>
                <span class="cta-arrow-down">↓</span>
              </button>
            </div>

          </div>

          <!-- Dynamic Interactive Pop-up Answer Modal (Overlays entire stage with pure solid white) -->
          <div class="dilemma-popup-overlay" id="dilemmaAnswerPopup" aria-hidden="true">
            <div class="dilemma-popup-card">
              <div class="popup-header-row">
                <h3 class="popup-answer-title" id="popupTitle">WRONG</h3>
                <button class="popup-close-btn" id="closePopupBtn" aria-label="Close answer">✕</button>
              </div>
              <div class="popup-body-content">
                <p class="popup-answer-p" id="popupText">
                  You can't afford food.
                </p>
                
                <!-- Primary Action Button ("try again" / "wth?") -->
                <div class="popup-action-row">
                  <button class="popup-action-btn" id="popupActionBtn" type="button">
                    <span id="popupActionBtnText">try again</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- FRAME 1: TEAL STAGE CURTAIN (SLIDES UP LIKE A THEATER CURTAIN ON SCROLL) -->
        <div class="hero-curtain-layer" id="heroCurtainLayer" data-hero-curtain>
          <!-- Floating Hero Title -->
          <div class="hero-float-center" data-hero-title>
            <h1 class="hero-title-text">
              <span>Automating</span>
              <span>Unemployment.</span>
            </h1>
          </div>

          <!-- Lounger Character Anchored in Bottom-Right Corner -->
          <div class="hero-lounger-corner" data-hero-lounger>
            <img
              src="/img/au-hero-character-cutout.png"
              alt="Character lounging on deckchair"
              class="hero-lounger-img"
            />
          </div>
        </div>

      </section>
    </div>

    <!-- ============================================================ -->
    <!-- 02 // HOW IT WORKS: INTERACTIVE WORKFLOW & DIVE-IN RUNTIME   -->
    <!-- ============================================================ -->
    <HowItWorksWorkflow />

    <!-- ============================================================ -->
    <!-- 03 // MEET THE TEAM: 2-TIER AUTONOMOUS AGENT HIERARCHY      -->
    <!-- ============================================================ -->
    <section class="team-hierarchy-section" id="team-section">
      <div class="team-section-container">
        <div class="team-header-box">
          <span class="team-eyebrow">03 // AUTONOMOUS AGENT HIERARCHY</span>
          <h2 class="team-main-title">Meet the team</h2>
        </div>

        <!-- Tree Hierarchy Container -->
        <div class="agent-tree-wrapper">
          
          <!-- TOP LEVEL: ROOT AGENT (GILES - THE ORCHESTRATOR / BOSS) -->
          <div class="tree-root-row">
            {agents[0] && (
              <div class="agent-node-card root-node" style="--node-accent: #D97706;">
                <div class="node-chassis-top">
                  <div class="node-tag-group">
                    <span class="node-rivet">+</span>
                    <span class="node-level-id">AGENT // 01</span>
                  </div>
                  <div class="node-status-chip">
                    <span class="node-live-led" style="background-color: #D97706;" />
                    <span class="node-status-label">ONLINE</span>
                    <span class="node-rivet">+</span>
                  </div>
                </div>

                <div class="node-chassis-body">
                  <div class="node-icon-col">
                    <AgentTreeIcons type="boss" size="52px" />
                  </div>
                  <div class="node-info-col">
                    <div class="node-title-row">
                      <h3 class="node-agent-name">{agents[0].name}</h3>
                      <span class="node-chip-badge">ORCHESTRATOR</span>
                    </div>
                    <span class="node-agent-role" style="color: #D97706;">{agents[0].role}</span>
                    <p class="node-brief-text">{agents[0].brief}</p>
                  </div>
                </div>

                <div class="node-telemetry-tray">
                  <span class="telemetry-item"><strong>SCHEDULE:</strong> 3X DAILY CRON</span>
                  <span class="telemetry-dot">·</span>
                  <span class="telemetry-item"><strong>FILTER:</strong> 95% SPAM DROPPED</span>
                </div>
              </div>
            )}
          </div>

          <!-- CONNECTING FORK BUS SVG (FLOWS FROM GILES TO CORDELIA & WILLOW ONLY) -->
          <div class="tree-fork-connector" aria-hidden="true">
            <svg class="tree-conduit-svg" viewBox="0 0 680 44" fill="none">
              <path d="M 340 0 L 340 22" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 340 0 L 340 22" stroke="#D97706" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-stem" />

              <path d="M 170 22 L 510 22" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 170 22 L 510 22" stroke="#71717A" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-split" />

              <path d="M 170 22 L 170 44" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 170 22 L 170 44" stroke="#E11D48" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-left" />

              <path d="M 510 22 L 510 44" stroke="#000000" stroke-width="3" stroke-linecap="round" />
              <path d="M 510 22 L 510 44" stroke="#0D9488" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="4 4" class="dash-right" />

              <circle r="4" fill="#E11D48" stroke="#000000" stroke-width="1.5">
                <animateMotion path="M 340 0 L 340 22 L 170 22 L 170 44" dur="2.2s" repeatCount="indefinite" />
                <animate attributeName="opacity" values="0; 1; 1; 0" keyTimes="0; 0.08; 0.92; 1" dur="2.2s" repeatCount="indefinite" />
              </circle>

              <circle r="4" fill="#0D9488" stroke="#000000" stroke-width="1.5">
                <animateMotion path="M 340 0 L 340 22 L 510 22 L 510 44" dur="2.2s" begin="0.35s" repeatCount="indefinite" />
                <animate attributeName="opacity" values="0; 1; 1; 0" keyTimes="0; 0.08; 0.92; 1" dur="2.2s" begin="0.35s" repeatCount="indefinite" />
              </circle>
            </svg>
          </div>

          <!-- BOTTOM LEVEL: 2 SUB-AGENTS -->
          <div class="tree-branches-row">
            {agents[1] && (
              <div class="agent-node-card branch-node" style="--node-accent: #E11D48;">
                <div class="node-chassis-top">
                  <div class="node-tag-group">
                    <span class="node-rivet">+</span>
                    <span class="node-level-id">SUB-AGENT // 01</span>
                  </div>
                  <div class="node-status-chip">
                    <span class="node-live-led" style="background-color: #E11D48;" />
                    <span class="node-status-label">ANALYZING</span>
                    <span class="node-rivet">+</span>
                  </div>
                </div>

                <div class="node-chassis-body">
                  <div class="node-icon-col">
                    <AgentTreeIcons type="tailor" size="48px" />
                  </div>
                  <div class="node-info-col">
                    <div class="node-title-row">
                      <h3 class="node-agent-name">{agents[1].name}</h3>
                      <span class="node-chip-badge">TAILOR & TWEAK</span>
                    </div>
                    <span class="node-agent-role" style="color: #E11D48;">{agents[1].role}</span>
                    <p class="node-brief-text">{agents[1].brief}</p>
                  </div>
                </div>

                <div class="node-telemetry-tray">
                  <span class="telemetry-item"><strong>EVAL:</strong> 100% FACT GROUNDED</span>
                  <span class="telemetry-dot">·</span>
                  <span class="telemetry-item"><strong>PRECISION:</strong> ZERO HALLUCINATION</span>
                </div>
              </div>
            )}

            {agents[2] && (
              <div class="agent-node-card branch-node" style="--node-accent: #0D9488;">
                <div class="node-chassis-top">
                  <div class="node-tag-group">
                    <span class="node-rivet">+</span>
                    <span class="node-level-id">SUB-AGENT // 02</span>
                  </div>
                  <div class="node-status-chip">
                    <span class="node-live-led" style="background-color: #0D9488;" />
                    <span class="node-status-label">READY</span>
                    <span class="node-rivet">+</span>
                  </div>
                </div>

                <div class="node-chassis-body">
                  <div class="node-icon-col">
                    <AgentTreeIcons type="developer" size="48px" />
                  </div>
                  <div class="node-info-col">
                    <div class="node-title-row">
                      <h3 class="node-agent-name">{agents[2].name}</h3>
                      <span class="node-chip-badge">DEV & DEBUG</span>
                    </div>
                    <span class="node-agent-role" style="color: #0D9488;">{agents[2].role}</span>
                    <p class="node-brief-text">{agents[2].brief}</p>
                  </div>
                </div>

                <div class="node-telemetry-tray">
                  <span class="telemetry-item"><strong>CHANNEL:</strong> #JOB-APPROVALS</span>
                  <span class="telemetry-dot">·</span>
                  <span class="telemetry-item"><strong>ACTION:</strong> 1-CLICK DISPATCH</span>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 04 // THE AI DOOM LOOP & MARKET REALITY                      -->
    <!-- ============================================================ -->
    <section class="doom-loop-standalone-section" id="doom-section">
      <div class="doom-section-container">
        <!-- Section Header -->
        <div class="doom-standalone-header">
          <span class="doom-section-eyebrow">04 // MARKET CONTEXT</span>
          <h2 class="doom-standalone-title">
            Job-seekers are trapped in the <strong>"AI doom loop"</strong>.
          </h2>
        </div>

        <!-- Vinyl & Lyrical Tracks Layout -->
        <div class="doom-interactive-layout">
          <!-- Vinyl Record Column -->
          <div class="doom-vinyl-column">
            <DoodleVinylRecord
              size="min(46vw, 400px)"
              autoSpin={true}
              interactive={true}
            />
          </div>

          <!-- Lyrical Tracks Column -->
          <div class="doom-tracks-column">
            <div class="doom-track-card track-1">
              <span class="lyric-track-tag">TRACK 01 // SIDE A</span>
              <p class="doom-wavy-text">
                Candidates facing a difficult job market turn to AI to help them apply for <strong>more</strong> jobs.
              </p>
            </div>
            <div class="doom-track-card track-2">
              <span class="lyric-track-tag">TRACK 02 // ACCELERATION</span>
              <p class="doom-wavy-text">
                Companies facing huge numbers of applications per job, turn to AI to help them filter candidates.
              </p>
            </div>
            <div class="doom-track-card track-3">
              <span class="lyric-track-tag">TRACK 03 // LOOP</span>
              <p class="doom-wavy-text">
                Competition increases and job-seeking gets harder.
              </p>
            </div>
          </div>
        </div>

        <!-- ON REPEAT Stamp & LinkedIn Surge Card -->
        <div class="doom-extras-row">
          <div class="doom-stamp-col">
            <div class="doom-on-repeat-stamp is-slammed">
              <svg class="on-repeat-svg" viewBox="0 0 270 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="7" y="7" width="248" height="74" rx="14" fill="#000000" />
                <rect x="3" y="3" width="248" height="74" rx="14" fill="#FFD233" stroke="#000000" stroke-width="3.5" />
                <rect x="12" y="8" width="230" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.65" />
                <text x="16" y="26" font-family="monospace" font-size="9" font-weight="900" fill="#000000" letter-spacing="1.5">CYCLE // STATUS</text>
                <text x="15" y="60" font-family="var(--archivo-font), 'Archivo', -apple-system, sans-serif" font-size="28" font-weight="900" font-style="italic" fill="#000000" letter-spacing="-0.5">ON REPEAT</text>
                <g transform="translate(182, 18)">
                  <circle cx="24" cy="24" r="21" fill="#FF5238" stroke="#000000" stroke-width="3" />
