<script>
  function initAUScrollytelling() {
    const runway = document.getElementById("hero-runway");
    const curtain = document.getElementById("heroCurtainLayer");
    const titleEl = document.querySelector("[data-hero-title]");
    const dilemmaHeader = document.querySelector("[data-dilemma-header]");
    const dilemmaBody = document.querySelector("[data-dilemma-body]");

    // Interactive choice selection & dynamic pop-up logic
    let selectionAttempts = 0;
    const dilemmaStageEl = document.querySelector("[data-dilemma-stage]");
    const choice1Btn = document.getElementById("choiceOption1");
    const choice2Btn = document.getElementById("choiceOption2");
    const answerPopup = document.getElementById("dilemmaAnswerPopup");
    const closePopupBtn = document.getElementById("closePopupBtn");
    const popupTitle = document.getElementById("popupTitle");
    const popupText = document.getElementById("popupText");
    const popupActionBtn = document.getElementById("popupActionBtn");
    const popupActionBtnText = document.getElementById("popupActionBtnText");
    const dilemmaQuestionsWrap = document.getElementById("dilemmaQuestionsWrap");
    const benefitsFrameWrap = document.getElementById("benefitsFrameWrap");
    const exploreWorkflowBtn = document.getElementById("exploreWorkflowBtn");
    const benefitsDesktopPeek = document.getElementById("benefitsDesktopPeek");

    function openAnswerPopup(choiceNumber: string) {
      selectionAttempts += 1;

      if (choice1Btn) choice1Btn.classList.toggle("is-selected", choiceNumber === "1");
      if (choice2Btn) choice2Btn.classList.toggle("is-selected", choiceNumber === "2");

      if (selectionAttempts === 1) {
        // First selection: title = "WRONG", button = "try again"
        if (popupTitle) popupTitle.textContent = "WRONG";
        if (popupActionBtnText) popupActionBtnText.textContent = "try again";

        if (choiceNumber === "1") {
          if (popupText) popupText.textContent = "You can't afford food";
        } else {
          if (popupText) {
            popupText.textContent =
              "You spend around 12 hours a day searching for and applying for jobs, leaving no time to complete your training.";
          }
        }
      } else {
        // Second selection: title = "ALSO WRONG", button = "wth?"
        if (popupTitle) popupTitle.textContent = "ALSO WRONG";
        if (popupActionBtnText) popupActionBtnText.textContent = "wth?";

        if (choiceNumber === "1") {
          if (popupText) popupText.textContent = "You can't afford food";
        } else {
          if (popupText) {
            popupText.textContent =
              "You spend around 12 hours a day searching for and applying for jobs, leaving no time to complete your training.";
          }
        }
      }

      if (answerPopup) {
        answerPopup.classList.add("is-visible");
        answerPopup.setAttribute("aria-hidden", "false");
      }
    }

    function closeAnswerPopup() {
      if (answerPopup) {
        answerPopup.classList.remove("is-visible");
        answerPopup.setAttribute("aria-hidden", "true");
      }
      if (choice1Btn) choice1Btn.classList.remove("is-selected");
      if (choice2Btn) choice2Btn.classList.remove("is-selected");
    }

    function navigateToHowItWorks() {
      const howItWorks =
        document.getElementById("how-it-works") ||
        document.getElementById("how-it-works-hero-canvas") ||
        document.querySelector(".how-it-works-section");
      if (howItWorks) {
        howItWorks.scrollIntoView({ behavior: "smooth" });
      } else {
        window.scrollBy({ top: window.innerHeight * 1.5, behavior: "smooth" });
      }
    }

    function handlePopupAction() {
      const currentBtnText = popupActionBtnText?.textContent?.trim().toLowerCase();
      if (currentBtnText === "try again") {
        closeAnswerPopup();
      } else if (currentBtnText === "wth?" || currentBtnText === "wtf" || currentBtnText === "wth") {
        // Transition to Frame 3: The Benefits Frame!
        closeAnswerPopup();
        if (dilemmaStageEl) dilemmaStageEl.classList.add("is-benefits-mode");
        if (dilemmaQuestionsWrap) dilemmaQuestionsWrap.classList.add("is-hidden");
        if (benefitsFrameWrap) benefitsFrameWrap.classList.remove("is-hidden");
      } else {
        closeAnswerPopup();
      }
    }

    if (choice1Btn) choice1Btn.addEventListener("click", () => openAnswerPopup("1"));
    if (choice2Btn) choice2Btn.addEventListener("click", () => openAnswerPopup("2"));
    if (closePopupBtn) closePopupBtn.addEventListener("click", closeAnswerPopup);
    if (popupActionBtn) popupActionBtn.addEventListener("click", handlePopupAction);
    if (answerPopup) {
      answerPopup.addEventListener("click", (e) => {
        if (e.target === answerPopup) closeAnswerPopup();
      });
    }

    if (exploreWorkflowBtn) exploreWorkflowBtn.addEventListener("click", navigateToHowItWorks);
    if (benefitsDesktopPeek) benefitsDesktopPeek.addEventListener("click", navigateToHowItWorks);

    if (!runway || !curtain) return;

    function onScroll() {
      const rect = runway.getBoundingClientRect();
      const runwayHeight = rect.height - window.innerHeight;
      if (runwayHeight <= 0) return;

      const scrolled = -rect.top;
      // Scroll progress from 0.0 -> 1.0
      const p = Math.min(Math.max(scrolled / runwayHeight, 0), 1);

      // 1. STAGE CURTAIN LIFT (p: 0.00 -> 0.40)
      if (p <= 0.40) {
        const curtainP = p / 0.38;
        const translateY = Math.min(curtainP * 105, 105);
        curtain.style.transform = `translateY(-${translateY.toFixed(2)}%)`;
        curtain.style.pointerEvents = curtainP >= 0.95 ? "none" : "auto";

        // Fade title slightly as curtain pulls up
        if (titleEl) {
          const titleOp = Math.max(0, 1 - curtainP * 1.2);
          (titleEl as HTMLElement).style.opacity = titleOp.toFixed(3);
        }
      } else {
        curtain.style.transform = `translateY(-105%)`;
        curtain.style.pointerEvents = "none";
        if (titleEl) (titleEl as HTMLElement).style.opacity = "0";
      }

      // 2. DILEMMA REVEAL UNDERNEATH (p: 0.15 -> 0.60)
      if (p >= 0.15) {
        if (dilemmaHeader) {
          const headOp = Math.min((p - 0.15) / 0.15, 1);
          (dilemmaHeader as HTMLElement).style.opacity = headOp.toFixed(3);
        }
        if (dilemmaBody) {
          const bodyOp = Math.min((p - 0.25) / 0.18, 1);
          (dilemmaBody as HTMLElement).style.opacity = bodyOp.toFixed(3);
        }
      } else {
        if (dilemmaHeader) (dilemmaHeader as HTMLElement).style.opacity = "0.4";
        if (dilemmaBody) (dilemmaBody as HTMLElement).style.opacity = "0.2";
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener("DOMContentLoaded", () => {
    initAUScrollytelling();
  });
  document.addEventListener("astro:page-load", () => {
    initAUScrollytelling();
  });
</script>
